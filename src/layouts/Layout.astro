---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

interface Breadcrumb {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageCaption?: string;
  type?: 'website' | 'article';
  robots?: string;
  adsEligible?: boolean;
  analyticsEligible?: boolean;
  breadcrumbs?: Breadcrumb[];
  article?: {
    pubDate: Date;
    updatedDate?: Date;
    section?: string;
    subjects?: string[];
    keywords?: string[];
    priorPublication?: {
      platform: 'NAVER';
      url: string;
      relation: 'revised-edition';
    };
  };
  extraSchema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  ogImageAlt = description,
  ogImageWidth,
  ogImageHeight,
  ogImageCaption,
  type = 'website',
  robots = 'index,follow,max-image-preview:large',
  adsEligible = true,
  analyticsEligible = true,
  breadcrumbs = [{ label: '홈', href: '/' }],
  article,
  extraSchema,
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} - ${site.name}`;
const canonicalURL = new URL(Astro.url.pathname, site.url).toString();
const ogImageURL = new URL(ogImage, site.url).toString();
const resolvedOgImageWidth = ogImageWidth ?? (ogImage === '/og-default.png' ? 1200 : undefined);
const resolvedOgImageHeight = ogImageHeight ?? (ogImage === '/og-default.png' ? 630 : undefined);
const ogImageType = ogImage.toLowerCase().endsWith('.png')
  ? 'image/png'
  : ogImage.toLowerCase().endsWith('.webp')
    ? 'image/webp'
    : 'image/jpeg';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.label,
    item: new URL(crumb.href, site.url).toString(),
  })),
};

const articleSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: {
        '@type': 'ImageObject',
        url: ogImageURL,
        contentUrl: ogImageURL,
        ...(resolvedOgImageWidth ? { width: resolvedOgImageWidth } : {}),
        ...(resolvedOgImageHeight ? { height: resolvedOgImageHeight } : {}),
        ...(ogImageCaption ? { caption: ogImageCaption } : {}),
      },
      datePublished: article.pubDate.toISOString(),
      dateModified: (article.updatedDate ?? article.pubDate).toISOString(),
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL,
      },
      inLanguage: site.locale,
      ...(article.section ? { articleSection: article.section } : {}),
      ...(article.keywords?.length ? { keywords: article.keywords.join(', ') } : {}),
      ...(article.subjects?.length
        ? { about: article.subjects.map((name) => ({ '@type': 'Thing', name })) }
        : {}),
      author: {
        '@type': 'Person',
        '@id': `${site.url}/#author`,
        name: site.authorName,
        url: `${site.url}/about/`,
      },
      publisher: { '@id': `${site.url}/#author` },
      copyrightHolder: { '@id': `${site.url}/#author` },
      copyrightYear: String(article.pubDate.getFullYear()),
      copyrightNotice: `© ${article.pubDate.getFullYear()} ${site.authorName}(${site.author}). All rights reserved.`,
      ...(article.priorPublication
        ? {
            isBasedOn: {
              '@type': 'CreativeWork',
              name: `${site.authorName}(${site.author})의 ${article.priorPublication.platform} 최초 공개본`,
              url: article.priorPublication.url,
            },
          }
        : {}),
    }
  : null;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.name,
  alternateName: site.alternateNames,
  description: site.homeDescription,
  inLanguage: site.locale,
  author: { '@id': `${site.url}/#author` },
  creator: { '@id': `${site.url}/#author` },
  publisher: { '@id': `${site.url}/#author` },
};

const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#author`,
  name: site.authorName,
  alternateName: site.authorAlternateNames,
  description: site.authorDescription,
  url: `${site.url}/about/`,
  image: `${site.url}/images/profile-bbinge.png`,
  sameAs: site.authorProfiles,
  jobTitle: '기획자·축구사 저자',
  knowsAbout: ['축구사', '축구 문화', '축구 산업', '축구 전술사', '스포츠 마케팅'],
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="image_src" href={ogImageURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={`${site.authorName}(${site.author})`} />
    <meta name="copyright" content={`© ${article?.pubDate.getFullYear() ?? new Date().getFullYear()} ${site.authorName}(${site.author}) · ${site.name}`} />
    <meta name="robots" content={robots} />
    <meta name="naver-site-verification" content="d6fb2830beb60655dc0db5fb92eae1fe8b1cf6be" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content={ogImageType} />
    {resolvedOgImageWidth && <meta property="og:image:width" content={String(resolvedOgImageWidth)} />}
    {resolvedOgImageHeight && <meta property="og:image:height" content={String(resolvedOgImageHeight)} />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {analyticsEligible && (
      <>
        <!-- Google tag (gtag.js) -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3931E0CPPK"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-3931E0CPPK');
        </script>
      </>
    )}
    {adsEligible && (
      <>
        {/* AdSense 사이트 소유권 확인 및 심사용 스니펫. 실제 광고는 권리 확인된 본문 화면의 AdSlot에서만 활성화한다. */}
        <script
          is:inline
          async
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7649211764099932"
          crossorigin="anonymous"
        ></script>
      </>
    )}
    <!-- Kakao SDK: 카카오 디벨로퍼스 JavaScript 키 발급 후 이 자리에 <script src="https://t1.kakaocdn.net/kakao_js_sdk/.../kakao.min.js"> 삽입 + Kakao.init(키).
         키 등록 전까지 ShareButtons.astro의 카카오 공유 버튼은 링크 복사로 자동 대체된다. -->

    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(authorSchema)} />
    {articleSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}
    {extraSchema && (Array.isArray(extraSchema) ? extraSchema : [extraSchema]).map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    {articleSchema && (
      <script is:inline define:vars={{ originalAuthor: `${site.authorName}(${site.author})`, originalSite: site.name, originalURL: canonicalURL }}>
        (() => {
          document.addEventListener('copy', (event) => {
            const selection = window.getSelection();
            if (!selection || selection.isCollapsed) return;
            const selectedText = selection.toString().trim();
            if (selectedText.length < 40) return;
            const anchor = selection.anchorNode instanceof Element
              ? selection.anchorNode
              : selection.anchorNode?.parentElement;
            if (!anchor?.closest('article')) return;
            const active = document.activeElement;
            if (active instanceof HTMLInputElement || active instanceof HTMLTextAreaElement || active?.getAttribute('contenteditable') === 'true') return;
            const attribution = `\n\n- 원문: ${document.title}\n- 저자: ${originalAuthor} · ${originalSite}\n- 출처: ${originalURL}`;
            event.clipboardData?.setData('text/plain', selectedText + attribution);
            event.preventDefault();
          });
        })();
      </script>
    )}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    {analyticsEligible && (
      <>
        <!-- NAVER Analytics -->
        <script is:inline type="text/javascript" src="https://wcs.pstatic.net/wcslog.js"></script>
        <script is:inline type="text/javascript">
          if (!window.wcs_add) window.wcs_add = {};
          window.wcs_add["wa"] = "25cc1f313cc6800";
          if (window.wcs) {
            window.wcs_do();
          }
        </script>
      </>
    )}
  </body>
</html>
