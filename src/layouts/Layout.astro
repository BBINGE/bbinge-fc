---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

interface Breadcrumb {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: 'website' | 'article';
  breadcrumbs?: Breadcrumb[];
  article?: {
    pubDate: Date;
    updatedDate?: Date;
    section?: string;
    subjects?: string[];
  };
  extraSchema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  type = 'website',
  breadcrumbs = [{ label: '홈', href: '/' }],
  article,
  extraSchema,
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} — ${site.name}`;
const canonicalURL = new URL(Astro.url.pathname, site.url).toString();
const ogImageURL = new URL(ogImage, site.url).toString();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.label,
    item: new URL(crumb.href, site.url).toString(),
  })),
};

const articleSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: ogImageURL,
      datePublished: article.pubDate.toISOString(),
      dateModified: (article.updatedDate ?? article.pubDate).toISOString(),
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL,
      },
      inLanguage: site.locale,
      ...(article.section ? { articleSection: article.section } : {}),
      ...(article.subjects?.length
        ? { about: article.subjects.map((name) => ({ '@type': 'Thing', name })) }
        : {}),
      author: {
        '@type': 'Person',
        '@id': `${site.url}/#author`,
        name: site.authorName,
        url: `${site.url}/about/`,
      },
      publisher: { '@id': `${site.url}/#author` },
    }
  : null;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.name,
  alternateName: site.fullName,
  description: site.tagline,
  inLanguage: site.locale,
  publisher: { '@id': `${site.url}/#author` },
};

const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#author`,
  name: site.authorName,
  alternateName: site.author,
  url: `${site.url}/about/`,
  sameAs: [site.naverBlog, site.instagram],
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={`${site.authorName}(${site.author})`} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="naver-site-verification" content="d6fb2830beb60655dc0db5fb92eae1fe8b1cf6be" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3931E0CPPK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-3931E0CPPK');
    </script>
    <!-- AdSense: 심사 승인 후 이 자리에 계정 인증 스니펫 삽입 -->
    <!-- Kakao SDK: 카카오 디벨로퍼스 JavaScript 키 발급 후 이 자리에 <script src="https://t1.kakaocdn.net/kakao_js_sdk/.../kakao.min.js"> 삽입 + Kakao.init(키).
         키 등록 전까지 ShareButtons.astro의 카카오 공유 버튼은 링크 복사로 자동 대체된다. -->

    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(authorSchema)} />
    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}
    {extraSchema && (Array.isArray(extraSchema) ? extraSchema : [extraSchema]).map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
