---
// 박빙 대진 카드: 둔기론·역전극의 대진 카드 구조(문장 · 스코어 · 아래 패널)를 따르고, 스코어 자리에 상대전적을 놓는다.
import type { Rivalry } from '../../data/popup/rivalries';
import RivalryTimeline from './RivalryTimeline.astro';

interface Props { rivalry: Rivalry; featured?: boolean; kicker?: string }
const { rivalry, featured = false, kicker } = Astro.props;
const { a, b, record, goals, meetings } = rivalry;
// 카드 색은 대회가 아니라 이 팝업 하나의 색을 쓴다(운영자 지시, 2026-09-16).
// 한 대진이 여러 대회에 걸쳐 있어 대회별로 칠하면 같은 기획 안에서 색이 들쭉날쭉해진다.
const decisive = meetings.filter((m) => m.round === '결승' || m.round === '4강');
---
<article class:list={['dg-card', 'dg-card--rivalry', 'rv-card', { 'is-featured': featured }]}>
  {kicker && <p class="dg-card__kicker">{kicker}</p>}
  <p class="dg-card__stage">{rivalry.first.slice(0, 4)}-{rivalry.last.slice(0, 4)} · {rivalry.matches}경기</p>
  <div class="dg-scoreboard">
    <div class="dg-side">
      <span class:list={['dg-crest', { 'is-empty': !a.crest }]}>{a.crest ? <img src={a.crest} alt={`${a.name} 문장`} width="64" height="64" loading="lazy" decoding="async" /> : <em aria-hidden="true">{a.name.slice(0, 1)}</em>}</span>
      <strong>{a.name}</strong>
    </div>
    <div class="dg-score rv-score">
      <span>상대전적</span>
      <strong><b>{record.aWin}</b><i>·</i><b class="rv-draw">{record.draw}</b><i>·</i><b>{record.bWin}</b></strong>
      <small>승 · 무 · 패</small>
    </div>
    <div class="dg-side">
      <span class:list={['dg-crest', { 'is-empty': !b.crest }]}>{b.crest ? <img src={b.crest} alt={`${b.name} 문장`} width="64" height="64" loading="lazy" decoding="async" /> : <em aria-hidden="true">{b.name.slice(0, 1)}</em>}</span>
      <strong>{b.name}</strong>
    </div>
  </div>

  <ul class="rv-facts">
    <li><span>득점</span><b>{goals[0]} : {goals[1]}</b></li>
    <li><span>기간</span><b>{rivalry.span}년</b></li>
    {rivalry.competitions.map((c) => <li><span>{c.label}</span><b>{c.count}경기</b></li>)}
  </ul>

  <RivalryTimeline rivalry={rivalry} />

  {decisive.length > 0 && (
    <p class="rv-decisive">
      {decisive.slice(0, 3).map((m) => (
        <span><b>{m.season} {m.round}</b>{m.score[0]}-{m.score[1]}{m.penalty ? ` (PK ${m.penalty[0]}-${m.penalty[1]})` : ''}</span>
      ))}
      {decisive.length > 3 && <span class="rv-decisive__more">결승·4강 {decisive.length}경기</span>}
    </p>
  )}
</article>
