---
// 역전극 카드: 왼쪽이 뒤집은 팀, 오른쪽이 뒤집힌 팀. 둔기론 카드 구조(dg-card)를 그대로 쓰고 대회별 색만 바꾼다.
// 유러피언컵·UEFA 챔피언스 리그 = 미드나이트, UEFA컵·UEFA 유로파 리그·유러피언 컵위너스컵 = 잉크.
import ComebackTimeline from './ComebackTimeline.astro';
import type { ComebackEntry } from '../../data/popup/comebacks';

interface Props { entry: ComebackEntry; featured?: boolean; kicker?: string }
const { entry, featured = false, kicker } = Astro.props;
const theme = entry.competition === 'ucl' ? 'ucl' : 'world';
const scoreLabel = entry.kind === 'aggregate' ? '합계' : '최종';
---
<article class:list={['dg-card', `dg-card--${theme}`, 'cb-card', { 'is-featured': featured }]}>
  {kicker && <p class="dg-card__kicker">{kicker}</p>}
  <p class="dg-card__stage">{entry.stage}</p>
  <div class="dg-scoreboard">
    <div class="dg-side">
      <span class:list={['dg-crest', { 'is-empty': !entry.comeback.crest }]}>{entry.comeback.crest ? <img src={entry.comeback.crest} alt={`${entry.comeback.name} 문장`} width="64" height="64" loading="lazy" decoding="async" /> : <em aria-hidden="true">{entry.comeback.name.slice(0, 1)}</em>}</span>
      <strong>{entry.comeback.name}</strong>
    </div>
    <div class="dg-score">
      <span>{scoreLabel}</span>
      <strong><b>{entry.score[0]}</b><i>:</i><b>{entry.score[1]}</b></strong>
      <small>{entry.note}</small>
    </div>
    <div class="dg-side">
      <span class:list={['dg-crest', { 'is-empty': !entry.opponent.crest }]}>{entry.opponent.crest ? <img src={entry.opponent.crest} alt={`${entry.opponent.name} 문장`} width="64" height="64" loading="lazy" decoding="async" /> : <em aria-hidden="true">{entry.opponent.name.slice(0, 1)}</em>}</span>
      <strong>{entry.opponent.name}</strong>
    </div>
  </div>
  <p class="cb-worst">{entry.worstLabel}</p>
  <div class:list={['dg-legs', { 'cb-legs--two': entry.legs.length > 1 }]}>
    {entry.legs.map((leg) => (
      <section class="dg-leg" aria-label={`${leg.name} ${leg.dateLabel} ${leg.score[0]}-${leg.score[1]}`}>
        <header><span>{leg.name}</span><time datetime={leg.date}>{leg.dateLabel}</time><b>{leg.score[0]}-{leg.score[1]}{leg.penalty ? ` (PK ${leg.penalty[0]}-${leg.penalty[1]})` : ''}</b></header>
        <ComebackTimeline goals={leg.goals} carry={leg.carry} label={`${leg.dateLabel} ${entry.comeback.name} 대 ${entry.opponent.name}`} comebackTeam={entry.comeback.name} opponentTeam={entry.opponent.name} />
      </section>
    ))}
  </div>
</article>
