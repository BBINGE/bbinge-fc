---
// 둔기론 경기 카드: 유러피언컵 대진 카드 구조(문장 · 스코어 · 차전 칸)를 따르고, 대회별로 색만 바꾼다.
// UEFA 챔피언스 리그 = 기존 미드나이트, 분데스리가·DFB-포칼·DFL-슈퍼컵 = 분데스리가 빨강(운영자 확정, 2026-09-16), FIFA 클럽 월드컵 = 잉크.
import DungiTimeline from './DungiTimeline.astro';
import { BAYERN, type Match } from '../../data/popup/bayern-dungi';

interface Props {
  stage: string;
  opponent: string;
  crest: string | null;
  score: [number, number];
  legs: Match[];
  twoLeg?: boolean;
  featured?: boolean;
  kicker?: string;
}
const { stage, opponent, crest, score, legs, twoLeg = false, featured = false, kicker } = Astro.props;
const theme = legs[0].competition === 'ucl' ? 'ucl' : legs[0].competition === 'club-world-cup' ? 'world' : 'germany';
const knockout = !/조별리그|리그 페이즈/.test(stage);
const legName = (m: Match, i: number) => (twoLeg ? (knockout ? `${i + 1}차전 · ${m.venue}` : `${m.venue} 경기`) : m.venue);
const sideName = (name: string) => name;
---
<article class:list={['dg-card', `dg-card--${theme}`, { 'is-featured': featured }]}>
  {kicker && <p class="dg-card__kicker">{kicker}</p>}
  <p class="dg-card__stage">{stage}</p>
  <div class="dg-scoreboard">
    <div class="dg-side">
      <span class="dg-crest"><img src={BAYERN.crest} alt="FC 바이에른 뮌헨 문장" width="64" height="64" loading="lazy" decoding="async" /></span>
      <strong>{BAYERN.name}</strong>
    </div>
    <div class="dg-score">
      {twoLeg && <span>합계</span>}
      <strong><b>{score[0]}</b><i>:</i><b>{score[1]}</b></strong>
      <small>{twoLeg ? `${legs.length}경기 합산` : `${legs[0].dateLabel} · ${legs[0].venue}`}</small>
    </div>
    <div class="dg-side">
      <span class:list={['dg-crest', { 'is-empty': !crest }]}>{crest ? <img src={crest} alt={`${opponent} 문장`} width="64" height="64" loading="lazy" decoding="async" /> : <em aria-hidden="true">{opponent.slice(0, 1)}</em>}</span>
      <strong>{sideName(opponent)}</strong>
    </div>
  </div>
  <div class="dg-legs">
    {legs.map((m, i) => (
      <section class="dg-leg" aria-label={`${legName(m, i)} ${m.dateLabel} ${m.score[0]}-${m.score[1]}`}>
        <header><span>{legName(m, i)}</span><time datetime={m.date}>{m.dateLabel}</time><b>{m.score[0]}-{m.score[1]}</b></header>
        <DungiTimeline goals={m.goals} label={`${m.dateLabel} ${opponent}전`} opponentTeam={opponent} />
      </section>
    ))}
  </div>
</article>
