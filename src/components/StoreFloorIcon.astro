---
interface Props {
  name: 'rooftop' | 'cinema' | 'honor' | 'tactics' | 'library' | 'arcade' | 'travel' | 'fashion' | 'luxury' | 'lobby';
}

const { name } = Astro.props;
---

<span class="store-floor-icon" aria-hidden="true">
  <svg viewBox="0 0 48 48" fill="none">
    {name === 'rooftop' && (
      <>
        <path d="M8 32h32M12 32v7h24v-7M17 27h14l4 5H13l4-5Z" />
        <circle cx="34" cy="14" r="5" />
        <path d="M34 5v3M34 20v3M25 14h3M40 14h3M27.6 7.6l2.1 2.1M38.3 18.3l2.1 2.1M40.4 7.6l-2.1 2.1" />
      </>
    )}
    {name === 'cinema' && (
      <>
        <rect x="8" y="15" width="32" height="24" rx="2" />
        <path d="M8 21h32M13 10l3 5M22 10l3 5M31 10l3 5M8 10h32v5H8z" />
        <path d="m21 26 8 4-8 4v-8Z" />
      </>
    )}
    {name === 'honor' && (
      <>
        <path d="M16 8h16v8c0 7-3 11-8 13-5-2-8-6-8-13V8Z" />
        <path d="M16 12h-6c0 7 3 10 9 10M32 12h6c0 7-3 10-9 10M24 29v7M17 40h14M20 36h8" />
        <path d="m24 13 1.6 3.3 3.7.5-2.7 2.6.7 3.7-3.3-1.8-3.3 1.8.7-3.7-2.7-2.6 3.7-.5L24 13Z" />
      </>
    )}
    {name === 'tactics' && (
      <>
        <rect x="7" y="9" width="34" height="30" rx="2" />
        <path d="M24 9v30M7 24h34" />
        <circle cx="16" cy="17" r="2.5" /><circle cx="32" cy="31" r="2.5" />
        <path d="m18.5 18.5 10 10M27 25l1.5 3.5L25 27" />
      </>
    )}
    {name === 'library' && (
      <>
        <path d="M7 10h12c3 0 5 2 5 5v25c0-3-2-5-5-5H7V10ZM41 10H29c-3 0-5 2-5 5v25c0-3 2-5 5-5h12V10Z" />
        <path d="M12 17h7M12 22h7M29 17h7M29 22h7" />
      </>
    )}
    {name === 'arcade' && (
      <>
        <path d="M14 19h20c4 0 7 3 8 7l2 9c.7 4-4 6-6.5 3l-4.5-5H15l-4.5 5C8 41 3.3 39 4 35l2-9c1-4 4-7 8-7Z" />
        <path d="M15 25v8M11 29h8" /><circle cx="33" cy="27" r="2" /><circle cx="37" cy="32" r="2" />
        <path d="M20 14h8M24 10v4" />
      </>
    )}
    {name === 'travel' && (
      <>
        <path d="M6 27 42 11 29 42l-5-12-12-5 27-11" />
        <path d="m24 30 18-19M9 36h9M5 41h15" />
      </>
    )}
    {name === 'fashion' && (
      <>
        <path d="M17 10c0 4 3 6 7 6s7-2 7-6l8 5-5 9-4-2v18H18V22l-4 2-5-9 8-5Z" />
        <path d="M20 10h8M18 31h12" />
      </>
    )}
    {name === 'luxury' && (
      <>
        <path d="m24 6 15 14-15 22L9 20 24 6Z" />
        <path d="M9 20h30M16 12l8 8 8-8M16 20l8 22 8-22" />
      </>
    )}
    {name === 'lobby' && (
      <>
        <path d="M8 40V12h32v28M14 40V18h20v22" />
        <path d="M24 18v22M18 24h2M28 24h2M5 40h38" />
        <path d="M16 12V7h16v5" />
      </>
    )}
  </svg>
</span>

<style>
  .store-floor-icon{display:grid;place-items:center;width:58px;height:58px;border:1px solid rgba(217,182,91,.34);border-radius:50%;background:radial-gradient(circle at 32% 25%,rgba(240,217,152,.12),rgba(130,199,255,.025) 62%);color:var(--gold-soft);box-shadow:0 0 0 6px rgba(217,182,91,.025) inset;transition:color .25s ease,border-color .25s ease,background .25s ease,transform .35s cubic-bezier(.2,.8,.2,1)}
  svg{width:31px;height:31px;stroke:currentColor;stroke-width:1.45;stroke-linecap:round;stroke-linejoin:round}
  :global(.floor:hover) .store-floor-icon,:global(.floor:focus-visible) .store-floor-icon,:global(.floor.is-active) .store-floor-icon{border-color:rgba(240,217,152,.78);background:rgba(217,182,91,.12);color:#fff1c7;transform:rotate(-4deg) scale(1.08)}
  :global(.floor--waiting) .store-floor-icon{color:rgba(240,217,152,.62);border-style:dashed}
  @media(max-width:620px){.store-floor-icon{width:45px;height:45px}.store-floor-icon svg{width:25px;height:25px}}
  @media(prefers-reduced-motion:reduce){.store-floor-icon{transition:none!important;transform:none!important}}
</style>
