---
import todayData from '../data/today-football.json';

type Match = {
  id: string;
  league: string;
  home: string;
  away: string;
  homeBadge?: string;
  awayBadge?: string;
  homeScore?: number | null;
  awayScore?: number | null;
  status?: string;
  progress?: string;
  time: string;
  date: string;
};
type StandingRow = { rank: number; team: string; badge?: string; played: number; goalDifference: number; points: number };
type StandingLeague = { leagueId: string; league: string; season: string; rows: StandingRow[] };
type DataState = 'ok' | 'fallback' | 'empty' | 'unavailable' | 'stale';

const now = new Date();
const kst = new Date(now.toLocaleString('en-US', { timeZone: 'Asia/Seoul' }));
const today = `${kst.getFullYear()}-${String(kst.getMonth() + 1).padStart(2, '0')}-${String(kst.getDate()).padStart(2, '0')}`;
const isCurrent = todayData.date === today;
const matches = (isCurrent ? todayData.matches : []).slice(0, 12) as Match[];
const standings = (isCurrent ? todayData.standings : []).slice(0, 5) as StandingLeague[];
const match = matches[0] ?? null;
const matchState = (isCurrent ? todayData.status?.matches?.state : 'stale') as DataState;
const standingsState = (isCurrent ? todayData.status?.standings?.state : 'stale') as DataState;
const matchCountLabel = matches.length ? `${matches.length} GAMES` : standings.length ? `${standings.length} LEAGUES` : 'TODAY';
const cardTitle = matches.length ? 'EUROPE TONIGHT' : standings.length ? 'EUROPE TABLE' : 'EUROPE TONIGHT';

const FINISHED_STATUSES = new Set(['FT', 'AET', 'PEN', 'FINISHED', 'MATCH FINISHED']);
const LIVE_STATUSES = new Set(['1H', 'HT', '2H', 'ET', 'BT', 'P', 'LIVE', 'IN_PLAY', 'PAUSED']);
const POSTPONED_STATUSES = new Set(['PST', 'POSTPONED', 'CANC', 'CANCELLED', 'ABD', 'ABANDONED']);

function matchView(item: Match) {
  const status = (item.status || '').trim().toUpperCase();
  const hasScore = Number.isInteger(item.homeScore) && Number.isInteger(item.awayScore);
  if (FINISHED_STATUSES.has(status)) return { label: '종료', kind: 'finished', hasScore };
  if (LIVE_STATUSES.has(status)) {
    const progress = (item.progress || '').trim();
    return { label: status === 'HT' ? '하프타임' : (progress || 'LIVE'), kind: 'live', hasScore };
  }
  if (POSTPONED_STATUSES.has(status)) return { label: status.startsWith('CANC') ? '취소' : '연기', kind: 'postponed', hasScore };
  const dayDifference = Math.round((Date.parse(`${item.date}T00:00:00+09:00`) - Date.parse(`${today}T00:00:00+09:00`)) / 86_400_000);
  const dayLabel = dayDifference === 1 ? '내일 ' : dayDifference === -1 ? '어제 ' : dayDifference === 0 ? '' : `${item.date.slice(5)} `;
  return {
    label: `${dayLabel}${item.time || 'TBD'}`,
    kind: 'scheduled',
    hasScore,
  };
}
---

<aside class="today-football" aria-label="오늘의 축구 안내">
  <article class="today-card today-card--tonight">
    <div class="today-card__top">
      <p>{cardTitle}</p>
      <time datetime={match?.date || today}>{matchCountLabel}</time>
    </div>
    {match ? (
      <>
        <div class="match-list" aria-label="오늘 밤 유럽 주요 축구 경기">
          {matches.map((item) => {
            const view = matchView(item);
            const scoreLabel = view.hasScore ? `${item.homeScore} 대 ${item.awayScore}` : '대';
            return (
            <article class:list={['match-row', `match-row--${view.kind}`]} aria-label={`${item.league}, ${item.home} ${scoreLabel} ${item.away}, ${view.label}`}>
              <div class="match-row__meta">
                <time datetime={`${item.date}${item.time ? `T${item.time}:00+09:00` : ''}`}>{view.label}</time>
                <span>{item.league}</span>
              </div>
              <div class="match-row__teams">
                <strong>{item.home}</strong>
                {item.homeBadge ? <img src={item.homeBadge} alt="" loading="lazy" /> : <i aria-hidden="true">⚽</i>}
                <b class="match-score">{view.hasScore ? `${item.homeScore}:${item.awayScore}` : 'VS'}</b>
                {item.awayBadge ? <img src={item.awayBadge} alt="" loading="lazy" /> : <i aria-hidden="true">⚽</i>}
                <strong>{item.away}</strong>
              </div>
            </article>
            );
          })}
        </div>
        <div class="today-card__body tonight-summary">
          <p class="today-card__eyebrow">주요리그 경기 큐레이션</p>
          <p class="today-card__copy">오늘 밤부터 내일 오전까지, 한국 시간으로 모았습니다.</p>
        </div>
        <a class="today-card__cta" href="/highlights/" aria-label="하이라이트 보러가기"><span>보러가기</span><i aria-hidden="true">↗</i></a>
      </>
    ) : standings.length ? (
      <>
        <div class="standings-toolbar">
          <div>
            <strong>유럽 주요리그 현재 순위</strong>
            <span>리그별 상위 5팀 · 옆으로 넘겨보세요</span>
          </div>
          <div class="standings-controls" aria-label="리그 순위 이동">
            <button type="button" class="standings-prev" aria-label="이전 리그">‹</button>
            <button type="button" class="standings-next" aria-label="다음 리그">›</button>
          </div>
        </div>
        <div class="standings-carousel" tabindex="0" aria-label="유럽 주요리그 순위표">
          {standings.map((table) => (
            <section class="standings-slide" aria-label={`${table.league} 상위 5팀`}>
              <div class="standings-slide__title">
                <strong>{table.league}</strong>
                <span>{table.season.replace('-', '/')}</span>
              </div>
              <div class="standings-columns" aria-hidden="true"><span>순위 · 팀</span><span>경기</span><span>득실</span><span>승점</span></div>
              <ol>
                {table.rows.map((row) => (
                  <li>
                    <b>{row.rank}</b>
                    {row.badge ? <img src={row.badge} alt="" loading="lazy" /> : <i aria-hidden="true">⚽</i>}
                    <strong>{row.team}</strong>
                    <span>{row.played}</span>
                    <span>{row.goalDifference > 0 ? `+${row.goalDifference}` : row.goalDifference}</span>
                    <em>{row.points}</em>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
        <p class="standings-note">오늘 예정 경기가 없어 순위표를 보여드립니다.{standingsState === 'fallback' ? ' · 직전 갱신값' : ''}</p>
      </>
    ) : matchState === 'unavailable' || matchState === 'stale' || standingsState === 'unavailable' || standingsState === 'stale' ? (
      <>
        <div class="today-card__body">
          <p class="today-card__eyebrow">일정 연결 지연</p>
          <h2>오늘 경기를 확인하고 있습니다</h2>
          <p class="today-card__copy">일정 제공처 응답이 늦어지고 있어요.<br />경기가 없다고 단정하지 않고 다시 확인합니다.</p>
        </div>
        <a class="today-card__cta" href="/highlights/" aria-label="명경기 하이라이트 보러가기"><span>보러가기</span><i aria-hidden="true">↗</i></a>
      </>
    ) : (
      <>
        <div class="today-card__body">
          <p class="today-card__eyebrow">오늘 밤 어디 볼까?</p>
          <h2>오늘 밤은 잠시 조용합니다</h2>
          <p class="today-card__copy">실시간 일정이 쉬어가는 동안<br />옛 결승전 한 편은 어떨까요? 📼</p>
        </div>
        <a class="today-card__cta" href="/highlights/" aria-label="명경기 하이라이트 보러가기"><span>보러가기</span><i aria-hidden="true">↗</i></a>
      </>
    )}
  </article>
</aside>

<script>
  document.querySelectorAll<HTMLElement>('.today-card--tonight').forEach((card) => {
    const carousel = card.querySelector<HTMLElement>('.standings-carousel');
    const previous = card.querySelector<HTMLButtonElement>('.standings-prev');
    const next = card.querySelector<HTMLButtonElement>('.standings-next');
    if (!carousel || !previous || !next) return;
    const move = (direction: number) => carousel.scrollBy({ left: direction * carousel.clientWidth, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
  });
</script>

<style>
  .today-football { display:flex; justify-content:flex-end; align-items:start; margin:0 0 38px; }
  .today-card { position:relative; width:calc(50% - .5px); min-width:0; min-height:224px; overflow:hidden; padding:22px 24px 20px; border:1px solid var(--bbfc-border); background:#fff; isolation:isolate; }
  .today-card--tonight { background:linear-gradient(145deg,#10192b 0%,#182b50 62%,#2468dc 145%); color:#fff; }
  .today-card__top { position:relative; z-index:3; display:flex; justify-content:space-between; gap:16px; padding-bottom:13px; border-bottom:1px solid var(--bbfc-border); color:var(--bbfc-gray-2); font-size:10px; font-weight:800; letter-spacing:.15em; }
  .today-card--tonight .today-card__top { border-color:rgba(255,255,255,.18); color:rgba(255,255,255,.56); }
  .today-card__body { position:absolute; z-index:3; left:24px; right:116px; bottom:20px; }
  .today-card__eyebrow { color:var(--bbfc-blue); font-size:10px; font-weight:800; letter-spacing:.07em; }
  .today-card--tonight .today-card__eyebrow { color:#79aefc; }
  .today-card h2 { margin-top:6px; font-size:26px; line-height:1.18; font-weight:760; letter-spacing:-.05em; text-wrap:balance; }
  .today-card h2 span { color:var(--bbfc-gray-3); font-family:Georgia,serif; font-size:.72em; font-weight:400; font-style:italic; }
  .today-card__copy { margin-top:9px; color:var(--bbfc-gray-1); font-size:12px; line-height:1.6; }
  .today-card--tonight .today-card__copy { color:rgba(255,255,255,.66); }
  .today-card__cta { position:absolute; z-index:4; right:18px; bottom:18px; height:38px; display:flex; align-items:center; justify-content:center; gap:7px; padding:0 13px 0 15px; border:1px solid rgba(255,255,255,.28); border-radius:999px; background:rgba(49,130,246,.68); box-shadow:0 8px 24px rgba(6,34,78,.2); color:#fff; font-size:10px; line-height:1; font-weight:800; letter-spacing:-.01em; white-space:nowrap; backdrop-filter:blur(9px); transition:transform .2s ease,background .2s ease,border-color .2s ease; }
  .today-card__cta i { width:18px; height:18px; display:grid; place-items:center; border-radius:50%; background:rgba(255,255,255,.18); font-family:Arial,sans-serif; font-size:11px; font-style:normal; }
  .today-card__cta:hover { transform:translateY(-2px); border-color:rgba(255,255,255,.5); background:rgba(49,130,246,.88); }
  .match-list { position:relative; z-index:3; max-height:292px; margin:14px -8px 74px 0; padding-right:6px; overflow-y:auto; scrollbar-width:thin; scrollbar-color:rgba(255,255,255,.26) transparent; }
  .match-row { padding:10px 8px 11px 0; border-bottom:1px solid rgba(255,255,255,.12); }
  .match-row:first-child { padding-top:2px; }
  .match-row__meta { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:7px; color:rgba(255,255,255,.5); font-size:8px; font-weight:750; letter-spacing:.06em; }
  .match-row__meta time { color:#86b7ff; font-size:10px; }
  .match-row__meta span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .match-row__teams { display:grid; grid-template-columns:minmax(0,1fr) 24px 30px 24px minmax(0,1fr); align-items:center; gap:5px; }
  .match-row__teams strong { min-width:0; overflow:hidden; color:#fff; font-size:10.5px; line-height:1.2; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }
  .match-row__teams strong:first-child { text-align:right; }
  .match-row__teams img,.match-row__teams i { display:grid; place-items:center; width:24px; height:24px; object-fit:contain; font-size:14px; font-style:normal; filter:drop-shadow(0 4px 7px rgba(0,0,0,.28)); }
  .match-row__teams b { color:rgba(255,255,255,.38); font-family:Georgia,serif; font-size:8px; font-style:italic; text-align:center; }
  .match-row__teams .match-score { color:#fff; font-family:Arial,sans-serif; font-size:11px; font-style:normal; font-variant-numeric:tabular-nums; letter-spacing:-.03em; }
  .match-row--scheduled .match-score { color:rgba(255,255,255,.38); font-family:Georgia,serif; font-size:8px; font-style:italic; }
  .match-row--live .match-score { color:#ffe36e; }
  .match-row--live .match-row__meta time { display:flex; align-items:center; gap:5px; color:#ffe36e; }
  .match-row--live .match-row__meta time::before { content:""; width:5px; height:5px; border-radius:50%; background:#ff4d5e; box-shadow:0 0 0 4px rgba(255,77,94,.14); animation:score-live 1.5s ease-in-out infinite; }
  .match-row--finished .match-row__meta time { color:rgba(255,255,255,.7); }
  .match-row--postponed { opacity:.58; }
  @keyframes score-live { 50% { opacity:.42; transform:scale(.76); } }
  .standings-toolbar { position:relative; z-index:3; display:flex; align-items:flex-end; justify-content:space-between; gap:10px; margin-top:13px; }
  .standings-toolbar strong { display:block; color:#fff; font-size:12px; line-height:1.2; }
  .standings-toolbar span { display:block; margin-top:4px; color:rgba(255,255,255,.5); font-size:8.5px; }
  .standings-controls { display:flex; gap:5px; }
  .standings-controls button { width:25px; height:25px; border:1px solid rgba(255,255,255,.22); border-radius:50%; color:#fff; font-family:Arial,sans-serif; font-size:18px; line-height:1; transition:background .2s ease,border-color .2s ease; }
  .standings-controls button:hover { border-color:rgba(255,255,255,.5); background:rgba(255,255,255,.1); }
  .standings-carousel { position:relative; z-index:3; display:flex; margin:11px -6px 0; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; }
  .standings-carousel::-webkit-scrollbar { display:none; }
  .standings-slide { flex:0 0 100%; min-width:0; padding:0 6px; scroll-snap-align:start; }
  .standings-slide__title { display:flex; align-items:baseline; justify-content:space-between; gap:10px; padding:7px 0 8px; border-top:1px solid rgba(255,255,255,.16); }
  .standings-slide__title strong { overflow:hidden; color:#fff; font-size:13px; text-overflow:ellipsis; white-space:nowrap; }
  .standings-slide__title span { color:#86b7ff; font-size:8px; font-weight:750; letter-spacing:.05em; }
  .standings-columns,.standings-slide li { display:grid; grid-template-columns:minmax(0,1fr) 28px 28px 28px; align-items:center; gap:3px; }
  .standings-columns { padding:0 4px 5px; color:rgba(255,255,255,.38); font-size:7.5px; text-align:center; }
  .standings-columns span:first-child { text-align:left; }
  .standings-slide ol { margin:0; padding:0; list-style:none; }
  .standings-slide li { min-height:34px; padding:4px; border-top:1px solid rgba(255,255,255,.1); color:rgba(255,255,255,.72); font-size:9px; text-align:center; font-variant-numeric:tabular-nums; }
  .standings-slide li b { grid-column:1; grid-row:1; width:14px; color:#86b7ff; font-size:9px; text-align:left; }
  .standings-slide li img,.standings-slide li i { grid-column:1; grid-row:1; width:20px; height:20px; margin-left:18px; object-fit:contain; font-size:12px; font-style:normal; }
  .standings-slide li strong { grid-column:1; grid-row:1; min-width:0; margin-left:43px; overflow:hidden; color:#fff; font-size:9.5px; text-align:left; text-overflow:ellipsis; white-space:nowrap; }
  .standings-slide li span:nth-of-type(1) { grid-column:2; }
  .standings-slide li span:nth-of-type(2) { grid-column:3; }
  .standings-slide li em { grid-column:4; color:#fff; font-size:10px; font-style:normal; font-weight:800; }
  .standings-note { position:relative; z-index:3; margin-top:9px; color:rgba(255,255,255,.45); font-size:8px; line-height:1.4; }
  .today-card--tonight .tonight-summary { right:112px; }
  .today-card--tonight::after { content:""; position:absolute; z-index:2; inset:auto 0 0; height:58%; background:linear-gradient(0deg,rgba(4,12,27,.74),rgba(4,12,27,0)); pointer-events:none; }

  @media (min-width: 1600px) {
    .today-football { position:absolute; inset:192px auto auto 50%; width:1px; margin:0; border:0; background:transparent; pointer-events:none; }
    .today-card { position:fixed; top:190px; width:clamp(170px,calc((100vw - 1230px) / 2),300px); min-height:310px; padding:20px 17px; border-top:2px solid var(--bbfc-ink); pointer-events:auto; }
    .today-card--tonight { top:190px; left:calc(50% + 600px); min-height:min(460px,calc(100vh - 220px)); max-height:calc(100vh - 210px); }
    .today-card h2 { font-size:clamp(21px,1.45vw,27px); }
    .today-card__copy { font-size:11.5px; }
    .today-card__body { left:17px; right:110px; bottom:18px; }
    .today-card__cta { right:14px; bottom:14px; height:36px; padding-inline:12px; }
    .match-list { max-height:calc(100vh - 350px); }
    .standings-toolbar span { display:none; }
    .standings-slide li { min-height:32px; }
    .today-card__copy br { display:none; }
  }
  @media (max-width: 700px) {
    .today-football { display:block; margin-bottom:28px; }
    .today-card { width:100%; min-height:224px; padding:18px 19px 17px; border:1px solid var(--bbfc-border); }
    .today-card--tonight { min-height:390px; }
    .today-card h2 { font-size:24px; }
    .today-card__body { left:19px; right:108px; bottom:18px; }
    .today-card__cta { right:15px; bottom:15px; height:36px; padding-inline:12px; }
    .today-card__copy br { display:none; }
    .match-list { max-height:230px; margin-bottom:72px; }
    .standings-slide li { min-height:36px; }
  }
  @media (prefers-reduced-motion: reduce) { .standings-carousel { scroll-behavior:auto; } }
</style>
