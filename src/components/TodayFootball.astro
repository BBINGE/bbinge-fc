---
import todayData from '../data/today-football.json';

type Match = {
  id: string;
  league: string;
  home: string;
  away: string;
  homeBadge?: string;
  awayBadge?: string;
  homeScore?: number | null;
  awayScore?: number | null;
  status?: string;
  progress?: string;
  time: string;
  date: string;
};
type StandingRow = { rank: number; team: string; badge?: string; played: number; goalDifference: number; points: number };
type StandingLeague = { leagueId: string; league: string; season: string; rows: StandingRow[] };
type DataState = 'ok' | 'fallback' | 'empty' | 'unavailable' | 'stale';

const now = new Date();
const kst = new Date(now.toLocaleString('en-US', { timeZone: 'Asia/Seoul' }));
const today = `${kst.getFullYear()}-${String(kst.getMonth() + 1).padStart(2, '0')}-${String(kst.getDate()).padStart(2, '0')}`;
const isCurrent = todayData.date === today;
const matches = (isCurrent ? todayData.matches : []).slice(0, 12) as Match[];
const standings = (isCurrent ? todayData.standings : []).slice(0, 5) as StandingLeague[];
const match = matches[0] ?? null;
const matchState = (isCurrent ? todayData.status?.matches?.state : 'stale') as DataState;
const standingsState = (isCurrent ? todayData.status?.standings?.state : 'stale') as DataState;
const matchCountLabel = matches.length ? `${matches.length} GAMES` : 'TODAY';

const FINISHED_STATUSES = new Set(['FT', 'AET', 'PEN', 'FINISHED', 'MATCH FINISHED']);
const LIVE_STATUSES = new Set(['1H', 'HT', '2H', 'ET', 'BT', 'P', 'LIVE', 'IN_PLAY', 'PAUSED']);
const POSTPONED_STATUSES = new Set(['PST', 'POSTPONED', 'CANC', 'CANCELLED', 'ABD', 'ABANDONED']);
const LIVE_STATUS_MAX_AGE = 4 * 60 * 60 * 1000;

function matchView(item: Match) {
  const status = (item.status || '').trim().toUpperCase();
  const hasScore = Number.isInteger(item.homeScore) && Number.isInteger(item.awayScore);
  const kickoff = Date.parse(`${item.date}T${item.time || '00:00'}:00+09:00`);
  const expiredLiveStatus = LIVE_STATUSES.has(status) && Number.isFinite(kickoff) && now.valueOf() - kickoff >= LIVE_STATUS_MAX_AGE;
  if (FINISHED_STATUSES.has(status)) return { label: '종료', kind: 'finished', hasScore };
  if (expiredLiveStatus) return { label: '종료', kind: 'finished', hasScore };
  if (LIVE_STATUSES.has(status)) {
    const progress = (item.progress || '').trim();
    return { label: status === 'HT' ? '하프타임' : (progress || 'LIVE'), kind: 'live', hasScore };
  }
  if (POSTPONED_STATUSES.has(status)) return { label: status.startsWith('CANC') ? '취소' : '연기', kind: 'postponed', hasScore };
  const dayDifference = Math.round((Date.parse(`${item.date}T00:00:00+09:00`) - Date.parse(`${today}T00:00:00+09:00`)) / 86_400_000);
  const dayLabel = dayDifference === 1 ? '내일 ' : dayDifference === -1 ? '어제 ' : dayDifference === 0 ? '' : `${item.date.slice(5)} `;
  return {
    label: `${dayLabel}${item.time || 'TBD'}`,
    kind: 'scheduled',
    hasScore,
  };
}
---

<aside class="today-football" aria-label="오늘의 축구 안내">
  <article class:list={['today-card', 'today-card--tonight', match && standings.length && 'today-card--combined']}>
    <div class="today-card__top">
      <p>EUROPE TODAY</p>
      <time datetime={match?.date || today}>{matchCountLabel}</time>
    </div>
    {match ? (
      <section class="fixtures-section" aria-label="최근 경기 결과와 예정 경기">
        <div class="fixtures-heading"><strong>경기 결과·일정</strong><span>한국시간</span></div>
        <div class="match-list" aria-label="오늘 밤 유럽 주요 축구 경기">
          {matches.map((item) => {
            const view = matchView(item);
            const scoreLabel = view.hasScore ? `${item.homeScore} 대 ${item.awayScore}` : '대';
            return (
            <article class:list={['match-row', `match-row--${view.kind}`]} aria-label={`${item.league}, ${item.home} ${scoreLabel} ${item.away}, ${view.label}`}>
              <div class="match-row__meta">
                <time datetime={`${item.date}${item.time ? `T${item.time}:00+09:00` : ''}`}>{view.label}</time>
                <span>{item.league}</span>
              </div>
              <div class="match-row__teams">
                <strong>{item.home}</strong>
                {item.homeBadge ? <img src={item.homeBadge} alt="" loading="lazy" /> : <i aria-hidden="true">⚽</i>}
                <b class="match-score">{view.hasScore ? `${item.homeScore}:${item.awayScore}` : 'VS'}</b>
                {item.awayBadge ? <img src={item.awayBadge} alt="" loading="lazy" /> : <i aria-hidden="true">⚽</i>}
                <strong>{item.away}</strong>
              </div>
            </article>
            );
          })}
        </div>
      </section>
    ) : (
      <div class:list={['fixtures-empty', (matchState === 'unavailable' || matchState === 'stale') && 'fixtures-empty--delayed']}>
        <strong>{matchState === 'unavailable' || matchState === 'stale' ? '경기 일정을 확인하고 있습니다' : '오늘 예정된 주요 경기가 없습니다'}</strong>
        <span>{matchState === 'unavailable' || matchState === 'stale' ? '제공처 응답이 늦어져 순위표를 먼저 보여드립니다.' : '아래에서 유럽 주요리그 순위를 확인해보세요.'}</span>
      </div>
    )}
    {standings.length ? (
      <section class="standings-section" aria-label="유럽 주요리그 순위">
        <div class="standings-toolbar">
          <div>
            <strong>유럽 주요리그 현재 순위</strong>
            <span>10위까지 확인하고 · 옆으로 넘겨보세요</span>
          </div>
          <div class="standings-controls" aria-label="리그 순위 이동">
            <button type="button" class="standings-prev" aria-label="이전 리그">‹</button>
            <button type="button" class="standings-next" aria-label="다음 리그">›</button>
          </div>
        </div>
        <div class="standings-carousel" tabindex="0" aria-label="유럽 주요리그 순위표">
          {standings.map((table, tableIndex) => (
            <section class:list={['standings-slide', tableIndex === 0 && 'is-active']} aria-label={`${table.league} 순위표`}>
              <div class="standings-slide__title">
                <strong>{table.league}</strong>
                <span>{table.season.replace('-', '/')}</span>
              </div>
              <div class="standings-columns" aria-hidden="true"><span>순위 · 팀</span><span>경기</span><span>득실</span><span>승점</span></div>
              <ol class="standings-list" id={`standings-${table.leagueId}`}>
                {table.rows.map((row, rowIndex) => (
                  <li class:list={['standings-row', rowIndex >= 10 && 'standings-row--extra']}>
                    <b>{row.rank}</b>
                    {row.badge ? <img src={row.badge} alt="" loading="lazy" /> : <i aria-hidden="true">⚽</i>}
                    <strong>{row.team}</strong>
                    <span>{row.played}</span>
                    <span>{row.goalDifference > 0 ? `+${row.goalDifference}` : row.goalDifference}</span>
                    <em>{row.points}</em>
                  </li>
                ))}
              </ol>
              {table.rows.length > 10 && (
                <button class="standings-more" type="button" aria-expanded="false" aria-controls={`standings-${table.leagueId}`}>
                  11위부터 더보기 <span aria-hidden="true">⌄</span>
                </button>
              )}
            </section>
          ))}
        </div>
        <p class="standings-note">공개 순위 데이터 기준 · 리그별 전체 순위{standingsState === 'fallback' ? ' · 직전 갱신값' : ''}</p>
      </section>
    ) : (
      <div class="standings-empty">
        <strong>{standingsState === 'unavailable' || standingsState === 'stale' ? '순위표를 갱신하고 있습니다' : '현재 순위 정보가 없습니다'}</strong>
      </div>
    )}
  </article>
</aside>

<script>
  document.querySelectorAll<HTMLElement>('.today-card--tonight').forEach((card) => {
    const carousel = card.querySelector<HTMLElement>('.standings-carousel');
    const previous = card.querySelector<HTMLButtonElement>('.standings-prev');
    const next = card.querySelector<HTMLButtonElement>('.standings-next');
    if (!carousel || !previous || !next) return;
    const slides = [...carousel.querySelectorAll<HTMLElement>('.standings-slide')];
    let activeIndex = 0;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const setExpanded = (slide: HTMLElement, expanded: boolean) => {
      const button = slide.querySelector<HTMLButtonElement>('.standings-more');
      slide.classList.toggle('is-expanded', expanded);
      if (!button) return;
      button.setAttribute('aria-expanded', String(expanded));
      button.innerHTML = expanded ? '10위까지만 보기 <span aria-hidden="true">⌃</span>' : '11위부터 더보기 <span aria-hidden="true">⌄</span>';
    };
    const activate = (index: number) => {
      activeIndex = index;
      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeIndex;
        slide.classList.toggle('is-active', isActive);
        if (!isActive && slide.classList.contains('is-expanded')) setExpanded(slide, false);
      });
    };
    const pulse = (button: HTMLButtonElement) => {
      button.classList.remove('is-clicked');
      requestAnimationFrame(() => button.classList.add('is-clicked'));
      window.setTimeout(() => button.classList.remove('is-clicked'), 360);
    };
    const move = (direction: number, button: HTMLButtonElement) => {
      if (!slides.length) return;
      const destination = (activeIndex + direction + slides.length) % slides.length;
      activate(destination);
      carousel.scrollTo({ left: destination * carousel.clientWidth, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
      pulse(button);
    };
    previous.addEventListener('click', () => move(-1, previous));
    next.addEventListener('click', () => move(1, next));
    let scrollFrame = 0;
    carousel.addEventListener('scroll', () => {
      cancelAnimationFrame(scrollFrame);
      scrollFrame = requestAnimationFrame(() => activate(Math.round(carousel.scrollLeft / Math.max(carousel.clientWidth, 1))));
    }, { passive: true });
    card.querySelectorAll<HTMLButtonElement>('.standings-more').forEach((button) => {
      button.addEventListener('click', () => {
        const slide = button.closest<HTMLElement>('.standings-slide');
        if (!slide) return;
        const expanded = !slide.classList.contains('is-expanded');
        setExpanded(slide, expanded);
        pulse(button);
      });
    });
  });
</script>

<style>
  .today-football { display:flex; justify-content:flex-end; align-items:start; margin:0 0 38px; }
  .today-card { position:relative; width:calc(50% - .5px); min-width:0; min-height:224px; overflow:hidden; padding:22px 24px 20px; border:1px solid var(--bbfc-border); background:#fff; isolation:isolate; }
  .today-card--tonight { background:linear-gradient(145deg,#10192b 0%,#182b50 62%,#2468dc 145%); color:#fff; }
  .today-card--combined { min-height:560px; }
  .today-card__top { position:relative; z-index:3; display:flex; justify-content:space-between; gap:16px; padding-bottom:13px; border-bottom:1px solid var(--bbfc-border); color:var(--bbfc-gray-2); font-size:12px; font-weight:800; letter-spacing:.15em; }
  .today-card--tonight .today-card__top { border-color:rgba(255,255,255,.18); color:rgba(255,255,255,.56); }
  .fixtures-section { position:relative; z-index:3; }
  .fixtures-heading { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:13px; color:rgba(255,255,255,.58); font-size:11px; letter-spacing:.05em; }
  .fixtures-heading strong { color:#fff; font-size:12px; letter-spacing:0; }
  .fixtures-empty,.standings-empty { position:relative; z-index:3; display:flex; flex-direction:column; gap:5px; margin-top:13px; padding:14px 0; border-bottom:1px solid rgba(255,255,255,.14); }
  .fixtures-empty strong,.standings-empty strong { color:#fff; font-size:12px; }
  .fixtures-empty span { color:rgba(255,255,255,.58); font-size:11px; line-height:1.45; }
  .fixtures-empty--delayed strong { color:#86b7ff; }
  .standings-empty { border-bottom:0; }
  .match-list { position:relative; z-index:3; margin:8px 0 0; overflow:visible; }
  .match-row { padding:10px 8px 11px 0; border-bottom:1px solid rgba(255,255,255,.12); }
  .match-row:first-child { padding-top:2px; }
  .match-row__meta { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:7px; color:rgba(255,255,255,.58); font-size:11px; font-weight:750; letter-spacing:.05em; }
  .match-row__meta time { color:#86b7ff; font-size:12px; }
  .match-row__meta span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .match-row__teams { display:grid; grid-template-columns:minmax(0,1fr) 24px 30px 24px minmax(0,1fr); align-items:center; gap:5px; }
  .match-row__teams strong { min-width:0; overflow:hidden; color:#fff; font-size:12px; line-height:1.2; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }
  .match-row__teams strong:first-child { text-align:right; }
  .match-row__teams img,.match-row__teams i { display:grid; place-items:center; width:24px; height:24px; object-fit:contain; font-size:14px; font-style:normal; filter:drop-shadow(0 4px 7px rgba(0,0,0,.28)); }
  .match-row__teams b { color:rgba(255,255,255,.48); font-family:Georgia,serif; font-size:11px; font-style:italic; text-align:center; }
  .match-row__teams .match-score { color:#fff; font-family:Arial,sans-serif; font-size:13px; font-style:normal; font-variant-numeric:tabular-nums; letter-spacing:-.03em; }
  .match-row--scheduled .match-score { color:rgba(255,255,255,.48); font-family:Georgia,serif; font-size:11px; font-style:italic; }
  .match-row--live .match-score { color:#ffe36e; }
  .match-row--live .match-row__meta time { display:flex; align-items:center; gap:5px; color:#ffe36e; }
  .match-row--live .match-row__meta time::before { content:""; width:5px; height:5px; border-radius:50%; background:#ff4d5e; box-shadow:0 0 0 4px rgba(255,77,94,.14); animation:score-live 1.5s ease-in-out infinite; }
  .match-row--finished .match-row__meta time { color:rgba(255,255,255,.7); }
  .match-row--postponed { opacity:.58; }
  @keyframes score-live { 50% { opacity:.42; transform:scale(.76); } }
  .standings-section { position:relative; z-index:3; margin-top:14px; padding-top:12px; border-top:1px solid rgba(255,255,255,.18); }
  .standings-toolbar { display:flex; align-items:flex-end; justify-content:space-between; gap:10px; }
  .standings-toolbar strong { display:block; color:#fff; font-size:12px; line-height:1.2; }
  .standings-toolbar span { display:block; margin-top:4px; color:rgba(255,255,255,.58); font-size:11px; }
  .standings-controls { display:flex; gap:5px; }
  .standings-controls button { position:relative; width:30px; height:30px; display:grid; place-items:center; border:1px solid rgba(255,255,255,.3); border-radius:50%; background:rgba(255,255,255,.04); color:#fff; cursor:pointer; font-family:Arial,sans-serif; font-size:21px; line-height:1; box-shadow:0 5px 15px rgba(1,7,19,.18); transition:transform .2s ease,background .2s ease,border-color .2s ease,box-shadow .2s ease; }
  .standings-controls button:hover { transform:translateY(-2px) scale(1.08); border-color:#86b7ff; background:rgba(134,183,255,.16); box-shadow:0 8px 20px rgba(1,7,19,.28); }
  .standings-controls button:active { transform:scale(.9); }
  .standings-controls button:focus-visible,.standings-more:focus-visible { outline:2px solid #86b7ff; outline-offset:3px; }
  .standings-controls button.is-clicked { animation:standings-control-pop .34s ease; }
  @keyframes standings-control-pop { 50% { border-color:#fff; background:rgba(134,183,255,.28); box-shadow:0 0 0 6px rgba(134,183,255,.1); } }
  .standings-carousel { position:relative; z-index:3; display:flex; margin:11px -6px 0; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; }
  .standings-carousel::-webkit-scrollbar { display:none; }
  .standings-slide { flex:0 0 100%; min-width:0; padding:0 6px; opacity:.62; transform:translateX(7px); scroll-snap-align:start; transition:opacity .36s ease,transform .36s ease; }
  .standings-slide.is-active { opacity:1; transform:translateX(0); }
  .standings-slide__title { display:flex; align-items:baseline; justify-content:space-between; gap:10px; padding:7px 0 8px; border-top:1px solid rgba(255,255,255,.16); }
  .standings-slide__title strong { overflow:hidden; color:#fff; font-size:13px; text-overflow:ellipsis; white-space:nowrap; }
  .standings-slide__title span { color:#86b7ff; font-size:11px; font-weight:750; letter-spacing:.05em; }
  .standings-columns,.standings-slide li { display:grid; grid-template-columns:minmax(0,1fr) 28px 28px 28px; align-items:center; gap:3px; }
  .standings-columns { padding:0 4px 5px; color:rgba(255,255,255,.52); font-size:11px; text-align:center; }
  .standings-columns span:first-child { text-align:left; }
  .standings-list { margin:0; padding:0; overflow:visible; list-style:none; }
  .standings-slide li { min-height:30px; padding:4px; border-top:1px solid rgba(255,255,255,.1); color:rgba(255,255,255,.72); font-size:12px; text-align:center; font-variant-numeric:tabular-nums; }
  .standings-row--extra { display:none !important; }
  .standings-slide.is-expanded .standings-row--extra { display:grid !important; animation:standings-row-reveal .24s ease both; }
  @keyframes standings-row-reveal { from { opacity:0; transform:translateY(-5px); } to { opacity:1; transform:translateY(0); } }
  .standings-slide li b { grid-column:1; grid-row:1; width:14px; color:#86b7ff; font-size:12px; text-align:left; }
  .standings-slide li img,.standings-slide li i { grid-column:1; grid-row:1; width:20px; height:20px; margin-left:18px; object-fit:contain; font-size:12px; font-style:normal; }
  .standings-slide li strong { grid-column:1; grid-row:1; min-width:0; margin-left:43px; overflow:hidden; color:#fff; font-size:12px; text-align:left; text-overflow:ellipsis; white-space:nowrap; }
  .standings-slide li span:nth-of-type(1) { grid-column:2; }
  .standings-slide li span:nth-of-type(2) { grid-column:3; }
  .standings-slide li em { grid-column:4; color:#fff; font-size:12px; font-style:normal; font-weight:800; }
  .standings-more { width:100%; min-height:33px; display:flex; align-items:center; justify-content:center; gap:6px; margin-top:7px; border:1px solid rgba(134,183,255,.28); border-radius:6px; background:rgba(134,183,255,.08); color:#b9d5ff; cursor:pointer; font-size:12px; font-weight:800; transition:transform .2s ease,background .2s ease,border-color .2s ease,color .2s ease; }
  .standings-more span { font-size:13px; transition:transform .2s ease; }
  .standings-more:hover { transform:translateY(-1px); border-color:rgba(134,183,255,.66); background:rgba(134,183,255,.16); color:#fff; }
  .standings-more.is-clicked span { transform:scale(1.3); }
  .standings-note { margin-top:8px; color:rgba(255,255,255,.56); font-size:11px; line-height:1.4; }
  .today-card--tonight::after { content:""; position:absolute; z-index:2; inset:auto 0 0; height:58%; background:linear-gradient(0deg,rgba(4,12,27,.74),rgba(4,12,27,0)); pointer-events:none; }

  @media (min-width: 1600px) {
    .today-football { position:absolute; inset:192px auto auto 50%; width:1px; margin:0; border:0; background:transparent; pointer-events:none; }
    .today-card { position:absolute; top:0; width:clamp(170px,calc((100vw - 1230px) / 2),300px); min-height:310px; padding:20px 17px; border-top:2px solid var(--bbfc-ink); pointer-events:auto; }
    .today-card--tonight { top:0; left:600px; min-height:0; max-height:none; }
    .today-card--tonight.today-card--combined { height:auto; min-height:0; }
    .standings-toolbar span { display:none; }
    .standings-slide li { min-height:28px; }
  }
  @media (max-width: 700px) {
    .today-football { display:block; margin-bottom:28px; }
    .today-card { width:100%; min-height:224px; padding:18px 19px 17px; border:1px solid var(--bbfc-border); }
    .today-card--tonight { min-height:390px; }
    .today-card--combined { min-height:560px; }
    .standings-slide li { min-height:36px; }
  }
  @media (prefers-reduced-motion: reduce) { .standings-carousel { scroll-behavior:auto; } .standings-slide,.standings-row--extra,.standings-controls button,.standings-more { animation:none; transition:none; } }
</style>
