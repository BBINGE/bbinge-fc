---
import { getReadingRoute } from '../data/reading-routes';

interface Props {
  currentId: string;
}

const route = getReadingRoute(Astro.props.currentId);
---

{route && (
  <aside class:list={['season-route', `season-route--${route.theme}`]} aria-labelledby="season-route-title">
    <header>
      <div><span>{route.kicker}</span><h2 id="season-route-title" set:html={route.title} /></div>
      <p>{route.lead}</p>
    </header>
    <div class:list={['season-route__grid', { 'is-pair': route.stories.length === 2 }]}>
      {route.stories.map((story) => (
        <a href={story.href} class:list={['season-route__card', `is-${story.theme}`]}>
          <figure><img src={story.image} alt="" width="720" height="720" loading="lazy" decoding="async" /><span>{story.index}</span></figure>
          <div><small>{story.label}</small><strong>{story.title}</strong><p>{story.description}</p><b>이어서 읽기 <i aria-hidden="true">→</i></b></div>
        </a>
      ))}
    </div>
  </aside>
)}

<style>
  .season-route{position:relative;overflow:hidden;margin:64px 0 18px;padding:36px 34px 34px;border:1px solid var(--route-line);background:var(--route-bg);color:#fff;box-shadow:0 28px 70px -52px var(--route-shadow)}
  .season-route--european-cup{--route-line:rgba(80,158,255,.42);--route-accent:#78dcff;--route-shadow:rgba(6,18,73,.95);--route-bg:radial-gradient(circle at 9% 12%,rgba(25,214,255,.26),transparent 34%),radial-gradient(circle at 94% 88%,rgba(218,39,255,.22),transparent 40%),linear-gradient(128deg,#06103f 3%,#102ca2 50%,#39128c 78%,#071340 100%)}
  .season-route--ballon-dor{--route-line:rgba(217,178,95,.4);--route-accent:#e2bd6a;--route-shadow:rgba(20,14,4,.95);--route-bg:radial-gradient(circle at 91% -8%,rgba(226,189,106,.22),transparent 32%),linear-gradient(145deg,#0b0a08,#1d1810 62%,#090807)}
  .season-route--hungary{--route-line:rgba(226,189,106,.36);--route-accent:#e2bd6a;--route-shadow:rgba(4,22,15,.95);--route-bg:radial-gradient(circle at 92% -6%,rgba(226,189,106,.2),transparent 34%),radial-gradient(circle at 6% 104%,rgba(206,41,57,.16),transparent 38%),linear-gradient(140deg,#06140f 0%,#0f2e22 56%,#07130e 100%)}
  .season-route::after{position:absolute;right:-48px;top:16px;width:210px;height:210px;border:1px solid rgba(255,255,255,.1);border-radius:50%;box-shadow:0 0 0 36px rgba(255,255,255,.025);content:'';pointer-events:none}
  .season-route>header{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(240px,.85fr);gap:30px;align-items:end;padding-bottom:27px;border-bottom:1px solid rgba(255,255,255,.18)}
  .season-route>header span{color:var(--route-accent);font-size:12px;font-weight:820;letter-spacing:.15em}
  .season-route h2{margin:12px 0 0;color:#fff;font-size:clamp(28px,4vw,40px);line-height:1.1;font-weight:790;letter-spacing:-.052em;text-wrap:balance}
  .season-route>header p{margin:0;color:rgba(255,255,255,.72);font-size:14px;line-height:1.75;text-wrap:pretty}
  .season-route__grid{position:relative;z-index:1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:19px}
  .season-route__card{display:grid;grid-template-rows:auto 1fr;overflow:hidden;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.06);color:#fff!important;transition:transform .28s ease,border-color .28s ease,background .28s ease}
  .season-route__card figure{position:relative;aspect-ratio:1.6/1;margin:0;overflow:hidden;background:#050817}
  .season-route__card img{width:100%;height:100%;object-fit:cover;object-position:50% 30%;transition:transform .55s cubic-bezier(.22,1,.36,1)}
  .season-route__card figure span{position:absolute;top:12px;left:12px;display:grid;width:34px;height:34px;place-items:center;border:1px solid rgba(255,255,255,.6);border-radius:50%;background:rgba(5,10,40,.72);color:#fff;font-size:12px;font-weight:800}
  .season-route__card>div{display:flex;min-height:206px;flex-direction:column;padding:19px 18px 18px}
  .season-route__card small{color:var(--route-accent);font-size:12px;font-weight:800;letter-spacing:.11em}
  .season-route__card.is-ballon-dor small{color:#e2bd6a}
  .season-route--european-cup .season-route__card.is-ballon-dor{border-color:rgba(226,189,106,.45);background:linear-gradient(150deg,rgba(20,16,8,.72),rgba(46,36,16,.55))}
  .season-route--european-cup .season-route__card.is-ballon-dor figure span{border-color:#e2bd6a;background:rgba(20,15,6,.8);color:#e2bd6a}
  .season-route__card strong{display:block;word-break:keep-all;margin-top:9px;color:#fff;font-size:19px;line-height:1.34;letter-spacing:-.035em;text-wrap:balance}
  .season-route__card p{margin:9px 0 0;color:rgba(255,255,255,.68);font-size:12px;line-height:1.6;text-wrap:pretty}
  .season-route__card b{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:18px;color:#fff;font-size:16px}
  .season-route__card b i{font-size:24px;font-style:normal;animation:season-route-arrow 1.8s ease-in-out infinite}
  .season-route__card:hover{transform:translateY(-4px);border-color:var(--route-accent);background:rgba(255,255,255,.1)}
  .season-route__card.is-ballon-dor:hover{border-color:#e2bd6a}
  .season-route__card:hover img{transform:scale(1.04)}
  .season-route__card:focus-visible{outline:2px solid var(--route-accent);outline-offset:3px}
  @keyframes season-route-arrow{0%,100%{transform:translateX(0)}50%{transform:translateX(5px)}}
  @media(max-width:800px){.season-route{padding:28px 20px 22px}.season-route>header{grid-template-columns:1fr;gap:16px}.season-route__grid{grid-template-columns:1fr}.season-route__card{grid-template-columns:118px minmax(0,1fr);grid-template-rows:1fr}.season-route__card figure{height:100%;aspect-ratio:auto}.season-route__card>div{min-height:176px;padding:17px 16px}.season-route__card strong{font-size:17px}}
  @media(max-width:430px){.season-route{margin-inline:-4px}.season-route__card{grid-template-columns:102px minmax(0,1fr)}.season-route__card p{font-size:12px}}
  @media(prefers-reduced-motion:reduce){.season-route__card,.season-route__card img{transition:none}.season-route__card b i{animation:none}}
</style>
