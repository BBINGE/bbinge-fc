---
import { getStoreLocation } from '../config/store';

interface Props {
  pathname: string;
  breadcrumbHrefs?: string[];
  variant?: 'position' | 'elevator';
}

const { pathname, breadcrumbHrefs = [], variant = 'position' } = Astro.props;
const location = getStoreLocation(pathname, breadcrumbHrefs);
---

{location && variant === 'position' && (
  <nav class="store-position" aria-label="PB 온라인 본점 현재 위치와 층별 안내">
    <div class="store-position__inner">
      <a class="store-position__current" href={location.href} aria-label={`현재 ${location.floor}층 ${location.name}. 해당 관으로 이동`}>
        <span class="store-position__floor"><b>{location.floor}</b><small>F</small></span>
        <span class="store-position__copy"><small>YOU ARE HERE</small><strong>{location.name}</strong></span>
      </a>
      <span class="store-position__line" aria-hidden="true"></span>
      <a class="store-position__map" href="/about/store/">
        <span><small>FLOOR MAP</small><strong>전체 층별 안내 보기</strong></span>
        <i aria-hidden="true">→</i>
      </a>
    </div>
  </nav>
)}

{location && variant === 'elevator' && (
  <aside class="store-elevator" aria-labelledby="store-elevator-title">
    <div class="store-elevator__panel">
      <div class="store-elevator__current">
        <span><b>{location.floor}</b><small>F</small></span>
        <p><small>CURRENT FLOOR</small><strong id="store-elevator-title">{location.name}에서 어디로 갈까요?</strong></p>
      </div>
      <nav class="store-elevator__destinations" aria-label="다른 층과 전체 층별 안내">
        {location.nearby.map((destination) => (
          <a href={destination.href}><span>{destination.floor}F</span><strong>{destination.label}</strong><i aria-hidden="true">↗</i></a>
        ))}
        <a class="store-elevator__map" href="/about/store/"><span>FLOOR MAP</span><strong>전체 층별 안내</strong><i aria-hidden="true">→</i></a>
      </nav>
    </div>
  </aside>
)}

<style>
  .store-position{border-bottom:1px solid var(--bbfc-border);background:linear-gradient(90deg,#111925,#182435 58%,#111925);color:#fff}
  .store-position__inner{display:flex;align-items:center;gap:18px;max-width:1280px;min-height:47px;margin:0 auto;padding:0 20px}
  .store-position__current,.store-position__map{display:flex;align-items:center;color:inherit;text-decoration:none}
  .store-position__current{gap:11px;min-width:0}
  .store-position__floor{display:flex;align-items:flex-start;gap:3px;color:#8fc2ff;line-height:1}
  .store-position__floor b{font-size:18px;font-weight:750;letter-spacing:-.04em}
  .store-position__floor small{margin-top:2px;font-size:8px;font-weight:800;letter-spacing:.08em}
  .store-position__copy{display:flex;align-items:baseline;gap:9px;min-width:0}
  .store-position__copy small,.store-position__map small{color:#8fc2ff;font-size:8px;font-weight:750;letter-spacing:.15em;white-space:nowrap}
  .store-position__copy strong{overflow:hidden;font-size:12px;font-weight:650;text-overflow:ellipsis;white-space:nowrap}
  .store-position__line{height:15px;flex:1;border-bottom:1px solid rgba(143,194,255,.25)}
  .store-position__map{gap:14px;flex:0 0 auto}
  .store-position__map>span{display:flex;align-items:baseline;gap:9px}
  .store-position__map strong{font-size:11px;font-weight:650}
  .store-position__map i{display:grid;place-items:center;width:23px;height:23px;border-radius:50%;background:var(--bbfc-blue);font-size:12px;font-style:normal;transition:transform .18s ease}
  .store-position__current:hover strong,.store-position__current:focus-visible strong,.store-position__map:hover strong,.store-position__map:focus-visible strong{color:#a9d0ff}
  .store-position__map:hover i{transform:translateX(2px)}
  .store-position__current:focus-visible,.store-position__map:focus-visible{border-radius:4px;outline:2px solid #8fc2ff;outline-offset:3px}

  .store-elevator{margin-top:70px;padding:0 20px 72px;background:linear-gradient(180deg,transparent 0,#f4f7fb 35%,#eef3f9 100%)}
  .store-elevator__panel{display:grid;grid-template-columns:minmax(250px,.78fr) minmax(0,1.22fr);gap:34px;max-width:1080px;margin:0 auto;padding:28px;border:1px solid #cdd8e6;border-top:3px solid var(--bbfc-ink);border-radius:0 0 14px 14px;background:#fff;box-shadow:0 20px 48px -38px rgba(15,31,52,.55)}
  .store-elevator__current{display:flex;align-items:center;gap:20px;min-width:0}
  .store-elevator__current>span{display:flex;align-items:flex-start;gap:4px;min-width:76px;color:var(--bbfc-blue);line-height:.8}
  .store-elevator__current b{font-size:43px;font-weight:720;letter-spacing:-.07em}
  .store-elevator__current>span small{margin-top:4px;font-size:10px;font-weight:800}
  .store-elevator__current p{min-width:0}
  .store-elevator__current p small{display:block;color:var(--bbfc-blue);font-size:8px;font-weight:800;letter-spacing:.16em}
  .store-elevator__current p strong{display:block;margin-top:7px;color:var(--bbfc-ink);font-size:18px;line-height:1.4;font-weight:680;letter-spacing:-.03em;word-break:keep-all}
  .store-elevator__destinations{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}
  .store-elevator__destinations a{display:grid;grid-template-columns:1fr auto;grid-template-rows:auto auto;align-items:center;min-width:0;padding:13px 13px 12px;border:1px solid var(--bbfc-border);border-radius:10px;background:#fff;color:var(--bbfc-ink);transition:border-color .18s ease,background .18s ease,transform .18s ease}
  .store-elevator__destinations a:hover{border-color:var(--bbfc-blue);background:var(--bbfc-blue-weak);transform:translateY(-2px)}
  .store-elevator__destinations a:focus-visible{outline:3px solid var(--bbfc-blue);outline-offset:2px}
  .store-elevator__destinations span{grid-column:1;color:var(--bbfc-blue);font-size:8px;font-weight:800;letter-spacing:.12em}
  .store-elevator__destinations strong{grid-column:1;margin-top:5px;overflow:hidden;font-size:12px;font-weight:680;text-overflow:ellipsis;white-space:nowrap}
  .store-elevator__destinations i{grid-column:2;grid-row:1/3;color:var(--bbfc-blue);font-size:14px;font-style:normal}
  .store-elevator__destinations .store-elevator__map{border-color:#1b2a3d;background:#111925;color:#fff}
  .store-elevator__destinations .store-elevator__map:hover{border-color:var(--bbfc-blue);background:#182b45}
  .store-elevator__destinations .store-elevator__map strong{color:#fff}

  @media(max-width:700px){
    .store-position__inner{gap:10px;min-height:44px;padding:0 14px}
    .store-position__current{gap:8px}
    .store-position__floor b{font-size:16px}
    .store-position__copy{display:block}
    .store-position__copy small{display:block;font-size:6.5px}
    .store-position__copy strong{display:block;margin-top:2px;max-width:112px;font-size:10.5px}
    .store-position__line{display:none}
    .store-position__map{justify-content:flex-end;gap:9px;margin-left:auto}
    .store-position__map>span{display:block;text-align:right}
    .store-position__map small{display:block;font-size:6.5px}
    .store-position__map strong{display:block;margin-top:2px;font-size:10px}
    .store-position__map i{width:21px;height:21px;font-size:11px}
    .store-elevator{margin-top:52px;padding:0 14px 54px}
    .store-elevator__panel{grid-template-columns:1fr;gap:20px;padding:22px 16px 17px}
    .store-elevator__current{gap:13px}
    .store-elevator__current>span{min-width:63px}
    .store-elevator__current b{font-size:36px}
    .store-elevator__current p strong{font-size:16px}
    .store-elevator__destinations{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
    .store-elevator__destinations .store-elevator__map{grid-column:1/-1}
  }
  @media(prefers-reduced-motion:reduce){.store-position__map i,.store-elevator__destinations a{transition:none}.store-position__map:hover i,.store-elevator__destinations a:hover{transform:none}}
</style>
