---
import { categories } from '../config/categories';
import type { CollectionEntry } from 'astro:content';

interface Props {
  featured?: CollectionEntry<'articles'>;
  list: CollectionEntry<'articles'>[];
}

const { featured, list } = Astro.props;
---

{featured && (
  <div class="grid grid-cols-1 md:grid-cols-[1.35fr_1fr] gap-5">
    <a href={`/${featured.data.category}/${featured.id}/`} class="block group">
      <div class="aspect-[16/10] bg-[var(--bbfc-fill)] rounded-[var(--bbfc-radius-lg)] overflow-hidden flex items-center justify-center">
        {featured.data.coverImage ? (
          <img
            src={featured.data.coverImage}
            alt=""
            loading="lazy"
            class="w-full h-full object-cover"
          />
        ) : (
          <span class="text-[12px] text-[var(--bbfc-gray-2)]">{categories[featured.data.category].label}</span>
        )}
      </div>
      <p class="text-[11px] text-[var(--bbfc-blue)] mt-3">{categories[featured.data.category].label}</p>
      <h2 class="text-[17px] md:text-[18px] font-medium text-[var(--bbfc-ink)] mt-1 leading-snug">
        {featured.data.title}
      </h2>
      <p class="text-[13px] text-[var(--bbfc-gray-1)] mt-1.5 leading-relaxed line-clamp-2">
        {featured.data.description}
      </p>
      <p class="text-[12px] text-[var(--bbfc-gray-2)] mt-2">
        {featured.data.pubDate.toLocaleDateString('ko-KR')}
      </p>
    </a>

    <ul>
      {list.length === 0 ? (
        <li class="text-[13px] text-[var(--bbfc-gray-1)] py-6 text-center border-t border-[var(--bbfc-line)]">
          곧 새 글이 올라와요.
        </li>
      ) : (
        list.map((entry) => (
          <li class="border-t border-[var(--bbfc-line)] py-3 first:pt-0">
            <a href={`/${entry.data.category}/${entry.id}/`} class="block">
              <p class="text-[11px] text-[var(--bbfc-blue)]">{categories[entry.data.category].label}</p>
              <p class="text-[13.5px] text-[var(--bbfc-ink)] mt-1 leading-snug">{entry.data.title}</p>
            </a>
          </li>
        ))
      )}
    </ul>
  </div>
)}
