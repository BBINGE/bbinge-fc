---
import { getCollection } from 'astro:content';
import { categoryList } from '../config/categories';

const currentPath = Astro.url.pathname;

const publishedArticles = await getCollection('articles', ({ data }) => !data.draft);

const tagsByCategory = Object.fromEntries(
  categoryList.map(({ slug }) => {
    const tags = new Set<string>();
    for (const entry of publishedArticles) {
      if (entry.data.category === slug) {
        entry.data.tags.forEach((tag) => tags.add(tag));
      }
    }
    return [slug, Array.from(tags).slice(0, 6)];
  })
);
---

<ul class="space-y-4">
  {categoryList.map(({ slug, label, color }) => {
    const href = `/${slug}/`;
    const isActive = currentPath.startsWith(href);
    const tags = tagsByCategory[slug];
    return (
      <li>
        <a
          href={href}
          class:list={['block text-[13px] font-medium pl-2', isActive ? 'border-l-2' : 'text-[var(--bbfc-text)]']}
          style={isActive ? `border-color: var(--nav-${color}); color: var(--nav-${color});` : undefined}
        >
          {label}
        </a>
        {tags.length > 0 && (
          <ul class="mt-1.5 space-y-1 pl-3.5">
            {tags.map((tag) => (
              <li class="text-[12px] text-[var(--bbfc-muted)]">{tag}</li>
            ))}
          </ul>
        )}
      </li>
    );
  })}
</ul>
