---
// 홈 히어로 2단: 좌(GOAT 뽑기, 유일한 인터랙티브 진입점) / 우(이번 주 HOT — featured: true 수동 플래그).
// 조회수 자동 순위가 아니라 운영자가 직접 켠 글만 노출한다.
import { categories } from '../config/categories';
import type { CollectionEntry } from 'astro:content';
import { isNewlyPublished } from '../utils/freshness';
import { getArticlePath } from '../config/categories';

interface Props {
  hotArticles: CollectionEntry<'articles'>[];
}

const { hotArticles } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
  <a
    href="/play/"
    class="flex flex-col justify-between gap-4 bg-[var(--bbfc-blue-weak)] rounded-[var(--bbfc-radius-lg)] p-6 min-h-[240px]"
  >
    <div>
      <p class="text-[11px] text-[var(--bbfc-blue)] font-medium">축겜 · 32강</p>
      <h2 class="text-[20px] md:text-[22px] font-medium text-[var(--bbfc-ink)] mt-2 leading-snug">
        당신의 GOAT는 누구인가요?
      </h2>
      <p class="text-[13px] text-[var(--bbfc-gray-1)] mt-2 leading-relaxed">
        역대 최고의 축구선수를 가리는 32강 토너먼트. 카드를 눌러 다음 라운드로 진출시키세요.
      </p>
    </div>
    <span class="self-start bg-[var(--bbfc-blue)] text-white text-[13.5px] font-medium rounded-[var(--bbfc-radius)] px-4 py-2.5">
      시작하기
    </span>
  </a>

  <div class="border border-[var(--bbfc-border)] rounded-[var(--bbfc-radius-lg)] p-5 min-h-[240px] flex flex-col">
    <p class="text-[13px] font-medium text-[var(--bbfc-ink)] mb-1">이번 주 HOT</p>
    {hotArticles.length === 0 ? (
      <p class="flex-1 flex items-center justify-center text-[13px] text-[var(--bbfc-gray-1)] text-center">
        곧 이번 주 HOT 글이 채워져요.
      </p>
    ) : (
      <ul class="flex-1">
        {hotArticles.map((entry) => (
          <li class="border-t border-[var(--bbfc-line)] py-3 first:pt-0 first:border-t-0">
            <a href={getArticlePath(entry.data.category, entry.id)} class="flex gap-3 items-center group">
              <div class="relative w-[56px] h-[56px] shrink-0 rounded-[var(--bbfc-radius)] bg-[var(--bbfc-fill)] overflow-hidden flex items-center justify-center">
                {entry.data.coverImage ? (
                  <img src={entry.data.coverImage} alt="" loading="lazy" class="w-full h-full object-cover" />
                ) : (
                  <span class="text-[9px] text-[var(--bbfc-gray-2)]">사진 없음</span>
                )}
                {isNewlyPublished(entry.data.pubDate) && <span class="new-dot" aria-label="새 글">N</span>}
              </div>
              <div class="min-w-0">
                <p class="text-[11px] text-[var(--bbfc-blue)]">{categories[entry.data.category]?.label}</p>
                <p class="text-[13.5px] text-[var(--bbfc-ink)] mt-0.5 leading-snug line-clamp-2">
                  {entry.data.title}
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</div>

<style>
  .new-dot { position:absolute; top:4px; right:4px; display:grid; place-items:center; width:16px; height:16px; border-radius:50%; background:var(--bbfc-blue); color:#fff; font-size:8px; line-height:1; font-weight:750; }
</style>
