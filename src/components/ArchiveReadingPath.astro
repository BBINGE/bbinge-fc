---
import type { resolveReadingPaths } from '../data/archive-reading-paths';
interface Props { path: ReturnType<typeof resolveReadingPaths>[number]; directory?: boolean }
const {path,directory=false}=Astro.props;
const first=path.stops[0];
const href=(r: typeof first.record)=>`/archive/${r.data.branch}/${r.data.index}/${r.id}/`;
---
<section class="reading-path" id={path.id} data-archive-reveal aria-labelledby={`path-${path.id}`}>
  <div class="reading-path__heading"><p>READING PATH · {path.stops.length}편</p>{!directory&&<a href="/archive/reading-paths/">독서 경로 전체 보기 ↗</a>}</div>
  <div class="reading-path__layout">
    <div class="reading-path__intro"><h2 id={`path-${path.id}`}>{path.title}</h2><p>{path.description}</p><a class="reading-path__cover" href={href(first.record)}><img src={first.record.data.coverImage} alt={first.record.data.coverImageAlt??first.record.data.subject} width="640" height="640" loading="lazy" /><span>첫 기록부터 읽기 →</span></a></div>
    <ol>{path.stops.map((stop,i)=><li><a href={href(stop.record)}><b>{String(i+1).padStart(2,'0')}</b><div><h3>{stop.record.data.subject}</h3><p>{stop.note}</p></div><span aria-hidden="true">↗</span></a></li>)}</ol>
  </div>
</section>
