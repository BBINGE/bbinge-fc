---
interface Fact {
  label: string;
  value: string;
}

interface Profile {
  eyebrow: string;
  name: string;
  romanName?: string;
  portrait: string;
  portraitAlt: string;
  portraitCredit?: string;
  facts: Fact[];
  officialChannel?: {
    label: string;
    handle: string;
    href: string;
  };
}

const { profile } = Astro.props as { profile: Profile };
const titleId = `fashion-profile-${profile.name.replace(/\s+/g, '-')}`;
---

<section class="fashion-profile" aria-labelledby={titleId}>
  <div class="fashion-profile__portrait">
    <img src={profile.portrait} alt={profile.portraitAlt} width="720" height="960" loading="eager" decoding="async" />
  </div>
  <div class="fashion-profile__body">
    <p class="fashion-profile__eyebrow">{profile.eyebrow}</p>
    <h2 id={titleId}>{profile.name}</h2>
    {profile.romanName && <p class="fashion-profile__roman" lang="en">{profile.romanName}</p>}
    <dl>
      {profile.facts.map((fact) => (
        <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
      ))}
      {profile.officialChannel && (
        <div>
          <dt>공식 채널</dt>
          <dd>
            <a class="fashion-profile__channel" href={profile.officialChannel.href} rel="noopener noreferrer">
              <span>{profile.officialChannel.label}</span> {profile.officialChannel.handle}
            </a>
          </dd>
        </div>
      )}
    </dl>
    {profile.portraitCredit && <p class="fashion-profile__credit">{profile.portraitCredit}</p>}
  </div>
</section>

<style>
  .fashion-profile { display:grid; grid-template-columns:minmax(250px,.84fr) minmax(0,1.16fr); margin:18px 0 58px; overflow:hidden; border:1px solid var(--bbfc-border); border-top:4px solid var(--bbfc-blue); border-radius:var(--bbfc-radius-lg); background:var(--bbfc-fill-2); box-shadow:0 20px 50px -40px rgba(15,34,58,.75); }
  .fashion-profile__portrait { min-height:100%; background:var(--bbfc-ink); }
  .fashion-profile__portrait img { display:block; width:100%; height:100%; margin:0; border-radius:0; object-fit:cover; }
  .fashion-profile__body { align-self:center; padding:30px 32px 27px; }
  .fashion-profile__eyebrow { margin:0; color:var(--bbfc-blue); font-size:10px; line-height:1.4; font-weight:760; letter-spacing:.16em; }
  .fashion-profile h2 { margin:11px 0 0; padding:0; border:0; color:var(--bbfc-ink); font-size:32px; line-height:1.1; font-weight:780; letter-spacing:-.045em; }
  .fashion-profile__roman { margin:5px 0 23px; color:var(--bbfc-gray-2); font-size:13px; line-height:1.4; font-weight:620; letter-spacing:.04em; }
  .fashion-profile dl { margin:0; border-top:1px solid var(--bbfc-border); }
  .fashion-profile dl div { display:grid; grid-template-columns:78px minmax(0,1fr); gap:13px; padding:9px 0; border-bottom:1px solid var(--bbfc-border); }
  .fashion-profile dt { color:var(--bbfc-gray-2); font-size:11px; line-height:1.55; font-weight:650; }
  .fashion-profile dd { margin:0; color:var(--bbfc-ink-2); font-size:13px; line-height:1.55; }
  .fashion-profile__channel { color:var(--bbfc-blue); font-weight:760; text-decoration:none; }
  .fashion-profile__channel span { color:var(--bbfc-gray-1); }
  .fashion-profile__channel:hover { text-decoration:underline; text-underline-offset:3px; }
  .fashion-profile__channel:focus-visible { outline:2px solid var(--bbfc-blue); outline-offset:3px; }
  .fashion-profile__credit { margin:15px 0 0; color:var(--bbfc-gray-2); font-size:10px; line-height:1.55; }
  @media (max-width:680px) {
    .fashion-profile { grid-template-columns:1fr; margin-bottom:46px; }
    .fashion-profile__portrait { aspect-ratio:4/5; }
    .fashion-profile__body { padding:24px 20px 22px; }
    .fashion-profile h2 { font-size:28px; }
    .fashion-profile dl div { grid-template-columns:69px minmax(0,1fr); gap:9px; }
  }
</style>
