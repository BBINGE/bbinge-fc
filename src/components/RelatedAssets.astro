---
import { imageFocusStyle } from '../utils/imageFocus';

interface RelatedAsset {
  href: string;
  title: string;
  description: string;
  label: string;
  coverImage?: string;
}

interface Props { items: RelatedAsset[] }
const { items } = Astro.props;
---

{items.length > 0 && (
  <aside class="related-assets" aria-labelledby="related-assets-title">
    <header><p>RELATED RECORDS</p><h2 id="related-assets-title">이 대회의 다른 기록</h2></header>
    <div class="related-assets-grid">
      {items.map((item) => (
        <a href={item.href}>
          {item.coverImage && <img src={item.coverImage} alt="" width="220" height="220" loading="lazy" style={imageFocusStyle(item.coverImage)} />}
          <span>{item.label}</span>
          <strong>{item.title}</strong>
          <small>{item.description}</small>
          <b>기록 보러가기 →</b>
        </a>
      ))}
    </div>
  </aside>
)}

<style>
  .related-assets { margin-top: 54px; padding-top: 25px; border-top: 2px solid var(--bbfc-ink); }
  header p { font-size: 9px; font-weight: 750; letter-spacing: .15em; color: var(--bbfc-blue); }
  header h2 { margin-top: 6px; font-size: 23px; line-height: 1.3; font-weight: 680; letter-spacing: -.035em; }
  .related-assets-grid { display: grid; gap: 12px; margin-top: 20px; }
  a { display: grid; grid-template-columns: 104px minmax(0, 1fr); column-gap: 17px; align-items: start; padding: 13px; border: 1px solid var(--bbfc-border); border-radius: var(--bbfc-radius-lg); transition: border-color .18s ease, transform .18s ease; }
  a:hover { border-color: var(--bbfc-blue); transform: translateY(-2px); }
  img { grid-row: 1 / 6; width: 104px; height: 104px; border-radius: var(--bbfc-radius); object-fit: cover; }
  span { font-size: 9px; line-height: 1.4; font-weight: 720; letter-spacing: .08em; color: var(--bbfc-blue); }
  strong { margin-top: 3px; font-size: 16px; line-height: 1.42; font-weight: 680; }
  small { margin-top: 5px; overflow: hidden; color: var(--bbfc-gray-1); font-size: 12px; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  b { margin-top: 8px; font-size: 10px; font-weight: 650; color: var(--bbfc-ink); }
  @media (max-width: 520px) {
    a { grid-template-columns: 82px minmax(0, 1fr); column-gap: 13px; padding: 10px; }
    img { width: 82px; height: 82px; }
    small { display: none; }
  }
</style>
