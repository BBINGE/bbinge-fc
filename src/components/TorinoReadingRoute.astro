---
interface Props {
  currentId: string;
}

const { currentId } = Astro.props;

const stories = [
  {
    id: 'grande-torino-wm-system-tactics',
    href: '/tactics/grande-torino-wm-system-tactics/',
    index: '01',
    label: '축술 · 이기는 방식',
    title: '그란데 토리노는 WM으로 어떻게 이겼나',
    description: '마촐라와 로이크가 3-2-2-3 안에서 움직인 방식',
    image: '/images/tactics/grande-torino-wm/grande-torino-wm-cover.png',
  },
  {
    id: 'grande-torino-card-news',
    href: '/history/grande-torino-card-news/',
    index: '02',
    label: '축세 · 사고와 애도',
    title: '수페르가 사고로 토리노에 무슨 일이 생겼나',
    description: '마지막 경기부터 비행기 사고와 장례까지, 7장의 이미지로 빠르게 읽기',
    image: '/images/history/grande-torino-cards/card-01.png',
  },
  {
    id: 'why-grande-torino-did-not-remain',
    href: '/history/why-grande-torino-did-not-remain/',
    index: '03',
    label: '축세 · 몰락의 이유',
    title: '최강 토리노는 왜 다시 만들어지지 못했나',
    description: '선수단을 잃은 뒤 전술과 구단 시스템까지 함께 끊긴 이유',
    image: '/images/history/grande-torino/grande-torino-filadelfia.png',
  },
  {
    id: 'turin-juventus-walk-of-fame-travel-10',
    href: '/pilgrimage/turin-juventus-walk-of-fame-travel-10/',
    index: '04',
    label: '축행 · 여행 동선',
    title: '토리노의 경기장과 수페르가는 어떻게 가나',
    description: '필라델피아·박물관·수페르가를 실제 2박 3일 동선으로 연결하기',
    image: '/images/pilgrimage/turin-two-museums/turin-two-museums-card.webp',
  },
];

const related = stories.filter((story) => story.id !== currentId);
---

<aside class="torino-route" aria-labelledby="torino-route-title">
  <header>
    <div><span>TORINO READING ROUTE · 01—04</span><h2 id="torino-route-title">그란데 토리노를<br />네 개의 시선으로 읽기</h2></div>
    <p>전술이 궁금한지, 사고의 전말이 궁금한지, 몰락의 이유가 궁금한지, 직접 토리노에 가고 싶은지에 따라 다음 글을 고르면 된다.</p>
  </header>
  <div class="torino-route__grid">
    {related.map((story) => (
      <a href={story.href} class="torino-route__card">
        <figure><img src={story.image} alt="" width="720" height="720" loading="lazy" decoding="async" /><span>{story.index}</span></figure>
        <div><small>{story.label}</small><strong>{story.title}</strong><p>{story.description}</p><b>이어서 읽기 <i aria-hidden="true">→</i></b></div>
      </a>
    ))}
  </div>
</aside>

<style>
  .torino-route{position:relative;overflow:hidden;margin:64px 0 18px;padding:36px 34px 34px;border:1px solid #511328;background:radial-gradient(circle at 91% -8%,rgba(229,181,88,.18),transparent 30%),linear-gradient(145deg,#1b0c11,#310c19 64%,#160a0e);color:#fff;box-shadow:0 28px 70px -52px rgba(72,5,29,.9)}
  .torino-route::after{position:absolute;right:-48px;top:16px;width:210px;height:210px;border:1px solid rgba(231,188,102,.1);border-radius:50%;content:'';pointer-events:none}
  .torino-route>header{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(260px,.85fr);gap:30px;align-items:end;padding-bottom:27px;border-bottom:1px solid rgba(255,255,255,.18)}
  .torino-route>header span{color:#e6ba67;font-size:12px;font-weight:820;letter-spacing:.15em}.torino-route h2{margin:12px 0 0;color:#fff;font-size:clamp(29px,4vw,43px);line-height:1.08;font-weight:790;letter-spacing:-.052em;text-wrap:balance}.torino-route>header p{margin:0;color:rgba(255,255,255,.69);font-size:14px;line-height:1.75;text-wrap:pretty}
  .torino-route__grid{position:relative;z-index:1;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:19px}
  .torino-route__card{display:grid;grid-template-rows:auto 1fr;overflow:hidden;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.055);color:#fff!important;transition:transform .28s ease,border-color .28s ease,background .28s ease}
  .torino-route__card figure{position:relative;aspect-ratio:1.45/1;margin:0;overflow:hidden;background:#090609}.torino-route__card img{width:100%;height:100%;object-fit:cover;filter:grayscale(.2) contrast(1.05);transition:transform .55s cubic-bezier(.22,1,.36,1),filter .35s ease}.torino-route__card figure span{position:absolute;top:12px;left:12px;display:grid;width:34px;height:34px;place-items:center;border:1px solid rgba(255,255,255,.55);border-radius:50%;background:rgba(24,7,13,.74);color:#fff;font-size:11px;font-weight:800}
  .torino-route__card>div{display:flex;min-height:223px;flex-direction:column;padding:19px 18px 18px}.torino-route__card small{color:#e6ba67;font-size:11px;font-weight:800;letter-spacing:.11em}.torino-route__card strong{display:block;margin-top:9px;color:#fff;font-size:20px;line-height:1.32;letter-spacing:-.035em;text-wrap:balance}.torino-route__card p{margin:9px 0 0;color:rgba(255,255,255,.65);font-size:12px;line-height:1.6;text-wrap:pretty}.torino-route__card b{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:18px;color:#fff;font-size:16px}.torino-route__card b i{font-size:24px;font-style:normal;animation:torino-route-arrow 1.8s ease-in-out infinite}
  .torino-route__card:hover{transform:translateY(-4px);border-color:#e6ba67;background:rgba(255,255,255,.09)}.torino-route__card:hover img{transform:scale(1.04);filter:grayscale(0) contrast(1.02)}
  @keyframes torino-route-arrow{0%,100%{transform:translateX(0)}50%{transform:translateX(5px)}}
  @media(max-width:800px){.torino-route{padding:28px 20px 22px}.torino-route>header{grid-template-columns:1fr;gap:16px}.torino-route__grid{grid-template-columns:1fr}.torino-route__card{grid-template-columns:118px minmax(0,1fr);grid-template-rows:1fr}.torino-route__card figure{height:100%;aspect-ratio:auto}.torino-route__card>div{min-height:190px;padding:17px 16px}.torino-route__card strong{font-size:18px}}
  @media(max-width:430px){.torino-route{margin-inline:-4px}.torino-route__card{grid-template-columns:102px minmax(0,1fr)}.torino-route__card p{font-size:11px}.torino-route__card b{font-size:16px}}
  @media(prefers-reduced-motion:reduce){.torino-route__card,.torino-route__card img{transition:none}.torino-route__card b i{animation:none}}
</style>
