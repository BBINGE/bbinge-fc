---
import { site } from '../config/site';
---

<footer class="border-t border-[var(--bbfc-line)] px-4 md:px-5 py-6 mt-8">
  <div class="max-w-[1040px] mx-auto">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-[14px] font-medium text-[var(--bbfc-ink)] mb-1">{site.name}</p>
        <p class="text-[12px] text-[var(--bbfc-gray-1)]">{site.tagline}</p>
      </div>
      <nav class="flex gap-4 text-[12px] text-[var(--bbfc-gray-1)]">
        <a href="/about/">소개</a>
        <a href="/privacy/">개인정보처리방침</a>
        <a href="/contact/">문의</a>
      </nav>
    </div>
    <p class="text-[11px] text-[var(--bbfc-gray-2)] mt-5">
      © {new Date().getFullYear()} {site.name}. All rights reserved.
    </p>
  </div>
</footer>
