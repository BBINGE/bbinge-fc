---
import type { CollectionEntry } from 'astro:content';
import { getArticlePath } from '../config/categories';

interface Props {
  entries: CollectionEntry<'articles'>[];
  description?: string;
}

interface MatchProfile {
  year: string;
  stage: string;
  home: string;
  away: string;
  homeScore: string;
  awayScore: string;
  date: string;
  venue: string;
  scenes: string;
  turningPoint: string;
  timeline: Array<{ time: string; label: string }>;
}

const { entries, description } = Astro.props;
const hrefFor = (entry: CollectionEntry<'articles'>) => getArticlePath(entry.data.category, entry.id);
const imageFor = (entry: CollectionEntry<'articles'>) => entry.data.cardImage ?? entry.data.coverImage;
const introLead = description?.split(' H/L은')[0] ?? description;

const profiles: Record<string, MatchProfile> = {
  '1950-fifa-world-cup-final-uruguay-brazil': {
    year: '1950',
    stage: 'FIFA WORLD CUP · FINAL ROUND',
    home: '우루과이',
    away: '브라질',
    homeScore: '2',
    awayScore: '1',
    date: '1950.07.16',
    venue: '마라카낭',
    scenes: '18 SCENES',
    turningPoint: '브라질의 선제골 뒤 스키아피노가 균형을 되찾고, 기지아가 마라카낭을 멈춰 세웠다.',
    timeline: [
      { time: 'KICK OFF', label: '20만의 확신' },
      { time: "47'", label: '브라질 1-0' },
      { time: "66'", label: '우루과이 1-1' },
      { time: "79'", label: '우루과이 2-1' },
      { time: 'FULL TIME', label: '마라카나수' },
    ],
  },
  '1938-fifa-world-cup-final-italy-hungary': {
    year: '1938',
    stage: 'FIFA WORLD CUP · FINAL',
    home: '이탈리아',
    away: '헝가리',
    homeScore: '4',
    awayScore: '2',
    date: '1938.06.19',
    venue: '스타드 올랭피크 드 콜롱브',
    scenes: '06 SCENES',
    turningPoint: '두 번의 추격을 허용하고도 피올라와 콜라우시가 결승전을 다시 이탈리아 쪽으로 돌렸다.',
    timeline: [
      { time: "6'", label: '1-0' },
      { time: "8'", label: '1-1' },
      { time: "16'", label: '2-1' },
      { time: "35'", label: '3-1' },
      { time: "82'", label: '4-2' },
    ],
  },
  '1934-fifa-world-cup-final-italy-czechoslovakia': {
    year: '1934',
    stage: 'FIFA WORLD CUP · FINAL',
    home: '이탈리아',
    away: '체코슬로바키아',
    homeScore: '2',
    awayScore: '1',
    date: '1934.06.10',
    venue: '스타디오 나치오날레 PNF',
    scenes: '07 SCENES',
    turningPoint: '푸치에게 선제골을 내준 개최국이 오르시의 동점골과 스키아비오의 연장 결승골로 돌아왔다.',
    timeline: [
      { time: "71'", label: '0-1' },
      { time: "81'", label: '1-1' },
      { time: "90'", label: '연장전' },
      { time: "95'", label: '2-1' },
      { time: 'FULL TIME', label: '이탈리아 우승' },
    ],
  },
  '1930-fifa-world-cup-final-uruguay-argentina': {
    year: '1930',
    stage: 'FIFA WORLD CUP · FINAL',
    home: '우루과이',
    away: '아르헨티나',
    homeScore: '4',
    awayScore: '2',
    date: '1930.07.30',
    venue: '에스타디오 센테나리오',
    scenes: '12 SCENES',
    turningPoint: '전반을 1-2로 마친 우루과이가 후반 세 골을 몰아치며 첫 월드컵의 초대 챔피언이 됐다.',
    timeline: [
      { time: "12'", label: '1-0' },
      { time: "37'", label: '1-2' },
      { time: "57'", label: '2-2' },
      { time: "68'", label: '3-2' },
      { time: "89'", label: '4-2' },
    ],
  },
};

const fallbackProfile: MatchProfile = {
  year: 'ARCHIVE',
  stage: 'MATCH RECORD',
  home: '기록',
  away: '경기',
  homeScore: '-',
  awayScore: '-',
  date: 'BBINGE FC',
  venue: 'H/L ARCHIVE',
  scenes: 'SCENES',
  turningPoint: '경기의 방향이 바뀐 장면을 시간순으로 다시 본다.',
  timeline: [],
};

const signature = entries.find((entry) => entry.id === '1950-fifa-world-cup-final-uruguay-brazil') ?? entries[0];
const archive = entries.filter((entry) => entry.id !== signature?.id);
const signatureProfile = signature ? (profiles[signature.id] ?? fallbackProfile) : undefined;
---

<main class="highlights-index">
  <header class="masthead">
    <div>
      <p>BBINGE FC · MATCH RESTORATION ARCHIVE</p>
      <h1>H/L</h1>
    </div>
    <p class="masthead-statement">
      <strong>결과를 알면서도<br />다시 숨을 멈춥니다.</strong>
      <span>TIME-ORDERED MATCH SCENES</span>
    </p>
  </header>

  {introLead && <p class="intro">{introLead}</p>}

  <div class="editorial-rule" aria-label="H/L 편집 원칙">
    <span>WHY REPLAY</span>
    <p>누가 득점했는지만 남기지 않고, 공이 어디에서 시작해 누구의 발을 거쳐 경기의 방향을 바꾸었는지 바라봅니다.</p>
    <small>{String(entries.length).padStart(2, '0')} MATCH FILES</small>
  </div>

  {signature && signatureProfile ? (
    <section class="signature" aria-labelledby="highlight-signature-title">
      <div class="section-heading">
        <p>THE MATCH THAT STOPPED A STADIUM</p>
        <span>결과표 한 줄이 만들어진 시간</span>
      </div>

      <article class="signature-card">
        <a class="signature-cover" href={hrefFor(signature)} aria-label={`${signature.data.title} 장면 순서대로 보기`}>
          {imageFor(signature) && <img src={imageFor(signature)} alt={signature.data.coverImageAlt ?? ''} />}
          <span class="archive-stamp">ARCHIVE {signatureProfile.year}</span>
        </a>

        <div class="signature-copy">
          <div class="signal-line"><span>RECORDED MATCH</span><i aria-hidden="true"></i><span>{signatureProfile.scenes}</span></div>
          <p class="competition">{signatureProfile.stage}</p>
          <h2 id="highlight-signature-title"><a href={hrefFor(signature)}>{signature.data.title}</a></h2>

          <div class="scoreboard" aria-label={`${signatureProfile.home} ${signatureProfile.homeScore} 대 ${signatureProfile.awayScore} ${signatureProfile.away}`}>
            <span>{signatureProfile.home}</span>
            <strong>{signatureProfile.homeScore}<i>-</i>{signatureProfile.awayScore}</strong>
            <span>{signatureProfile.away}</span>
          </div>

          <p class="turning-point">{signatureProfile.turningPoint}</p>
          <dl class="match-facts">
            <div><dt>DATE</dt><dd>{signatureProfile.date}</dd></div>
            <div><dt>VENUE</dt><dd>{signatureProfile.venue}</dd></div>
          </dl>
          <a class="signature-cta" href={hrefFor(signature)}><span>장면 순서대로 보기</span><b aria-hidden="true">→</b></a>
        </div>
      </article>

      <ol class="match-timeline" aria-label={`${signature.data.title} 주요 장면`}>
        {signatureProfile.timeline.map((event) => (
          <li><span>{event.time}</span><small>{event.label}</small></li>
        ))}
      </ol>
    </section>
  ) : (
    <p class="empty">첫 번째 경기를 복원하고 있습니다.</p>
  )}

  {archive.length > 0 && (
    <section class="archive" aria-labelledby="highlight-archive-title">
      <div class="archive-heading">
        <div><p>WORLD CUP FINAL ARCHIVE</p><h2 id="highlight-archive-title">경기 파일</h2></div>
        <span>{String(archive.length).padStart(2, '0')} RESTORED MATCHES</span>
      </div>

      <div class="archive-grid">
        {archive.map((entry, index) => {
          const profile = profiles[entry.id] ?? fallbackProfile;
          return (
            <article class="match-card">
              <a class="match-cover" href={hrefFor(entry)} aria-label={`${entry.data.title} 장면 순서대로 보기`}>
                {imageFor(entry) && <img src={imageFor(entry)} alt={entry.data.coverImageAlt ?? ''} loading="lazy" />}
                <span>{String(index + 2).padStart(2, '0')}</span>
              </a>
              <div class="match-copy">
                <p class="match-meta"><span>{profile.year}</span><span>{profile.scenes}</span></p>
                <div class="compact-score" aria-label={`${profile.home} ${profile.homeScore} 대 ${profile.awayScore} ${profile.away}`}>
                  <p><span>{profile.home}</span><span>{profile.away}</span></p>
                  <strong><span>{profile.homeScore}</span><i>-</i><span>{profile.awayScore}</span></strong>
                </div>
                <h3><a href={hrefFor(entry)}>{entry.data.title}</a></h3>
                <p class="match-turn">{profile.turningPoint}</p>
                <div class="match-timebar" aria-hidden="true">
                  {profile.timeline.map((event) => <i title={event.time}></i>)}
                </div>
                <div class="match-footer">
                  <span><small>{profile.date}</small><small>{profile.venue}</small></span>
                  <a href={hrefFor(entry)}><span>경기 복원 보기</span><b aria-hidden="true">→</b></a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )}
</main>

<style>
  .highlights-index{--hl-night:#101318;--hl-night-2:#1a1f26;--hl-paper:#f4f0e8;--hl-muted:#aeb6c0;--hl-signal:#ff553d;max-width:1180px;margin:0 auto;padding:34px 20px 82px}.masthead{display:flex;align-items:end;justify-content:space-between;gap:32px;padding-bottom:23px;border-bottom:3px solid var(--bbfc-ink)}.masthead>div>p{color:var(--hl-signal);font-size:11px;font-weight:780;letter-spacing:.16em}.masthead h1{margin-top:7px;font-size:clamp(58px,9vw,102px);line-height:.82;font-weight:840;letter-spacing:-.075em}.masthead-statement{display:grid;justify-items:end;max-width:440px;text-align:right}.masthead-statement strong{font-size:18px;line-height:1.28;letter-spacing:-.025em}.masthead-statement span{margin-top:10px;color:var(--hl-signal);font-size:11px;font-weight:760;letter-spacing:.12em}.intro{margin:20px 0 25px;color:var(--bbfc-gray-1);font-size:14px;line-height:1.82;text-wrap:pretty}.editorial-rule{display:grid;grid-template-columns:100px minmax(0,1fr) auto;align-items:center;gap:20px;padding:17px 16px;border-block:1px solid var(--bbfc-ink)}.editorial-rule>span{color:var(--hl-signal);font-size:11px;font-weight:800;letter-spacing:.14em}.editorial-rule p{font-size:16px;line-height:1.5;font-weight:720;letter-spacing:-.025em}.editorial-rule small{color:var(--bbfc-gray-1);font-size:12px;font-weight:700;letter-spacing:.08em;white-space:nowrap}
  .signature{margin-top:56px}.section-heading{display:flex;align-items:baseline;gap:14px;padding-bottom:12px;border-bottom:1px solid var(--bbfc-ink)}.section-heading p{color:var(--hl-signal);font-size:11px;font-weight:780;letter-spacing:.14em}.section-heading span{margin-left:auto;color:var(--bbfc-gray-1);font-size:14px;font-weight:610}.signature-card{display:grid;grid-template-columns:minmax(0,1.04fr) minmax(380px,.96fr);margin-top:20px}.signature-cover{position:relative;display:block;aspect-ratio:1/1;overflow:hidden;background:transparent}.signature-cover img,.match-cover img{width:100%;height:100%;object-fit:cover;transition:transform .55s cubic-bezier(.22,1,.36,1)}.archive-stamp{position:absolute;right:18px;bottom:18px;padding:7px 9px;border:1px solid rgba(255,255,255,.5);background:rgba(16,19,24,.75);color:white;font-size:10px;font-weight:800;letter-spacing:.11em;backdrop-filter:blur(6px)}.signature-copy{display:flex;position:relative;isolation:isolate;overflow:hidden;flex-direction:column;padding:30px 34px;background:var(--hl-night);color:var(--hl-paper)}.signature-copy:before,.match-copy:before{content:"";position:absolute;z-index:-2;inset:0;background:radial-gradient(circle at 82% 18%,rgba(255,85,61,.16),transparent 28%),repeating-linear-gradient(90deg,rgba(255,255,255,.022) 0 1px,transparent 1px 48px)}.signature-copy:after,.match-copy:after{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(104deg,transparent 0 64%,rgba(255,255,255,.025) 64% 64.5%,transparent 64.5%);pointer-events:none}.signal-line{display:flex;align-items:center;gap:9px;color:var(--hl-muted);font-size:10px;font-weight:750;letter-spacing:.12em}.signal-line i{width:7px;height:7px;border-radius:50%;background:var(--hl-signal);box-shadow:0 0 0 5px rgba(255,85,61,.12);animation:hl-signal 2s ease-in-out infinite}.signal-line span:last-child{margin-left:auto}.competition{margin-top:27px;color:var(--hl-signal);font-size:11px;font-weight:780;letter-spacing:.12em}.signature-copy h2{margin-top:10px;font-size:clamp(27px,3.05vw,41px);line-height:1.16;font-weight:790;letter-spacing:-.05em;text-wrap:balance}.scoreboard{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:13px;margin-top:26px;padding:19px 0;border-block:1px solid rgba(244,240,232,.24);text-align:center}.scoreboard>span{font-size:15px;font-weight:700}.scoreboard strong{display:flex;align-items:center;gap:12px;font-size:45px;line-height:1;font-weight:820;letter-spacing:-.05em}.scoreboard strong i{color:var(--hl-signal);font-size:20px;font-style:normal}.turning-point{margin-top:21px;color:rgba(244,240,232,.82);font-size:13.5px;line-height:1.72;font-weight:600}.match-facts{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:18px}.match-facts div{padding-top:11px;border-top:1px solid rgba(244,240,232,.15)}.match-facts dt{color:var(--hl-signal);font-size:9px;font-weight:780;letter-spacing:.12em}.match-facts dd{margin:5px 0 0;color:var(--hl-muted);font-size:11px;line-height:1.4}.signature-cta{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:auto;min-height:58px;padding:14px 16px 14px 19px;border:1px solid rgba(255,255,255,.35);background:var(--hl-signal);color:white;font-size:17px;font-weight:800;letter-spacing:-.025em;box-shadow:0 15px 30px -22px rgba(255,85,61,.8);transition:transform .25s ease,filter .25s ease}.signature-cta b{font-size:23px;line-height:1;animation:hl-arrow 1.7s ease-in-out infinite}.match-timeline{display:grid;position:relative;grid-template-columns:repeat(5,1fr);margin:0;padding:24px 0 0;list-style:none}.match-timeline:before{content:"";position:absolute;top:28px;right:4%;left:4%;height:2px;background:var(--hl-night)}.match-timeline:after{content:"";position:absolute;top:28px;left:4%;width:92%;height:2px;background:var(--hl-signal);transform:scaleX(0);transform-origin:left;animation:hl-timeline 1.15s .2s cubic-bezier(.22,1,.36,1) forwards}.match-timeline li{display:grid;position:relative;z-index:1;justify-items:center;gap:11px;text-align:center}.match-timeline li:before{content:"";width:10px;height:10px;border:2px solid var(--hl-night);border-radius:50%;background:var(--bbfc-bg)}.match-timeline span{font-size:11px;font-weight:800;letter-spacing:.04em}.match-timeline small{color:var(--bbfc-gray-1);font-size:10px;line-height:1.35}
  .archive{margin-top:70px}.archive-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;padding-bottom:13px;border-bottom:2px solid var(--bbfc-ink)}.archive-heading p{color:var(--hl-signal);font-size:11px;font-weight:780;letter-spacing:.14em}.archive-heading h2{margin-top:5px;font-size:27px;font-weight:790;letter-spacing:-.04em}.archive-heading>span{color:var(--bbfc-gray-2);font-size:11px;font-weight:760;letter-spacing:.1em}.archive-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px 18px;margin-top:24px}.match-card{display:flex;flex-direction:column;border-bottom:1px solid var(--bbfc-ink)}.match-cover{position:relative;display:block;aspect-ratio:1/1;overflow:hidden;background:transparent}.match-cover>span{position:absolute;top:16px;left:16px;color:white;font-size:11px;font-weight:800;text-shadow:0 1px 7px rgba(0,0,0,.9)}.match-copy{display:flex;position:relative;isolation:isolate;flex:1;overflow:hidden;flex-direction:column;padding:18px;background:var(--hl-night);color:var(--hl-paper)}.match-meta{display:flex;justify-content:space-between;gap:12px;color:var(--hl-signal);font-size:10px;font-weight:780;letter-spacing:.11em}.compact-score{display:grid;grid-template-columns:1fr auto;align-items:center;gap:16px;margin-top:15px;padding-bottom:14px;border-bottom:1px solid rgba(244,240,232,.2)}.compact-score p{display:grid;gap:6px;font-size:13px;font-weight:680}.compact-score strong{display:flex;align-items:center;gap:7px;font-size:27px;line-height:1;font-weight:820}.compact-score strong i{color:var(--hl-signal);font-size:13px;font-style:normal}.match-copy h3{margin-top:15px;font-size:18px;line-height:1.3;font-weight:750;letter-spacing:-.035em;text-wrap:balance}.match-turn{display:-webkit-box;overflow:hidden;margin-top:11px;color:rgba(244,240,232,.7);font-size:12px;line-height:1.65;-webkit-box-orient:vertical;-webkit-line-clamp:3}.match-timebar{display:flex;align-items:center;gap:0;margin-top:16px}.match-timebar:before{content:"KICK";margin-right:8px;color:var(--hl-muted);font-size:8px;font-weight:760;letter-spacing:.08em}.match-timebar i{position:relative;flex:1;height:2px;background:rgba(244,240,232,.26)}.match-timebar i:after{content:"";position:absolute;top:50%;right:-2px;width:5px;height:5px;border-radius:50%;background:var(--hl-signal);transform:translateY(-50%)}.match-footer{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-top:auto;padding-top:18px}.match-footer>span{display:grid;gap:3px;min-width:0;color:var(--hl-muted);font-size:9px}.match-footer>span small:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.match-footer>a{display:flex;flex:0 0 132px;align-items:center;justify-content:space-between;gap:10px;min-height:42px;padding:10px 11px;border:1px solid rgba(255,255,255,.34);background:var(--hl-signal);color:white;font-size:12.5px;font-weight:800;transition:transform .25s ease,filter .25s ease}.match-footer>a b{font-size:18px;line-height:1;animation:hl-arrow 1.7s ease-in-out infinite}.signature-cover:hover img,.match-card:hover .match-cover img{transform:scale(1.025)}.signature-cta:hover,.match-footer>a:hover{filter:brightness(1.08);transform:translateY(-2px)}.highlights-index a:focus-visible{outline:3px solid var(--hl-signal);outline-offset:4px}.empty{padding:80px 0;text-align:center}
  @keyframes hl-signal{0%,100%{opacity:.5}50%{opacity:1;box-shadow:0 0 0 7px rgba(255,85,61,.08)}}@keyframes hl-timeline{to{transform:scaleX(1)}}@keyframes hl-arrow{0%,55%,100%{transform:translateX(0)}72%{transform:translateX(4px)}}
  @media(max-width:980px){.signature-card{grid-template-columns:minmax(0,1fr) minmax(340px,1fr)}.archive-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:900px){.signature-card{grid-template-columns:1fr}.signature-copy{min-height:520px}}
  @media(max-width:760px){.signature-card{grid-template-columns:1fr}.signature-copy{min-height:530px}.archive-grid{grid-template-columns:1fr 1fr}.editorial-rule{grid-template-columns:90px 1fr}.editorial-rule small{grid-column:2}.match-footer{display:grid}.match-footer>a{width:100%;flex-basis:auto}}
  @media(max-width:560px){.highlights-index{padding:25px 16px 62px}.masthead{display:grid;grid-template-columns:minmax(0,1fr) 138px;align-items:start;gap:18px}.masthead>div{min-width:0}.masthead-statement{width:138px}.masthead-statement strong{display:block;width:100%;font-size:12px;line-height:1.35;white-space:nowrap}.masthead-statement span{display:none}.intro{font-size:13.2px}.editorial-rule{grid-template-columns:1fr;gap:8px;padding:15px 0}.editorial-rule p{font-size:15px}.editorial-rule small{grid-column:auto}.signature{margin-top:48px}.section-heading span{display:none}.signature-copy{min-height:510px;padding:25px 20px}.signature-copy h2{font-size:28px}.scoreboard{gap:8px}.scoreboard>span{font-size:13px}.scoreboard strong{font-size:38px}.signature-cta{margin-top:28px;font-size:16px}.match-timeline{overflow-x:auto;grid-template-columns:repeat(5,minmax(88px,1fr));padding-bottom:6px}.match-timeline:before,.match-timeline:after{right:44px;left:44px}.match-timeline:after{width:calc(100% - 88px)}.archive{margin-top:56px}.archive-heading{align-items:start}.archive-heading>span{max-width:100px;text-align:right}.archive-grid{grid-template-columns:1fr}.match-copy{min-height:350px;padding:20px}.match-copy h3{font-size:20px}.match-footer{display:flex}.match-footer>a{width:auto;flex-basis:140px}}
  @media(prefers-reduced-motion:reduce){.signal-line i,.match-timeline:after,.signature-cta b,.match-footer>a b{animation:none}.signature-cover img,.match-cover img,.signature-cta,.match-footer>a{transition:none}.match-timeline:after{transform:scaleX(1)}}
</style>
