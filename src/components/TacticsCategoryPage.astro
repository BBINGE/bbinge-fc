---
import type { CollectionEntry } from 'astro:content';
import { getArticlePath } from '../config/categories';

interface Props { entries: CollectionEntry<'articles'>[]; description?: string; }
interface ArticleProfile { eyebrow: string; period: string; hook: string; }

const { entries, description } = Astro.props;
const [lead, ...archive] = entries;
const hrefFor = (entry: CollectionEntry<'articles'>) => getArticlePath(entry.data.category, entry.id);
const imageFor = (entry: CollectionEntry<'articles'>) => entry.data.cardImage ?? entry.data.coverImage;
const publishedDate = (entry: CollectionEntry<'articles'>) => new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(entry.data.pubDate);

const profiles: Record<string, ArticleProfile> = {
  'football-manager-change-effect-before-tactics': { eyebrow: '감독과 팀', period: '2011—2024', hook: '경질 직후의 반등은 감독의 효과일까, 아니면 곧 제자리로 돌아갈 숫자의 흔들림일까.' },
  'valeriy-lobanovskyi-dynamo-kyiv-system-football': { eyebrow: '시스템 축구', period: '1964—2002', hook: '로바노우스키는 재능을 지워 버린 것이 아니라, 재능이 반복해서 작동할 체계를 만들었다.' },
  'grande-torino-wm-system-tactics': { eyebrow: 'WM과 시스테마', period: '1939—1949', hook: '마촐라와 로이크의 중원 사각형은 고정된 숫자가 아니라 전진과 복귀의 질서였다.' },
  'pep-guardiola-manchester-city-wm-tactics': { eyebrow: 'WM과 3-2-4-1', period: '1925—2023', hook: '닮은 것은 포메이션의 외곽선이 아니라 다섯 개 공격선과 중원 사각형의 역할이다.' },
  'hungary-golden-team-total-football-elo-rating': { eyebrow: '다뉴브의 계보', period: '1920s—1954', hook: '매직 마자르의 유동성은 한 번의 발명이 아니라 여러 시대를 건너온 사상의 집적이었다.' },
};
const profileFor = (entry: CollectionEntry<'articles'>): ArticleProfile => profiles[entry.id] ?? { eyebrow: (entry.data.tags ?? [])[0] ?? '전술과 아이디어', period: entry.data.pubDate.getFullYear().toString(), hook: entry.data.description };
const leadProfile = lead ? profileFor(lead) : undefined;
---

<main class="tactics-index">
  <header class="category-head">
    <div><p>BBINGE FC · TACTICS &amp; IDEAS</p><h1>축술</h1><span>축구 전술과 아이디어의 계보</span></div>
    <p class="article-count"><b>{entries.length}편</b></p>
  </header>

  {description && <section class="category-intro" aria-label="축술 소개"><p>{description}</p><strong>숫자 뒤의 움직임과<br />그 움직임을 만든 사람을 읽습니다.</strong></section>}

  {lead && leadProfile ? (
    <section class="lead-story" aria-labelledby="lead-story-title">
      <header class="section-head"><p>LATEST</p><span>새로 올라온 글</span><b>{publishedDate(lead)}</b></header>
      <article class="lead-story__body">
        <a class="cover cover--lead" href={hrefFor(lead)}>{imageFor(lead) && <img src={imageFor(lead)} alt={lead.data.coverImageAlt ?? ''} />}</a>
        <div class="lead-story__copy">
          <p class="story-meta"><span>{leadProfile.eyebrow}</span><b>{leadProfile.period}</b></p>
          <h2 id="lead-story-title"><a href={hrefFor(lead)}>{lead.data.title}</a></h2>
          <p class="lead-description">{lead.data.description}</p>
          <blockquote>{leadProfile.hook}</blockquote>
          <a class="read-link" href={hrefFor(lead)}><span>글 읽기</span><i aria-hidden="true">→</i></a>
        </div>
      </article>
    </section>
  ) : <p class="empty">첫 글을 준비하고 있습니다.</p>}

  {archive.length > 0 && (
    <section class="archive" aria-labelledby="archive-title">
      <header class="section-head section-head--archive"><div><p>ARCHIVE</p><h2 id="archive-title">전술과 사람, 시대를 잇는 글</h2></div><span>{String(archive.length).padStart(2, '0')} ARTICLES</span></header>
      <div class="archive-grid">
        {archive.map((entry) => { const profile = profileFor(entry); return (
          <article class="story-card">
            <a class="cover" href={hrefFor(entry)}>{imageFor(entry) && <img src={imageFor(entry)} alt={entry.data.coverImageAlt ?? ''} loading="lazy" />}</a>
            <div class="story-card__copy">
              <p class="story-meta"><span>{profile.eyebrow}</span><b>{profile.period}</b></p>
              <h3><a href={hrefFor(entry)}>{entry.data.title}</a></h3>
              <p>{profile.hook}</p>
              <a href={hrefFor(entry)} aria-label={`${entry.data.title} 읽기`}>읽기 <i aria-hidden="true">↗</i></a>
            </div>
          </article>
        ); })}
      </div>
    </section>
  )}
</main>

<style>
  .tactics-index{--ink:#101923;--navy:#071522;--blue:#24658f;--gold:#c49b43;max-width:1180px;margin:0 auto;padding:36px 20px 84px;font-family:Pretendard,"Pretendard Variable",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink)}
  .category-head{display:flex;align-items:end;justify-content:space-between;gap:40px;padding-bottom:25px;border-bottom:3px solid var(--ink)}.category-head>div>p,.section-head>p,.section-head>div>p{color:var(--blue);font-size:12px;font-weight:800;letter-spacing:.15em}.category-head h1{margin-top:10px;font-size:clamp(58px,8vw,96px);line-height:.82;font-weight:850;letter-spacing:-.075em}.category-head>div>span{display:block;margin-top:17px;font-size:17px;font-weight:690;letter-spacing:-.025em}.article-count{flex:0 0 auto;margin:0;white-space:nowrap}.article-count b{font-size:38px;line-height:1;font-weight:780;letter-spacing:-.05em}
  .category-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.46fr);gap:50px;padding:26px 0 30px;border-bottom:1px solid var(--ink)}.category-intro>p{color:#59636d;font-size:14px;line-height:1.9;text-wrap:pretty}.category-intro>strong{align-self:end;padding-left:22px;border-left:3px solid var(--gold);font-size:19px;line-height:1.5;font-weight:760;letter-spacing:-.035em}
  .lead-story{margin-top:58px}.section-head{display:flex;align-items:baseline;gap:16px;padding-bottom:12px;border-bottom:1px solid var(--ink)}.section-head>span{color:#67717b;font-size:13px;font-weight:650}.section-head>b{margin-left:auto;font-size:12px;font-weight:700;letter-spacing:.04em}.lead-story__body{display:grid;grid-template-columns:minmax(0,1fr) minmax(390px,.92fr);margin-top:20px}.cover{display:block;aspect-ratio:1/1;overflow:hidden;background:transparent}.cover img{display:block;width:100%;height:100%;object-fit:cover}.lead-story__copy{display:flex;position:relative;isolation:isolate;overflow:hidden;flex-direction:column;justify-content:center;padding:40px;background:var(--navy);color:#fff}.lead-story__copy:before{content:"";position:absolute;z-index:-1;inset:0;background:radial-gradient(circle at 90% 10%,rgba(45,115,166,.3),transparent 38%),linear-gradient(135deg,transparent 55%,rgba(255,255,255,.035))}.story-meta{display:flex;align-items:center;justify-content:space-between;gap:18px;margin:0}.story-meta span{color:#83c2e8;font-size:12px;font-weight:800;letter-spacing:.1em}.story-meta b{color:#d7b968;font-size:12px;font-weight:760}.lead-story h2{margin-top:24px;font-size:clamp(31px,3.4vw,45px);line-height:1.16;font-weight:810;letter-spacing:-.052em;text-wrap:balance}.lead-description{margin-top:20px;color:rgba(240,245,249,.78);font-size:14px;line-height:1.8}.lead-story blockquote{margin:26px 0 0;padding:15px 0 15px 18px;border-left:2px solid var(--gold);color:rgba(255,255,255,.94);font-size:16px;line-height:1.7;font-weight:670}.read-link{display:flex;align-items:center;justify-content:space-between;margin-top:30px;min-height:54px;padding:13px 16px;border:1px solid rgba(218,190,119,.68);color:#fff;font-size:16px;font-weight:790}.read-link i{color:#e2c77f;font-size:20px;font-style:normal;transition:transform .25s ease}.read-link:hover i{transform:translateX(4px)}
  .archive{margin-top:74px}.section-head--archive{align-items:end}.section-head--archive h2{margin-top:5px;font-size:27px;font-weight:800;letter-spacing:-.04em}.section-head--archive>span{margin-left:auto;font-size:12px;font-weight:780;letter-spacing:.1em}.archive-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:34px 20px;margin-top:25px}.story-card{min-width:0}.story-card .cover{border-radius:14px;transition:transform .28s ease,box-shadow .28s ease}.story-card:hover .cover{transform:translateY(-4px);box-shadow:0 20px 34px -24px rgba(4,18,29,.6)}.story-card__copy{padding:17px 2px 0}.story-card .story-meta span{color:#24658f}.story-card .story-meta b{color:#8a6a29}.story-card h3{margin-top:12px;font-size:20px;line-height:1.34;font-weight:790;letter-spacing:-.035em;text-wrap:balance}.story-card__copy>p:not(.story-meta){margin-top:11px;color:#626c74;font-size:13px;line-height:1.68}.story-card__copy>a{display:inline-block;margin-top:15px;color:#173e5e;font-size:13px;font-weight:800}.story-card__copy>a i{font-style:normal}
  .empty{padding:80px 0;text-align:center;font-size:14px}.tactics-index a:focus-visible{outline:3px solid #338ac6;outline-offset:4px}
  @media(max-width:1000px){.lead-story__body{grid-template-columns:1fr}.archive-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:760px){.category-intro{grid-template-columns:1fr;gap:23px}.category-intro>strong{justify-self:start}.article-count b{font-size:34px}}
  @media(max-width:560px){.tactics-index{padding:26px 16px 62px}.category-head{align-items:start}.category-head h1{font-size:64px}.category-head>div>span{font-size:15px}.article-count{padding-top:30px}.article-count b{font-size:28px}.category-intro>p{font-size:13px;line-height:1.82}.category-intro>strong{font-size:17px}.lead-story{margin-top:48px}.section-head{flex-wrap:wrap}.section-head>b{width:100%;margin-left:0}.lead-story__copy{padding:28px 21px 25px}.lead-story h2{font-size:30px}.lead-story blockquote{font-size:15px}.archive{margin-top:58px}.section-head--archive>div h2{font-size:24px}.archive-grid{grid-template-columns:1fr;gap:42px}.story-card h3{font-size:22px}}
  @media(prefers-reduced-motion:reduce){.story-card .cover,.read-link i{transition:none}}
</style>
