---
import type { CollectionEntry } from 'astro:content';
import { getArticlePath } from '../config/categories';
import { imageFocusStyle } from '../utils/imageFocus';

interface Props {
  entries: CollectionEntry<'articles'>[];
  description?: string;
}

interface MatchFile {
  code: string;
  shortCode: string;
  question: string;
  clue: string;
  verdict: string;
  notation: string;
  searchIntents: string[];
}

const { entries, description } = Astro.props;
const [lead] = entries;
const imageFor = (entry: CollectionEntry<'articles'>) => entry.data.cardImage ?? entry.data.coverImage;
const hrefFor = (entry: CollectionEntry<'articles'>) => getArticlePath(entry.data.category, entry.id);

const matchFiles: Record<string, MatchFile> = {
  '2026-football-rule-changes-substitution-throw-in-goal-kick': {
    code: 'TIME LIMITS',
    shortCode: '10s · 5s · 5s',
    question: '교체 선수는 왜 바로 들어오지 못했을까?',
    clue: '심판의 신호와 공이 다시 움직이는 순간',
    verdict: '자동 제한이 아니라 고의적인 지연을 심판이 선언한 때부터 센다.',
    notation: 'SIGNAL → COUNT → RESTART',
    searchIntents: ['교체 선수가 왜 안 들어와', '교체 투입 지연', '교체 10초', '스로인 5초', '골킥 5초', '시간 지연 경고'],
  },
  'goalkeeper-handball-back-pass-rules': {
    code: 'GOALKEEPER',
    shortCode: 'BALL × AREA',
    question: '골키퍼인데 왜 손을 쓰면 반칙일까?',
    clue: '손과 공, 페널티지역의 관계',
    verdict: '누가 공을 보냈는지와 손이 공에 닿은 위치가 판정을 나눈다.',
    notation: 'SOURCE → AREA → HAND',
    searchIntents: ['골키퍼가 공을 잡았는데 왜 반칙', '골키퍼 손 반칙', '백패스 손으로 잡기', '페널티지역 밖 핸드볼', '골키퍼 8초'],
  },
  'offside-questions-and-answers': {
    code: 'OFFSIDE',
    shortCode: 'PASS → TOUCH',
    question: '깃발은 왜 골이 들어간 뒤에야 올라갔을까?',
    clue: '공을 받은 때가 아니라 패스가 출발한 순간',
    verdict: '위치만으로 끝나지 않고 그 선수가 플레이에 관여했는지까지 본다.',
    notation: 'POSITION → INVOLVEMENT',
    searchIntents: ['골 넣고 깃발이 늦게 올라간 이유', '오프사이드 깃발 지연', '득점 뒤 오프사이드', 'VAR 오프사이드', '패스 순간 위치'],
  },
};

const fallbackFile = (entry: CollectionEntry<'articles'>): MatchFile => ({
  code: 'MATCH QUESTION',
  shortCode: 'WHY?',
  question: entry.data.title,
  clue: entry.data.tags?.[0] ?? '판정을 가른 장면',
  verdict: entry.data.description,
  notation: 'SCENE → CLUE → VERDICT',
  searchIntents: entry.data.tags ?? [],
});

const fileFor = (entry: CollectionEntry<'articles'>) => matchFiles[entry.id] ?? fallbackFile(entry);
const leadFile = lead ? fileFor(lead) : undefined;
---

<div class="easy-index">
  <header class="easy-masthead">
    <div>
      <p>BBINGE FC · FOOTBALL EXPLAINED</p>
      <h1>축떡</h1>
    </div>
    <p class="easy-masthead__manifesto">
      <strong>FOOTBALL,<br />MADE CLEAR.</strong>
      <span>경기는 계속됩니다. 놓친 판정은 여기서 따라잡습니다.</span>
    </p>
  </header>

  {description && <p class="easy-intro">{description}</p>}

  {lead && leadFile ? (
    <section class="easy-lead" aria-labelledby="easy-lead-title">
      <a class="easy-lead__image" href={hrefFor(lead)}>
        {imageFor(lead) && (
          <img src={imageFor(lead)} alt={lead.data.coverImageAlt ?? ''} style={imageFocusStyle(imageFor(lead))} />
        )}
        <span class="easy-lead__live"><i></i> LIVE QUESTION</span>
        <span class="easy-lead__sequence">FILE {String(entries.length).padStart(2, '0')}</span>
      </a>

      <div class="easy-lead__desk">
        <div class="easy-lead__scoreline">
          <span>{leadFile.code}</span>
          <strong>{leadFile.shortCode}</strong>
        </div>
        <p class="easy-lead__eyebrow">지금 화면에서 놓친 질문</p>
        <h2 id="easy-lead-title"><a href={hrefFor(lead)}>{leadFile.question}</a></h2>
        <p class="easy-lead__answer">{lead.data.description}</p>
        <dl>
          <div>
            <dt>판정을 가른 단서</dt>
            <dd>{leadFile.clue}</dd>
          </div>
          <div>
            <dt>짧은 답</dt>
            <dd>{leadFile.verdict}</dd>
          </div>
        </dl>
        <a class="easy-lead__cta" href={hrefFor(lead)}>
          <span>장면의 순서로 납득하기</span>
          <i aria-hidden="true">→</i>
        </a>
      </div>
    </section>
  ) : <p class="easy-empty">아직 설명할 장면을 준비하고 있어요.</p>}

  {entries.length > 0 && (
    <section class="easy-library" aria-labelledby="easy-library-title" data-easy-library>
      <div class="easy-library__head">
        <div>
          <p>ASK BBINGE</p>
          <h2 id="easy-library-title">님들 궁금한 거 다 풀어드림</h2>
        </div>
        <div class="easy-search">
          <label for="easy-question-search">축떡 글 검색</label>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
          <input id="easy-question-search" type="search" placeholder="뭐든 검색해봐요! (대신 제가 쓴 것만 나와요.. ㄱ-..)" autocomplete="off" aria-controls="easy-library-list" />
        </div>
      </div>
      <p class="easy-library__call" hidden data-easy-call>아마 이런 걸 찾으시는 것 같아요..!</p>
      <section class="easy-library__tier" data-easy-primary aria-labelledby="easy-primary-title">
        <div class="easy-library__tier-head" hidden data-easy-primary-head>
          <span>1순위</span>
          <h3 id="easy-primary-title">가장 가까운 결과</h3>
        </div>
        <div class="easy-library__list" id="easy-library-list" data-easy-primary-list>
        {entries.map((entry) => {
          const file = fileFor(entry);
          const searchText = [entry.data.title, entry.data.description, ...(entry.data.tags ?? []), file.question, file.clue, file.verdict, ...file.searchIntents].join(' ');
          return (
            <article
              class="easy-library__item"
              data-search={searchText}
              data-title={entry.data.title}
              data-summary={[entry.data.description, file.question, file.verdict, ...file.searchIntents].join(' ')}
            >
              <a href={hrefFor(entry)}>
                <span class="easy-library__thumb">
                  {imageFor(entry) && <img src={imageFor(entry)} alt="" loading="lazy" style={imageFocusStyle(imageFor(entry))} />}
                </span>
                <span class="easy-library__copy">
                  <strong>{entry.data.title}</strong>
                  <span>{entry.data.description}</span>
                </span>
              </a>
            </article>
          );
        })}
        </div>
      </section>
      <section class="easy-library__tier easy-library__tier--secondary" hidden data-easy-secondary aria-labelledby="easy-secondary-title">
        <div class="easy-library__tier-head">
          <span>2순위</span>
          <h3 id="easy-secondary-title">함께 보면 좋은 결과</h3>
        </div>
        <div class="easy-library__list" data-easy-secondary-list></div>
      </section>
      <p class="easy-library__empty" hidden data-easy-empty>아직 이 질문을 풀어놓은 글이 없어요.</p>
      <span class="sr-only" aria-live="polite" data-easy-status></span>
    </section>
  )}
</div>

<script>
  const library = document.querySelector<HTMLElement>('[data-easy-library]');
  const input = library?.querySelector<HTMLInputElement>('#easy-question-search');
  const items = Array.from(library?.querySelectorAll<HTMLElement>('[data-search]') ?? []);
  const primaryList = library?.querySelector<HTMLElement>('[data-easy-primary-list]');
  const secondaryList = library?.querySelector<HTMLElement>('[data-easy-secondary-list]');
  const primaryHead = library?.querySelector<HTMLElement>('[data-easy-primary-head]');
  const secondary = library?.querySelector<HTMLElement>('[data-easy-secondary]');
  const call = library?.querySelector<HTMLElement>('[data-easy-call]');
  const empty = library?.querySelector<HTMLElement>('[data-easy-empty]');
  const status = library?.querySelector<HTMLElement>('[data-easy-status]');

  const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase('ko-KR').replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
  const compact = (value: string) => normalize(value).replace(/\s+/g, '');
  const bigrams = (value: string) => {
    const chars = compact(value);
    if (chars.length < 2) return chars ? [chars] : [];
    return Array.from({ length: chars.length - 1 }, (_, index) => chars.slice(index, index + 2));
  };
  const similarity = (left: string, right: string) => {
    const a = bigrams(left);
    const b = bigrams(right);
    if (!a.length || !b.length) return 0;
    const pool = [...b];
    let overlap = 0;
    a.forEach((pair) => {
      const index = pool.indexOf(pair);
      if (index >= 0) { overlap += 1; pool.splice(index, 1); }
    });
    return (2 * overlap) / (a.length + b.length);
  };
  const tokensFor = (value: string) => normalize(value).split(/\s+/)
    .map((token) => token.length > 2 ? token.replace(/(에서|으로|에게|한테|부터|까지|처럼|보다|하고|이며|이고|이라면|라면|인가요|이야|은|는|이|가|을|를|의|와|과|도|로)$/u, '') : token)
    .filter((token) => token.length > 1 && !['왜', '뭐', '어떤', '이런', '저런', '그런', '인가요', '축구'].includes(token));

  const reset = () => {
    items.forEach((item) => { item.hidden = false; primaryList?.append(item); });
    if (primaryHead) primaryHead.hidden = true;
    if (secondary) secondary.hidden = true;
    if (call) call.hidden = true;
    if (empty) empty.hidden = true;
    if (status) status.textContent = '';
  };

  const render = () => {
    const query = input?.value.trim() ?? '';
    if (!query) { reset(); return; }
    const q = normalize(query);
    const tokens = tokensFor(q);
    const ranked = items.map((item, order) => {
      const title = normalize(item.dataset.title ?? '');
      const summary = normalize(item.dataset.summary ?? '');
      const context = normalize(item.dataset.search ?? '');
      let hits = 0;
      let score = title === q ? 1000 : title.includes(q) ? 520 : summary.includes(q) ? 330 : context.includes(q) ? 180 : 0;
      tokens.forEach((token) => {
        if (title.includes(token)) { score += 110; hits += 1; }
        else if (summary.includes(token)) { score += 72; hits += 1; }
        else if (context.includes(token)) { score += 36; hits += 1; }
      });
      score += similarity(q, title) * 110 + similarity(q, summary) * 150 + similarity(q, context) * 70;
      return { item, order, hits, score };
    }).sort((a, b) => b.score - a.score || b.hits - a.hits || a.order - b.order);
    const relevant = ranked.filter((result) => result.hits > 0 || result.score >= 30);
    items.forEach((item) => { item.hidden = true; });

    if (!relevant.length) {
      if (primaryHead) primaryHead.hidden = true;
      if (secondary) secondary.hidden = true;
      if (call) call.hidden = true;
      if (empty) empty.hidden = false;
      if (status) status.textContent = '아직 이 질문을 풀어놓은 글이 없습니다.';
      return;
    }

    const [closest, ...candidates] = relevant;
    const related = candidates.filter((result) => result.score >= Math.max(42, closest.score * .3));
    closest.item.hidden = false;
    primaryList?.append(closest.item);
    related.slice(0, 4).forEach(({ item }) => { item.hidden = false; secondaryList?.append(item); });
    if (primaryHead) primaryHead.hidden = false;
    if (secondary) secondary.hidden = related.length === 0;
    if (call) call.hidden = false;
    if (empty) empty.hidden = true;
    if (status) status.textContent = `${Math.min(relevant.length, 5)}개의 축떡 글을 순서대로 찾았습니다.`;
  };

  input?.addEventListener('input', render);
</script>

<style>
  .easy-index { max-width:1180px; margin:0 auto; padding:34px 20px 76px; }
  .easy-masthead { display:flex; align-items:end; justify-content:space-between; gap:30px; padding-bottom:23px; border-bottom:3px solid var(--bbfc-ink); }
  .easy-masthead>div>p { color:var(--bbfc-blue); font-size:9px; font-weight:760; letter-spacing:.17em; }
  .easy-masthead h1 { margin-top:7px; font-size:clamp(52px,8vw,94px); line-height:.88; font-weight:820; letter-spacing:-.075em; }
  .easy-masthead__manifesto { display:grid; justify-items:end; text-align:right; }
  .easy-masthead__manifesto strong { font-size:16px; line-height:1.05; letter-spacing:.02em; }
  .easy-masthead__manifesto span { margin-top:8px; color:var(--bbfc-gray-2); font-size:11px; }
  .easy-intro { width:100%; max-width:none; margin:19px 0 31px; color:var(--bbfc-gray-1); font-size:13px; line-height:1.8; text-wrap:pretty; }

  .easy-lead { display:grid; grid-template-columns:minmax(0,1.08fr) minmax(350px,.92fr); min-height:540px; border-top:1px solid var(--bbfc-border); border-bottom:1px solid var(--bbfc-border); }
  .easy-lead__image { position:relative; display:block; min-height:100%; overflow:hidden; background:var(--bbfc-fill); }
  .easy-lead__image::after { content:""; position:absolute; inset:0; background:linear-gradient(180deg,rgba(25,31,40,.03) 46%,rgba(25,31,40,.55)); pointer-events:none; }
  .easy-lead__image img { width:100%; height:100%; object-fit:cover; transition:transform .55s cubic-bezier(.22,1,.36,1); }
  .easy-lead__image:hover img { transform:scale(1.018); }
  .easy-lead__live { position:absolute; z-index:1; top:19px; left:19px; display:flex; align-items:center; gap:7px; padding:7px 10px; background:var(--bbfc-blue); color:white; font-size:8px; font-weight:780; letter-spacing:.14em; }
  .easy-lead__live i { width:5px; height:5px; border-radius:50%; background:white; box-shadow:0 0 0 3px rgba(255,255,255,.22); animation:easy-live 2.4s ease-in-out infinite; }
  .easy-lead__sequence { position:absolute; z-index:1; right:19px; bottom:17px; color:white; font-size:10px; font-weight:760; letter-spacing:.18em; text-shadow:0 2px 12px rgba(25,31,40,.7); }
  .easy-lead__desk { position:relative; display:flex; flex-direction:column; justify-content:center; overflow:hidden; padding:34px 36px 32px; background-color:#16351e; background-image:linear-gradient(90deg,rgba(8,35,12,.38),rgba(47,92,39,.1) 50%,rgba(8,35,12,.38)),url('/images/football-made-easy/pitch-notes/grass-texture.webp'); background-size:auto,360px 360px; color:#f7f4e8; }
  .easy-lead__desk::before { content:""; position:absolute; top:-12%; right:-25%; width:58%; aspect-ratio:1/1; border:2px solid rgba(247,244,232,.28); border-radius:50%; pointer-events:none; }
  .easy-lead__desk::after { content:""; position:absolute; top:0; right:4px; bottom:0; width:2px; background:rgba(247,244,232,.24); pointer-events:none; }
  .easy-lead__desk>* { position:relative; z-index:1; }
  .easy-lead__scoreline { display:flex; align-items:end; justify-content:space-between; gap:18px; padding-bottom:12px; border-bottom:1px solid rgba(247,244,232,.38); }
  .easy-lead__scoreline span { color:#c8e56f; font-size:9px; font-weight:780; letter-spacing:.16em; }
  .easy-lead__scoreline strong { color:#f7f4e8; font-size:17px; line-height:1; font-weight:780; letter-spacing:.08em; }
  .easy-lead__eyebrow { margin-top:24px; color:#c8e56f; font-size:9px; font-weight:760; letter-spacing:.14em; }
  .easy-lead h2 { margin-top:11px; max-width:470px; color:#f7f4e8; font-size:clamp(29px,3.2vw,43px); line-height:1.14; font-weight:760; letter-spacing:-.047em; text-wrap:balance; }
  .easy-lead__answer { margin-top:16px; color:rgba(247,244,232,.78); font-size:12.5px; line-height:1.72; }
  .easy-lead dl { margin-top:21px; border-top:1px solid rgba(247,244,232,.23); }
  .easy-lead dl div { display:grid; grid-template-columns:105px minmax(0,1fr); gap:14px; padding:10px 0; border-bottom:1px solid rgba(247,244,232,.23); }
  .easy-lead dt { color:#c8e56f; font-size:9px; font-weight:760; letter-spacing:.08em; }
  .easy-lead dd { margin:0; color:#f7f4e8; font-size:11.5px; line-height:1.55; }
  .easy-lead__cta { display:flex; align-items:center; justify-content:space-between; gap:18px; margin-top:22px; color:#f7f4e8; font-size:13.5px; font-weight:720; }
  .easy-lead__cta i { display:grid; width:35px; height:35px; flex:0 0 auto; place-items:center; border:1px solid rgba(247,244,232,.5); border-radius:50%; color:#c8e56f; font-size:17px; font-style:normal; transition:transform .3s ease,background-color .3s ease; }
  .easy-lead__cta:hover i { background:rgba(247,244,232,.12); transform:translateX(4px); }

  .easy-library { margin-top:64px; }
  .easy-library__head { display:grid; grid-template-columns:minmax(0,1fr) minmax(280px,370px); align-items:end; gap:32px; padding-bottom:17px; border-bottom:1px solid var(--bbfc-ink); }
  .easy-library__head>div:first-child { display:flex; align-items:baseline; gap:12px; min-width:0; }
  .easy-library__head>div:first-child p { flex:0 0 auto; color:var(--bbfc-blue); font-size:9px; font-weight:760; letter-spacing:.15em; }
  .easy-library__head h2 { font-size:25px; line-height:1.25; font-weight:720; letter-spacing:-.035em; text-wrap:balance; }
  .easy-search { position:relative; z-index:1; display:flex; align-items:center; align-self:center; width:100%; height:48px; padding:0 17px; border:1px solid rgba(139,149,161,.26); border-radius:999px; background:rgba(255,255,255,.76); box-shadow:0 15px 34px -24px rgba(25,31,40,.38),inset 0 1px rgba(255,255,255,.96); backdrop-filter:blur(18px) saturate(115%); animation:easy-search-float 5.2s ease-in-out infinite; }
  .easy-search label { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); clip-path:inset(50%); white-space:nowrap; }
  .easy-search svg { width:18px; height:18px; flex:0 0 auto; fill:none; stroke:var(--bbfc-gray-2); stroke-width:1.7; transition:stroke .25s ease; }
  .easy-search input { width:100%; min-width:0; height:100%; padding:0 3px 0 11px; border:0; outline:0; background:transparent; color:var(--bbfc-ink); font:inherit; font-size:13px; }
  .easy-search input::placeholder { color:var(--bbfc-gray-2); }
  .easy-search:focus-within { border-color:rgba(49,130,246,.38); box-shadow:0 17px 38px -25px rgba(25,31,40,.4),inset 0 1px rgba(255,255,255,.96); }
  .easy-search:focus-within svg { stroke:var(--bbfc-blue); }
  .easy-library__call { margin:30px 0 6px; color:var(--bbfc-ink); font-size:20px; line-height:1.35; font-weight:720; letter-spacing:-.035em; }
  .easy-library__call[hidden],.easy-library__tier[hidden],.easy-library__tier-head[hidden] { display:none; }
  .easy-library__tier { margin-top:24px; }
  .easy-library__tier--secondary { margin-top:42px; }
  .easy-library__tier-head { display:flex; align-items:baseline; gap:11px; padding-bottom:10px; border-bottom:1px solid var(--bbfc-ink); }
  .easy-library__tier-head span { color:var(--bbfc-blue); font-size:9px; line-height:1; font-weight:780; letter-spacing:.15em; }
  .easy-library__tier-head h3 { color:var(--bbfc-ink); font-size:16px; line-height:1.3; font-weight:720; letter-spacing:-.025em; }
  .easy-library__list { border-bottom:1px solid var(--bbfc-border); }
  .easy-library__item { border-top:1px solid var(--bbfc-border); }
  .easy-library__item:first-child { border-top:0; }
  .easy-library__item[hidden] { display:none; }
  .easy-library__item>a { display:grid; grid-template-columns:220px minmax(0,1fr); align-items:center; gap:25px; padding:18px 0; }
  .easy-library__thumb { display:block; aspect-ratio:16/9; overflow:hidden; border-radius:10px; background:var(--bbfc-fill); }
  .easy-library__thumb img { width:100%; height:100%; object-fit:cover; transition:transform .42s ease; }
  .easy-library__copy { display:grid; gap:9px; min-width:0; }
  .easy-library__copy>strong { color:var(--bbfc-ink); font-size:18px; line-height:1.4; font-weight:680; letter-spacing:-.028em; text-wrap:balance; }
  .easy-library__copy>span { max-width:760px; color:var(--bbfc-gray-1); font-size:13px; line-height:1.7; }
  .easy-library__item>a:hover .easy-library__thumb img { transform:scale(1.025); }
  .easy-library__empty { padding:58px 0; border-bottom:1px solid var(--bbfc-border); color:var(--bbfc-gray-2); font-size:13px; text-align:center; }
  .easy-empty { padding:70px 0; color:var(--bbfc-gray-2); text-align:center; }
  .easy-lead__image:focus-visible,.easy-lead__cta:focus-visible,.easy-library__item>a:focus-visible { outline:2px solid var(--bbfc-blue); outline-offset:5px; }

