---
import ArticleCardGrid from './ArticleCardGrid.astro';
import AdSlot from './AdSlot.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'articles'>[];
  emptyMessage?: string;
}

const { entries, emptyMessage = '아직 등록된 글이 없어요.' } = Astro.props;

---

<ArticleCardGrid entries={entries} adEvery={5} emptyMessage={emptyMessage} />
{entries.length > 0 && entries.length <= 5 && <AdSlot />}
