---
import ArticleCard from './ArticleCard.astro';
import AdSlot from './AdSlot.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'articles'>[];
  emptyMessage?: string;
}

const { entries, emptyMessage = '아직 등록된 글이 없어요.' } = Astro.props;
---

{entries.length === 0 ? (
  <p class="text-[13px] text-[var(--bbfc-gray-1)] py-10 text-center">{emptyMessage}</p>
) : (
  <>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
      {entries.map((entry) => (
        <ArticleCard entry={entry} />
      ))}
    </div>
    <AdSlot />
  </>
)}
