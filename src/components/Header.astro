---
import { getTopLevel } from '../config/categories';
import CategorySidebar from './CategorySidebar.astro';

const currentPath = Astro.url.pathname;
const topCategories = getTopLevel();
const primaryNav = [
  { href: '/', label: 'MAIN', active: currentPath === '/' },
  { href: '/about/', label: '저자 @삥이', active: currentPath.startsWith('/about/') },
  ...topCategories.flatMap(({ slug, label }) => {
    const item = { href: `/${slug}/`, label, active: currentPath.startsWith(`/${slug}/`) };
    return slug === 'pilgrimage'
      ? [item, { href: '/archive/', label: '삥이 아카이브', active: currentPath.startsWith('/archive/') }]
      : [item];
  }),
];
---

<header class="sticky top-0 z-30 bg-[var(--bbfc-bg)] border-b border-[var(--bbfc-line)]">
  <div class="max-w-[1040px] mx-auto px-4 md:px-5 h-14 flex items-center justify-between">
    <div class="flex items-center gap-6">
      <button
        id="bbfc-menu-btn"
        type="button"
        aria-label="카테고리 메뉴 열기"
        aria-expanded="false"
        aria-controls="bbfc-drawer"
        class="md:hidden text-[var(--bbfc-gray-1)]"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
      </button>

      <a href="/" class="text-[17px] font-medium tracking-tight text-[var(--bbfc-ink)]">
        삥이<span class="text-[var(--bbfc-blue)]">FC</span>
      </a>

      <nav class="hidden md:flex items-center gap-4" aria-label="주요 메뉴">
        {primaryNav.map(({ href, label, active }) => (
            <a
              href={href}
              class:list={[
                'text-[13px] whitespace-nowrap',
                active ? 'text-[var(--bbfc-blue)] font-medium' : 'text-[var(--bbfc-ink-2)] font-normal',
              ]}
            >
              {label}
            </a>
        ))}
      </nav>
    </div>

    <a href="/search/" aria-label="검색" class="text-[var(--bbfc-gray-1)]">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7" />
        <path d="M21 21l-4.35-4.35" stroke-linecap="round" />
      </svg>
    </a>
  </div>
</header>

<div
  id="bbfc-overlay"
  class="fixed inset-0 bg-black/40 opacity-0 pointer-events-none transition-opacity duration-200 md:hidden z-40"
  hidden
>
</div>

<div
  id="bbfc-drawer"
  class="fixed top-0 left-0 bottom-0 w-[230px] bg-[var(--bbfc-bg)] -translate-x-full transition-transform duration-200 md:hidden overflow-y-auto p-4 z-50"
  hidden
>
  <div class="flex items-center justify-between mb-4">
    <span class="text-[14px] font-medium text-[var(--bbfc-ink)]">메뉴</span>
    <button id="bbfc-close-btn" type="button" aria-label="메뉴 닫기" class="text-[var(--bbfc-gray-1)]">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <ul class="space-y-1 mb-4 pb-4 border-b border-[var(--bbfc-line)]">
    {primaryNav.map(({ href, label, active }) => (
      <li>
        <a
          href={href}
          class:list={['block text-[13.5px] py-2', active ? 'text-[var(--bbfc-blue)] font-medium' : 'text-[var(--bbfc-ink-2)]']}
        >
          {label}
        </a>
      </li>
    ))}
    <li>
      <a href="/search/" class="block text-[13.5px] py-2 text-[var(--bbfc-ink-2)]">검색</a>
    </li>
  </ul>
  <CategorySidebar activeSlug={currentPath.split('/').filter(Boolean)[0]} />
</div>

<script>
  const menuBtn = document.getElementById('bbfc-menu-btn');
  const closeBtn = document.getElementById('bbfc-close-btn');
  const drawer = document.getElementById('bbfc-drawer');
  const overlay = document.getElementById('bbfc-overlay');

  function openDrawer() {
    drawer?.removeAttribute('hidden');
    overlay?.removeAttribute('hidden');
    requestAnimationFrame(() => {
      drawer?.classList.remove('-translate-x-full');
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
    });
    menuBtn?.setAttribute('aria-expanded', 'true');
  }

  function closeDrawer() {
    drawer?.classList.add('-translate-x-full');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    menuBtn?.setAttribute('aria-expanded', 'false');
    setTimeout(() => {
      drawer?.setAttribute('hidden', '');
      overlay?.setAttribute('hidden', '');
    }, 200);
  }

  menuBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
</script>
