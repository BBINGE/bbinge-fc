---
import CategoryNav from './CategoryNav.astro';
import { site } from '../config/site';
---

<header class="bg-[var(--bbfc-dark)]">
  <div class="flex items-center justify-between px-4 md:px-6 h-14">
    <button
      id="bbfc-menu-btn"
      type="button"
      aria-label="카테고리 메뉴 열기"
      aria-expanded="false"
      aria-controls="bbfc-drawer"
      class="md:hidden text-[#c9cdd2]"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
      </svg>
    </button>

    <a href="/" class="text-[17px] font-medium text-white tracking-wide">{site.name}</a>

    <span class="w-5 md:hidden" aria-hidden="true"></span>
  </div>
</header>

<div
  id="bbfc-overlay"
  class="fixed inset-0 bg-black/40 opacity-0 pointer-events-none transition-opacity duration-200 md:hidden"
  hidden
>
</div>

<div
  id="bbfc-drawer"
  class="fixed top-0 left-0 bottom-0 w-[230px] bg-[var(--bbfc-bg)] -translate-x-full transition-transform duration-200 md:hidden overflow-y-auto p-4"
  hidden
>
  <div class="flex items-center justify-between mb-4">
    <span class="text-[14px] font-medium">카테고리</span>
    <button id="bbfc-close-btn" type="button" aria-label="메뉴 닫기">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <CategoryNav />
</div>

<script>
  const menuBtn = document.getElementById('bbfc-menu-btn');
  const closeBtn = document.getElementById('bbfc-close-btn');
  const drawer = document.getElementById('bbfc-drawer');
  const overlay = document.getElementById('bbfc-overlay');

  function openDrawer() {
    drawer?.removeAttribute('hidden');
    overlay?.removeAttribute('hidden');
    requestAnimationFrame(() => {
      drawer?.classList.remove('-translate-x-full');
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
    });
    menuBtn?.setAttribute('aria-expanded', 'true');
  }

  function closeDrawer() {
    drawer?.classList.add('-translate-x-full');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    menuBtn?.setAttribute('aria-expanded', 'false');
    setTimeout(() => {
      drawer?.setAttribute('hidden', '');
      overlay?.setAttribute('hidden', '');
    }, 200);
  }

  menuBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
</script>
