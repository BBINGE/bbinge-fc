---
import { getAncestorChain, getTopLevel } from '../config/categories';
import CategorySidebar from './CategorySidebar.astro';
import { getCollection } from 'astro:content';
import { isRecentlyChanged } from '../utils/freshness';

const currentPath = Astro.url.pathname;
const topCategories = getTopLevel();
const [articles, archiveRecords] = await Promise.all([
  getCollection('articles', ({ data }) => !data.draft),
  getCollection('archive', ({ data }) => !data.draft),
]);
const freshTopCategories = new Set(
  articles
    .filter((article) => isRecentlyChanged(article.data.pubDate, article.data.updatedDate))
    .map((article) => getAncestorChain(article.data.category)[0]?.slug)
    .filter(Boolean)
);
const archiveIsFresh = archiveRecords.some((record) => isRecentlyChanged(record.data.pubDate, record.data.updatedDate));
const primaryNav = [
  { href: '/', label: 'MAIN', active: currentPath === '/', isNew: false },
  { href: '/about/', label: '저자 @삥이', active: currentPath.startsWith('/about/'), isNew: false },
  ...topCategories.flatMap(({ slug, label }) => {
    const item = { href: `/${slug}/`, label, active: currentPath.startsWith(`/${slug}/`), isNew: freshTopCategories.has(slug) };
    return slug === 'pilgrimage'
      ? [item, { href: '/archive/', label: '삥이 아카이브', active: currentPath.startsWith('/archive/'), isNew: archiveIsFresh }]
      : [item];
  }),
];
---

<header class="sticky top-0 z-30 bg-[var(--bbfc-bg)] border-b border-[var(--bbfc-line)]">
  <div class="max-w-[1040px] mx-auto px-4 md:px-5 h-14 md:h-16 flex items-center justify-between">
    <div class="flex items-center gap-6">
      <button
        id="bbfc-menu-btn"
        type="button"
        aria-label="카테고리 메뉴 열기"
        aria-expanded="false"
        aria-controls="bbfc-drawer"
        class="md:hidden text-[var(--bbfc-gray-1)]"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
      </button>

      <a href="/" class="text-[17px] font-medium tracking-tight text-[var(--bbfc-ink)]">
        삥이<span class="text-[var(--bbfc-blue)]">FC</span>
      </a>

      <nav class="hidden md:flex items-center gap-[18px]" aria-label="주요 메뉴">
        {primaryNav.map(({ href, label, active, isNew }) => href === '/about/' ? (
          <div class="about-nav">
            <a
              href={href}
              class:list={[
                'about-nav-trigger text-[14.5px] leading-none whitespace-nowrap transition-colors hover:text-[var(--bbfc-blue)]',
                active ? 'text-[var(--bbfc-blue)] font-semibold' : 'text-[var(--bbfc-ink-2)] font-medium',
              ]}
              aria-haspopup="true"
            >
              {label}
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" /></svg>
            </a>
            <div class="about-nav-menu">
              <a href="/about/"><span>AUTHOR</span><strong>저자 이야기</strong><small>박성호, 온라인에서는 삥이</small></a>
              <a href="/about/logo/"><span>IDENTITY</span><strong>로고 이야기</strong><small>P와 B, 하나의 저자명</small></a>
            </div>
          </div>
        ) : (
          <a
            href={href}
            class:list={[
              'text-[14.5px] leading-none whitespace-nowrap transition-colors hover:text-[var(--bbfc-blue)]',
              active ? 'text-[var(--bbfc-blue)] font-semibold' : 'text-[var(--bbfc-ink-2)] font-medium',
            ]}
          >
            {label}
            {isNew && <span class="nav-new">NEW</span>}
          </a>
        ))}
      </nav>
    </div>

    <a href="/search/" aria-label="검색" class="text-[var(--bbfc-gray-1)]">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7" />
        <path d="M21 21l-4.35-4.35" stroke-linecap="round" />
      </svg>
    </a>
  </div>
</header>

<div
  id="bbfc-overlay"
  class="fixed inset-0 bg-black/40 opacity-0 pointer-events-none transition-opacity duration-200 md:hidden z-40"
  hidden
>
</div>

<div
  id="bbfc-drawer"
  class="fixed top-0 left-0 bottom-0 w-[230px] bg-[var(--bbfc-bg)] -translate-x-full transition-transform duration-200 md:hidden overflow-y-auto p-4 z-50"
  hidden
>
  <div class="flex items-center justify-between mb-4">
    <span class="text-[14px] font-medium text-[var(--bbfc-ink)]">메뉴</span>
    <button id="bbfc-close-btn" type="button" aria-label="메뉴 닫기" class="text-[var(--bbfc-gray-1)]">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <ul class="space-y-1 mb-4 pb-4 border-b border-[var(--bbfc-line)]">
    {primaryNav.map(({ href, label, active, isNew }) => href === '/about/' ? (
      <li class="mobile-about">
        <details open={active}>
          <summary class:list={['text-[13.5px] py-2', active ? 'text-[var(--bbfc-blue)] font-medium' : 'text-[var(--bbfc-ink-2)]']}>{label}</summary>
          <div>
            <a href="/about/">저자 이야기</a>
            <a href="/about/logo/">로고 이야기</a>
          </div>
        </details>
      </li>
    ) : (
      <li>
        <a
          href={href}
          class:list={['block text-[13.5px] py-2', active ? 'text-[var(--bbfc-blue)] font-medium' : 'text-[var(--bbfc-ink-2)]']}
        >
          {label}
          {isNew && <span class="nav-new">NEW</span>}
        </a>
      </li>
    ))}
    <li>
      <a href="/search/" class="block text-[13.5px] py-2 text-[var(--bbfc-ink-2)]">검색</a>
    </li>
  </ul>
  <CategorySidebar activeSlug={currentPath.split('/').filter(Boolean)[0]} />
</div>

<style>
  .nav-new { margin-left: 4px; color: var(--bbfc-blue); font-size: 8px; font-weight: 750; letter-spacing: .06em; vertical-align: top; }
  .about-nav { position:relative; height:64px; display:flex; align-items:center; }
  .about-nav-trigger { display:flex; align-items:center; gap:4px; }
  .about-nav-trigger svg { width:11px; height:11px; fill:none; stroke:currentColor; stroke-width:1.4; transition:transform 160ms ease; }
  .about-nav-menu { position:absolute; top:56px; left:-18px; width:238px; padding:8px; border:1px solid var(--bbfc-border); border-radius:12px; background:#fff; box-shadow:0 18px 42px -24px rgba(25,31,40,.38); opacity:0; visibility:hidden; transform:translateY(-5px); transition:opacity 150ms ease,transform 150ms ease,visibility 150ms; }
  .about-nav:hover .about-nav-menu,.about-nav:focus-within .about-nav-menu { opacity:1; visibility:visible; transform:translateY(0); }
  .about-nav:hover .about-nav-trigger svg,.about-nav:focus-within .about-nav-trigger svg { transform:rotate(180deg); }
  .about-nav-menu a { display:grid; padding:12px; border-radius:8px; transition:background 140ms ease; }
  .about-nav-menu a:hover,.about-nav-menu a:focus-visible { background:var(--bbfc-fill-2); outline:none; }
  .about-nav-menu span { color:var(--bbfc-blue); font-size:8px; font-weight:700; letter-spacing:.15em; }
  .about-nav-menu strong { margin-top:4px; color:var(--bbfc-ink); font-size:13px; font-weight:650; }
  .about-nav-menu small { margin-top:3px; color:var(--bbfc-gray-2); font-size:10.5px; }
  .mobile-about summary { display:flex; align-items:center; justify-content:space-between; list-style:none; cursor:pointer; }
  .mobile-about summary::-webkit-details-marker { display:none; }
  .mobile-about summary::after { content:'+'; color:var(--bbfc-gray-2); font-size:15px; font-weight:400; }
  .mobile-about details[open] summary::after { content:'−'; }
  .mobile-about details div { margin:0 0 5px 8px; padding:2px 0 3px 12px; border-left:1px solid var(--bbfc-border); }
  .mobile-about details div a { display:block; padding:7px 0; color:var(--bbfc-gray-1); font-size:12.5px; }
</style>

<script>
  const menuBtn = document.getElementById('bbfc-menu-btn');
  const closeBtn = document.getElementById('bbfc-close-btn');
  const drawer = document.getElementById('bbfc-drawer');
  const overlay = document.getElementById('bbfc-overlay');

  function openDrawer() {
    drawer?.removeAttribute('hidden');
    overlay?.removeAttribute('hidden');
    requestAnimationFrame(() => {
      drawer?.classList.remove('-translate-x-full');
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
    });
    menuBtn?.setAttribute('aria-expanded', 'true');
  }

  function closeDrawer() {
    drawer?.classList.add('-translate-x-full');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    menuBtn?.setAttribute('aria-expanded', 'false');
    setTimeout(() => {
      drawer?.setAttribute('hidden', '');
      overlay?.setAttribute('hidden', '');
    }, 200);
  }

  menuBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
</script>
