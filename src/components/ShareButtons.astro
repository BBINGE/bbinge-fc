---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const xShareUrl = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const facebookShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const naverShareUrl = `https://share.naver.com/web/shareView?url=${encodedUrl}&title=${encodedTitle}`;
---

<section class="share-panel" aria-labelledby="share-title" data-share-url={url} data-share-title={title}>
  <div class="share-copy">
    <span aria-hidden="true">💙</span>
    <div>
      <h2 id="share-title">이 글이 좋았다면 공유해 주세요!</h2>
      <p>함께 읽고 싶은 사람에게 삥이FC를 보내주세요.</p>
    </div>
  </div>
  <div class="share-actions" aria-label="글 공유 방법">
    <button type="button" data-share-kakao aria-label="카카오톡으로 공유">
      <img src="/images/share/kakaotalk.png" alt="" width="44" height="44" loading="lazy" />
      <span>카카오톡</span>
    </button>
    <button type="button" data-share-instagram aria-label="인스타그램으로 공유">
      <img src="/images/about-logos/instagram.svg" alt="" width="44" height="44" loading="lazy" />
      <span>인스타그램</span>
    </button>
    <a href={facebookShareUrl} target="_blank" rel="noopener noreferrer" aria-label="페이스북으로 공유">
      <img src="/images/share/facebook.png" alt="" width="44" height="44" loading="lazy" />
      <span>페이스북</span>
    </a>
    <a href={xShareUrl} target="_blank" rel="noopener noreferrer" aria-label="X 구 트위터로 공유">
      <img src="/images/share/x.png" alt="" width="44" height="44" loading="lazy" />
      <span>X(구 트위터)</span>
    </a>
    <a href={naverShareUrl} target="_blank" rel="noopener noreferrer" aria-label="네이버 블로그로 퍼가기">
      <img src="/images/about-logos/naver-blog.png" alt="" width="44" height="44" loading="lazy" />
      <span>네이버 블로그</span>
    </a>
    <button type="button" data-share-copy aria-label="링크 복사">
      <span class="link-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M10.6 13.4a4 4 0 0 0 5.7 0l2.1-2.1a4 4 0 0 0-5.7-5.7l-1.2 1.2M13.4 10.6a4 4 0 0 0-5.7 0l-2.1 2.1a4 4 0 0 0 5.7 5.7l1.2-1.2"/></svg></span>
      <span>링크복사</span>
    </button>
  </div>
  <p class="share-message" data-share-message aria-live="polite" hidden></p>
</section>

<script>
  function showMessage(el, text) {
    if (!(el instanceof HTMLElement)) return;
    el.hidden = false;
    el.textContent = text;
    setTimeout(() => { el.hidden = true; }, 2200);
  }

  async function copyLink(url) {
    try {
      await navigator.clipboard.writeText(url);
      return true;
    } catch {
      window.prompt('아래 링크를 복사하세요', url);
      return false;
    }
  }

  document.querySelectorAll('[data-share-url]').forEach((container) => {
    const url = container.getAttribute('data-share-url') || window.location.href;
    const title = container.getAttribute('data-share-title') || document.title;
    const message = container.querySelector('[data-share-message]');

    container.querySelector('[data-share-copy]')?.addEventListener('click', async () => {
      const copied = await copyLink(url);
      showMessage(message, copied ? '링크를 복사했어요! 💙' : '복사창에서 링크를 복사해 주세요.');
    });

    container.querySelector('[data-share-kakao]')?.addEventListener('click', async () => {
      const kakao = window.Kakao;
      if (kakao?.isInitialized?.()) {
        kakao.Share.sendDefault({
          objectType: 'feed',
          content: { title, description: title, link: { mobileWebUrl: url, webUrl: url } },
        });
        return;
      }
      const copied = await copyLink(url);
      showMessage(message, copied ? '카카오 연동 전이라 링크를 복사했어요! 💛' : '복사창에서 링크를 복사해 주세요.');
    });

    container.querySelector('[data-share-instagram]')?.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({ title, text: title, url });
          return;
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
        }
      }
      const copied = await copyLink(url);
      showMessage(message, copied ? '인스타그램에 붙여넣을 링크를 복사했어요! 💗' : '복사창에서 링크를 복사해 주세요.');
    });
  });
</script>

<style>
  .share-panel { position: relative; padding: 22px 0 4px; }
  .share-copy { display: flex; align-items: center; gap: 11px; }
  .share-copy > span { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--bbfc-blue-weak); font-size: 17px; }
  .share-copy h2 { font-size: 17px; line-height: 1.35; font-weight: 680; letter-spacing: -.02em; color: var(--bbfc-blue-strong); }
  .share-copy p { margin-top: 3px; font-size: 11.5px; line-height: 1.5; color: var(--bbfc-gray-2); }
  .share-actions { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; margin-top: 18px; }
  .share-actions button, .share-actions a { display: flex; min-width: 0; min-height: 82px; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 10px 5px; border: 1px solid var(--bbfc-border); border-radius: 14px; background: #fff; color: var(--bbfc-ink-2); font-size: 11px; line-height: 1.25; text-align: center; transition: border-color .15s ease, color .15s ease, transform .15s ease, box-shadow .15s ease; }
  .share-actions button:hover, .share-actions a:hover { border-color: var(--bbfc-blue); color: var(--bbfc-blue-strong); box-shadow: 0 5px 16px rgba(27, 102, 214, .08); transform: translateY(-2px); }
  .share-actions img, .link-icon { display: grid; width: 36px; height: 36px; flex: 0 0 36px; place-items: center; border-radius: 10px; object-fit: contain; }
  .share-actions a[href*="share.naver.com"] img { padding: 3px; border: 1px solid var(--bbfc-border); background: #fff; }
  .link-icon { background: var(--bbfc-blue-weak); color: var(--bbfc-blue-strong); }
  .link-icon svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .share-message { margin-top: 10px; font-size: 11px; color: var(--bbfc-blue-strong); }
  @media (max-width: 480px) {
    .share-panel { padding-top: 19px; }
    .share-copy h2 { font-size: 16px; }
    .share-copy p { display: none; }
    .share-actions { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .share-actions button, .share-actions a { min-height: 84px; padding: 9px 3px; }
  }
</style>
