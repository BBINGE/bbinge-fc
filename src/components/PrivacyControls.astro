---
interface Props {
  analyticsEligible?: boolean;
  adsEligible?: boolean;
}

const { analyticsEligible = true, adsEligible = true } = Astro.props;
const googleCmpEligible = adsEligible && Astro.url.pathname !== '/privacy/';
---

<section class="privacy-choice" data-privacy-panel hidden aria-labelledby="privacy-choice-title">
  <div class="privacy-choice__inner">
    <div class="privacy-choice__intro">
      <h2 id="privacy-choice-title">분석·광고 이용 여부를 정해주세요</h2>
      <p data-privacy-message>
        모두 동의하면 방문 분석과 Google 광고를 사용하고, 관련 이용 정보는 미국 등 국외로 이전됩니다.
        동의하지 않아도 모든 기사를 볼 수 있습니다. <a href="/privacy/">개인정보처리방침</a>
      </p>
    </div>
    <form data-privacy-form>
      <div class="privacy-choice__quick" data-privacy-quick>
        <button type="button" class="privacy-choice__button privacy-choice__button--primary" data-privacy-allow>모두 동의</button>
        <button type="button" class="privacy-choice__button" data-privacy-deny>필수 기능만 사용</button>
        <button type="button" class="privacy-choice__button" data-privacy-customize aria-controls="privacy-choice-details" aria-expanded="false">선택 설정</button>
      </div>
      <div id="privacy-choice-details" class="privacy-choice__details" data-privacy-details hidden>
        <fieldset class="privacy-choice__options" data-privacy-options>
          <legend>선택 항목별 설정</legend>
          <div class="privacy-choice__option">
            <label>
              <input type="checkbox" data-consent-analytics />
              <span><strong>방문 분석 수집·이용</strong> <em>선택</em></span>
            </label>
            <p>방문 페이지·유입 경로·이용 시간·기기 정보와 쿠키 식별자를 콘텐츠 및 제휴 성과 분석에 사용합니다. NAVER 데이터는 1년, Google은 이벤트 2개월·사용자 14개월 동안 보관합니다.</p>
          </div>
          <div class="privacy-choice__option">
            <label>
              <input type="checkbox" data-consent-google-transfer />
              <span><strong>Google 국외 이전</strong> <em>선택</em></span>
            </label>
            <p>식별자·IP·기기·방문·광고 기록을 Google LLC가 운영하는 미국 등 국가로 전송해 분석·광고 제공과 측정에 사용합니다. 분석 데이터는 2개월·14개월, 광고 데이터는 Google 정책에 따른 기간 동안 보관합니다.</p>
          </div>
          <div class="privacy-choice__option">
            <label>
              <input type="checkbox" data-consent-ads />
              <span><strong>Google 광고 쿠키</strong> <em>선택</em></span>
            </label>
            <p>본 사이트 또는 다른 사이트의 이전 방문 기록을 바탕으로 맞춤·비맞춤 광고를 제공하고 노출·성과를 측정합니다. Google 국외 이전에도 동의한 경우에만 작동합니다.</p>
          </div>
        </fieldset>
        <div class="privacy-choice__actions" data-privacy-actions>
          <button type="submit" class="privacy-choice__button privacy-choice__button--primary" data-privacy-save>선택 저장</button>
          <button type="button" class="privacy-choice__button" data-privacy-deny>필수 기능만 사용</button>
          <button type="button" class="privacy-choice__button" data-privacy-cancel>이전</button>
        </div>
      </div>
    </form>
    <button type="button" class="privacy-choice__button privacy-choice__close" data-privacy-close hidden>닫기</button>
  </div>
</section>

<script is:inline define:vars={{ analyticsEligible, adsEligible, googleCmpEligible }}>
  (() => {
    const STORAGE_KEY = 'bbfc_optional_data_choice_v2';
    const panel = document.querySelector('[data-privacy-panel]');
    const message = panel?.querySelector('[data-privacy-message]');
    const form = panel?.querySelector('[data-privacy-form]');
    const quick = panel?.querySelector('[data-privacy-quick]');
    const details = panel?.querySelector('[data-privacy-details]');
    const analyticsConsent = panel?.querySelector('[data-consent-analytics]');
    const googleTransferConsent = panel?.querySelector('[data-consent-google-transfer]');
    const adsConsent = panel?.querySelector('[data-consent-ads]');
    const allowButton = panel?.querySelector('[data-privacy-allow]');
    const customizeButton = panel?.querySelector('[data-privacy-customize]');
    const cancelButton = panel?.querySelector('[data-privacy-cancel]');
    const denyButtons = panel?.querySelectorAll('[data-privacy-deny]') ?? [];
    const closeButton = panel?.querySelector('[data-privacy-close]');
    if (!(panel instanceof HTMLElement) || !(message instanceof HTMLElement) || !(form instanceof HTMLFormElement)) return;

    let optionalScriptsAllowed = false;
    let consentSurface = 'disabled';
    let regionResolved = false;
    let googleAnalyticsActivated = false;
    let naverAnalyticsActivated = false;
    let adsActivated = false;

    const emptyChoice = () => ({ decided: false, analytics: false, googleTransfer: false, ads: false });

    const readChoice = () => {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (!stored) return emptyChoice();
        const parsed = JSON.parse(stored);
        return {
          decided: parsed?.decided === true,
          analytics: parsed?.analytics === true,
          googleTransfer: parsed?.googleTransfer === true,
          ads: parsed?.ads === true,
        };
      } catch { return emptyChoice(); }
    };
    const saveChoice = (choice) => {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(choice)); } catch {}
    };
    const loadScript = (src, attributes = {}) => new Promise((resolve, reject) => {
      if (document.querySelector(`script[src="${src}"]`)) return resolve();
      const script = document.createElement('script');
      script.src = src;
      script.async = true;
      Object.entries(attributes).forEach(([name, value]) => script.setAttribute(name, value));
      script.addEventListener('load', resolve, { once: true });
      script.addEventListener('error', reject, { once: true });
      document.head.appendChild(script);
    });

    const activateGoogleAnalytics = () => {
      if (!analyticsEligible || googleAnalyticsActivated) return;
      googleAnalyticsActivated = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', 'G-3931E0CPPK');
      loadScript('https://www.googletagmanager.com/gtag/js?id=G-3931E0CPPK').catch(() => {});

      if (!window.__bbfcAffiliateTrackingBound) {
        window.__bbfcAffiliateTrackingBound = true;
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const link = target.closest('[data-affiliate-link]');
          if (!(link instanceof HTMLAnchorElement) || typeof window.gtag !== 'function') return;
          window.gtag('event', 'affiliate_click', {
            affiliate_network: link.dataset.affiliateNetwork || '',
            merchant: link.dataset.affiliateMerchant || '',
            item_id: link.dataset.affiliateProduct || '',
            link_url: link.href,
          });
        });
      }

    };

    const activateNaverAnalytics = () => {
      if (!analyticsEligible || naverAnalyticsActivated) return;
      naverAnalyticsActivated = true;
      loadScript('https://wcs.pstatic.net/wcslog.js').then(() => {
        window.wcs_add = window.wcs_add || {};
        window.wcs_add.wa = '25cc1f313cc6800';
        if (window.wcs) window.wcs_do();
      }).catch(() => {});
    };

    const activateAds = () => {
      if (!adsEligible || adsActivated) return;
      adsActivated = true;
      loadScript(
        'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7649211764099932',
        { crossorigin: 'anonymous' },
      ).catch(() => {});
    };

    const openGoogleCmpSettings = () => {
      if (!googleCmpEligible) {
        window.location.href = '/?privacy-settings=google';
        return;
      }
      window.googlefc = window.googlefc || {};
      window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
      window.googlefc.callbackQueue.push({
        CONSENT_API_READY: () => window.googlefc?.showRevocationMessage?.(),
      });
    };

    const activateGoogleCmp = () => {
      if (!googleCmpEligible) return;
      const params = new URLSearchParams(window.location.search);
      if (params.get('privacy-settings') === 'google') openGoogleCmpSettings();
      activateAds();
    };

    const activateOptionalScripts = () => {
      if (!optionalScriptsAllowed) return;
      const choice = readChoice();
      if (!choice.decided) return;
      if (choice.analytics) activateNaverAnalytics();
      if (choice.analytics && choice.googleTransfer) activateGoogleAnalytics();
      if (choice.ads && choice.googleTransfer) activateAds();
    };

    const syncInputs = (choice) => {
      if (analyticsConsent instanceof HTMLInputElement) analyticsConsent.checked = choice.analytics;
      if (googleTransferConsent instanceof HTMLInputElement) googleTransferConsent.checked = choice.googleTransfer;
      if (adsConsent instanceof HTMLInputElement) adsConsent.checked = choice.ads;
    };

    const setDetailsState = (showDetails, choice) => {
      if (quick instanceof HTMLElement) quick.hidden = showDetails;
      if (details instanceof HTMLElement) details.hidden = !showDetails;
      if (customizeButton instanceof HTMLButtonElement) customizeButton.setAttribute('aria-expanded', String(showDetails));
      panel.dataset.view = showDetails ? 'details' : 'summary';
      if (cancelButton instanceof HTMLButtonElement) cancelButton.textContent = choice.decided ? '닫기' : '이전';
    };

    const setPanelState = (forceOpen = false, forceDetails = false) => {
      if (consentSurface === 'google-cmp') {
        panel.hidden = true;
        return;
      }
      const choice = readChoice();
      syncInputs(choice);
      if (!optionalScriptsAllowed) {
        message.innerHTML = '현재 접속 지역에서는 선택 분석·광고 스크립트를 불러오지 않습니다. 필수 보안·전송 기능만 작동합니다. 자세한 내용은 <a href="/privacy/">개인정보처리방침</a>에서 확인할 수 있습니다.';
        form.hidden = true;
        if (closeButton instanceof HTMLElement) closeButton.hidden = false;
      } else {
        message.innerHTML = choice.decided
          ? '저장된 선택을 항목별로 바꿀 수 있습니다. 동의를 철회하면 페이지를 다시 불러와 해당 스크립트를 즉시 차단합니다. 자세한 내용은 <a href="/privacy/">개인정보처리방침</a>에서 확인할 수 있습니다.'
          : '모두 동의하면 방문 분석과 Google 광고를 사용하고, 관련 이용 정보는 미국 등 국외로 이전됩니다. 동의하지 않아도 모든 기사를 볼 수 있습니다. <a href="/privacy/">개인정보처리방침</a>';
        form.hidden = false;
        if (closeButton instanceof HTMLElement) closeButton.hidden = true;
        setDetailsState(forceDetails || choice.decided, choice);
      }
      panel.hidden = !forceOpen && Boolean(choice.decided || !optionalScriptsAllowed);
    };

    const chooseAll = () => {
      saveChoice({ decided: true, analytics: true, googleTransfer: true, ads: true });
      syncInputs(readChoice());
      panel.hidden = true;
      activateOptionalScripts();
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const previousChoice = readChoice();
      const nextChoice = {
        decided: true,
        analytics: analyticsConsent instanceof HTMLInputElement && analyticsConsent.checked,
        googleTransfer: googleTransferConsent instanceof HTMLInputElement && googleTransferConsent.checked,
        ads: adsConsent instanceof HTMLInputElement && adsConsent.checked,
      };
      const requiresReload = previousChoice.decided && (
        (previousChoice.analytics && !nextChoice.analytics)
        || (previousChoice.googleTransfer && !nextChoice.googleTransfer)
        || (previousChoice.ads && !nextChoice.ads)
      );
      saveChoice(nextChoice);
      if (requiresReload) {
        window.location.reload();
        return;
      }
      panel.hidden = true;
      activateOptionalScripts();
    });
    allowButton?.addEventListener('click', chooseAll);
    denyButtons.forEach((button) => button.addEventListener('click', () => {
      const previousChoice = readChoice();
      saveChoice({ decided: true, analytics: false, googleTransfer: false, ads: false });
      if (previousChoice.analytics || previousChoice.googleTransfer || previousChoice.ads) {
        window.location.reload();
        return;
      }
      syncInputs(readChoice());
      panel.hidden = true;
    }));
    customizeButton?.addEventListener('click', () => setDetailsState(true, readChoice()));
    cancelButton?.addEventListener('click', () => {
      const choice = readChoice();
      if (choice.decided) panel.hidden = true;
      else setDetailsState(false, choice);
    });
    closeButton?.addEventListener('click', () => { panel.hidden = true; });
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest('[data-privacy-settings]')) return;
      event.preventDefault();
      if (consentSurface === 'google-cmp') {
        openGoogleCmpSettings();
        return;
      }
      setPanelState(true, true);
    });

    fetch('/api/privacy/region', { credentials: 'same-origin', cache: 'no-store' })
      .then((response) => response.ok ? response.json() : Promise.reject(new Error('region lookup failed')))
      .then((region) => {
        consentSurface = region?.consentSurface || 'disabled';
        optionalScriptsAllowed = consentSurface === 'site';
        regionResolved = true;
        setPanelState();
        if (consentSurface === 'google-cmp') activateGoogleCmp();
        else activateOptionalScripts();
      })
      .catch(() => {
        regionResolved = true;
        consentSurface = 'disabled';
        optionalScriptsAllowed = false;
        setPanelState();
      });

    window.addEventListener('pageshow', () => {
      if (regionResolved) setPanelState();
    });
  })();
</script>

<style>
  .privacy-choice {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 80;
    margin: 0 auto;
    max-width: 780px;
    max-height: calc(100dvh - 1.5rem);
    overflow-y: auto;
    border: 1px solid color-mix(in srgb, var(--bbfc-blue) 38%, var(--bbfc-border));
    border-radius: 16px;
    background: rgba(255, 255, 255, .98);
    box-shadow: 0 18px 48px rgba(15, 23, 42, .2);
  }
  .privacy-choice[hidden] { display: none; }
  .privacy-choice[data-view='details'] { max-width: 700px; max-height: min(64dvh, 560px); }
  .privacy-choice__inner { display: grid; gap: .65rem; padding: .8rem .9rem; }
  .privacy-choice h2 { color: var(--bbfc-ink); font-size: 17px; font-weight: 700; line-height: 1.35; }
  .privacy-choice p { margin-top: .25rem; color: var(--bbfc-gray-1); font-size: 13px; line-height: 1.5; }
  .privacy-choice a { color: var(--bbfc-blue-strong); text-decoration: underline; text-underline-offset: 3px; }
  .privacy-choice__quick,
  .privacy-choice__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .55rem; }
  .privacy-choice__options { margin: 0; padding: 0; border: 0; }
  .privacy-choice__options legend { width: 100%; padding-bottom: .4rem; color: var(--bbfc-ink); font-size: 14px; font-weight: 700; }
  .privacy-choice__option { padding: .55rem 0; border-top: 1px solid var(--bbfc-border); }
  .privacy-choice__option label { display: flex; align-items: center; min-height: 32px; gap: .6rem; cursor: pointer; }
  .privacy-choice__option input { flex: 0 0 auto; width: 23px; height: 23px; margin: 0; accent-color: var(--bbfc-blue-strong); }
  .privacy-choice__option strong { color: var(--bbfc-ink); font-size: 15px; line-height: 1.45; }
  .privacy-choice__option em { margin-left: .25rem; color: var(--bbfc-blue-strong); font-size: 13px; font-style: normal; }
  .privacy-choice__option p { margin: .2rem 0 0 2.05rem; font-size: 13px; line-height: 1.45; }
  .privacy-choice__button,
  .privacy-choice__close {
    min-height: 44px;
    padding: .65rem .9rem;
    border: 1px solid var(--bbfc-gray-3);
    border-radius: 10px;
    background: #fff;
    color: var(--bbfc-ink-2);
    font-size: 14px;
    font-weight: 650;
    line-height: 1.2;
    cursor: pointer;
  }
  .privacy-choice__button--primary { border-color: var(--bbfc-blue-strong); background: var(--bbfc-blue-strong); color: #fff; }
  .privacy-choice__close { justify-self: end; }
  @media (max-width: 560px) {
    .privacy-choice { right: .75rem; bottom: .75rem; left: .75rem; }
    .privacy-choice[data-view='details'] { max-height: 54dvh; }
    .privacy-choice__inner { padding: .75rem .8rem; }
    .privacy-choice__quick { display: grid; grid-template-columns: 1fr 1fr; }
    .privacy-choice__quick .privacy-choice__button:last-child { grid-column: 1 / -1; }
    .privacy-choice__actions { display: grid; grid-template-columns: 1fr 1fr; }
    .privacy-choice__actions .privacy-choice__button:first-child { grid-column: 1 / -1; }
  }
  @media (min-width: 900px) {
    .privacy-choice__inner { grid-template-columns: minmax(0, 1fr) auto; align-items: end; padding: .85rem 1rem; }
    .privacy-choice[data-view='details'] .privacy-choice__inner { grid-template-columns: 1fr; align-items: stretch; padding: .9rem 1rem; }
    .privacy-choice__quick,
    .privacy-choice__actions { justify-content: flex-end; }
  }
</style>
