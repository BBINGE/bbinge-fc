---
import type { CollectionEntry } from 'astro:content';
import { getArticlePath } from '../config/categories';
import { cultureSections, getCultureSectionPath, type CultureSection } from '../config/culture';
import { imageFocusStyle } from '../utils/imageFocus';

interface Props {
  entries: CollectionEntry<'articles'>[];
  section: CultureSection;
}

const { entries, section } = Astro.props;
const hall = cultureSections[section];
const [lead, ...rest] = entries;
const imageFor = (entry: CollectionEntry<'articles'>) => entry.data.cardImage ?? entry.data.coverImage;
---

<main class:list={['culture-hall', `culture-hall--${section}`]}>
  <nav class="culture-hall__nav" aria-label="축디 편집관">
    <a href="/culture/">축디 전체</a>
    {(Object.keys(cultureSections) as CultureSection[]).map((key) => (
      <a href={getCultureSectionPath(key)} aria-current={key === section ? 'page' : undefined}>
        <small>{cultureSections[key].floor}F</small>{cultureSections[key].label}
      </a>
    ))}
  </nav>

  <header class="culture-hall__head">
    <p>{hall.eyebrow}</p>
    <div><span>{hall.floor}<small>F</small></span><h1>{hall.label}</h1></div>
    <strong>{hall.en}</strong>
    <p>{hall.description}</p>
  </header>

  {lead ? (
    <section class="culture-hall__lead" aria-label={`${hall.label} 대표 콘텐츠`}>
      <a class="culture-hall__lead-image" href={getArticlePath(lead.data.category, lead.id)}>
        {imageFor(lead) && <img src={imageFor(lead)} alt={lead.data.coverImageAlt ?? ''} style={imageFocusStyle(imageFor(lead))} />}
        <span>NOW SHOWING</span>
      </a>
      <div>
        <p>{hall.floor}F · {hall.label}</p>
        <h2><a href={getArticlePath(lead.data.category, lead.id)}>{lead.data.title}</a></h2>
        <span>{lead.data.description}</span>
        <a class="culture-hall__read" href={getArticlePath(lead.data.category, lead.id)}>콘텐츠 입장하기 <i aria-hidden="true">↗</i></a>
      </div>
    </section>
  ) : <p class="culture-hall__empty">이 관의 첫 번째 편집물을 준비하고 있습니다.</p>}

  {rest.length > 0 && (
    <section class="culture-hall__stories" aria-labelledby="hall-stories-title">
      <header><p>THE COLLECTION</p><h2 id="hall-stories-title">{hall.label}의 편집물</h2><span>{String(entries.length).padStart(2, '0')} STORIES</span></header>
      <div>
        {rest.map((entry, index) => (
          <a href={getArticlePath(entry.data.category, entry.id)}>
            <figure>
              {imageFor(entry) && <img src={imageFor(entry)} alt="" loading="lazy" style={imageFocusStyle(imageFor(entry))} />}
              <span>{String(index + 1).padStart(2, '0')}</span>
            </figure>
            <p>{hall.floor}F · {hall.label}</p>
            <h3>{entry.data.title}</h3>
          </a>
        ))}
      </div>
    </section>
  )}
</main>

<style>
  .culture-hall{--hall-accent:#a8ceff;--hall-gradient:linear-gradient(140deg,#061733 0%,#124ca7 58%,#2776ef 100%);max-width:1180px;margin:0 auto;padding:28px 20px 76px}.culture-hall--boutique{--hall-accent:#f4d68b;--hall-gradient:linear-gradient(140deg,#14100a 0%,#5f4318 58%,#b17d20 100%)}.culture-hall--kit{--hall-accent:#b0d7ff;--hall-gradient:linear-gradient(140deg,#06111e 0%,#12365d 58%,#1763a5 100%)}.culture-hall__nav{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:36px}.culture-hall__nav a{display:flex;align-items:center;gap:7px;padding:10px 14px;border:1px solid var(--bbfc-border);border-radius:999px;color:var(--bbfc-gray-1);font-size:13px;font-weight:650;transition:.2s ease}.culture-hall__nav a small{color:#246bfd;font-size:10px;font-weight:800;letter-spacing:.08em}.culture-hall__nav a:hover,.culture-hall__nav a:focus-visible,.culture-hall__nav a[aria-current=page]{border-color:transparent;background:var(--hall-gradient);color:#fff;outline:none;box-shadow:0 10px 22px -16px rgba(7,20,48,.85)}.culture-hall__nav a[aria-current=page] small{color:var(--hall-accent)}.culture-hall__head{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.55fr);align-items:end;gap:8px 50px;padding:38px 40px 40px;background:var(--hall-gradient);color:#fff;box-shadow:0 24px 46px -35px rgba(4,11,25,.95)}.culture-hall__head>p:first-child{grid-column:1/-1;color:var(--hall-accent);font-size:11px;font-weight:800;letter-spacing:.16em}.culture-hall__head>div{display:flex;align-items:end;gap:20px}.culture-hall__head>div>span{color:var(--hall-accent);font-size:clamp(52px,7vw,88px);font-weight:350;line-height:.75;letter-spacing:-.07em}.culture-hall__head>div>span small{margin-left:5px;font-size:14px;font-weight:800;letter-spacing:0}.culture-hall__head h1{color:#fff;font-size:clamp(38px,5vw,66px);font-weight:800;line-height:.9;letter-spacing:-.065em}.culture-hall__head strong{justify-self:end;color:#fff;font-size:13px;letter-spacing:.08em}.culture-hall__head>p:last-child{grid-column:1/-1;max-width:760px;margin-top:18px;color:rgba(255,255,255,.82);font-size:15px;line-height:1.75}.culture-hall__lead{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,.7fr);margin-top:24px;border:1px solid rgba(16,36,66,.22)}.culture-hall__lead-image{position:relative;display:block;aspect-ratio:1/1;overflow:hidden;background:var(--bbfc-fill)}.culture-hall__lead-image img{width:100%;height:100%;object-fit:cover;transition:transform .45s ease}.culture-hall__lead-image:hover img{transform:scale(1.015)}.culture-hall__lead-image>span{position:absolute;top:17px;left:17px;padding:8px 10px;background:#fff;color:#12213a;font-size:10px;font-weight:850;letter-spacing:.12em}.culture-hall__lead>div{display:flex;flex-direction:column;justify-content:center;padding:40px 34px;background:var(--hall-gradient);color:#fff}.culture-hall__lead>div>p,.culture-hall__stories a>p{color:var(--hall-accent);font-size:10.5px;font-weight:800;letter-spacing:.11em}.culture-hall__lead h2{margin-top:13px;color:#fff;font-size:clamp(28px,3.3vw,45px);font-weight:760;line-height:1.14;letter-spacing:-.045em;text-wrap:balance}.culture-hall__lead>div>span{margin-top:17px;color:rgba(255,255,255,.8);font-size:14px;line-height:1.72}.culture-hall__read{display:flex;align-items:center;justify-content:space-between;min-height:58px;margin-top:29px;padding:8px 10px 8px 18px;border:1px solid rgba(255,255,255,.7);background:#fff;color:#111b2b;font-size:15px;font-weight:800;box-shadow:0 15px 30px -19px rgba(0,0,0,.7);transition:transform .25s ease,box-shadow .25s ease}.culture-hall__read i{display:grid;width:40px;height:40px;place-items:center;border-radius:50%;background:var(--hall-gradient);color:#fff;font-size:18px;font-style:normal;transition:transform .25s ease}.culture-hall__read:hover{transform:translateY(-3px);box-shadow:0 20px 34px -18px rgba(0,0,0,.75)}.culture-hall__read:hover i{transform:rotate(45deg)}.culture-hall__stories{margin-top:54px}.culture-hall__stories>header{display:flex;align-items:baseline;gap:12px;padding-bottom:13px;border-bottom:1px solid var(--bbfc-ink)}.culture-hall__stories>header p{color:#246bfd;font-size:11px;font-weight:800;letter-spacing:.13em}.culture-hall__stories>header h2{font-size:22px}.culture-hall__stories>header span{margin-left:auto;color:var(--bbfc-gray-1);font-size:11px;letter-spacing:.1em}.culture-hall__stories>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:27px 18px;margin-top:20px}.culture-hall__stories figure{position:relative;aspect-ratio:1/1;overflow:hidden;background:var(--bbfc-fill)}.culture-hall__stories img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}.culture-hall__stories a:hover img{transform:scale(1.02)}.culture-hall__stories figure span{position:absolute;right:9px;bottom:8px;color:#fff;font-size:12px;font-weight:800;text-shadow:0 1px 8px #000}.culture-hall__stories a>p{margin-top:11px}.culture-hall__stories h3{margin-top:6px;font-size:17px;line-height:1.42;font-weight:680;letter-spacing:-.02em}.culture-hall__empty{padding:80px 0;color:var(--bbfc-gray-2);text-align:center}
  @media(max-width:820px){.culture-hall__head{grid-template-columns:1fr}.culture-hall__head strong{justify-self:start}.culture-hall__lead{grid-template-columns:1fr}.culture-hall__stories>div{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:560px){.culture-hall{padding:22px 16px 58px}.culture-hall__nav{margin-bottom:29px}.culture-hall__nav a{padding:9px 11px;font-size:12px}.culture-hall__head{margin:0 -16px;padding:31px 16px 34px}.culture-hall__head>div{gap:13px}.culture-hall__head>div>span{font-size:52px}.culture-hall__head h1{font-size:40px}.culture-hall__head>p:last-child{font-size:14px}.culture-hall__lead{margin-left:-16px;margin-right:-16px}.culture-hall__lead>div{padding:27px 20px 29px}.culture-hall__lead h2{font-size:29px}.culture-hall__read{min-height:56px;font-size:15px}.culture-hall__stories>div{gap:26px 10px}.culture-hall__stories h3{font-size:15px}}
  @media(prefers-reduced-motion:reduce){.culture-hall *{transition:none!important}}
</style>
