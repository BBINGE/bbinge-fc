---
type Props = {
  variant: 'desktop' | 'compact';
};

const { variant } = Astro.props;
---

<aside
  class:list={['commemorative-banner', `commemorative-banner--${variant}`]}
  data-commemorative-banner
  data-variant={variant}
  hidden
  tabindex="0"
  role="status"
>
  <div class="commemorative-stage" aria-hidden="true">
    <div class="story story--pass">
      <span class="pass-character pass-character--messi"></span>
      <img class="pass-ball" src="/images/brand-events/football.svg" alt="" width="20" height="20" />
      <span class="pass-character pass-character--ronaldo"></span>
    </div>

    <div class="story story--liberation">
      <span class="liberation-character liberation-character--messi"></span>
      <img class="liberation-flag" src="/images/brand-events/taegeukgi.svg" alt="" width="72" height="48" />
      <span class="liberation-character liberation-character--ronaldo"></span>
    </div>
  </div>

  <div class="commemorative-copy">
    <strong data-commemorative-message></strong>
    <small data-commemorative-label></small>
  </div>
</aside>

<style>
  .commemorative-banner {
    position:relative;
    min-width:0;
    color:var(--bbfc-ink);
    background:var(--bbfc-bg);
    overflow:hidden;
    isolation:isolate;
    cursor:default;
    outline:none;
  }
  .commemorative-banner[hidden] { display:none !important; }
  .commemorative-banner:focus-visible { box-shadow:inset 0 0 0 1px var(--bbfc-blue); }
  .commemorative-banner--desktop {
    flex:1 1 270px;
    max-width:285px;
    height:62px;
    display:none;
    align-items:center;
    justify-content:center;
    gap:5px;
    padding:0 4px;
  }
  .commemorative-banner--compact {
    width:100%;
    height:48px;
    align-items:center;
    justify-content:center;
    gap:8px;
    border-top:1px solid var(--bbfc-line);
  }
  .commemorative-stage {
    position:relative;
    flex:0 0 108px;
    align-self:stretch;
  }
  .story { position:absolute; inset:0; }
  .story--liberation { display:none; }
  .commemorative-banner[data-story='liberation'] .story--pass { display:none; }
  .commemorative-banner[data-story='liberation'] .story--liberation { display:block; }

  .pass-character {
    position:absolute;
    z-index:2;
    bottom:-1px;
    width:53px;
    height:60px;
    background-repeat:no-repeat;
    background-size:400% 100%;
    background-position:0 0;
    mix-blend-mode:multiply;
    transform-origin:50% 100%;
  }
  .pass-character--messi {
    left:-2px;
    background-image:url('/images/brand-events/pass-messi-sprite.jpg');
    animation:pass-messi-pose 4.8s steps(1,end) infinite, pass-messi-body 4.8s ease-in-out infinite;
  }
  .pass-character--ronaldo {
    right:-2px;
    background-image:url('/images/brand-events/pass-ronaldo-sprite.jpg');
    animation:pass-ronaldo-pose 4.8s steps(1,end) infinite, pass-ronaldo-body 4.8s ease-in-out infinite;
  }
  .pass-ball {
    position:absolute;
    z-index:3;
    left:20px;
    top:38px;
    width:14px;
    height:14px;
    filter:drop-shadow(0 1px 1px rgba(18,27,39,.2));
    transform-origin:50% 70%;
    animation:pass-ball 4.8s cubic-bezier(.36,.04,.32,1) infinite;
  }

  .liberation-character {
    position:absolute;
    z-index:2;
    bottom:-2px;
    width:52px;
    height:60px;
    background-repeat:no-repeat;
    background-size:300% 100%;
    background-position:0 0;
    mix-blend-mode:multiply;
    transform-origin:50% 100%;
  }
  .liberation-character--messi {
    left:-1px;
    background-image:url('/images/brand-events/liberation-messi-sprite.jpg');
    animation:liberation-messi-pose 7.2s steps(1,end) infinite, liberation-messi 7.2s ease-in-out infinite;
  }
  .liberation-character--ronaldo {
    right:-1px;
    background-image:url('/images/brand-events/liberation-ronaldo-sprite.jpg');
    animation:liberation-ronaldo-pose 7.2s steps(1,end) infinite, liberation-ronaldo 7.2s ease-in-out infinite;
  }
  .liberation-flag {
    position:absolute;
    z-index:3;
    left:29px;
    top:13px;
    width:51px;
    height:34px;
    object-fit:fill;
    filter:drop-shadow(0 1px 1px rgba(25,31,40,.16));
    transform-origin:50% 50%;
    animation:liberation-flag 7.2s cubic-bezier(.42,0,.2,1) infinite;
  }

  .commemorative-copy {
    position:relative;
    display:flex;
    flex:0 1 166px;
    min-width:0;
    height:43px;
    flex-direction:column;
    justify-content:center;
  }
  .commemorative-copy::after {
    content:'';
    position:absolute;
    left:0;
    bottom:5px;
    width:22px;
    height:1px;
    background:var(--bbfc-blue);
    opacity:.32;
    transform-origin:left center;
    animation:message-story-line 4.8s ease-in-out infinite;
  }
  .commemorative-copy strong {
    display:block;
    overflow:hidden;
    color:var(--bbfc-ink);
    font-size:12px;
    font-weight:650;
    line-height:1.25;
    white-space:nowrap;
    text-overflow:ellipsis;
    animation:message-story 4.8s ease-in-out infinite;
  }
  .commemorative-copy small {
    display:block;
    align-self:flex-end;
    max-width:100%;
    margin-top:4px;
    overflow:hidden;
    color:var(--bbfc-gray-2);
    font-size:8.5px;
    font-weight:500;
    line-height:1;
    white-space:nowrap;
    text-overflow:ellipsis;
  }
  .commemorative-banner[data-story='liberation'] .commemorative-copy strong,
  .commemorative-banner[data-story='liberation'] .commemorative-copy::after { animation-duration:7.2s; }

  @keyframes pass-messi-pose {
    0%,5%,24%,76%,100% { background-position:0 0; }
    6%,9%,82%,87% { background-position:33.333% 0; }
    10%,13% { background-position:66.666% 0; }
    14%,23% { background-position:100% 0; }
  }
  @keyframes pass-ronaldo-pose {
    0%,33%,43%,69%,100% { background-position:0 0; }
    34%,42% { background-position:33.333% 0; }
    51%,56% { background-position:66.666% 0; }
    57%,68% { background-position:100% 0; }
  }
  @keyframes pass-messi-body {
    0%,5%,24%,76%,100% { transform:translate3d(0,0,0); }
    10% { transform:translate3d(-1px,-1px,0); }
    15% { transform:translate3d(3px,0,0); }
    82% { transform:translate3d(1px,-1px,0); }
  }
  @keyframes pass-ronaldo-body {
    0%,33%,43%,50%,69%,100% { transform:translate3d(0,0,0); }
    38% { transform:translate3d(-1px,-1px,0); }
    57% { transform:translate3d(1px,-1px,0); }
    61% { transform:translate3d(-3px,0,0); }
  }
  @keyframes pass-ball {
    0%,13% { transform:translate3d(0,0,0) rotate(0) scale(1); }
    15% { transform:translate3d(4px,-3px,0) rotate(35deg) scaleX(.9); }
    24% { transform:translate3d(25px,-20px,0) rotate(190deg) scale(1); }
    33% { transform:translate3d(48px,-11px,0) rotate(340deg) scale(1); }
    37% { transform:translate3d(58px,2px,0) rotate(405deg) scale(1.12,.78); }
    42%,56% { transform:translate3d(58px,2px,0) rotate(430deg) scale(1); }
    58% { transform:translate3d(54px,-3px,0) rotate(470deg) scaleX(.9); }
    68% { transform:translate3d(32px,-20px,0) rotate(650deg) scale(1); }
    78% { transform:translate3d(9px,-10px,0) rotate(820deg) scale(1); }
    83% { transform:translate3d(0,2px,0) rotate(890deg) scale(1.12,.78); }
    88%,100% { transform:translate3d(0,0,0) rotate(920deg) scale(1); }
  }
  @keyframes liberation-messi-pose {
    0%,15%,100% { background-position:0 0; }
    16%,31%,86% { background-position:50% 0; }
    32%,85% { background-position:100% 0; }
  }
  @keyframes liberation-ronaldo-pose {
    0%,15%,100% { background-position:0 0; }
    16%,31%,86% { background-position:50% 0; }
    32%,85% { background-position:100% 0; }
  }
  @keyframes liberation-messi {
    0%,100% { opacity:0; transform:translate3d(-9px,2px,0); }
    10% { opacity:1; }
    19%,78% { opacity:1; transform:translate3d(3px,0,0); }
    35%,62% { opacity:1; transform:translate3d(4px,-1px,0) rotate(1deg); }
    91% { opacity:0; transform:translate3d(-7px,2px,0); }
  }
  @keyframes liberation-ronaldo {
    0%,100% { opacity:0; transform:translate3d(9px,2px,0); }
    10% { opacity:1; }
    19%,78% { opacity:1; transform:translate3d(-3px,0,0); }
    35%,62% { opacity:1; transform:translate3d(-4px,-1px,0) rotate(-1deg); }
    91% { opacity:0; transform:translate3d(7px,2px,0); }
  }
  @keyframes liberation-flag {
    0%,15%,100% { opacity:0; transform:scaleX(.04) translateY(2px); }
    21% { opacity:1; }
    34% { opacity:1; transform:scaleX(1.04) translateY(-1px); }
    42%,68% { opacity:1; transform:scaleX(1) translateY(0) rotate(.5deg); }
    74% { opacity:1; transform:scaleX(.96) translateY(1px) rotate(-.6deg); }
    88% { opacity:0; transform:scaleX(.05) translateY(2px); }
  }
  @keyframes message-story {
    0%,100% { opacity:.82; transform:translateY(0); }
    12% { opacity:1; transform:translateY(-1px); }
    25%,74% { opacity:1; transform:translateY(0); }
    88% { opacity:.86; }
  }
  @keyframes message-story-line {
    0%,100% { opacity:.16; transform:scaleX(.25); }
    18%,68% { opacity:.42; transform:scaleX(1); }
    86% { opacity:.2; transform:scaleX(.35); }
  }

  @media (min-width:1280px) {
    .commemorative-banner--desktop { display:flex; }
    .commemorative-banner--compact { display:none !important; }
  }
  @media (max-width:1279px) {
    .commemorative-banner--desktop { display:none !important; }
    .commemorative-banner--compact { display:flex; }
    .commemorative-banner--compact .commemorative-stage { flex-basis:94px; }
    .commemorative-banner--compact .pass-character { width:45px; height:48px; }
    .commemorative-banner--compact .pass-ball { left:18px; top:31px; width:12px; height:12px; }
    .commemorative-banner--compact .liberation-character { width:45px; height:48px; }
    .commemorative-banner--compact .liberation-flag { left:26px; top:10px; width:43px; height:29px; }
    .commemorative-banner--compact .commemorative-copy { flex-basis:min(64vw,245px); height:38px; }
    .commemorative-banner--compact .commemorative-copy strong { font-size:12px; }
  }
  @media (max-width:420px) {
    .commemorative-banner--compact { gap:5px; padding:0 9px; }
    .commemorative-banner--compact .commemorative-copy { flex:1 1 auto; }
    .commemorative-banner--compact .commemorative-copy strong { font-size:11.5px; }
    .commemorative-banner--compact .commemorative-copy small { font-size:8px; }
  }
  @media (prefers-reduced-motion:reduce) {
    .commemorative-banner *, .commemorative-banner *::before, .commemorative-banner *::after { animation:none !important; transition:none !important; }
    .pass-character, .liberation-character { background-position:0 0; }
    .pass-ball { transform:translate3d(29px,-9px,0); }
    .liberation-character, .liberation-flag { opacity:1; transform:none; }
  }
</style>

<script>
  type HeaderEvent = {
    id: string;
    monthDay?: string;
    date?: string;
    message: string;
    label: string;
    scene: string;
    story?: string;
    prop: string;
    priority?: number;
  };

  function getSeoulDateKeys() {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Seoul',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).formatToParts(new Date());
    const values = Object.fromEntries(parts.map(({ type, value }) => [type, value]));
    return { iso: `${values.year}-${values.month}-${values.day}`, monthDay: `${values.month}-${values.day}` };
  }

  function chooseEvent(events: HeaderEvent[]) {
    const { iso, monthDay } = getSeoulDateKeys();
    return events
      .filter((event) => event.date === iso || event.monthDay === monthDay)
      .sort((a, b) => {
        const exactDateDifference = Number(Boolean(b.date)) - Number(Boolean(a.date));
        return exactDateDifference || (b.priority ?? 0) - (a.priority ?? 0);
      })[0];
  }

  function initialiseCommemorativeBanners() {
    const data = document.getElementById('bbfc-commemorative-data');
    if (!data?.textContent) return;

    let events: HeaderEvent[] = [];
    try { events = JSON.parse(data.textContent); } catch { return; }
    const previewId = ['localhost', '127.0.0.1'].includes(window.location.hostname)
      ? new URLSearchParams(window.location.search).get('event')
      : null;
    const event = (previewId ? events.find(({ id }) => id === previewId) : undefined) ?? chooseEvent(events);
    if (!event) return;

    document.querySelectorAll<HTMLElement>('[data-commemorative-banner]').forEach((banner) => {
      banner.hidden = false;
      banner.dataset.event = event.id;
      banner.dataset.scene = event.scene;
      banner.dataset.story = event.story ?? 'pass';
      banner.setAttribute('aria-label', `${event.message} — ${event.label}`);
      const message = banner.querySelector<HTMLElement>('[data-commemorative-message]');
      const label = banner.querySelector<HTMLElement>('[data-commemorative-label]');
      if (message) message.textContent = event.message;
      if (label) label.textContent = event.label;
    });
  }

  initialiseCommemorativeBanners();
  document.addEventListener('astro:page-load', initialiseCommemorativeBanners);
</script>
