---
type Props = {
  variant: 'desktop' | 'compact';
};

const { variant } = Astro.props;
---

<aside
  class:list={['commemorative-banner', `commemorative-banner--${variant}`]}
  data-commemorative-banner
  data-variant={variant}
  hidden
  tabindex="0"
  role="status"
>
  <div class="commemorative-characters" aria-hidden="true">
    <img class="commemorative-character commemorative-character--messi" src="/images/brand-events/messi-10.jpg" alt="" width="240" height="360" />
    <span class="commemorative-prop" data-commemorative-prop></span>
    <img class="commemorative-character commemorative-character--ronaldo" src="/images/brand-events/ronaldo-7.jpg" alt="" width="240" height="360" />
    <i class="commemorative-spark commemorative-spark--one"></i>
    <i class="commemorative-spark commemorative-spark--two"></i>
  </div>
  <div class="commemorative-copy">
    <strong data-commemorative-message></strong>
    <small data-commemorative-label></small>
  </div>
</aside>

<style>
  .commemorative-banner {
    position:relative;
    min-width:0;
    color:var(--bbfc-ink);
    background:var(--bbfc-bg);
    overflow:hidden;
    isolation:isolate;
    cursor:default;
    outline:none;
  }
  .commemorative-banner[hidden] { display:none !important; }
  .commemorative-banner:focus-visible { box-shadow:inset 0 0 0 1px var(--bbfc-blue); }
  .commemorative-banner--desktop {
    flex:1 1 270px;
    max-width:285px;
    height:62px;
    display:none;
    align-items:center;
    justify-content:center;
    gap:5px;
    padding:0 4px;
  }
  .commemorative-banner--compact {
    width:100%;
    height:48px;
    align-items:center;
    justify-content:center;
    gap:8px;
    border-top:1px solid var(--bbfc-line);
  }
  .commemorative-characters {
    position:relative;
    flex:0 0 103px;
    align-self:stretch;
  }
  .commemorative-character {
    position:absolute;
    bottom:-2px;
    width:49px;
    height:58px;
    object-fit:cover;
    object-position:center;
    mix-blend-mode:multiply;
    transform-origin:50% 100%;
  }
  .commemorative-character--messi { left:1px; }
  .commemorative-character--ronaldo { right:1px; }
  .commemorative-prop {
    position:absolute;
    z-index:2;
    left:50%;
    top:50%;
    min-width:25px;
    padding:1px 3px;
    transform:translate(-50%,-32%);
    color:var(--bbfc-blue-strong);
    font-size:16px;
    font-weight:750;
    line-height:1;
    text-align:center;
    text-shadow:0 1px 0 var(--bbfc-bg);
  }
  .commemorative-copy {
    display:flex;
    flex:0 1 166px;
    min-width:0;
    height:43px;
    flex-direction:column;
    justify-content:center;
  }
  .commemorative-copy strong {
    display:block;
    overflow:hidden;
    color:var(--bbfc-ink);
    font-size:12px;
    font-weight:650;
    line-height:1.25;
    white-space:nowrap;
    text-overflow:ellipsis;
  }
  .commemorative-copy small {
    display:block;
    align-self:flex-end;
    max-width:100%;
    margin-top:4px;
    overflow:hidden;
    color:var(--bbfc-gray-2);
    font-size:8.5px;
    font-weight:500;
    line-height:1;
    white-space:nowrap;
    text-overflow:ellipsis;
  }
  .commemorative-spark {
    position:absolute;
    z-index:3;
    width:3px;
    height:3px;
    border-radius:50%;
    background:var(--bbfc-blue);
    opacity:0;
  }
  .commemorative-spark--one { left:45%; top:11px; }
  .commemorative-spark--two { left:58%; top:20px; }

  .commemorative-banner.is-playing .commemorative-character--messi {
    animation:commemorative-messi-in 1.15s cubic-bezier(.2,.8,.2,1) both, commemorative-idle 5.4s 1.2s ease-in-out infinite;
  }
  .commemorative-banner.is-playing .commemorative-character--ronaldo {
    animation:commemorative-ronaldo-in 1.15s .12s cubic-bezier(.2,.8,.2,1) both, commemorative-idle 5.4s 1.32s ease-in-out infinite reverse;
  }
  .commemorative-banner.is-playing .commemorative-prop { animation:commemorative-prop-in 1s .45s cubic-bezier(.16,1,.3,1) both; }
  .commemorative-banner.is-playing .commemorative-copy strong { animation:commemorative-copy-in .78s .78s cubic-bezier(.2,.8,.2,1) both; }
  .commemorative-banner.is-playing .commemorative-copy small { animation:commemorative-label-in .65s 1.08s ease-out both; }
  .commemorative-banner.is-playing .commemorative-spark { animation:commemorative-spark 1.2s .75s ease-out both; }
  .commemorative-banner.is-playing .commemorative-spark--two { animation-delay:.9s; }

  .commemorative-banner[data-scene='remember'] .commemorative-prop { font-size:19px; }
  .commemorative-banner[data-scene='remember'].is-playing .commemorative-character--messi,
  .commemorative-banner[data-scene='remember'].is-playing .commemorative-character--ronaldo { animation:commemorative-stand-in .85s ease-out both; }
  .commemorative-banner[data-scene='remember'].is-playing .commemorative-prop { animation:commemorative-flag-in 1.45s .35s ease-out both; }
  .commemorative-banner[data-scene='love'] .commemorative-prop { color:var(--bbfc-blue); }
  .commemorative-banner[data-scene='nature'] .commemorative-prop,
  .commemorative-banner[data-scene='food'] .commemorative-prop,
  .commemorative-banner[data-scene='season'] .commemorative-prop { font-size:19px; }

  @keyframes commemorative-messi-in {
    0% { opacity:0; transform:translate3d(-12px,4px,0) rotate(-3deg); }
    58% { opacity:1; transform:translate3d(3px,-2px,0) rotate(2deg); }
    100% { opacity:1; transform:none; }
  }
  @keyframes commemorative-ronaldo-in {
    0% { opacity:0; transform:translate3d(12px,4px,0) rotate(3deg); }
    58% { opacity:1; transform:translate3d(-3px,-2px,0) rotate(-2deg); }
    100% { opacity:1; transform:none; }
  }
  @keyframes commemorative-stand-in {
    0% { opacity:0; transform:translateY(4px); }
    100% { opacity:1; transform:none; }
  }
  @keyframes commemorative-idle { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-1.5px); } }
  @keyframes commemorative-prop-in {
    0% { opacity:0; transform:translate(-50%,35%) scale(.35) rotate(-12deg); }
    64% { opacity:1; transform:translate(-50%,-45%) scale(1.14) rotate(4deg); }
    100% { opacity:1; transform:translate(-50%,-32%) scale(1); }
  }
  @keyframes commemorative-flag-in {
    0% { opacity:0; transform:translate(-50%,20%) scale(.55) rotate(-8deg); }
    55% { opacity:1; transform:translate(-50%,-40%) scale(1.05) rotate(5deg); }
    100% { opacity:1; transform:translate(-50%,-32%) scale(1) rotate(0); }
  }
  @keyframes commemorative-copy-in {
    0% { opacity:0; clip-path:inset(0 100% 0 0); transform:translateX(8px); letter-spacing:.06em; }
    100% { opacity:1; clip-path:inset(0 0 0 0); transform:none; letter-spacing:-.01em; }
  }
  @keyframes commemorative-label-in { from { opacity:0; transform:translateY(3px); } to { opacity:1; transform:none; } }
  @keyframes commemorative-spark {
    0% { opacity:0; transform:translateY(4px) scale(.5); }
    35% { opacity:.9; }
    100% { opacity:0; transform:translateY(-8px) scale(1.5); }
  }

  @media (min-width:1280px) {
    .commemorative-banner--desktop { display:flex; }
    .commemorative-banner--compact { display:none !important; }
  }
  @media (max-width:1279px) {
    .commemorative-banner--desktop { display:none !important; }
    .commemorative-banner--compact { display:flex; }
    .commemorative-banner--compact .commemorative-characters { flex-basis:88px; }
    .commemorative-banner--compact .commemorative-character { width:42px; height:47px; }
    .commemorative-banner--compact .commemorative-copy { flex-basis:min(64vw,245px); height:38px; }
    .commemorative-banner--compact .commemorative-copy strong { font-size:12px; }
  }
  @media (max-width:420px) {
    .commemorative-banner--compact { gap:5px; padding:0 9px; }
    .commemorative-banner--compact .commemorative-copy { flex:1 1 auto; }
    .commemorative-banner--compact .commemorative-copy strong { font-size:11.5px; }
    .commemorative-banner--compact .commemorative-copy small { font-size:8px; }
  }
  @media (prefers-reduced-motion:reduce) {
    .commemorative-banner *, .commemorative-banner *::before, .commemorative-banner *::after { animation:none !important; transition:none !important; }
  }
</style>

<script>
  type HeaderEvent = {
    id: string;
    monthDay?: string;
    date?: string;
    message: string;
    label: string;
    scene: string;
    prop: string;
    priority?: number;
  };

  function getSeoulDateKeys() {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Seoul',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).formatToParts(new Date());
    const values = Object.fromEntries(parts.map(({ type, value }) => [type, value]));
    return { iso: `${values.year}-${values.month}-${values.day}`, monthDay: `${values.month}-${values.day}` };
  }

  function chooseEvent(events: HeaderEvent[]) {
    const { iso, monthDay } = getSeoulDateKeys();
    return events
      .filter((event) => event.date === iso || event.monthDay === monthDay)
      .sort((a, b) => {
        const exactDateDifference = Number(Boolean(b.date)) - Number(Boolean(a.date));
        return exactDateDifference || (b.priority ?? 0) - (a.priority ?? 0);
      })[0];
  }

  function playBanner(banner: HTMLElement) {
    banner.classList.remove('is-playing');
    void banner.offsetWidth;
    banner.classList.add('is-playing');
  }

  function initialiseCommemorativeBanners() {
    const data = document.getElementById('bbfc-commemorative-data');
    if (!data?.textContent) return;

    let events: HeaderEvent[] = [];
    try { events = JSON.parse(data.textContent); } catch { return; }
    const event = chooseEvent(events);
    if (!event) return;

    document.querySelectorAll<HTMLElement>('[data-commemorative-banner]').forEach((banner) => {
      banner.hidden = false;
      banner.dataset.event = event.id;
      banner.dataset.scene = event.scene;
      banner.setAttribute('aria-label', `${event.message} — ${event.label}`);
      const message = banner.querySelector<HTMLElement>('[data-commemorative-message]');
      const label = banner.querySelector<HTMLElement>('[data-commemorative-label]');
      const prop = banner.querySelector<HTMLElement>('[data-commemorative-prop]');
      if (message) message.textContent = event.message;
      if (label) label.textContent = event.label;
      if (prop) prop.textContent = event.prop;
      playBanner(banner);
      banner.addEventListener('mouseenter', () => playBanner(banner));
      banner.addEventListener('focus', () => playBanner(banner));
    });
  }

  initialiseCommemorativeBanners();
  document.addEventListener('astro:page-load', initialiseCommemorativeBanners);
</script>
