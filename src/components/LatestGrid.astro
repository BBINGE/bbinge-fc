---
import { categories } from '../config/categories';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'articles'>[];
}

const { entries } = Astro.props;
---

{entries.length === 0 ? (
  <p class="text-[13px] text-[var(--bbfc-gray-1)] py-8 text-center border-t border-[var(--bbfc-line)]">
    아직 등록된 글이 없어요.
  </p>
) : (
  <div class="grid grid-cols-1 md:grid-cols-3 gap-x-5 gap-y-5">
    {entries.map((entry) => (
      <a href={`/${entry.data.category}/${entry.id}/`} class="block">
        <div class="aspect-[16/10] bg-[var(--bbfc-fill)] rounded-[var(--bbfc-radius)] overflow-hidden flex items-center justify-center">
          {entry.data.coverImage ? (
            <img src={entry.data.coverImage} alt="" loading="lazy" class="w-full h-full object-cover" />
          ) : (
            <span class="text-[11px] text-[var(--bbfc-gray-2)]">{categories[entry.data.category].label}</span>
          )}
        </div>
        <p class="text-[12.5px] font-medium text-[var(--bbfc-ink)] mt-2 leading-snug">{entry.data.title}</p>
        <p class="text-[11px] text-[var(--bbfc-gray-2)] mt-1">
          {entry.data.pubDate.toLocaleDateString('ko-KR')}
        </p>
      </a>
    ))}
  </div>
)}
