---
import { categories } from '../config/categories';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { title, category, coverImage, gallery } = entry.data;
const meta = categories[category];
const href = `/${category}/${entry.id}/`;
const imageCount = gallery?.length ?? (coverImage ? 1 : 0);
---

<article class="border border-[var(--bbfc-border)] rounded-[var(--bbfc-radius)] overflow-hidden">
  <a href={href} class="block">
    <div class="aspect-square bg-[var(--bbfc-fill)] flex items-center justify-center relative">
      {coverImage ? (
        <img src={coverImage} alt="" loading="lazy" class="w-full h-full object-cover" />
      ) : (
        <span class="text-[11px] text-[var(--bbfc-gray-2)]">{meta.label}</span>
      )}
      {imageCount > 1 && (
        <span class="absolute top-1.5 right-1.5 bg-[var(--bbfc-ink)]/80 text-white text-[10px] px-1.5 py-0.5 rounded-full">
          1/{imageCount}
        </span>
      )}
    </div>
    <div class="p-2.5">
      <span class="text-[11px] text-[var(--bbfc-blue)]">{meta.label}</span>
      <p class="text-[13.5px] font-medium mt-1 leading-snug text-[var(--bbfc-ink)]">{title}</p>
    </div>
  </a>
</article>
