---
// 정사각(1:1) 카드 피드. 데스크톱 4열 → 태블릿 2열 → 모바일 1열(모바일 퍼스트로는 1→2→4 순서로 작성).
// 사진은 3000×3000 무손실 정사각 원본을 쓰는 게 원칙이라 object-fit:cover를 걸어도 실제로는 크롭이 일어나지 않는다.
// N개마다 인피드 광고(AdSlot square)를 같은 크기의 카드 한 칸으로 끼워 넣는다.
import { categories } from '../config/categories';
import AdSlot from './AdSlot.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'articles'>[];
  adEvery?: number;
}

const { entries, adEvery = 8 } = Astro.props;
---

{entries.length === 0 ? (
  <p class="text-[13px] text-[var(--bbfc-gray-1)] py-10 text-center">아직 등록된 글이 없어요.</p>
) : (
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    {entries.map((entry, i) => (
      <>
        <a href={`/${entry.data.category}/${entry.id}/`} class="block group">
          <div class="aspect-square rounded-[var(--bbfc-radius)] bg-[var(--bbfc-fill)] overflow-hidden flex items-center justify-center">
            {entry.data.coverImage ? (
              <img src={entry.data.coverImage} alt="" loading="lazy" class="w-full h-full object-cover" />
            ) : (
              <span class="text-[11px] text-[var(--bbfc-gray-2)]">사진 없음</span>
            )}
          </div>
          <p class="text-[11px] text-[var(--bbfc-blue)] mt-2.5">{categories[entry.data.category]?.label}</p>
          <p class="text-[13.5px] font-medium text-[var(--bbfc-ink)] mt-1 leading-snug line-clamp-2">
            {entry.data.title}
          </p>
          {entry.data.tags.length > 0 && (
            <p class="text-[11px] text-[var(--bbfc-gray-2)] mt-1 truncate">
              {entry.data.tags.slice(0, 2).map((tag) => `#${tag}`).join(' ')}
            </p>
          )}
          <p class="text-[11px] text-[var(--bbfc-gray-2)] mt-1">
            {entry.data.pubDate.toLocaleDateString('ko-KR')}
          </p>
        </a>
        {adEvery > 0 && (i + 1) % adEvery === 0 && i !== entries.length - 1 && <AdSlot square />}
      </>
    ))}
  </div>
)}
