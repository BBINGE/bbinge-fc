<aside class="reading-companion" data-reading-companion aria-live="polite" aria-label="삥이FC 독서 동행">
  <button type="button" class="reading-companion__toggle" aria-expanded="false" aria-label="독서 동행 인사 펼치기">
    <span class="hourglass" aria-hidden="true">
      <i class="hourglass__glass"><b class="hourglass__sand-top"></b><b class="hourglass__stream"></b><b class="hourglass__sand-bottom"></b></i>
      <i class="hourglass__frame hourglass__frame--top"></i>
      <i class="hourglass__frame hourglass__frame--bottom"></i>
    </span>
    <span class="reading-companion__copy">
      <small>BBINGE FC · READING WITH YOU</small>
      <strong data-reading-message>잠시 머물러 주셨네요. 반가워요.</strong>
      <span>오늘도 좋은 하루 되세용.</span>
      <em>— 삥이</em>
    </span>
  </button>
</aside>

<style>
  .reading-companion { position:fixed; z-index:24; top:32vh; right:max(18px, calc((100vw - 920px) / 2 - 178px)); width:158px; opacity:0; visibility:hidden; transform:translateY(12px); transition:opacity 900ms ease,transform 900ms ease,visibility 900ms; pointer-events:none; }
  .reading-companion.is-visible { opacity:1; visibility:visible; transform:translateY(0); pointer-events:auto; }
  .reading-companion__toggle { display:grid; justify-items:center; width:100%; padding:16px 12px 14px; border:1px solid rgba(181,139,45,.3); border-radius:24px; background:linear-gradient(145deg,rgba(255,255,255,.96),rgba(250,247,239,.94)); color:var(--bbfc-ink); box-shadow:0 22px 54px -35px rgba(67,45,5,.55),inset 0 1px 0 rgba(255,255,255,.9); backdrop-filter:blur(12px); cursor:default; }
  .hourglass { position:relative; display:block; width:54px; height:74px; filter:drop-shadow(0 10px 13px rgba(111,78,15,.2)); transform-style:preserve-3d; animation:hourglass-turn 60s cubic-bezier(.65,0,.2,1) infinite; }
  .hourglass__glass { position:absolute; inset:8px 9px; overflow:hidden; border:1px solid rgba(125,104,65,.42); background:linear-gradient(100deg,rgba(255,255,255,.86),rgba(220,233,238,.28) 32%,rgba(255,255,255,.76) 55%,rgba(181,205,214,.22)); clip-path:polygon(0 0,100% 0,66% 47%,100% 100%,0 100%,34% 53%); box-shadow:inset 7px 0 9px rgba(255,255,255,.72),inset -4px 0 8px rgba(110,135,145,.08); }
  .hourglass__glass::after { content:''; position:absolute; top:-8%; left:22%; width:8px; height:116%; border-radius:50%; background:linear-gradient(90deg,transparent,rgba(255,255,255,.88),transparent); transform:rotate(8deg); }
  .hourglass__sand-top,.hourglass__sand-bottom,.hourglass__stream { position:absolute; display:block; background:linear-gradient(90deg,#b68120,#f1d778 45%,#c3912c); }
  .hourglass__sand-top { top:4px; left:6px; width:24px; height:22px; clip-path:polygon(0 0,100% 0,50% 100%); animation:sand-top 60s linear infinite; transform-origin:50% 0; }
  .hourglass__stream { top:22px; left:17px; width:2px; height:22px; opacity:.9; animation:sand-stream 60s ease-in-out infinite; }
  .hourglass__sand-bottom { bottom:4px; left:5px; width:26px; height:22px; clip-path:polygon(50% 0,100% 100%,0 100%); animation:sand-bottom 60s linear infinite; transform-origin:50% 100%; }
  .hourglass__frame { position:absolute; left:2px; width:50px; height:8px; border:1px solid rgba(100,67,12,.52); border-radius:50%; background:linear-gradient(180deg,#f2d777,#a8741e 55%,#6f480d); box-shadow:inset 0 1px 1px rgba(255,255,255,.7),0 2px 5px rgba(87,54,5,.2); }
  .hourglass__frame::before,.hourglass__frame::after { content:''; position:absolute; top:5px; width:4px; height:58px; border-radius:99px; background:linear-gradient(90deg,#8f5d12,#e4c35e,#70470c); transform-origin:50% 0; }
  .hourglass__frame::before { left:6px; transform:rotate(-5deg); }
  .hourglass__frame::after { right:6px; transform:rotate(5deg); }
  .hourglass__frame--top { top:3px; }
  .hourglass__frame--bottom { bottom:3px; transform:rotate(180deg); }
  .reading-companion__copy { display:grid; justify-items:center; margin-top:10px; text-align:center; }
  .reading-companion__copy small { color:#a07824; font-size:6px; font-weight:800; letter-spacing:.13em; }
  .reading-companion__copy strong { margin-top:7px; font-size:11.5px; line-height:1.55; font-weight:650; letter-spacing:-.025em; text-wrap:balance; }
  .reading-companion__copy span { margin-top:6px; color:var(--bbfc-gray-1); font-size:9.5px; line-height:1.5; }
  .reading-companion__copy em { margin-top:3px; color:var(--bbfc-blue); font-size:9px; font-style:normal; }
  .reading-companion.is-paused .hourglass { animation-play-state:paused; }
  .reading-companion.is-paused .hourglass__sand-top,.reading-companion.is-paused .hourglass__stream,.reading-companion.is-paused .hourglass__sand-bottom { animation-play-state:paused; }
  @keyframes sand-top { 0%,5%{transform:scaleY(1)} 88%,100%{transform:scaleY(.08)} }
  @keyframes sand-bottom { 0%,5%{transform:scaleY(.08)} 88%,100%{transform:scaleY(1)} }
  @keyframes sand-stream { 0%,4%,90%,100%{opacity:0} 8%,86%{opacity:.92} }
  @keyframes hourglass-turn { 0%,92%{transform:rotateX(0deg) rotateY(-8deg)} 98%,100%{transform:rotateX(180deg) rotateY(8deg)} }
  @media (max-width:1279px) and (min-width:1024px) {
    .reading-companion { right:8px; width:118px; }
    .reading-companion__toggle { padding:13px 8px 12px; border-radius:20px; }
    .hourglass { width:45px; height:62px; zoom:.84; }
    .reading-companion__copy { margin-top:2px; }
    .reading-companion__copy small { display:none; }
    .reading-companion__copy strong { font-size:10.5px; }
    .reading-companion__copy span { font-size:8.5px; }
  }
  @media (max-width:1023px) and (min-width:768px) {
    .reading-companion { top:auto; right:18px; bottom:22px; width:auto; }
    .reading-companion__toggle { grid-template-columns:38px 0fr; align-items:center; justify-items:start; gap:0; width:auto; min-height:50px; padding:6px 9px; overflow:hidden; border-radius:999px; cursor:pointer; transition:grid-template-columns 420ms ease,gap 420ms ease,padding 420ms ease; }
    .reading-companion.is-expanded .reading-companion__toggle { grid-template-columns:38px minmax(0,230px); gap:9px; padding-right:16px; }
    .hourglass { width:36px; height:46px; zoom:.62; }
    .reading-companion__copy { display:grid; justify-items:start; min-width:0; margin:0; overflow:hidden; text-align:left; white-space:nowrap; opacity:0; transition:opacity 220ms ease 80ms; }
    .reading-companion.is-expanded .reading-companion__copy { opacity:1; }
    .reading-companion__copy small,.reading-companion__copy span,.reading-companion__copy em { display:none; }
    .reading-companion__copy strong { margin:0; font-size:11px; }
  }
  @media (max-width:767px) { .reading-companion { display:none; } }
  :global(.reading-companion-mobile) { display:none; }
  @media (max-width:767px) {
    :global(.reading-companion-mobile) { position:relative; display:grid; grid-template-columns:42px minmax(0,1fr); gap:13px; align-items:center; margin:52px 0; padding:17px 18px; border:1px solid rgba(181,139,45,.27); border-radius:18px; background:linear-gradient(145deg,#fff,#fbf7ed); box-shadow:0 18px 40px -34px rgba(72,47,5,.5); }
    :global(.reading-companion-mobile__hourglass) { position:relative; display:block; width:42px; height:48px; filter:drop-shadow(0 6px 8px rgba(111,78,15,.18)); }
    :global(.reading-companion-mobile__hourglass::before),:global(.reading-companion-mobile__hourglass::after) { content:''; position:absolute; left:5px; width:32px; height:6px; border:1px solid rgba(100,67,12,.45); border-radius:50%; background:linear-gradient(180deg,#f2d777,#9b6818 64%,#6f480d); box-shadow:inset 0 1px 1px rgba(255,255,255,.7); }
    :global(.reading-companion-mobile__hourglass::before) { top:3px; }
    :global(.reading-companion-mobile__hourglass::after) { bottom:3px; }
    :global(.reading-companion-mobile__glass) { position:absolute; inset:8px 10px; overflow:hidden; border:1px solid rgba(125,104,65,.4); background:linear-gradient(100deg,rgba(255,255,255,.9),rgba(212,230,237,.28) 38%,rgba(255,255,255,.75)); clip-path:polygon(0 0,100% 0,64% 47%,100% 100%,0 100%,36% 53%); }
    :global(.reading-companion-mobile__glass::before) { content:''; position:absolute; left:5px; right:5px; bottom:3px; height:13px; background:linear-gradient(90deg,#b68120,#f1d778 48%,#c3912c); clip-path:polygon(50% 0,100% 100%,0 100%); animation:mobile-sand 60s linear infinite; transform-origin:50% 100%; }
    :global(.reading-companion-mobile small) { display:block; color:#a07824; font-size:7px; font-weight:800; letter-spacing:.12em; }
    :global(.reading-companion-mobile strong) { display:block; margin-top:4px; color:var(--bbfc-ink); font-size:13px; line-height:1.55; font-weight:650; letter-spacing:-.025em; }
    :global(.reading-companion-mobile span) { display:block; margin-top:3px; color:var(--bbfc-gray-1); font-size:10px; line-height:1.5; }
  }
  @media (prefers-reduced-motion:reduce) {
    .reading-companion { transition:none; }
    .hourglass,.hourglass__sand-top,.hourglass__stream,.hourglass__sand-bottom { animation:none!important; }
    :global(.reading-companion-mobile__glass::before) { animation:none!important; }
  }
  @keyframes mobile-sand { 0%,5%{transform:scaleY(.12)} 88%,100%{transform:scaleY(1)} }
</style>

<script>
  const companion = document.querySelector<HTMLElement>('[data-reading-companion]');
  if (companion) {
    const message = companion.querySelector<HTMLElement>('[data-reading-message]');
    const toggle = companion.querySelector<HTMLButtonElement>('.reading-companion__toggle');
    const readingBody = document.querySelector<HTMLElement>('.article-body, .archive-body');
    let activeSeconds = 0;
    let lastActivity = Date.now();
    let tabletExpandedOnce = false;
    const mobileMilestones = new Set<number>();

    const copyForMinutes = (minutes: number) => {
      if (minutes >= 40) return '여기까지 읽은 우리는 이제 제법 오래된 축구 친구네요.';
      if (minutes >= 20) return '긴 이야기에 오래 머물러 주셔서 고마워요.';
      if (minutes >= 10) return '제법 깊은 곳까지 함께 오셨네요.';
      if (minutes >= 5) return `이 글과 ${minutes}분째 함께 걷고 계세요.`;
      return '잠시 머물러 주셨네요. 반가워요.';
    };

    const updateActivity = () => { lastActivity = Date.now(); };
    ['scroll','pointerdown','keydown','touchstart'].forEach((name) => window.addEventListener(name, updateActivity, { passive:true }));

    const addMobileGreeting = (milestone: number, minutes: number) => {
      if (!readingBody || mobileMilestones.has(milestone)) return;
      const children = [...readingBody.children] as HTMLElement[];
      const target = children.find((child) => child.offsetTop >= readingBody.scrollHeight * milestone) ?? children[children.length - 1];
      if (!target) return;
      const card = document.createElement('aside');
      card.className = 'reading-companion-mobile';
      card.setAttribute('aria-label', '삥이FC 독서 동행 인사');
      card.innerHTML = `<span class="reading-companion-mobile__hourglass" aria-hidden="true"><i class="reading-companion-mobile__glass"></i></span><div><small>BBINGE FC · READING WITH YOU</small><strong>${copyForMinutes(minutes)}</strong><span>오늘도 좋은 하루 되세용. — 삥이</span></div>`;
      target.insertAdjacentElement('beforebegin', card);
      mobileMilestones.add(milestone);
    };

    const render = () => {
      const minutes = Math.max(1, Math.floor(activeSeconds / 60));
      if (message) message.textContent = copyForMinutes(minutes);
      if (activeSeconds < 90) return;
      if (window.innerWidth < 768) {
        if (!readingBody) return;
        const rect = readingBody.getBoundingClientRect();
        const progress = Math.min(1, Math.max(0, -rect.top / Math.max(1, rect.height - window.innerHeight)));
        if (progress >= .35) addMobileGreeting(.35, minutes);
        if (progress >= .7) addMobileGreeting(.7, minutes);
        return;
      }
      companion.classList.add('is-visible');
      if (window.innerWidth < 1024 && !tabletExpandedOnce) {
        companion.classList.add('is-expanded');
        toggle?.setAttribute('aria-expanded', 'true');
        tabletExpandedOnce = true;
        window.setTimeout(() => {
          companion.classList.remove('is-expanded');
          toggle?.setAttribute('aria-expanded', 'false');
        }, 6500);
      }
    };

    toggle?.addEventListener('click', () => {
      if (window.innerWidth < 768 || window.innerWidth >= 1024) return;
      const expanded = companion.classList.toggle('is-expanded');
      toggle.setAttribute('aria-expanded', String(expanded));
    });

    document.addEventListener('visibilitychange', () => companion.classList.toggle('is-paused', document.hidden));
    window.setInterval(() => {
      if (!document.hidden && Date.now() - lastActivity < 60000) activeSeconds += 1;
      render();
    }, 1000);
  }
</script>
