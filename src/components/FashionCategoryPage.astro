---
import type { CollectionEntry } from 'astro:content';
import { getArticlePath } from '../config/categories';
import { imageFocusStyle } from '../utils/imageFocus';
import { cultureCoverArticleId, cultureSections, getCultureSectionPath, type CultureSection } from '../config/culture';

interface Props {
  entries: CollectionEntry<'articles'>[];
  description?: string;
}

const { entries, description } = Astro.props;
const lead = entries.find((entry) => entry.id === cultureCoverArticleId) ?? entries[0];
const edit = entries.filter((entry) => entry.id !== lead?.id);
const imageFor = (entry: CollectionEntry<'articles'>) => entry.data.cardImage ?? entry.data.coverImage;
const halls = (Object.keys(cultureSections) as CultureSection[]).map((key) => ({
  key,
  ...cultureSections[key],
  entries: entries.filter((entry) => entry.data.cultureSection === key),
}));
const hallLeadStyle = (hall: (typeof halls)[number]) =>
  `object-position:${hall.leadImageFocus.x}% ${hall.leadImageFocus.y}%;transform-origin:${hall.leadImageFocus.x}% ${hall.leadImageFocus.y}%;scale:${hall.leadImageFocus.scale}`;
const hallFor = (entry: CollectionEntry<'articles'>) => entry.data.cultureSection ? cultureSections[entry.data.cultureSection] : null;
---

<div class="fashion-index">
  <header class="fashion-index__masthead">
    <div>
      <p>BBINGE FC · FOOTBALL & STYLE</p>
      <h1>축디</h1>
    </div>
    <p class="fashion-index__manifesto"><strong>FOOTBALL,<br />WORN DIFFERENTLY.</strong><span>경기장을 떠난 유니폼은 누구의 옷이 되는가.</span></p>
  </header>

  {description && <p class="fashion-index__note">{description}</p>}

  <section class="fashion-halls" aria-labelledby="fashion-halls-title">
    <div class="fashion-section-title"><p>DEPARTMENT DIRECTORY</p><h2 id="fashion-halls-title">축디의 세 편집관</h2><span>02–03F</span></div>
    <div class="fashion-halls__grid">
      {halls.map((hall) => {
        const hallLead = hall.entries.find((entry) => entry.id === hall.leadArticleId) ?? hall.entries[0];
        return (
          <a class:list={['fashion-hall', `fashion-hall--${hall.key}`]} href={getCultureSectionPath(hall.key)}>
            <div class="fashion-hall__media">
              {hallLead && imageFor(hallLead) && <img src={imageFor(hallLead)} alt="" loading="lazy" style={hallLeadStyle(hall)} />}
              <span>{String(hall.entries.length).padStart(2,'0')} STORIES</span>
            </div>
            <div class="fashion-hall__copy">
              <span>{hall.floor}<small>F</small></span>
              <div><p>{hall.en}</p><h3>{hall.label}</h3><small>{hall.description}</small></div>
              <span class="fashion-hall__cta">
                <span><small>ENTER {hall.floor}F</small><strong>{hall.ctaLabel}</strong></span>
                <i aria-hidden="true">↗</i>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  {lead ? (
    <section class="fashion-cover" aria-labelledby="fashion-cover-title">
      <a class="fashion-cover__image" href={getArticlePath(lead.data.category, lead.id)}>
        {imageFor(lead) && <img src={imageFor(lead)} alt={lead.data.coverImageAlt ?? ''} style={imageFocusStyle(imageFor(lead))} />}
        <span>{hallFor(lead) ? `${hallFor(lead)!.floor}F · ${hallFor(lead)!.label}` : 'LATEST ISSUE'}</span>
      </a>
      <div class="fashion-cover__copy">
        <p>THE COVER STORY · {lead.data.pubDate.toLocaleDateString('ko-KR')}</p>
        <h2 id="fashion-cover-title"><a href={getArticlePath(lead.data.category, lead.id)}>{lead.data.title}</a></h2>
        <span>{lead.data.description}</span>
        <a class="fashion-cover__cta" href={getArticlePath(lead.data.category, lead.id)}>
          <span>화보와 이야기 보기</span>
          <i aria-hidden="true"><span>→</span></i>
        </a>
      </div>
    </section>
  ) : <p class="fashion-index__empty">아직 등록된 글이 없어요.</p>}

  {edit.length > 0 && (
    <section class="fashion-edit" aria-labelledby="fashion-edit-title">
      <div class="fashion-section-title"><p>THE EDIT</p><h2 id="fashion-edit-title">이번 편집면</h2><span>{String(entries.length).padStart(2,'0')} STORIES</span></div>
      <div class="fashion-edit__grid">
        {edit.map((entry, index) => (
          <a class:list={["fashion-edit__story", { "fashion-edit__story--major": index === 0 }]} href={getArticlePath(entry.data.category, entry.id)}>
            <div>
              {imageFor(entry) && <img src={imageFor(entry)} alt="" loading="lazy" style={imageFocusStyle(imageFor(entry))} />}
              <span>{String(index + 1).padStart(2,'0')}</span>
            </div>
            <p>{hallFor(entry) ? `${hallFor(entry)!.floor}F · ${hallFor(entry)!.label}` : 'STYLE FILE'}</p>
            <h3>{entry.data.title}</h3>
          </a>
        ))}
      </div>
    </section>
  )}

</div>

<style>
  .fashion-index { max-width:1180px; margin:0 auto; padding:34px 20px 70px; }
  .fashion-index__masthead { display:flex; align-items:end; justify-content:space-between; gap:30px; padding:0 0 23px; border-bottom:3px solid var(--bbfc-ink); }
  .fashion-index__masthead>div>p { color:var(--bbfc-blue); font-size:9px; font-weight:760; letter-spacing:.17em; }
  .fashion-index__masthead h1 { margin-top:7px; font-size:clamp(52px,8vw,94px); line-height:.88; font-weight:820; letter-spacing:-.075em; }
  .fashion-index__manifesto { display:grid; justify-items:end; text-align:right; }
  .fashion-index__manifesto strong { font-size:16px; line-height:1.05; letter-spacing:.02em; }
  .fashion-index__manifesto span { margin-top:8px; color:var(--bbfc-gray-2); font-size:11px; }
  .fashion-index__note { width:100%; max-width:none; margin:19px 0 30px; color:var(--bbfc-gray-1); font-size:13px; line-height:1.8; text-wrap:pretty; }
  .fashion-halls { margin:0 0 58px; }
  .fashion-halls__grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-top:18px; }
  .fashion-hall { --hall-accent:#9bc5ff; --hall-gradient:linear-gradient(140deg,#061733 0%,#124ca7 57%,#2776ef 100%); --hall-cta:linear-gradient(110deg,#d4e6ff 0%,#fff 100%); --hall-cta-ink:#0b3472; display:block; overflow:hidden; border:1px solid rgba(255,255,255,.16); background:var(--hall-gradient); color:#fff; box-shadow:0 18px 36px -30px rgba(7,18,40,.9); transition:transform .3s ease,border-color .3s ease,box-shadow .3s ease; }
  .fashion-hall--boutique { --hall-accent:#f4d68b; --hall-gradient:linear-gradient(140deg,#14100a 0%,#5f4318 58%,#b17d20 100%); --hall-cta:linear-gradient(110deg,#edc75e 0%,#fff0b9 100%); --hall-cta-ink:#3a2705; }
  .fashion-hall--kit { --hall-accent:#a5d1ff; --hall-gradient:linear-gradient(140deg,#06111e 0%,#12365d 58%,#1763a5 100%); --hall-cta:linear-gradient(110deg,#b9ddff 0%,#f5fbff 100%); --hall-cta-ink:#082c4d; }
  .fashion-hall:hover,.fashion-hall:focus-visible { border-color:var(--hall-accent); outline:none; transform:translateY(-6px); box-shadow:0 24px 48px -25px rgba(8,20,42,.82); }
  .fashion-hall__media { position:relative; aspect-ratio:1.38/1; overflow:hidden; background:var(--bbfc-fill); }
  .fashion-hall__media::after { content:""; position:absolute; inset:0; background:linear-gradient(180deg,rgba(4,8,15,.03) 34%,rgba(4,8,15,.72) 100%); }
  .fashion-hall__media img { width:100%;height:100%;object-fit:cover;transition:transform .45s ease; }
  .fashion-hall:hover .fashion-hall__media img { transform:scale(1.025); }
  .fashion-hall__media>span { position:absolute;z-index:1;right:12px;bottom:11px;color:#fff;font-size:10px;font-weight:800;letter-spacing:.12em; }
  .fashion-hall__copy { display:grid;grid-template-columns:auto minmax(0,1fr);align-items:start;gap:15px;padding:21px 18px 19px; }
  .fashion-hall__copy>span:first-child { color:var(--hall-accent);font-size:39px;font-weight:450;line-height:1;letter-spacing:-.06em; }
  .fashion-hall__copy>span:first-child small { margin-left:4px;font-size:12px;font-weight:800;letter-spacing:0; }
  .fashion-hall__copy p { color:var(--hall-accent);font-size:9px;font-weight:800;line-height:1.35;letter-spacing:.09em; }
  .fashion-hall__copy h3 { margin-top:4px;color:#fff;font-size:22px;font-weight:780;letter-spacing:-.035em; }
  .fashion-hall__copy div>small { display:block;margin-top:9px;color:rgba(255,255,255,.78);font-size:12.5px;line-height:1.55; }
  .fashion-hall__cta { grid-column:1/-1;display:flex!important;align-items:center;justify-content:space-between;min-height:60px;margin-top:3px;padding:8px 10px 8px 15px;border:1px solid rgba(255,255,255,.82);background:var(--hall-cta);color:var(--hall-cta-ink)!important;box-shadow:0 15px 28px -18px rgba(0,0,0,.88);transition:transform .25s ease,box-shadow .25s ease; }
  .fashion-hall__cta>span { display:flex;flex-direction:column;gap:3px; }
  .fashion-hall__cta>span small { font-size:8px;font-weight:850;line-height:1;letter-spacing:.13em;opacity:.7; }
  .fashion-hall__cta>span strong { font-size:14px;font-weight:850;line-height:1.2;letter-spacing:-.025em; }
  .fashion-hall__cta i { display:grid;width:38px;height:38px;place-items:center;border-radius:50%;background:var(--hall-cta-ink);color:#fff;font-size:19px;font-style:normal;box-shadow:0 8px 18px -10px rgba(0,0,0,.85);transition:transform .25s ease;animation:fashion-hall-arrow 2.8s ease-in-out infinite; }
  .fashion-hall:hover .fashion-hall__cta { transform:translateY(-2px);box-shadow:0 17px 28px -17px rgba(0,0,0,.9); }
  .fashion-hall:hover .fashion-hall__cta i { transform:rotate(45deg); }
  @keyframes fashion-hall-arrow { 0%,72%,100%{transform:translate(0,0)} 82%{transform:translate(2px,-2px)} 90%{transform:translate(0,0)} }
  .fashion-cover { display:grid; grid-template-columns:minmax(0,1fr) minmax(290px,.58fr); border-top:1px solid var(--bbfc-border); border-bottom:1px solid var(--bbfc-border); }
  .fashion-cover__image { position:relative; display:block; aspect-ratio:1/1; overflow:hidden; background:var(--bbfc-fill); }
  .fashion-cover__image img { width:100%; height:100%; object-fit:cover; transition:transform .5s ease; }
  .fashion-cover__image:hover img { transform:scale(1.012); }
  .fashion-cover__image>span { position:absolute; top:18px; left:18px; padding:7px 9px; background:var(--bbfc-blue); color:#fff; font-size:8px; font-weight:760; letter-spacing:.14em; }
  .fashion-cover__copy { display:flex; flex-direction:column; justify-content:center; padding:42px 36px; background:var(--bbfc-fill-2); }
  .fashion-cover__copy>p,.fashion-edit__story>p { color:var(--bbfc-blue); font-size:9px; font-weight:760; letter-spacing:.14em; }
  .fashion-cover__copy h2 { margin-top:14px; font-size:clamp(29px,3.2vw,44px); line-height:1.14; font-weight:760; letter-spacing:-.045em; text-wrap:balance; }
  .fashion-cover__copy>span { margin-top:18px; color:var(--bbfc-gray-1); font-size:13px; line-height:1.75; }
  .fashion-cover__cta { position:relative; display:grid; grid-template-columns:minmax(0,1fr) 42px; align-items:center; gap:20px; min-height:58px; margin-top:34px; padding:8px 9px 8px 18px; overflow:hidden; border:1px solid var(--bbfc-blue); background:linear-gradient(115deg,#174fc2,#2878ff); color:#fff; font-size:16px; line-height:1.35; font-weight:790; letter-spacing:-.018em; box-shadow:0 14px 28px -18px rgba(36,107,253,.9); transition:transform .25s ease,box-shadow .25s ease; }
  .fashion-cover__cta::before { content:""; position:absolute; inset:0; background:linear-gradient(105deg,transparent 25%,rgba(255,255,255,.18) 48%,transparent 70%); transform:translateX(-120%); transition:transform .55s ease; }
  .fashion-cover__cta i { position:relative; display:grid; width:42px; height:42px; place-items:center; overflow:hidden; border-radius:50%; background:#fff; color:var(--bbfc-blue); font-style:normal; box-shadow:0 8px 20px -12px rgba(0,0,0,.8); transition:transform .35s cubic-bezier(.22,1,.36,1); }
  .fashion-cover__cta i::before { content:""; position:absolute; inset:4px; border:1px solid rgba(255,255,255,.55); border-radius:50%; opacity:0; transform:scale(.72); animation:fashion-cta-ring 3.6s ease-out infinite; }
  .fashion-cover__cta i>span { position:relative; font-size:18px; line-height:1; animation:fashion-cta-arrow 3.6s ease-in-out infinite; }
  .fashion-cover__cta:hover { color:#fff; transform:translateY(-3px); box-shadow:0 20px 34px -17px rgba(36,107,253,.9); }
  .fashion-cover__cta:hover::before { transform:translateX(120%); }
  .fashion-cover__cta:hover i { transform:translateX(3px); }
  .fashion-cover__cta:hover i>span { animation:none; transform:translateX(2px); }
  .fashion-cover__cta:focus-visible { outline:2px solid var(--bbfc-blue); outline-offset:6px; }
  @keyframes fashion-cta-ring { 0%,68% { opacity:0; transform:scale(.72); } 76% { opacity:.75; } 92%,100% { opacity:0; transform:scale(1.12); } }
  @keyframes fashion-cta-arrow { 0%,68%,100% { transform:translateX(0); } 78% { transform:translateX(3px); } 86% { transform:translateX(0); } }
  .fashion-edit { margin-top:54px; }
  .fashion-section-title { display:flex; align-items:baseline; gap:12px; padding-bottom:13px; border-bottom:1px solid var(--bbfc-ink); }
  .fashion-section-title p { color:var(--bbfc-blue); font-size:11px; font-weight:780; letter-spacing:.13em; }
  .fashion-section-title h2 { font-size:22px; font-weight:720; letter-spacing:-.025em; }
  .fashion-section-title span { margin-left:auto; color:var(--bbfc-gray-1); font-size:11px; letter-spacing:.1em; }
  .fashion-edit__grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:25px 18px; margin-top:20px; }
  .fashion-edit__story>div,
  .fashion-edit__story:not(.fashion-edit__story--major)>div { position:relative; aspect-ratio:1/1; overflow:hidden; background:var(--bbfc-fill); }
  .fashion-edit__story img { width:100%; height:100%; object-fit:cover; transition:transform .35s ease; }
  .fashion-edit__story:hover img { transform:scale(1.02); }
  .fashion-edit__story>div span { position:absolute; right:9px; bottom:8px; color:#fff; font-size:11px; font-weight:750; text-shadow:0 1px 8px rgba(0,0,0,.7); }
  .fashion-edit__story>p { margin-top:11px; }
  .fashion-edit__story h3 { margin-top:5px; font-size:16px; line-height:1.4; font-weight:650; letter-spacing:-.02em; }
  .fashion-index__empty { padding:70px 0; text-align:center; color:var(--bbfc-gray-2); }
  @media (max-width:820px) {
    .fashion-halls__grid { grid-template-columns:1fr; }
    .fashion-hall { display:grid;grid-template-columns:minmax(180px,.62fr) 1fr; }
    .fashion-hall__media { aspect-ratio:1.4/1; }
    .fashion-cover { grid-template-columns:1fr; }
    .fashion-cover__image { aspect-ratio:1/1; }
    .fashion-cover__copy { padding:30px 26px; }
    .fashion-edit__grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .fashion-edit__story--major>div { aspect-ratio:1/1; }
  }
  @media (max-width:560px) {
    .fashion-index { padding:25px 16px 55px; }
    .fashion-index__masthead { align-items:start; }
    .fashion-index__manifesto span { display:none; }
    .fashion-index__manifesto strong { font-size:11px; }
    .fashion-index__note { margin-bottom:24px; font-size:12.5px; }
    .fashion-halls { margin-bottom:45px; }
    .fashion-hall { grid-template-columns:118px minmax(0,1fr); }
    .fashion-hall__media { aspect-ratio:auto;min-height:142px; }
    .fashion-hall__copy { grid-template-columns:auto minmax(0,1fr);gap:10px;padding:16px 12px; }
    .fashion-hall__copy>span:first-child { font-size:31px; }
    .fashion-hall__copy h3 { font-size:19px; }
    .fashion-hall__copy div>small { font-size:11.5px;line-height:1.45; }
    .fashion-hall__cta { min-height:54px;padding:7px 8px 7px 11px; }
    .fashion-hall__cta>span strong { font-size:13px; }
    .fashion-hall__cta i { width:34px;height:34px;font-size:17px; }
    .fashion-cover__image { aspect-ratio:1/1; }
    .fashion-cover__copy { padding:25px 20px 24px; }
    .fashion-cover__copy h2 { font-size:29px; }
    .fashion-cover__cta { grid-template-columns:minmax(0,1fr) 38px; min-height:56px; margin-top:28px; padding:8px 9px 8px 16px; font-size:15px; }
    .fashion-cover__cta i { width:36px; height:36px; }
    .fashion-edit__grid { gap:24px 10px; }
    .fashion-edit__story h3 { font-size:13.5px; }
    .fashion-edit__story:not(.fashion-edit__story--major)>div { aspect-ratio:1/1; }
  }
  @media (prefers-reduced-motion:reduce) {
    .fashion-cover__cta::before, .fashion-cover__cta i, .fashion-cover__cta i::before, .fashion-cover__cta i>span { animation:none; transition:none; }
  }
  @media (max-width:1179px) {
    .fashion-index { padding-top:26px; }
    .fashion-index__note { display:-webkit-box; overflow:hidden; margin-bottom:22px; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
    .fashion-halls { margin-bottom:38px; }
    .fashion-cover__copy { padding:28px 26px; }
    .fashion-cover__copy>span { display:-webkit-box; overflow:hidden; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
    .fashion-edit { margin-top:40px; }
  }
  @media (max-width:900px) {
    .fashion-halls__grid { grid-template-columns:repeat(3,minmax(0,1fr)); gap:9px; }
    .fashion-hall { display:block; }
    .fashion-hall__media { aspect-ratio:4/3; min-height:0; }
    .fashion-hall__copy { display:flex; align-items:center; justify-content:space-between; gap:8px; padding:11px 10px; }
    .fashion-hall__copy>span:first-child,.fashion-hall__copy p,.fashion-hall__copy div>small,.fashion-hall__cta>span { display:none; }
    .fashion-hall__copy h3 { margin:0; font-size:17px; }
    .fashion-hall__cta { display:grid!important; grid-column:auto; width:32px; min-width:32px; height:32px; min-height:0; margin:0; padding:0; place-items:center; border-radius:50%; }
    .fashion-hall__cta i { width:24px; height:24px; font-size:14px; }
    .fashion-cover { grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr); }
    .fashion-cover__image { aspect-ratio:auto; min-height:100%; }
    .fashion-cover__copy h2 { font-size:clamp(24px,3.7vw,31px); }
    .fashion-cover__cta { margin-top:20px; }
  }
  @media (max-width:599px) {
    .fashion-index { padding:18px 12px 48px; }
    .fashion-index__masthead { padding-bottom:14px; }
    .fashion-index__masthead h1 { font-size:50px; }
    .fashion-index__note { margin:13px 0 17px; font-size:12px; line-height:1.62; }
    .fashion-section-title { padding-bottom:9px; }
    .fashion-section-title p { font-size:8px; }
    .fashion-section-title h2 { font-size:18px; }
    .fashion-halls { margin-bottom:28px; }
    .fashion-halls__grid { margin-top:11px; gap:6px; }
    .fashion-hall__media { aspect-ratio:1/1; }
    .fashion-hall__media>span { right:7px; bottom:6px; font-size:7px; }
    .fashion-hall__copy { padding:8px 6px; }
    .fashion-hall__copy h3 { font-size:14px; }
    .fashion-hall__cta { width:27px; min-width:27px; height:27px; }
    .fashion-hall__cta i { width:21px; height:21px; font-size:12px; }
    .fashion-cover { grid-template-columns:1fr; }
    .fashion-cover__image { min-height:0; aspect-ratio:16/10; }
    .fashion-cover__copy { padding:20px 17px; }
    .fashion-cover__copy h2 { margin-top:9px; font-size:24px; line-height:1.2; }
    .fashion-cover__copy>span { margin-top:10px; font-size:12px; line-height:1.58; }
    .fashion-cover__cta { min-height:48px; margin-top:16px; font-size:14px; }
    .fashion-edit { margin-top:30px; }
    .fashion-edit__grid { margin-top:13px; gap:18px 8px; }
    .fashion-edit__story h3 { display:-webkit-box; overflow:hidden; font-size:13px; line-height:1.35; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
  }
</style>
