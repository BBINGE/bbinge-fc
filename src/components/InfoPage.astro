---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  updated?: string;
}

const { eyebrow, title, description, updated } = Astro.props;
---

<article class="max-w-[760px] mx-auto px-5 md:px-8 py-12 md:py-20">
  <header class="pb-9 md:pb-12 border-b border-[var(--bbfc-border)]">
    <p class="text-[12px] font-medium tracking-[0.16em] text-[var(--bbfc-blue)]">{eyebrow}</p>
    <h1 class="mt-4 text-[28px] md:text-[38px] font-medium tracking-[-0.035em] leading-[1.3] text-[var(--bbfc-ink)]">
      {title}
    </h1>
    <p class="mt-4 max-w-[620px] text-[15px] md:text-[17px] leading-[1.75] text-[var(--bbfc-gray-1)]">
      {description}
    </p>
    {updated && <p class="mt-5 text-[12px] text-[var(--bbfc-gray-2)]">최종 업데이트 {updated}</p>}
  </header>

  <div class="info-body pt-9 md:pt-12">
    <slot />
  </div>
</article>

<style>
  .info-body :global(section + section) { margin-top: 2.5rem; }
  .info-body :global(h2) {
    margin-bottom: 0.75rem;
    color: var(--bbfc-ink);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: -0.02em;
  }
  .info-body :global(h3) {
    margin: 1.25rem 0 0.5rem;
    color: var(--bbfc-ink-2);
    font-size: 15px;
    font-weight: 600;
  }
  .info-body :global(p), .info-body :global(li) {
    color: var(--bbfc-gray-1);
    font-size: 14px;
    line-height: 1.85;
  }
  .info-body :global(ul) { margin-top: 0.65rem; padding-left: 1.25rem; list-style: disc; }
  .info-body :global(li + li) { margin-top: 0.35rem; }
  .info-body :global(a) { color: var(--bbfc-blue-strong); text-decoration: underline; text-underline-offset: 3px; }
  .info-body :global(strong) { color: var(--bbfc-ink-2); font-weight: 600; }
  .info-body :global(.info-note) {
    margin-bottom: 2.5rem;
    padding: 1rem 1.1rem;
    border-radius: var(--bbfc-radius-lg);
    background: var(--bbfc-blue-weak);
    color: var(--bbfc-ink-2);
    font-size: 13px;
    line-height: 1.75;
  }
</style>
