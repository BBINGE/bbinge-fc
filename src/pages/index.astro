---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/HomeHero.astro';
import LatestGrid from '../components/LatestGrid.astro';
import { getCollection } from 'astro:content';
import { site } from '../config/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const hotArticles = articles.filter((entry) => entry.data.featured).slice(0, 4);
---

<Layout title={site.name} description={site.tagline} breadcrumbs={[{ label: '홈', href: '/' }]}>
  <div class="max-w-[1040px] mx-auto px-4 md:px-5 py-6 space-y-7">
    <HomeHero hotArticles={hotArticles} />
    <LatestGrid entries={articles} />
  </div>
</Layout>
