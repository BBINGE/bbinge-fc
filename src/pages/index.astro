---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categories, getAncestorChain, getArticlePath } from '../config/categories';
import { site } from '../config/site';
import { isNewlyPublished } from '../utils/freshness';
import TodayFootball from '../components/TodayFootball.astro';
import { imageFocusStyle } from '../utils/imageFocus';

const deskForCategory = (category: string) => {
  const root = getAncestorChain(category)[0];
  const deskKey = root?.slug ?? category;
  return {
    deskKey,
    deskLabel: categories[deskKey]?.label ?? categories[category]?.label ?? category,
  };
};

const articles = (await getCollection('articles', ({ data }) => !data.draft)).map((entry) => {
  const desk = deskForCategory(entry.data.category);
  return {
    id: entry.id,
    href: getArticlePath(entry.data.category, entry.id),
    title: entry.data.title,
    description: entry.data.description,
    label: categories[entry.data.category]?.label ?? entry.data.category,
    ...desk,
    coverImage: entry.data.coverImage,
    cardImage: entry.data.cardImage ?? entry.data.coverImage,
    coverImageAlt: entry.data.coverImageAlt ?? entry.data.title,
    pubDate: entry.data.pubDate,
    kind: 'article' as const,
  };
});

const archiveEntries = (await getCollection('archive', ({ data }) => !data.draft)).map((entry) => ({
  id: entry.id,
  href: `/archive/${entry.data.branch}/${entry.data.index}/${entry.id}/`,
  title: entry.data.title,
  description: entry.data.description,
  label: '삥이 아카이브',
  deskKey: 'archive',
  deskLabel: '삥이 아카이브',
  coverImage: entry.data.coverImage,
  cardImage: entry.data.coverImage,
  coverImageAlt: entry.data.coverImageAlt,
  pubDate: entry.data.pubDate,
  kind: 'archive' as const,
}));

const editorialFeed = [...articles, ...archiveEntries].sort(
  (a, b) => b.pubDate.valueOf() - a.pubDate.valueOf() || b.id.localeCompare(a.id)
);

const lead = editorialFeed[0];
const deskStories = [] as typeof editorialFeed;
const representedDesks = new Set(lead ? [lead.deskKey] : []);

for (const item of editorialFeed) {
  if (item.href === lead?.href || representedDesks.has(item.deskKey)) continue;
  deskStories.push(item);
  representedDesks.add(item.deskKey);
  if (deskStories.length === 7) break;
}

if (deskStories.length < 7) {
  const deskCounts = new Map<string, number>();
  if (lead) deskCounts.set(lead.deskKey, 1);
  for (const item of deskStories) deskCounts.set(item.deskKey, (deskCounts.get(item.deskKey) ?? 0) + 1);
  for (const item of editorialFeed) {
    if (item.href === lead?.href || deskStories.some((story) => story.href === item.href)) continue;
    if ((deskCounts.get(item.deskKey) ?? 0) >= 2) continue;
    deskStories.push(item);
    deskCounts.set(item.deskKey, (deskCounts.get(item.deskKey) ?? 0) + 1);
    if (deskStories.length === 7) break;
  }
}

const featuredHrefs = new Set([lead?.href, ...deskStories.map((item) => item.href)]);
const rollingFeed = editorialFeed.filter((item) => !featuredHrefs.has(item.href));
const latest = rollingFeed.slice(0, 8);
const moreStories = rollingFeed.slice(8, 14);
---

<Layout title={site.name} description={site.homeDescription} breadcrumbs={[{ label: '홈', href: '/' }]}>
  <main class="home-magazine max-w-[1180px] mx-auto px-4 md:px-6 py-7 md:py-10">
    <h1 class="sr-only">삥이FC - 축구의 역사와 문화를 읽고 기록하는 독립 매거진</h1>

    <header class="edition-head">
      <div>
        <p class="edition-kicker">BBINGE FC · FOOTBALL ARCHIVE MAGAZINE</p>
        <p class="edition-title">축구의 역사를 놀고, 읽고, 걷는 곳</p>
      </div>
      <p class="edition-note">역사 · 공간 · 유니폼 · 서사</p>
    </header>

    {lead ? (
      <>
        <section class="lobby-hero" aria-label="삥이FC 메인 로비와 최신 기사">
          <div class="lobby-panel">
            <div class="lobby-copy">
              <p class="lobby-kicker"><span>01F</span> PB ONLINE MAIN</p>
              <h2>축구 문화가 모이는 로비</h2>
              <p>경기 결과보다 오래 남는 축구의 역사·공간·유니폼·서사를 기록하는 독립 매거진입니다.</p>
            </div>
          </div>

          <a href={lead.href} class="lead-story group">
            <div class="lead-image media-frame">
              {lead.coverImage ? (
                <img src={lead.coverImage} alt={lead.coverImageAlt} width="1200" height="675" sizes="(max-width: 700px) calc(100vw - 32px), (max-width: 1100px) 55vw, 680px" loading="eager" decoding="async" fetchpriority="high" style={imageFocusStyle(lead.coverImage)} />
              ) : (
                <span>이미지 준비 중</span>
              )}
              <span class="lead-badge">NEWEST ARRIVAL</span>
            </div>
            <div class="lead-copy">
              <div class="story-meta">
                <span>{lead.label}</span>
                <time datetime={lead.pubDate.toISOString()}>{lead.pubDate.toLocaleDateString('ko-KR')}</time>
                {isNewlyPublished(lead.pubDate) && <span class="new-mark">NEW</span>}
              </div>
              <h2>{lead.title}</h2>
              <p>{lead.description}</p>
              <span class="read-more">최신 기록 읽기 <span aria-hidden="true">→</span></span>
            </div>
          </a>

          <nav class="lobby-actions" aria-label="삥이FC와 저자 소개">
            <a href="/about/"><img src="/images/profile-bbinge-192.webp" alt="" width="42" height="42" decoding="async" /><span><small>AUTHOR</small><strong>저자 @삥이</strong></span></a>
            <a href="/about/logo/"><img src="/images/brand/pb-mark-2026-color-240.webp" alt="" width="42" height="42" decoding="async" /><span><small>IDENTITY</small><strong>로고 이야기</strong></span></a>
            <a class="lobby-actions__map" href="/about/store/"><span class="floor-disc" aria-hidden="true">01F</span><span><small>FLOOR MAP</small><strong>전체 층별 안내</strong></span></a>
            <a class="lobby-actions__goat" href="/play/"><span class="goat-disc" aria-hidden="true">32</span><span><small>PB ARCADE</small><strong>나만의 GOAT</strong></span></a>
          </nav>
        </section>

        <section class="desk-edition" aria-labelledby="desk-edition-heading">
          <div class="section-heading section-heading--compact">
            <div><p>FROM EVERY FLOOR</p><h2 id="desk-edition-heading">각 층에서 도착한 최신 기록</h2></div>
            <a href="/about/store/">전체 층별 안내 <span aria-hidden="true">→</span></a>
          </div>
          <div class="desk-grid">
            {deskStories.map((item, index) => (
              <a href={item.href} class="desk-story group">
                <div class="desk-thumb media-frame">
                  {item.cardImage ? <img src={item.cardImage} alt="" width="300" height="200" loading="lazy" decoding="async" style={imageFocusStyle(item.cardImage)} /> : <span>NO IMAGE</span>}
                  <span class="desk-number">{String(index + 2).padStart(2, '0')}</span>
                </div>
                <div class="desk-copy">
                  <div class="story-meta"><span>{item.deskLabel}</span>{isNewlyPublished(item.pubDate) && <span class="new-mark">NEW</span>}</div>
                  <h3>{item.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </section>
      </>
    ) : (
      <p class="empty-state">첫 번째 이야기를 준비하고 있습니다.</p>
    )}

    <TodayFootball />

    <section class="below-fold" aria-labelledby="latest-heading">
      <div class="section-heading">
        <div>
          <p>THE LATEST</p>
          <h2 id="latest-heading">최근 기록</h2>
        </div>
        <a href="/archive/">전체 아카이브 <span aria-hidden="true">→</span></a>
      </div>

      <div class="latest-layout">
        <div class="latest-list">
          {latest.length > 0 ? latest.map((item, index) => (
            <a href={item.href} class="latest-row">
              <span class="latest-index">{String(index + 1).padStart(2, '0')}</span>
              <div class="latest-thumb media-frame">
                {item.coverImage ? <img src={item.coverImage} alt="" loading="lazy" style={imageFocusStyle(item.coverImage)} /> : <span>NO IMAGE</span>}
              </div>
              <div class="latest-copy">
                <div class="story-meta"><span>{item.label}</span></div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
              <time datetime={item.pubDate.toISOString()}>{item.pubDate.toLocaleDateString('ko-KR')}</time>
            </a>
          )) : (
            <p class="empty-latest">다음 기록을 준비하고 있습니다.</p>
          )}
        </div>

        <a href="/play/" class="play-feature" aria-label="GOAT 32강 토너먼트 시작하기">
          <div class="play-feature__copy">
            <p>BBINGE FC PRESENTS</p>
            <strong>GOAT<br />SHOWDOWN</strong>
            <h2>전설 32명.<br />왕은 한 명.</h2>
            <span>32강 바로 시작 <b aria-hidden="true">▶</b></span>
          </div>
          <div class="play-feature__roster" aria-hidden="true">
            <img src="/images/goat/players/di-stefano.webp" alt="" class="goat-face goat-face--1" loading="lazy" decoding="async" />
            <img src="/images/goat/players/puskas.webp" alt="" class="goat-face goat-face--2" loading="lazy" decoding="async" />
            <img src="/images/goat/players/pele.webp" alt="" class="goat-face goat-face--3" loading="lazy" decoding="async" />
            <img src="/images/goat/players/beckenbauer.webp" alt="" class="goat-face goat-face--4" loading="lazy" decoding="async" />
            <img src="/images/goat/players/cruyff.webp" alt="" class="goat-face goat-face--5" loading="lazy" decoding="async" />
            <img src="/images/goat/players/maradona.webp" alt="" class="goat-face goat-face--6" loading="lazy" decoding="async" />
            <img src="/images/goat/players/cristiano.webp" alt="" class="goat-hero goat-hero--ronaldo" loading="lazy" decoding="async" />
            <img src="/images/goat/players/messi.webp" alt="" class="goat-hero goat-hero--messi" loading="lazy" decoding="async" />
          </div>
          <span class="play-feature__eight" aria-hidden="true">32</span>
        </a>
      </div>
    </section>

    {moreStories.length > 0 && (
      <section class="more-records" aria-labelledby="more-records-heading">
        <div class="section-heading">
          <div><p>MORE STORIES</p><h2 id="more-records-heading">기록 더 보기</h2></div>
          <a href="/search/">모든 기록 검색 <span aria-hidden="true">→</span></a>
        </div>
        <div class="more-grid">
          {moreStories.map((item) => (
            <a href={item.href} class="more-card group">
              <div class="more-image media-frame">
                {item.coverImage ? <img src={item.coverImage} alt={item.coverImageAlt} loading="lazy" style={imageFocusStyle(item.coverImage)} /> : <span>NO IMAGE</span>}
              </div>
              <div class="story-meta"><span>{item.label}</span><time datetime={item.pubDate.toISOString()}>{item.pubDate.toLocaleDateString('ko-KR')}</time></div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>

<style>
  .home-magazine { color:var(--bbfc-ink); }
  .edition-head { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; padding:0 0 18px; border-bottom:2px solid var(--bbfc-ink); }
  .edition-kicker,.section-heading p { color:var(--bbfc-blue); font-size:10px; line-height:1.4; font-weight:750; letter-spacing:.16em; }
  .edition-title { margin-top:7px; font-size:17px; line-height:1.4; font-weight:620; letter-spacing:-.025em; }
  .edition-note { color:var(--bbfc-gray-2); font-size:11px; letter-spacing:.08em; white-space:nowrap; }
  .identity-hub { display:flex; align-items:stretch; justify-content:space-between; gap:24px; margin-top:18px; padding:12px 13px; border:1px solid var(--bbfc-border); border-radius:var(--bbfc-radius-lg); background:var(--bbfc-fill-2); }
  .identity-hub__intro { display:flex; min-width:0; align-items:center; gap:13px; }
  .identity-hub__portraits { position:relative; display:block; width:76px; height:54px; flex:0 0 auto; }
  .identity-hub__profile { position:absolute; left:0; top:1px; width:52px; height:52px; border:2px solid var(--bbfc-bg); border-radius:50%; object-fit:cover; box-shadow:0 5px 14px -9px rgba(25,31,40,.7); }
  .identity-hub__mark { position:absolute; right:0; bottom:0; width:38px; height:28px; padding:3px; border:1px solid var(--bbfc-border); border-radius:9px; background:var(--bbfc-bg); object-fit:contain; box-shadow:0 5px 14px -9px rgba(25,31,40,.7); }
  .identity-hub__intro p,.identity-hub__links span { color:var(--bbfc-blue); font-size:8px; line-height:1.35; font-weight:750; letter-spacing:.14em; }
  .identity-hub__intro strong { display:block; margin-top:3px; color:var(--bbfc-ink-2); font-size:12px; line-height:1.5; font-weight:570; }
  .identity-hub__links { display:grid; grid-template-columns:repeat(3,minmax(150px,1fr)); gap:9px; }
  .identity-hub__links a { display:grid; grid-template-columns:38px minmax(0,1fr) 25px; grid-template-rows:auto auto; align-items:center; column-gap:10px; min-width:170px; padding:9px 10px; border:1px solid var(--bbfc-border); border-radius:11px; background:var(--bbfc-bg); box-shadow:0 9px 22px -21px rgba(25,31,40,.7); transition:color .18s,background .18s,border-color .18s,transform .18s,box-shadow .18s; }
  .identity-hub__links a:hover { border-color:var(--bbfc-blue); color:var(--bbfc-blue); background:var(--bbfc-blue-weak); transform:translateY(-1px); box-shadow:0 12px 24px -20px rgba(20,91,198,.6); }
  .identity-hub__links a:focus-visible { outline:3px solid var(--bbfc-blue); outline-offset:2px; }
  .identity-hub__links img { grid-column:1; grid-row:1 / 3; width:38px; height:38px; padding:2px; border:1px solid var(--bbfc-border); border-radius:50%; background:#fff; object-fit:cover; }
  .identity-hub__links a:last-child img { padding:5px; object-fit:contain; }
  .identity-hub__floor { grid-column:1; grid-row:1 / 3; display:flex!important; align-items:flex-start; justify-content:center; gap:2px; width:38px; height:38px; padding-top:9px; border:1px solid var(--bbfc-border); border-radius:50%; background:#fff; color:var(--bbfc-blue)!important; letter-spacing:0!important; }
  .identity-hub__floor b { font-size:14px; line-height:1; font-weight:780; }
  .identity-hub__floor small { margin-top:1px; font-size:6px; line-height:1; font-weight:800; }
  .identity-hub__links span { grid-column:2; align-self:end; }
  .identity-hub__links strong { grid-column:2; align-self:start; margin-top:2px; font-size:11px; line-height:1.4; font-weight:680; }
  .identity-hub__links i { grid-column:3; grid-row:1 / 3; display:grid; place-items:center; width:25px; height:25px; border-radius:50%; background:var(--bbfc-blue); color:#fff; font-size:13px; font-style:normal; transition:transform .18s; }
  .identity-hub__links a:hover i { transform:translateX(2px); }
  .cover-grid { display:grid; grid-template-columns:minmax(0,1.72fr) minmax(300px,.88fr); gap:30px; padding:28px 0 42px; border-bottom:1px solid var(--bbfc-border); }
  .lead-story { display:grid; grid-template-rows:auto 1fr; min-width:0; }
  .media-frame { position:relative; overflow:hidden; background:var(--bbfc-fill); }
  .media-frame picture { display:block; width:100%; height:100%; }
  .media-frame img { display:block; width:100%; height:100%; object-fit:cover; transition:transform .45s ease; }
  .group:hover .media-frame img { transform:scale(1.025); }
  .media-frame>span:not(.story-label):not(.story-number) { display:grid; place-items:center; min-height:100%; color:var(--bbfc-gray-2); font-size:11px; }
  .lead-image { aspect-ratio:16/9; }
  .story-label-on-image { position:absolute; left:0; bottom:0; padding:8px 12px; background:var(--bbfc-blue); color:white; font-size:9px; font-weight:750; letter-spacing:.13em; }
  .lead-copy { padding-top:20px; }
  .story-meta { display:flex; align-items:center; gap:9px; color:var(--bbfc-gray-2); font-size:10px; line-height:1.4; }
  .story-meta>span:first-child { color:var(--bbfc-blue); font-weight:700; }
  .new-mark { padding:3px 5px; border-radius:999px; background:var(--bbfc-blue-weak); color:var(--bbfc-blue)!important; font-size:8px; font-weight:800; letter-spacing:.06em; }
  .lead-copy h2 { max-width:760px; margin-top:10px; font-size:clamp(29px,3.25vw,45px); line-height:1.16; font-weight:720; letter-spacing:-.055em; text-wrap:balance; }
  .lead-copy>p { max-width:740px; margin-top:13px; color:var(--bbfc-gray-1); font-size:14px; line-height:1.75; }
  .read-more { display:inline-block; margin-top:19px; color:var(--bbfc-ink); font-size:12px; font-weight:650; border-bottom:1px solid var(--bbfc-ink); padding-bottom:3px; }
  .secondary-stack { display:grid; align-content:start; gap:0; min-width:0; }
  .secondary-story { display:grid; grid-template-columns:122px minmax(0,1fr); gap:15px; padding:18px 0; border-bottom:1px solid var(--bbfc-border); }
  .secondary-story:first-child { padding-top:0; }
  .secondary-story:last-child { padding-bottom:0; border-bottom:0; }
  .secondary-image { aspect-ratio:4/3; align-self:start; }
  .story-number { position:absolute; top:7px; left:7px; padding:4px 6px; background:rgba(25,31,40,.78); color:#fff; font-size:8px; font-weight:750; letter-spacing:.08em; }
  .secondary-copy h2 { margin-top:7px; font-size:15.5px; line-height:1.38; font-weight:680; letter-spacing:-.035em; }
  .secondary-copy>p { margin-top:6px; color:var(--bbfc-gray-1); font-size:11.5px; line-height:1.55; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .below-fold { padding-top:38px; }
  .section-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; padding-bottom:14px; border-bottom:1px solid var(--bbfc-ink); }
  .section-heading h2 { margin-top:5px; font-size:25px; line-height:1.2; font-weight:680; letter-spacing:-.04em; }
  .section-heading>a { color:var(--bbfc-gray-1); font-size:11px; }
  .latest-layout { display:grid; grid-template-columns:minmax(0,1fr) 300px; gap:34px; padding-top:4px; }
  .latest-row { display:grid; grid-template-columns:28px 112px minmax(0,1fr) auto; align-items:center; gap:15px; padding:16px 0; border-bottom:1px solid var(--bbfc-line); }
  .latest-index { color:var(--bbfc-gray-3); font-family:Georgia,serif; font-size:13px; }
  .latest-thumb { aspect-ratio:4/3; border-radius:2px; }
  .latest-copy h3 { margin-top:5px; font-size:15px; line-height:1.4; font-weight:650; letter-spacing:-.025em; }
  .latest-copy>p { margin-top:5px; color:var(--bbfc-gray-1); font-size:11.5px; line-height:1.55; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .latest-row>time { align-self:start; padding-top:4px; color:var(--bbfc-gray-3); font-size:10px; white-space:nowrap; }
  .play-feature { position:relative; align-self:start; min-height:0; aspect-ratio:5/11; margin-top:16px; overflow:hidden; border-radius:12px; background:radial-gradient(circle at 72% 22%,#24599a 0,#0d294e 34%,#07182e 72%); color:#fff; isolation:isolate; box-shadow:0 18px 45px -24px rgba(5,20,42,.8); }
  .play-feature::before { content:''; position:absolute; inset:0; z-index:1; background:linear-gradient(180deg,rgba(5,15,29,.05) 25%,rgba(5,15,29,.92) 82%); }
  .play-feature::after { content:''; position:absolute; inset:0; z-index:5; border:1px solid rgba(255,255,255,.16); border-radius:inherit; pointer-events:none; }
  .play-feature__copy { position:absolute; z-index:6; left:21px; right:19px; bottom:22px; }
  .play-feature__copy p { color:#78acff; font-size:8px; font-weight:850; letter-spacing:.18em; }
  .play-feature__copy>strong { display:block; margin-top:5px; color:#fff; font-size:30px; line-height:.86; font-weight:950; font-style:italic; letter-spacing:-.065em; text-shadow:0 3px 18px rgba(0,0,0,.45); }
  .play-feature__copy h2 { margin-top:12px; color:rgba(255,255,255,.94); font-size:15px; line-height:1.35; font-weight:720; letter-spacing:-.035em; }
  .play-feature__copy>span { position:absolute; right:0; bottom:0; display:inline-flex; align-items:center; gap:8px; margin-top:0; padding:10px 14px; border:1px solid rgba(255,255,255,.4); border-radius:999px; background:#2469d7; font-size:10px; font-weight:850; box-shadow:0 8px 24px rgba(3,16,34,.38); backdrop-filter:blur(7px); }
  .play-feature__copy b { font-size:7px; }
  .play-feature__roster { position:absolute; inset:0; z-index:2; }
  .play-feature__roster img { position:absolute; display:block; object-fit:cover; object-position:center top; filter:saturate(.78) contrast(1.08); transition:transform .35s ease,filter .35s ease; }
  .play-feature:hover .play-feature__roster img { filter:saturate(1) contrast(1.08); }
  .goat-face { z-index:4; width:82px; height:98px; border:2px solid rgba(255,255,255,.34); border-radius:10px; box-shadow:0 8px 18px rgba(0,0,0,.3); }
  .goat-face--1 { left:14px; top:14px; transform:rotate(-4deg); }
  .goat-face--2 { left:50%; top:8px; transform:translateX(-50%) rotate(2deg); }
  .goat-face--3 { right:14px; top:14px; transform:rotate(4deg); }
  .goat-face--4 { left:14px; top:96px; transform:rotate(3deg); }
