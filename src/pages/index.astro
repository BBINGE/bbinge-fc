---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/HomeHero.astro';
import ArticleCardGrid from '../components/ArticleCardGrid.astro';
import { getCollection } from 'astro:content';
import { site } from '../config/site';
import { PAGE_SIZE } from '../config/pagination';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const hotArticles = articles.filter((entry) => entry.data.featured).slice(0, 4);
const firstPage = articles.slice(0, PAGE_SIZE);
const hasMore = articles.length > PAGE_SIZE;
---

<Layout title={site.name} description={site.tagline} breadcrumbs={[{ label: '홈', href: '/' }]}>
  <div class="max-w-[1040px] mx-auto px-4 md:px-5 py-6 space-y-7">
    <HomeHero hotArticles={hotArticles} />
    <ArticleCardGrid entries={firstPage} />
    {hasMore && (
      <div class="flex justify-center">
        <a
          href="/page/2/"
          class="text-[13px] font-medium text-[var(--bbfc-ink-2)] border border-[var(--bbfc-border)] rounded-[var(--bbfc-radius)] px-5 py-2.5"
        >
          다음 페이지 →
        </a>
      </div>
    )}
  </div>
</Layout>
