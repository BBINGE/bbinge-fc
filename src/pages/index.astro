---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categories, getAncestorChain, getArticlePath } from '../config/categories';
import { site } from '../config/site';
import { storeFloors } from '../config/store';
import { cultureSections } from '../config/culture';
import { seasonShelves } from '../data/reading-routes';
import { isNewlyPublished } from '../utils/freshness';
import HaechukBanner from '../components/HaechukBanner.astro';
import { imageFocusStyle } from '../utils/imageFocus';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import sharp from 'sharp';

// 메인 1:1 칸 규칙: 정사각형 편집물은 잘리지 않게 contain, 가로·세로로 긴 사진은 초점값 기준 cover로 채운다.
const squareTolerance = 0.15;
const imageShapeCache = new Map<string, boolean>();
const needsFill = async (src?: string) => {
  if (!src || !src.startsWith('/')) return false;
  if (imageShapeCache.has(src)) return imageShapeCache.get(src)!;
  const file = join(process.cwd(), 'public', src.split(/[?#]/, 1)[0]);
  let fill = false;
  if (existsSync(file)) {
    const { width, height } = await sharp(file).metadata();
    if (width && height) fill = Math.abs(width / height - 1) > squareTolerance;
  }
  imageShapeCache.set(src, fill);
  return fill;
};

// 홈은 주인공 표지 없이 백화점 층 단위로 편성한다. 층·관 이름과 링크는 src/config/store.ts가 단일 기준이다.
const locate = (root: string, extra?: string) => {
  if (root === 'culture') {
    const section = extra ? cultureSections[extra as keyof typeof cultureSections] : undefined;
    return section ? { floor: section.floor, hall: section.label } : { floor: '03', hall: '축디' };
  }
  const map: Record<string, { floor: string; hall: string }> = {
    pilgrimage: { floor: '04', hall: '축행' },
    play: { floor: '05', hall: '오락실' },
    history: { floor: '06', hall: '세계사관' },
    tactics: { floor: '07', hall: '전술관' },
    'football-made-easy': { floor: '07', hall: '축떡관' },
    squads: { floor: '08', hall: '명예의 전당' },
    highlights: { floor: '09', hall: '영화관' },
  };
  return map[root] ?? { floor: '01', hall: categories[root]?.label ?? root };
};

const articles = (await getCollection('articles', ({ data }) => !data.draft)).map((entry) => {
  const root = getAncestorChain(entry.data.category)[0]?.slug ?? entry.data.category;
  return {
    id: entry.id,
    href: getArticlePath(entry.data.category, entry.id),
    title: entry.data.title,
    description: entry.data.description,
    ...locate(root, entry.data.cultureSection),
    cardImage: entry.data.cardImage ?? entry.data.coverImage,
    coverImageAlt: entry.data.coverImageAlt ?? entry.data.title,
    pubDate: entry.data.pubDate,
  };
});

const archiveEntries = (await getCollection('archive', ({ data }) => !data.draft)).map((entry) => ({
  id: entry.id,
  href: `/archive/${entry.data.branch}/${entry.data.index}/${entry.id}/`,
  title: entry.data.title,
  description: entry.data.description,
  floor: '06',
  hall: entry.data.branch === 'legends' ? '인물관' : entry.data.branch === 'awards' ? '시상관' : '대회관',
  cardImage: entry.data.coverImage,
  coverImageAlt: entry.data.coverImageAlt ?? entry.data.title,
  pubDate: entry.data.pubDate,
}));

const feed = [...articles, ...archiveEntries].sort(
  (a, b) => b.pubDate.valueOf() - a.pubDate.valueOf() || b.id.localeCompare(a.id)
);

const used = new Set<string>();
const take = <T extends { href: string }>(items: T[]) => {
  for (const item of items) used.add(item.href);
  return items;
};

// ② 최근 입고: 발행일 순 같은 크기 10칸
const arrivals = take(feed.slice(0, 10));

// ③ 층별 진열창: 층마다 ②에 나오지 않은 최신 2편과 소장 편수. 6층은 도서실과 세계사관을 나누고, 5층 오락실은 소장 기록 옆 GOAT 포스터가 맡는다.
// tone은 각 층 목록 페이지의 승인된 색(명품관 블랙골드, 오뭐입? 블루, 아카이브 세 관, 축세 종이·잉크, 축술 네이비·축떡 잔디, 축쿼드 챔피언스 리그, H/L 나이트·골드)을 머리띠에만 옮긴다.
type FeedItem = (typeof feed)[number];
const storeFloor = (floor: string) => storeFloors.find((item) => item.floor === floor)!;
const uniqueZones = (zones: readonly { label: string; href?: string }[]) => [...new Map(zones.filter((zone) => zone.href).map((zone) => [zone.href, zone])).values()];
const floorPlan = [
  { floor: '02', name: storeFloor('02').name, href: storeFloor('02').href, zones: [], tone: 'boutique', match: (item: FeedItem) => item.floor === '02' },
  { floor: '03', name: storeFloor('03').name, href: storeFloor('03').href, zones: uniqueZones(storeFloor('03').zones), tone: 'outfit', match: (item: FeedItem) => item.floor === '03' },
  { floor: '04', name: storeFloor('04').name, href: storeFloor('04').href, zones: [], tone: 'travel', match: (item: FeedItem) => item.floor === '04' },
  { floor: '06', name: '도서실', href: '/archive/', zones: uniqueZones(storeFloor('06').zones.filter((zone) => zone.label !== '세계사관')), tone: 'library', match: (item: FeedItem) => item.floor === '06' && item.hall !== '세계사관' },
  { floor: '06', name: '세계사관', href: '/history/', zones: [], tone: 'history', match: (item: FeedItem) => item.hall === '세계사관' },
  { floor: '07', name: storeFloor('07').name, href: storeFloor('07').href, zones: uniqueZones(storeFloor('07').zones), tone: 'tactics', match: (item: FeedItem) => item.floor === '07' },
  { floor: '08', name: storeFloor('08').name, href: storeFloor('08').href, zones: [], tone: 'squads', match: (item: FeedItem) => item.floor === '08' },
  { floor: '09', name: storeFloor('09').name, href: storeFloor('09').href, zones: [], tone: 'cinema', match: (item: FeedItem) => item.floor === '09' },
];
const floors = floorPlan.map(({ match, ...floor }) => {
  const onFloor = feed.filter(match);
  return { ...floor, href: floor.href ?? '/about/store/', total: onFloor.length, picks: take(onFloor.filter((item) => !used.has(item.href)).slice(0, 2)) };
});

// ④ 시즌 서가: 연재 한 시즌을 여섯 기록의 선반으로
const shelves = seasonShelves.map((shelf) => {
  for (const story of shelf.stories) used.add(story.href);
  return shelf;
});

// ⑥ 소장 기록 더 보기: 위에서 쓰지 않은 글 8편을 옛 최근 기록 줄 형식으로, 오른쪽에 GOAT 포스터(원래 5:11 비율)
const stacks = take(feed.filter((item) => !used.has(item.href)).slice(0, 8));

const homeFill = new Map<string, boolean>();
const images = [
  ...arrivals.map((item) => item.cardImage),
  ...floors.flatMap((floor) => floor.picks.map((item) => item.cardImage)),
  ...shelves.flatMap((shelf) => shelf.stories.map((story) => story.image)),
  ...stacks.map((item) => item.cardImage),
];
for (const src of images) if (src) homeFill.set(src, await needsFill(src));
const fillClass = (src?: string) => (src && homeFill.get(src) ? 'media-frame--fill' : undefined);

const shortDate = (date: Date) => {
  const [, month, day] = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul', year: 'numeric', month: 'numeric', day: 'numeric' }).format(date).split('-');
  return `${Number(month)}.${Number(day)}`;
};
---

<Layout title={site.name} description={site.homeDescription} breadcrumbs={[{ label: '홈', href: '/' }]}>
  <main class="home-magazine max-w-[1180px] mx-auto px-4 md:px-6 py-7 md:py-10">
    <h1 class="sr-only">삥이FC - 축구의 역사와 문화를 읽고 기록하는 독립 매거진</h1>

    <header class="edition-head">
      <div>
        <p class="edition-kicker">BBINGE FC · FOOTBALL ARCHIVE MAGAZINE</p>
        <p class="edition-title">축구의 역사를 놀고, 읽고, 걷는 곳</p>
      </div>
      <p class="edition-note">역사 · 공간 · 유니폼 · 서사</p>
    </header>

    <section class="lobby-bar" aria-label="삥이FC 메인 로비">
      <div class="lobby-bar__copy">
        <p class="lobby-kicker"><span>01F</span> PB ONLINE MAIN</p>
        <h2>축구 문화가 모이는 로비</h2>
        <p>경기 결과보다 오래 남는 축구의 역사·공간·유니폼·서사를 기록하는 독립 매거진입니다.</p>
      </div>
      <nav class="lobby-actions" aria-label="삥이FC와 저자 소개">
        <a href="/about/"><img src="/images/profile-bbinge-192.webp" alt="" width="36" height="36" decoding="async" /><span><small>AUTHOR</small><strong>저자 @삥이</strong></span></a>
        <a href="/about/logo/"><img src="/images/brand/pb-mark-2026-color-240.webp" alt="" width="36" height="36" decoding="async" /><span><small>IDENTITY</small><strong>로고 이야기</strong></span></a>
        <a href="/about/store/"><span class="floor-disc" aria-hidden="true">01F</span><span><small>FLOOR MAP</small><strong>전체 층별 안내</strong></span></a>
        <a href="/play/"><span class="goat-disc" aria-hidden="true">32</span><span><small>PB ARCADE</small><strong>나만의 GOAT</strong></span></a>
      </nav>
    </section>

    {arrivals.length > 0 ? (
      <section class="home-section" aria-labelledby="arrivals-heading">
        <div class="section-heading">
          <div><p>NEW ARRIVALS</p><h2 id="arrivals-heading">최근 입고</h2></div>
          <a href="/search/">모든 기록 검색 <span aria-hidden="true">→</span></a>
        </div>
        <div class="arrival-grid">
          {arrivals.map((item, index) => (
            <a href={item.href} class="arrival-card group">
              <div class:list={['arrival-thumb', 'media-frame', fillClass(item.cardImage)]}>
                {item.cardImage ? (
                  <img src={item.cardImage} alt={item.coverImageAlt} width="320" height="320" loading={index < 5 ? 'eager' : 'lazy'} decoding="async" fetchpriority={index === 0 ? 'high' : undefined} style={imageFocusStyle(item.cardImage, { zoom: false })} />
                ) : (
                  <span>NO IMAGE</span>
                )}
              </div>
              <div class="story-meta">
                <span class="floor-tag">{item.floor}F {item.hall}</span>
                <time datetime={item.pubDate.toISOString()}>{shortDate(item.pubDate)}</time>
                {isNewlyPublished(item.pubDate) && <span class="new-mark">NEW</span>}
              </div>
              <h3>{item.title}</h3>
            </a>
          ))}
        </div>
      </section>
    ) : (
      <p class="empty-state">첫 번째 이야기를 준비하고 있습니다.</p>
    )}

    <section class="home-section" aria-labelledby="floors-heading">
      <div class="section-heading">
        <div><p>FLOOR DIRECTORY</p><h2 id="floors-heading">층별 진열창</h2></div>
        <a href="/about/store/">전체 층별 안내 <span aria-hidden="true">→</span></a>
      </div>
      <div class="floor-grid">
          {floors.map((floor) => (
            <article class:list={['floor-card', 'floor-card--' + floor.tone]}>
              <header class="floor-card__head">
                <a href={floor.href} class="floor-card__name"><span class="floor-pill">{floor.floor}F</span><strong>{floor.name}</strong></a>
                {floor.total > 0 && <span class="floor-card__count">{floor.total}편</span>}
              </header>
              <div class="floor-card__body">
                {floor.zones.length > 1 && (
                  <ul class="floor-card__zones">
                    {floor.zones.map((zone) => <li><a href={zone.href}>{zone.label}</a></li>)}
                  </ul>
                )}
                {floor.picks.length > 0 ? (
                  <ul class="floor-card__picks">
                    {floor.picks.map((item) => (
                      <li>
                        <a href={item.href} class="floor-pick group">
                          <div class:list={['floor-thumb', 'media-frame', fillClass(item.cardImage)]}>
                            {item.cardImage ? <img src={item.cardImage} alt="" width="72" height="72" loading="lazy" decoding="async" style={imageFocusStyle(item.cardImage, { zoom: false })} /> : <span>NO IMAGE</span>}
                          </div>
                          <span class="floor-pick__copy"><small>{item.hall} · {shortDate(item.pubDate)}</small><strong>{item.title}</strong></span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="floor-card__more">최근 입고에 이 층의 새 기록이 올라 있습니다.</p>
                )}
                <a href={floor.href} class="floor-card__enter">{floor.name} 둘러보기 <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
      </div>
    </section>

    {shelves.length > 0 && (
      <section class="home-section" aria-labelledby="shelves-heading">
        <div class="section-heading">
          <div><p>SEASON SHELF</p><h2 id="shelves-heading">시즌 서가</h2></div>
          <a href="/archive/competitions/">대회관 <span aria-hidden="true">→</span></a>
        </div>
        {shelves.map((shelf) => (
          <div class="shelf">
            <div class="shelf__head"><p>{shelf.kicker}</p><h3>{shelf.title}</h3></div>
            <ol class="shelf__row">
              {shelf.stories.map((story) => (
                <li>
                  <a href={story.href} class="shelf-item group">
                    <div class:list={['shelf-thumb', 'media-frame', fillClass(story.image)]}>
                      <img src={story.image} alt="" width="180" height="180" loading="lazy" decoding="async" style={imageFocusStyle(story.image, { zoom: false })} />
                      <span class="shelf-index">{story.index}</span>
                    </div>
                    <small>{story.label}</small>
                    <strong>{story.title}</strong>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </section>
    )}

    <HaechukBanner />

    {stacks.length > 0 && (
      <section class="home-section home-section--last" aria-labelledby="stacks-heading">
        <div class="section-heading">
          <div><p>FROM THE STACKS</p><h2 id="stacks-heading">소장 기록 더 보기</h2></div>
          <a href="/archive/">전체 아카이브 <span aria-hidden="true">→</span></a>
        </div>
        <div class="latest-layout">
          <div class="latest-list">
            {stacks.map((item, index) => (
              <a href={item.href} class="latest-row">
                <span class="latest-index">{String(index + 1).padStart(2, '0')}</span>
                <div class:list={['latest-thumb', 'media-frame', fillClass(item.cardImage)]}>
                  {item.cardImage ? <img src={item.cardImage} alt="" width="112" height="112" loading="lazy" decoding="async" style={imageFocusStyle(item.cardImage, { zoom: false })} /> : <span>NO IMAGE</span>}
                </div>
                <div class="latest-copy">
                  <div class="story-meta"><span class="floor-tag">{item.floor}F {item.hall}</span></div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
                <time datetime={item.pubDate.toISOString()}>{shortDate(item.pubDate)}</time>
              </a>
            ))}
          </div>

          <a href="/play/" class="play-feature" aria-label="GOAT 32강 토너먼트 시작하기">
            <div class="play-feature__copy">
              <p>BBINGE FC PRESENTS</p>
              <strong>GOAT<br />SHOWDOWN</strong>
              <h2>전설 32명.<br />왕은 한 명.</h2>
              <span>32강 바로 시작 <b aria-hidden="true">▶</b></span>
            </div>
            <div class="play-feature__roster" aria-hidden="true">
              <img src="/images/goat/players/di-stefano.webp" alt="" class="goat-face goat-face--1" loading="lazy" decoding="async" />
              <img src="/images/goat/players/puskas.webp" alt="" class="goat-face goat-face--2" loading="lazy" decoding="async" />
              <img src="/images/goat/players/pele.webp" alt="" class="goat-face goat-face--3" loading="lazy" decoding="async" />
              <img src="/images/goat/players/beckenbauer.webp" alt="" class="goat-face goat-face--4" loading="lazy" decoding="async" />
              <img src="/images/goat/players/cruyff.webp" alt="" class="goat-face goat-face--5" loading="lazy" decoding="async" />
              <img src="/images/goat/players/maradona.webp" alt="" class="goat-face goat-face--6" loading="lazy" decoding="async" />
              <img src="/images/goat/players/cristiano.webp" alt="" class="goat-hero goat-hero--ronaldo" loading="lazy" decoding="async" />
              <img src="/images/goat/players/messi.webp" alt="" class="goat-hero goat-hero--messi" loading="lazy" decoding="async" />
            </div>
            <span class="play-feature__eight" aria-hidden="true">32</span>
          </a>
        </div>
      </section>
    )}
  </main>
</Layout>

<style>
  .home-magazine { color:var(--bbfc-ink); }
  .edition-head { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; padding:0 0 14px; border-bottom:2px solid var(--bbfc-ink); }
  .edition-kicker,.section-heading p,.shelf__head p { color:var(--bbfc-blue); font-size:13px; line-height:1.4; font-weight:750; letter-spacing:.12em; }
  .edition-title { margin-top:6px; font-size:17px; line-height:1.4; font-weight:620; letter-spacing:-.025em; }
  .edition-note { color:var(--bbfc-gray-2); font-size:13px; letter-spacing:.08em; white-space:nowrap; }

  /* ① 로비 한 줄 */
  .lobby-bar { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:24px; margin-top:16px; padding:16px 20px; border-radius:var(--bbfc-radius-lg); background:var(--bbfc-ink); color:#fff; }
  .lobby-bar__copy { display:grid; grid-template-columns:auto minmax(0,1fr); align-items:center; column-gap:22px; row-gap:4px; }
  .lobby-kicker { grid-column:1; display:flex; align-items:center; gap:9px; color:rgba(255,255,255,.72); font-size:13px; line-height:1.2; font-weight:750; letter-spacing:.1em; white-space:nowrap; }
  .lobby-kicker span { display:inline-grid; place-items:center; min-width:44px; height:28px; border-radius:999px; background:var(--bbfc-blue); color:#fff; font-size:13px; letter-spacing:.04em; }
  .lobby-bar h2 { grid-column:1; font-size:22px; line-height:1.2; font-weight:690; letter-spacing:-.04em; white-space:nowrap; }
  .lobby-bar__copy>p:last-child { grid-column:2; grid-row:1 / 3; padding-left:22px; border-left:1px solid rgba(255,255,255,.2); color:rgba(255,255,255,.76); font-size:14px; line-height:1.6; }
  .lobby-actions { display:grid; grid-template-columns:repeat(4,auto); gap:6px; }
  .lobby-actions a { display:flex; align-items:center; gap:8px; min-height:48px; padding:6px 12px 6px 7px; border:1px solid rgba(255,255,255,.18); border-radius:999px; background:rgba(255,255,255,.06); transition:border-color .18s,background .18s; }
  .lobby-actions a:hover { border-color:#86b7ff; background:rgba(134,183,255,.14); }
  .lobby-actions img,.lobby-actions .floor-disc,.lobby-actions .goat-disc { width:34px; height:34px; flex:0 0 34px; }
  .lobby-actions img { border-radius:50%; background:#fff; object-fit:cover; padding:2px; }
  .floor-disc,.goat-disc { display:grid; place-items:center; border-radius:50%; background:#fff; color:var(--bbfc-blue); font-size:12px; font-weight:850; }
  .goat-disc { background:var(--bbfc-blue); color:#fff; }
  .lobby-actions small { display:block; color:#86b7ff; font-size:12px; line-height:1.1; font-weight:780; letter-spacing:.08em; }
  .lobby-actions strong { display:block; margin-top:2px; color:#fff; font-size:14px; line-height:1.2; font-weight:650; white-space:nowrap; }

  /* 공통 */
  .home-section { margin-top:34px; }
  .home-section--last { margin-bottom:8px; }
  .section-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; padding-bottom:10px; border-bottom:1px solid var(--bbfc-ink); }
  .section-heading h2 { margin-top:4px; font-size:24px; line-height:1.2; font-weight:680; letter-spacing:-.04em; }
  .section-heading>a { color:var(--bbfc-gray-1); font-size:15px; white-space:nowrap; }
  .section-heading>a:hover { color:var(--bbfc-blue); }
  .media-frame { position:relative; overflow:hidden; aspect-ratio:1; background:var(--bbfc-fill); border-radius:6px; }
  .media-frame img { display:block; width:100%; height:100%; object-fit:contain; }
  .media-frame--fill img { object-fit:cover; }
  .media-frame>span:not(.shelf-index) { display:grid; place-items:center; height:100%; color:var(--bbfc-gray-2); font-size:13px; }
  .story-meta { display:flex; flex-wrap:wrap; align-items:center; gap:4px 8px; color:var(--bbfc-gray-2); font-size:13px; line-height:1.4; }
  .floor-tag { color:var(--bbfc-blue); font-weight:700; }
  .new-mark { padding:2px 6px; border-radius:999px; background:var(--bbfc-blue-weak); color:var(--bbfc-blue); font-size:12px; font-weight:800; letter-spacing:.04em; }
  .empty-state { padding:50px 0; color:var(--bbfc-gray-2); font-size:15px; text-align:center; }

  /* ② 최근 입고 */
