---
// 카테고리 트리(무한 depth) + 글 페이지를 함께 처리하는 캐치올 라우트.
// URL 규칙:
//  - 카테고리 리스팅: /{조상 slug 체인 전체}/  (예: /history/, 나중에 하위가 생기면 /history/sub-slug/)
//  - 글 페이지: /{글 자신의 category 값}/{글 slug}/  (카테고리 depth와 무관하게 항상 2세그먼트 고정 — 기존 링크 코드와 호환)
// 'play'는 GOAT 토너먼트 전용 페이지(src/pages/play/index.astro)가 대신하므로 카테고리 리스팅에서 제외한다.
import { site } from '../config/site';
import Layout from '../layouts/Layout.astro';
import CategoryArticleList from '../components/CategoryArticleList.astro';
import RelatedList from '../components/RelatedList.astro';
import AdSlot from '../components/AdSlot.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { categories, categoryList, getAncestorChain, getChildren } from '../config/categories';
import ShareButtons from '../components/ShareButtons.astro';
import ContentCover from '../components/ContentCover.astro';

type CategoryProps = { kind: 'category'; categorySlug: string };
type ArticleProps = { kind: 'article'; entry: CollectionEntry<'articles'> };

export async function getStaticPaths() {
  const categoryPaths = categoryList
    .filter(({ slug }) => slug !== 'play')
    .map(({ slug }) => ({
      params: { path: getAncestorChain(slug).map((c) => c.slug).join('/') },
      props: { kind: 'category', categorySlug: slug } satisfies CategoryProps,
    }));

  const entries = await getCollection('articles', ({ data }) => !data.draft);
  const articlePaths = entries.map((entry) => ({
    params: { path: `${entry.data.category}/${entry.id}` },
    props: { kind: 'article', entry } satisfies ArticleProps,
  }));

  return [...categoryPaths, ...articlePaths];
}

const props = Astro.props as CategoryProps | ArticleProps;

let categoryView:
  | {
      categorySlug: string;
      meta: (typeof categories)[string];
      children: ReturnType<typeof getChildren>;
      articles: CollectionEntry<'articles'>[];
      hasContent: boolean;
    }
  | null = null;

let articleView:
  | {
      entry: CollectionEntry<'articles'>;
      meta: (typeof categories)[string];
      Content: Awaited<ReturnType<typeof render>>['Content'];
      readingMinutes: number;
      related: CollectionEntry<'articles'>[];
      faqSchema: object | null;
    }
  | null = null;

if (props.kind === 'category') {
  const { categorySlug } = props;
  const meta = categories[categorySlug];
  const children = getChildren(categorySlug);
  const publishedArticles = await getCollection('articles', ({ data }) => !data.draft);
  const articles = publishedArticles
    .filter(({ data }) => data.category === categorySlug)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.id.localeCompare(a.id));
  const hasContent = publishedArticles.some(({ data }) =>
    getAncestorChain(data.category).some(({ slug }) => slug === categorySlug)
  );
  categoryView = { categorySlug, meta, children, articles, hasContent };
} else {
  const { entry } = props;
  const { category, faq } = entry.data;
  const meta = categories[category];
  const { Content } = await render(entry);
  const readingMinutes = Math.max(1, Math.round((entry.body?.length ?? 0) / 500));
  const related = (
    await getCollection(
      'articles',
      ({ data, id }) => !data.draft && data.category === category && id !== entry.id
    )
  )
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.id.localeCompare(a.id))
    .slice(0, 3);
  const faqSchema =
    faq && faq.length > 0
      ? {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: faq.map((item) => ({
            '@type': 'Question',
            name: item.question,
            acceptedAnswer: { '@type': 'Answer', text: item.answer },
          })),
        }
      : null;
  articleView = { entry, meta, Content, readingMinutes, related, faqSchema };
}
---

{categoryView && (
  <Layout
    title={categoryView.meta.label}
    description={`${categoryView.meta.fullLabel} — ${site.name}`}
    robots={categoryView.hasContent ? 'index,follow,max-image-preview:large' : 'noindex,follow'}
    breadcrumbs={[
      { label: '홈', href: '/' },
      { label: categoryView.meta.label, href: `/${categoryView.categorySlug}/` },
    ]}
  >
    <div class="max-w-[1040px] mx-auto px-4 md:px-5 py-6">
      <div class="min-w-0">
        <div class="flex items-baseline gap-2 mb-5">
          <h1 class="text-[24px] font-medium text-[var(--bbfc-ink)]">{categoryView.meta.label}</h1>
          <p class="text-[13px] text-[var(--bbfc-gray-2)] mt-1">{categoryView.meta.fullLabel}</p>
          <span class="text-[13px] text-[var(--bbfc-gray-2)]">{categoryView.articles.length}편</span>
        </div>

        {categoryView.children.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-5">
            {categoryView.children.map((child) => (
              <a
                href={`/${categoryView!.categorySlug}/${child.slug}/`}
                class="text-[12.5px] text-[var(--bbfc-ink-2)] border border-[var(--bbfc-border)] rounded-[var(--bbfc-radius)] px-3 py-1.5"
              >
                {child.label}
              </a>
            ))}
          </div>
        )}

        <CategoryArticleList entries={categoryView.articles} />
      </div>
    </div>
  </Layout>
)}

{articleView && (
  <Layout
    title={articleView.entry.data.title}
    description={articleView.entry.data.description}
    ogImage={articleView.entry.data.coverImage}
    ogImageAlt={articleView.entry.data.coverImageAlt ?? articleView.entry.data.title}
    ogImageWidth={articleView.entry.data.coverImageWidth}
    ogImageHeight={articleView.entry.data.coverImageHeight}
    ogImageCaption={articleView.entry.data.coverImageCaption}
    type="article"
    article={{ pubDate: articleView.entry.data.pubDate, updatedDate: articleView.entry.data.updatedDate }}
    breadcrumbs={[
      { label: '홈', href: '/' },
      { label: articleView.meta.label, href: `/${articleView.entry.data.category}/` },
      { label: articleView.entry.data.title, href: `/${articleView.entry.data.category}/${articleView.entry.id}/` },
    ]}
  >
    {articleView.faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(articleView.faqSchema)} />}

    <div class="max-w-[920px] mx-auto px-4 md:px-6 py-8 md:py-12">
      <article>
        <span class="text-[11px] text-[var(--bbfc-blue)]">{articleView.meta.label}</span>
        <h1 class="text-[30px] md:text-[42px] font-semibold mt-3 mb-4 leading-[1.2] tracking-[-0.035em] text-[var(--bbfc-ink)]">{articleView.entry.data.title}</h1>
        <p class="text-[13px] text-[var(--bbfc-gray-2)] mb-6">
          {articleView.entry.data.pubDate.toLocaleDateString('ko-KR')} · {articleView.readingMinutes}분 읽기
        </p>
        {articleView.entry.data.coverImage && (
          <ContentCover
            src={articleView.entry.data.coverImage}
            alt={articleView.entry.data.coverImageAlt ?? articleView.entry.data.title}
            caption={articleView.entry.data.coverImageCaption}
            width={articleView.entry.data.coverImageWidth}
            height={articleView.entry.data.coverImageHeight}
          />
        )}
        <div class="article-body text-[17px] md:text-[18px] leading-[1.9] text-[var(--bbfc-ink)]">
          <articleView.Content />
        </div>

        <div class="mt-6 pt-4 border-t border-[var(--bbfc-line)]">
          <ShareButtons
            url={new URL(`/${articleView.entry.data.category}/${articleView.entry.id}/`, site.url).toString()}
            title={articleView.entry.data.title}
          />
        </div>
      </article>

      {articleView.related.length > 0 && (
        <div class="mt-10">
          <h2 class="text-[15px] font-medium mb-1 text-[var(--bbfc-ink)]">{articleView.meta.label} 카테고리의 다른 글</h2>
          <RelatedList entries={articleView.related} />
        </div>
      )}

      <AdSlot />
    </div>
  </Layout>
)}

<style>
  .article-body :global(h2) {
    border-left: 4px solid var(--bbfc-blue);
    padding-left: 14px;
    font-size: 26px;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -0.025em;
    margin-top: 76px;
    margin-bottom: 20px;
    color: var(--bbfc-ink);
  }
  .article-body :global(p) {
    margin-top: 22px;
  }
  .article-body :global(a) {
    color: var(--bbfc-blue);
  }
  .article-body :global(blockquote) {
    border-left: 3px solid var(--bbfc-blue);
    padding-left: 14px;
    margin: 20px 0;
    color: var(--bbfc-ink-2);
  }
  .article-body :global(strong) { font-weight: 680; }
  .article-body :global(figure) { margin: 48px 0; }
  .article-body :global(figure > img) { display: block; width: 100%; height: auto; border-radius: var(--bbfc-radius-lg); }
  .article-body :global(figcaption) { margin-top: 11px; font-size: 13px; line-height: 1.65; text-align: center; color: var(--bbfc-gray-2); }
  .article-body :global(.hero-figure) { margin-top: 12px; }
  .article-body :global(.portrait-figure) { max-width: 620px; margin-left: auto; margin-right: auto; }
  .article-body :global(.document-figure) { max-width: 780px; margin-left: auto; margin-right: auto; padding: 18px; border: 1px solid var(--bbfc-border); background: var(--bbfc-fill-2); border-radius: var(--bbfc-radius-lg); }
  .article-body :global(.document-figure img) { border-radius: var(--bbfc-radius); }
  .article-body :global(.media-grid) { display: grid; gap: 16px; margin: 52px 0; }
  .article-body :global(.media-grid-three) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .article-body :global(.media-grid > figure) { margin: 0; }
  .article-body :global(.media-grid img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--bbfc-radius-lg); }
  .article-body :global(.column-thesis) { margin: 48px 0 64px; padding: 24px 28px 26px; border-top: 2px solid var(--bbfc-blue); background: var(--bbfc-fill-2); }
  .article-body :global(.column-thesis > span) { font-size: 10px; font-weight: 700; letter-spacing: .14em; color: var(--bbfc-blue); }
  .article-body :global(.column-thesis p) { margin-top: 12px; font-size: 20px; line-height: 1.65; font-weight: 620; color: var(--bbfc-ink); }
  .article-body :global(.foreign-note) { font-size: max(.72em, 12px); line-height: inherit; font-weight: 400; letter-spacing: 0; color: var(--bbfc-gray-2); vertical-align: baseline; }
  .article-body :global(code) {
    background: var(--bbfc-fill);
    border-radius: 4px;
    padding: 2px 5px;
    font-size: 0.9em;
  }
  .article-body :global(pre) {
    background: var(--bbfc-fill);
    border-radius: var(--bbfc-radius);
    padding: 14px;
    overflow-x: auto;
  }
  .article-body :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .article-body :global(table) {
    width: 100%;
    background: var(--bbfc-fill);
    border-collapse: collapse;
    margin: 32px 0;
  }
  .article-body :global(th),
  .article-body :global(td) {
    border: 1px solid var(--bbfc-border);
    padding: 8px 10px;
    text-align: left;
  }
  .article-body :global(.club-honours-wrap) { margin: 42px 0 54px; overflow-x: auto; }
  .article-body :global(.club-honours) { min-width: 700px; margin: 0; border-top: 2px solid var(--bbfc-ink); border-bottom: 1px solid var(--bbfc-gray-2); }
  .article-body :global(.club-honours th),
  .article-body :global(.club-honours td) { padding: 13px 16px; vertical-align: middle; }
  .article-body :global(.club-honours thead th) { background: #fff; color: var(--bbfc-ink); font-weight: 500; }
  .article-body :global(.club-honours .group-cell) { width: 104px; text-align: center; font-weight: 500; background: #fff; color: var(--bbfc-ink); }
  .article-body :global(.club-honours .org-cell) { width: 224px; text-align: center; font-weight: 760; color: #fff; }
  .article-body :global(.club-honours .ajax-row .org-cell) { background: #b7193f; }
  .article-body :global(.club-honours .feyenoord-row .org-cell) { background: #e30613; color: #f2cf66; }
  .article-body :global(.club-honours .psv-row .org-cell) { background: #ed1b24; }
  .article-body :global(.club-honours .netherlands-row .org-cell) { background: #f36c21; }
  .article-body :global(.club-honours ul) { margin: 0; padding-left: 1.2rem; list-style: disc outside; }
  .article-body :global(.club-honours li) { margin: 2px 0; line-height: 1.5; }
  .article-body :global(.source-notes) { margin-top: 70px; padding-top: 22px; border-top: 1px solid var(--bbfc-border); color: var(--bbfc-gray-2); font-size: 12px; line-height: 1.65; }
  .article-body :global(.source-notes h2) { margin: 0 0 10px; padding: 0; border: 0; font-size: 12px; line-height: 1.4; font-weight: 650; letter-spacing: .02em; color: var(--bbfc-gray-2); }
  .article-body :global(.source-notes ol) { margin: 0; padding-left: 18px; }
  .article-body :global(.source-notes li) { margin: 2px 0; }
  .article-body :global(.source-notes a) { color: inherit; text-decoration-color: color-mix(in srgb, currentColor 45%, transparent); }
  @media (max-width: 899px) {
    .article-body :global(.media-grid-three) { grid-template-columns: 1fr; }
    .article-body :global(.media-grid img) { aspect-ratio: 16 / 10; }
  }
  @media (max-width: 767px) {
    .article-body :global(h2) { margin-top: 58px; padding-left: 11px; font-size: 22px; }
    .article-body :global(p) { margin-top: 19px; }
    .article-body :global(figure) { margin: 38px 0; }
    .article-body :global(.document-figure) { padding: 10px; }
    .article-body :global(.column-thesis) { margin: 38px 0 52px; padding: 21px 20px 23px; }
    .article-body :global(.column-thesis p) { font-size: 18px; }
    .article-body :global(table) { display: block; overflow-x: auto; font-size: 14px; }
    .article-body :global(.club-honours) { display: table; font-size: 13px; }
    .article-body :global(.source-notes) { margin-top: 54px; font-size: 11px; }
    .article-body :global(.source-notes h2) { font-size: 11px; }
  }
  @media (max-width: 639px) {
    .article-body :global(.club-honours-wrap) { margin: 34px 0 44px; overflow: visible; }
    .article-body :global(.club-honours) { display: block; min-width: 0; width: 100%; border: 0; font-size: 13px; }
    .article-body :global(.club-honours thead) { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
    .article-body :global(.club-honours tbody),
    .article-body :global(.club-honours tr),
    .article-body :global(.club-honours th),
    .article-body :global(.club-honours td) { display: block; width: 100%; }
    .article-body :global(.club-honours tr) { margin: 0 0 18px; border: 1px solid var(--bbfc-border); border-radius: var(--bbfc-radius-lg); overflow: hidden; }
    .article-body :global(.club-honours th),
    .article-body :global(.club-honours td) { border: 0; }
    .article-body :global(.club-honours .group-cell) { width: 100%; padding: 7px 14px; text-align: left; font-size: 11px; letter-spacing: .08em; color: var(--bbfc-gray-2); background: var(--bbfc-fill-2); }
    .article-body :global(.club-honours .org-cell) { width: 100%; padding: 14px 16px; text-align: left; }
    .article-body :global(.club-honours .honours-cell) { padding: 14px 18px 16px; background: #fff; }
    .article-body :global(.club-honours ul) { padding-left: 1.15rem; }
    .article-body :global(.club-honours li) { margin: 4px 0; line-height: 1.55; }
    .article-body :global(.club-honours .feyenoord-row::before),
    .article-body :global(.club-honours .psv-row::before) { display: block; padding: 7px 14px; background: var(--bbfc-fill-2); color: var(--bbfc-gray-2); font-size: 11px; line-height: 1.4; letter-spacing: .08em; content: '클럽'; }
  }
</style>
