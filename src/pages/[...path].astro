      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const video = entry.target;
          if (entry.isIntersecting) video.play().catch(() => {});
          else video.pause();
        });
      }, { threshold: 0.58 });
      clips.forEach((clip) => observer.observe(clip));
    }
  </script>
)}

{articleView && (
  <script is:inline>
    (function () {
      const videos = document.querySelectorAll('[data-inline-video]');
      if (!videos.length) return;

      videos.forEach((video) => {
        const triggers = video.querySelectorAll('[data-inline-video-trigger]');
        const poster = video.querySelector('[data-inline-video-poster]');
        const player = video.querySelector('.inline-video__player');
        const frame = player?.querySelector('iframe');
        const close = player?.querySelector('[data-inline-video-close]');
        const label = video.querySelector('[data-inline-video-label]');
        const icon = label?.previousElementSibling;
        const src = video.getAttribute('data-video-src');
        if (!triggers.length || !poster || !player || !frame || !close || !src) return;

        let opener = triggers[0];
        const setPlayingLabel = (isPlaying) => {
          if (label) label.textContent = isPlaying ? '영상 닫기' : '이 자리에서 공식 영상 재생';
          if (icon) icon.textContent = isPlaying ? '×' : '▶';
        };
        const openPlayer = (trigger) => {
          opener = trigger;
          frame.setAttribute('src', src);
          poster.hidden = true;
          player.hidden = false;
          video.classList.add('is-playing');
          setPlayingLabel(true);
        };
        const closePlayer = () => {
          frame.removeAttribute('src');
          player.hidden = true;
          poster.hidden = false;
          video.classList.remove('is-playing');
          setPlayingLabel(false);
          opener?.focus();
        };

        triggers.forEach((trigger) => {
          trigger.addEventListener('click', () => {
            if (video.classList.contains('is-playing')) {
              closePlayer();
              return;
            }
            openPlayer(trigger);
          });
        });
        close.addEventListener('click', closePlayer);
        setPlayingLabel(false);
      });
    })();
  </script>
)}

{articleView && (
  <script is:inline>
    (function () {
      const ageItems = document.querySelectorAll('[data-birth-date]');
      if (!ageItems.length) return;

      const todayParts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Asia/Seoul',
        year: 'numeric',
        month: 'numeric',
        day: 'numeric',
      }).formatToParts(new Date());
      const today = Object.fromEntries(todayParts.map(({ type, value }) => [type, Number(value)]));

      ageItems.forEach((item) => {
        const birthDate = item.getAttribute('data-birth-date');
        if (!birthDate) return;
        const [birthYear, birthMonth, birthDay] = birthDate.split('-').map(Number);
        if (![birthYear, birthMonth, birthDay].every(Number.isFinite)) return;

        const yearAge = today.year - birthYear;
        const birthdayPassed = today.month > birthMonth || (today.month === birthMonth && today.day >= birthDay);
        const fullAge = yearAge - (birthdayPassed ? 0 : 1);
        const yearAgeTarget = item.querySelector('[data-year-age]');
        const fullAgeTarget = item.querySelector('[data-full-age]');
        if (yearAgeTarget) yearAgeTarget.textContent = String(yearAge);
        if (fullAgeTarget) fullAgeTarget.textContent = String(fullAge);
      });
    })();
  </script>
)}

{articleView && (
  <script is:inline>
    (function () {
      const containers = document.querySelectorAll('.custom-xi-music[data-youtube-id]');
      if (!containers.length) return;

      containers.forEach((container) => {
        const toggles = container.querySelectorAll('.music-toggle');
        const wrapper = container.querySelector('.custom-xi-music-player');
        const frame = container.querySelector('iframe');
        if (!toggles.length || !wrapper || !frame) return;

        const videoId = container.getAttribute('data-youtube-id');
        const playerSrc = videoId ? `https://www.youtube-nocookie.com/embed/${videoId}?rel=0&autoplay=1&playsinline=1&loop=1&playlist=${videoId}` : '';
        const primary = toggles[1] || toggles[0];
        const playStateText = {
          closed: ['▶', '재생하기'],
          open: ['▾', '접기'],
        };

        const updateUI = (isOpen) => {
          toggles.forEach((toggle) => {
            if (toggle.classList.contains('music-cta')) {
              toggle.textContent = isOpen ? playStateText.open[1] : playStateText.closed[1];
              return;
            }
            if (toggle.classList.contains('music-toggle')) {
              toggle.textContent = isOpen ? playStateText.open[0] : playStateText.closed[0];
            }
          });
        };
        const closePlayer = () => {
          frame.removeAttribute('src');
          wrapper.hidden = true;
          container.classList.remove('is-playing');
          updateUI(false);
        };
        const openPlayer = () => {
          if (playerSrc) frame.src = playerSrc;
          wrapper.hidden = false;
          container.classList.add('is-playing');
          updateUI(true);
        };
        const toggle = () => {
          if (container.classList.contains('is-playing')) {
            closePlayer();
            return;
          }
          openPlayer();
        };

        toggles.forEach((toggleButton) => toggleButton.addEventListener('click', toggle));
        updateUI(false);
        if (primary) {
          primary.setAttribute('aria-label', '삽입형 BGM 접기/재생 토글');
        }
      });
    })();
  </script>
)}

