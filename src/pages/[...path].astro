---
// 카테고리 트리(무한 depth) + 글 페이지를 함께 처리하는 캐치올 라우트.
// URL 규칙:
//  - 카테고리 리스팅: /{조상 slug 체인 전체}/  (예: /history/, 나중에 하위가 생기면 /history/sub-slug/)
//  - 글 페이지: /{글 자신의 category 값}/{글 slug}/  (카테고리 depth와 무관하게 항상 2세그먼트 고정 - 기존 링크 코드와 호환)
// 'play'는 GOAT 토너먼트 전용 페이지(src/pages/play/index.astro)가 대신하므로 카테고리 리스팅에서 제외한다.
import { site } from '../config/site';
import Layout from '../layouts/Layout.astro';
import CategoryArticleList from '../components/CategoryArticleList.astro';
import RelatedList from '../components/RelatedList.astro';
import AdSlot from '../components/AdSlot.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { categories, categoryList, getAncestorChain, getArticlePath, getCategoryPath, getChildren } from '../config/categories';
import ShareButtons from '../components/ShareButtons.astro';
import ContentCover from '../components/ContentCover.astro';
import ArticleByline from '../components/ArticleByline.astro';
import ArticleProvenance from '../components/ArticleProvenance.astro';
import RelatedAssets from '../components/RelatedAssets.astro';
import FashionCategoryPage from '../components/FashionCategoryPage.astro';
import PilgrimageCategoryPage from '../components/PilgrimageCategoryPage.astro';
import FashionProfileCard from '../components/FashionProfileCard.astro';
import { archiveBranches } from '../data/archive';

type CategoryProps = { kind: 'category'; categorySlug: string };
type ArticleProps = { kind: 'article'; entry: CollectionEntry<'articles'> };

export async function getStaticPaths() {
  const categoryPaths = categoryList
    .filter(({ slug }) => slug !== 'play')
    .map(({ slug }) => ({
      params: { path: getAncestorChain(slug).map((c) => c.slug).join('/') },
      props: { kind: 'category', categorySlug: slug } satisfies CategoryProps,
    }));

  const entries = await getCollection('articles', ({ data }) => !data.draft);
  const articlePaths = entries.map((entry) => ({
    params: { path: getArticlePath(entry.data.category, entry.id).replace(/^\//, '').replace(/\/$/, '') },
    props: { kind: 'article', entry } satisfies ArticleProps,
  }));

  return [...categoryPaths, ...articlePaths];
}

const props = Astro.props as CategoryProps | ArticleProps;

let categoryView:
  | {
      categorySlug: string;
      meta: (typeof categories)[string];
      children: ReturnType<typeof getChildren>;
      articles: CollectionEntry<'articles'>[];
      hasContent: boolean;
    }
  | null = null;

let articleView:
  | {
      entry: CollectionEntry<'articles'>;
      meta: (typeof categories)[string];
      Content: Awaited<ReturnType<typeof render>>['Content'];
      related: CollectionEntry<'articles'>[];
      relatedAssets: Array<{ href: string; title: string; description: string; label: string; coverImage?: string }>;
      faqSchema: object | null;
    }
  | null = null;

if (props.kind === 'category') {
  const { categorySlug } = props;
  const meta = categories[categorySlug];
  const children = getChildren(categorySlug);
  const publishedArticles = await getCollection('articles', ({ data }) => !data.draft);
  const hasPublishedContent = (slug: string) =>
    publishedArticles.some(({ data }) =>
      getAncestorChain(data.category).some(({ slug: ancestorSlug }) => ancestorSlug === slug)
    );
  const articles = publishedArticles
    .filter(({ data }) => getAncestorChain(data.category).some(({ slug }) => slug === categorySlug))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.id.localeCompare(a.id));
  const hasContent = hasPublishedContent(categorySlug);
  const visibleChildren = children.filter(({ slug }) => hasPublishedContent(slug));
  categoryView = { categorySlug, meta, children: visibleChildren, articles, hasContent };
} else {
  const { entry } = props;
  const { category, faq } = entry.data;
  const meta = categories[category];
  const { Content } = await render(entry);
  const related = (
    await getCollection(
      'articles',
      ({ data, id }) => !data.draft && data.category === category && id !== entry.id
    )
  )
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.id.localeCompare(a.id))
    .slice(0, 3);
  const relatedAssets = entry.data.relatedGroup
    ? (await getCollection('archive', ({ data }) => !data.draft && data.relatedGroup === entry.data.relatedGroup))
        .map((record) => {
          const relatedBranch = archiveBranches.find((item) => item.id === record.data.branch);
          const relatedIndex = relatedBranch?.indexes.find((item) => item.slug === record.data.index);
          return {
            href: `/archive/${record.data.branch}/${record.data.index}/${record.id}/`,
            title: record.data.title,
            description: record.data.description,
            label: relatedIndex?.label ?? '삥이 아카이브',
            coverImage: record.data.coverImage,
          };
        })
    : [];
  const faqSchema =
    faq && faq.length > 0
      ? {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: faq.map((item) => ({
            '@type': 'Question',
            name: item.question,
            acceptedAnswer: { '@type': 'Answer', text: item.answer },
          })),
        }
      : null;
  articleView = { entry, meta, Content, related, relatedAssets, faqSchema };
}
---

{categoryView && (
  <Layout
    title={categoryView.meta.pageTitle ?? categoryView.meta.label}
    description={`${categoryView.meta.fullLabel} - ${site.name}`}
    robots={categoryView.hasContent ? 'index,follow,max-image-preview:large' : 'noindex,follow'}
    adsEligible={false}
    breadcrumbs={[
      { label: '홈', href: '/' },
      ...getAncestorChain(categoryView.categorySlug).map((category) => ({
        label: category.pageTitle ?? category.label,
        href: getCategoryPath(category.slug),
      })),
    ]}
  >
    {categoryView.categorySlug === 'culture' ? (
      <FashionCategoryPage entries={categoryView.articles} description={categoryView.meta.description} />
    ) : categoryView.categorySlug === 'pilgrimage' ? (
      <PilgrimageCategoryPage entries={categoryView.articles} description={categoryView.meta.description} />
    ) : (
    <div class="max-w-[1040px] mx-auto px-4 md:px-5 py-6">
      <div class="min-w-0">
        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 mb-5">
          <h1 class="shrink-0 whitespace-nowrap text-[24px] font-medium text-[var(--bbfc-ink)]">{categoryView.meta.pageTitle ?? categoryView.meta.label}</h1>
          <p class="text-[13px] text-[var(--bbfc-gray-2)] mt-1">{categoryView.meta.fullLabel}</p>
          <span class="shrink-0 text-[13px] text-[var(--bbfc-gray-2)]">{categoryView.articles.length}편</span>
        </div>

        {categoryView.meta.description && (
          <section class="category-intro" aria-label={`${categoryView.meta.pageTitle ?? categoryView.meta.label} 소개`}>
            <p>{categoryView.meta.description}</p>
          </section>
        )}

        <section class="category-contents" aria-label={`${categoryView.meta.pageTitle ?? categoryView.meta.label} 콘텐츠`}>
          <div class="category-contents__heading" aria-hidden="true">
            <span>CONTENTS</span>
            <i></i>
          </div>

          {categoryView.children.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-5">
              {categoryView.children.map((child) => (
                <a
                  href={getCategoryPath(child.slug)}
                  class="text-[12.5px] text-[var(--bbfc-ink-2)] border border-[var(--bbfc-border)] rounded-[var(--bbfc-radius)] px-3 py-1.5"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}

          <CategoryArticleList entries={categoryView.articles} emptyMessage={categoryView.meta.emptyMessage} />
        </section>
      </div>
    </div>
    )}
  </Layout>
)}

{articleView && (
  <Layout
    title={articleView.entry.data.title}
    description={articleView.entry.data.description}
    ogImage={articleView.entry.data.coverImage}
    ogImageAlt={articleView.entry.data.coverImageAlt ?? articleView.entry.data.title}
    ogImageWidth={articleView.entry.data.coverImageWidth}
    ogImageHeight={articleView.entry.data.coverImageHeight}
    ogImageCaption={articleView.entry.data.coverImageCaption}
    type="article"
    article={{
      pubDate: articleView.entry.data.pubDate,
      updatedDate: articleView.entry.data.updatedDate,
      section: articleView.meta.fullLabel,
      subjects: [articleView.meta.fullLabel, ...articleView.entry.data.tags],
      keywords: articleView.entry.data.tags,
    }}
    breadcrumbs={[
      { label: '홈', href: '/' },
      ...getAncestorChain(articleView.entry.data.category).map((category) => ({ label: category.label, href: getCategoryPath(category.slug) })),
      { label: articleView.entry.data.title, href: getArticlePath(articleView.entry.data.category, articleView.entry.id) },
    ]}
  >
    {articleView.faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(articleView.faqSchema)} />}

    <div class:list={["mx-auto px-4 md:px-6 py-8 md:py-12", articleView.entry.data.category === 'culture' ? 'max-w-[1080px] fashion-article-shell' : articleView.entry.data.category === 'pilgrimage' ? 'max-w-[1080px] journey-article-shell' : 'max-w-[920px]']}>
      <article class:list={[{ 'fashion-article': articleView.entry.data.category === 'culture', 'journey-article': articleView.entry.data.category === 'pilgrimage' }]}>
        <header class="article-heading">
          <span class="text-[11px] text-[var(--bbfc-blue)]">{articleView.meta.label}</span>
          {articleView.entry.data.category === 'culture' && <p class="fashion-article__issue">BBINGE FC · STYLE FILE</p>}
          {articleView.entry.data.category === 'pilgrimage' && <p class="journey-article__issue">BBINGE FC · FOOTBALL TRAVEL JOURNAL</p>}
          <h1 class="text-[30px] md:text-[42px] font-semibold mt-3 mb-4 leading-[1.2] tracking-[-0.035em] text-[var(--bbfc-ink)]">{articleView.entry.data.title}</h1>
        </header>
        <div class="mb-6">
          <ArticleByline
            pubDate={articleView.entry.data.pubDate}
            updatedDate={articleView.entry.data.updatedDate}
          />
        </div>
        {articleView.entry.data.coverImage && (
          <ContentCover
            src={articleView.entry.data.coverImage}
            alt={articleView.entry.data.coverImageAlt ?? articleView.entry.data.title}
            caption={articleView.entry.data.coverImageCaption}
            width={articleView.entry.data.coverImageWidth}
            height={articleView.entry.data.coverImageHeight}
          />
        )}
        <div class="article-body text-[17px] md:text-[18px] leading-[1.9] text-[var(--bbfc-ink)]">
          {articleView.entry.data.fashionProfile && <FashionProfileCard profile={articleView.entry.data.fashionProfile} />}
          <articleView.Content />
        </div>
        <ArticleProvenance />

        <div class="mt-6 pt-4 border-t border-[var(--bbfc-line)]">
          <ShareButtons
            url={new URL(getArticlePath(articleView.entry.data.category, articleView.entry.id), site.url).toString()}
            title={articleView.entry.data.title}
          />
        </div>
        <RelatedAssets items={articleView.relatedAssets} />
      </article>

      {articleView.related.length > 0 && (
        <div class="mt-14 pt-6 border-t-2 border-[var(--bbfc-ink)]">
          <p class="text-[10px] font-medium tracking-[0.14em] text-[var(--bbfc-blue)]">MORE FROM {articleView.meta.label.toUpperCase()}</p>
          <h2 class="text-[24px] font-medium mt-2 text-[var(--bbfc-ink)]">{articleView.meta.label} 카테고리의 다른 글</h2>
          <RelatedList entries={articleView.related} />
        </div>
      )}

      <AdSlot />
    </div>

    <script is:inline>
      (() => {
        const clips = document.querySelectorAll('.highlight-clip[data-autoplay-on-view]');
        if (!clips.length || !('IntersectionObserver' in window)) return;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            const video = entry.target;
            if (!(video instanceof HTMLVideoElement)) continue;
            if (entry.isIntersecting) {
              if (video.preload === 'none') {
                video.preload = 'metadata';
                video.load();
              }
              if (!reduceMotion) video.play().catch(() => {});
            } else {
              video.pause();
            }
          }
        }, { rootMargin: '180px 0px', threshold: 0.15 });
        clips.forEach((clip) => observer.observe(clip));
      })();
    </script>
  </Layout>
)}

<style>
  .fashion-article .article-heading { display:grid; grid-template-columns:auto 1fr; column-gap:13px; align-items:center; padding-bottom:21px; border-bottom:3px solid var(--bbfc-ink); }
  .fashion-article .article-heading>span { font-weight:760; letter-spacing:.12em; }
  .fashion-article__issue { justify-self:end; color:var(--bbfc-gray-2); font-size:9px; font-weight:650; letter-spacing:.14em; }
  .fashion-article .article-heading h1 { grid-column:1/3; max-width:920px; margin-top:17px; font-size:clamp(38px,5.2vw,64px); line-height:1.08; font-weight:780; letter-spacing:-.052em; text-wrap:balance; }
  .fashion-article :global(.content-cover) { margin-top:0; }
  .fashion-article .article-body { margin-top:34px; }
  .fashion-article .article-body>:global(p),
  .fashion-article .article-body>:global(h2),
  .fashion-article .article-body>:global(h3),
  .fashion-article .article-body>:global(blockquote),
  .fashion-article .article-body>:global(.source-notes) { max-width:760px; margin-left:auto; margin-right:auto; }
  .fashion-article .article-body>:global(h2) { border-left:0; padding:20px 0 0; border-top:2px solid var(--bbfc-ink); font-size:clamp(27px,3.4vw,36px); }
  .fashion-article .article-body>:global(p:first-of-type)::first-letter { float:left; margin:10px 9px 0 0; color:var(--bbfc-blue); font-size:66px; line-height:.68; font-weight:780; }
  @media (max-width:680px) {
    .fashion-article-shell { padding-top:25px; }
    .fashion-article .article-heading h1 { font-size:36px; }
    .fashion-article__issue { font-size:8px; }
    .fashion-article .article-body { margin-top:26px; }
    .fashion-article .article-body>:global(p:first-of-type)::first-letter { font-size:54px; }
  }
  .journey-article .article-heading { display:grid; grid-template-columns:auto 1fr; column-gap:13px; align-items:center; padding-bottom:21px; border-bottom:3px solid var(--bbfc-ink); }
  .journey-article .article-heading>span { font-weight:760; letter-spacing:.12em; }
  .journey-article__issue { justify-self:end; color:var(--bbfc-gray-2); font-size:15px; font-weight:650; letter-spacing:.1em; }
  .journey-article .article-heading h1 { grid-column:1/3; max-width:980px; margin-top:17px; font-size:clamp(38px,5vw,62px); line-height:1.1; font-weight:780; letter-spacing:-.052em; text-wrap:balance; }
  .journey-article :global(.content-cover) { margin-top:0; }
  .journey-article .article-body { margin-top:38px; }
  .journey-article .article-body>:global(p),
  .journey-article .article-body>:global(h2),
  .journey-article .article-body>:global(h3),
  .journey-article .article-body>:global(blockquote),
  .journey-article .article-body>:global(.journey-note),
  .journey-article .article-body>:global(.source-notes) { max-width:760px; margin-left:auto; margin-right:auto; }
  .journey-article .article-body>:global(h2) { margin-top:92px; padding:21px 0 0; border-top:2px solid var(--bbfc-ink); border-left:0; font-size:clamp(27px,3.3vw,36px); line-height:1.28; letter-spacing:-.04em; }
  .journey-article .article-body>:global(p:first-of-type)::first-letter { float:left; margin:10px 9px 0 0; color:var(--bbfc-blue); font-size:66px; line-height:.68; font-weight:780; }
  .journey-article .article-body>:global(figure) { overflow:hidden; border-radius:0; }
  .journey-article .article-body>:global(figure img) { border-radius:0; }
  .journey-article .article-body>:global(figcaption) { padding:0 8px; text-align:left; }
  .journey-article .article-body>:global(.journey-deck) { position:relative; overflow:hidden; margin:62px 0 24px; padding:52px 54px 55px; background:radial-gradient(circle at 88% 15%,rgba(65,127,255,.33),transparent 34%),linear-gradient(145deg,#09111e,#17253a); color:#fff; }
  .journey-article .article-body>:global(.journey-deck::after) { content:attr(data-city); position:absolute; right:-10px; bottom:-31px; color:rgba(255,255,255,.045); font-size:116px; line-height:1; font-weight:820; letter-spacing:-.07em; }
  .journey-article .article-body>:global(.journey-deck p) { position:relative; z-index:1; margin:0; color:#85b5ff; font-size:15px; line-height:1.4; font-weight:760; letter-spacing:.12em; }
  .journey-article .article-body>:global(.journey-deck strong) { position:relative; z-index:1; display:block; max-width:720px; margin-top:19px; font-size:clamp(34px,5vw,56px); line-height:1.08; font-weight:760; letter-spacing:-.052em; }
  .journey-article .article-body>:global(.journey-deck span) { position:relative; z-index:1; display:block; margin-top:24px; color:rgba(255,255,255,.76); font-size:15px; line-height:1.55; letter-spacing:.04em; }
  .journey-article .article-body>:global(.journey-route-card) { margin:0 0 54px; padding:25px 26px 26px; border:0; background:#101b2b; }
  .journey-article .article-body>:global(.journey-route-card>p) { margin:0; color:#91b9ff; font-size:15px; line-height:1.4; font-weight:760; letter-spacing:.12em; }
  .journey-article .article-body>:global(.journey-route-card>div) { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:2px; margin-top:17px; background:#101b2b; }
  .journey-article .article-body>:global(.journey-route-card section) { display:flex; min-height:210px; flex-direction:column; justify-content:flex-end; padding:23px 20px; background-image:linear-gradient(180deg,rgba(5,10,18,.08) 12%,rgba(5,10,18,.88) 100%),var(--journey-image); background-position:center; background-size:cover; color:#fff; }
  .journey-article .article-body>:global(.journey-route-card span) { display:block; color:#a9c8ff; font-size:15px; line-height:1.4; font-weight:760; letter-spacing:.1em; }
  .journey-article .article-body>:global(.journey-route-card strong) { display:block; margin-top:7px; color:#fff; font-size:22px; line-height:1.35; text-shadow:0 2px 14px rgba(0,0,0,.55); }
  .journey-article .article-body>:global(.journey-route-card small) { display:block; margin-top:8px; color:rgba(255,255,255,.83); font-size:15px; line-height:1.55; text-shadow:0 2px 12px rgba(0,0,0,.6); }
  .journey-article .article-body>:global(.journey-wide) { margin:48px 0 64px; }
  .journey-article .article-body>:global(.journey-poster) { max-width:920px; margin:48px auto 64px; background:#090d14; }
  .journey-article .article-body>:global(.journey-poster figcaption) { margin:0; padding:13px 16px 15px; color:rgba(255,255,255,.6); }
  .journey-article .article-body>:global(.journey-image-pair) { display:grid; grid-template-columns:1.12fr .88fr; gap:10px; margin:48px 0 66px; }
  .journey-article .article-body>:global(.journey-image-pair figure) { display:grid; grid-template-rows:1fr auto; min-width:0; margin:0; overflow:hidden; background:#f3f4f5; }
  .journey-article .article-body>:global(.journey-image-pair img) { width:100%; height:100%; min-height:330px; border-radius:0; object-fit:cover; }
  .journey-article .article-body>:global(.journey-image-pair figcaption) { margin:0; padding:12px 14px 14px; background:#f3f4f5; color:#566171; font-size:15px; line-height:1.6; text-align:left; }
  .journey-article .article-body>:global(.journey-note) { margin-top:35px; margin-bottom:55px; padding:23px 25px 25px; border-top:3px solid var(--bbfc-blue); background:#f2f5fb; }
  .journey-article .article-body>:global(.journey-note>span) { display:block; color:var(--bbfc-blue); font-size:15px; line-height:1.4; font-weight:760; letter-spacing:.11em; }
  .journey-article .article-body>:global(.journey-note p) { margin:10px 0 0; color:var(--bbfc-ink-2); font-size:15px; line-height:1.75; }
  .journey-article .article-body :global(.journey-inline-term) { white-space:nowrap; }
  .journey-article .article-body>:global(.journey-fact-strip) { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1px; margin:4px 0 67px; border:0; background-image:linear-gradient(90deg,rgba(7,15,27,.8),rgba(10,31,60,.55)),var(--journey-image); background-position:center; background-size:cover; }
  .journey-article .article-body>:global(.journey-fact-strip div) { padding:27px 13px 25px; background:rgba(8,19,36,.68); text-align:center; backdrop-filter:blur(2px); }
  .journey-article .article-body>:global(.journey-fact-strip span) { display:block; color:#78a8ff; font-size:30px; line-height:1; font-weight:780; letter-spacing:-.04em; }
  .journey-article .article-body>:global(.journey-fact-strip small) { display:block; margin-top:10px; color:rgba(255,255,255,.86); font-size:15px; line-height:1.45; }
  .journey-article .article-body>:global(.journey-finale) { margin:52px 0 74px; background:#07100f; }
  .journey-article .article-body>:global(.journey-finale img) { min-height:500px; object-fit:cover; }
  .journey-article .article-body>:global(.journey-finale figcaption) { margin:0; padding:13px 16px 15px; color:rgba(255,255,255,.62); }
  .journey-article .article-body>:global(.journey-links) { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin:42px 0 70px; }
  .journey-article .article-body>:global(.journey-links a) { display:flex; min-height:260px; flex-direction:column; padding:24px 22px 21px; border:0; background-image:linear-gradient(180deg,rgba(3,8,15,.42) 0%,rgba(3,8,15,.94) 100%),var(--journey-image); background-position:center; background-size:cover; color:#fff; text-decoration:none; box-shadow:inset 0 0 0 1px rgba(255,255,255,.12); transition:transform .25s ease,box-shadow .25s ease; }
  .journey-article .article-body>:global(.journey-links a:hover),
  .journey-article .article-body>:global(.journey-links a:focus-visible) { transform:translateY(-3px); box-shadow:inset 0 0 0 2px #78a8ff,0 12px 25px rgba(7,18,36,.16); }
  .journey-article .article-body>:global(.journey-links a:focus-visible) { outline:3px solid rgba(120,168,255,.58); outline-offset:4px; }
