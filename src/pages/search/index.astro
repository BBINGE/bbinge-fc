---
// 정적 사이트 원칙에 맞춰 백엔드 검색 없이, 발행된 글 메타데이터를 빌드 타임에 페이지에 심어두고
// 클라이언트 JS로 제목·설명·태그를 부분일치 검색한다. draft는 애초에 제외.
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categories, getArticlePath } from '../../config/categories';

const entries = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.id.localeCompare(a.id)
);

const searchIndex = entries.map((entry) => ({
  title: entry.data.title,
  description: entry.data.description,
  tags: entry.data.tags,
  href: getArticlePath(entry.data.category, entry.id),
  categoryLabel: categories[entry.data.category]?.label ?? '',
  pubDate: entry.data.pubDate.toLocaleDateString('ko-KR'),
}));
---

<Layout
  title="검색"
  description="삥이FC 글 검색"
  robots="noindex,follow"
  breadcrumbs={[
    { label: '홈', href: '/' },
    { label: '검색', href: '/search/' },
  ]}
>
  <div class="max-w-[680px] mx-auto px-4 md:px-5 py-6">
    <h1 class="text-[20px] font-medium text-[var(--bbfc-ink)] mb-4">검색</h1>
    <input
      id="bbfc-search-input"
      type="search"
      placeholder="제목, 설명, 태그로 검색"
      class="w-full text-[15px] border border-[var(--bbfc-border)] rounded-[var(--bbfc-radius)] px-3.5 py-2.5 outline-none bg-[var(--bbfc-bg)] text-[var(--bbfc-ink)]"
      autofocus
    />
    <p id="bbfc-search-count" class="text-[12px] text-[var(--bbfc-gray-2)] mt-3 mb-1"></p>
    <div id="bbfc-search-results"></div>
  </div>
</Layout>

<script is:inline define:vars={{ searchIndex }}>
  const input = document.getElementById('bbfc-search-input');
  const resultsEl = document.getElementById('bbfc-search-results');
  const countEl = document.getElementById('bbfc-search-count');

  function render(query) {
    const q = query.trim().toLowerCase();
    if (!q) {
      resultsEl.innerHTML = '';
      countEl.textContent = '';
      return;
    }
    const matches = searchIndex.filter((item) => {
      const haystack = [item.title, item.description, ...(item.tags || [])].join(' ').toLowerCase();
      return haystack.includes(q);
    });
    countEl.textContent = `${matches.length}건`;
    resultsEl.innerHTML = matches.length
      ? matches
          .map(
            (item) => `
        <a href="${item.href}" class="block py-4 border-b border-[var(--bbfc-line)] first:pt-0">
          <p class="text-[11px] text-[var(--bbfc-blue)]">${item.categoryLabel}</p>
          <p class="text-[14px] font-medium text-[var(--bbfc-ink)] mt-1 leading-snug">${item.title}</p>
          <p class="text-[13px] text-[var(--bbfc-gray-1)] mt-1 leading-relaxed">${item.description}</p>
          <p class="text-[11px] text-[var(--bbfc-gray-2)] mt-1.5">${item.pubDate}</p>
        </a>`
          )
          .join('')
      : '<p class="text-[13px] text-[var(--bbfc-gray-1)] py-8 text-center">검색 결과가 없어요.</p>';
  }

  input.addEventListener('input', () => render(input.value));

  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q') || '';
  if (initialQuery) {
    input.value = initialQuery;
    render(initialQuery);
  }
</script>
