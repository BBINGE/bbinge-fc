---
// 정적 사이트 원칙에 맞춰 백엔드 없이, 발행된 모든 보유 자산의 메타데이터와 본문을
// 빌드 타임에 색인한다. draft는 애초에 제외한다.
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categories, getArticlePath } from '../../config/categories';

const entries = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.id.localeCompare(a.id)
);
const archiveEntries = (await getCollection('archive', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.id.localeCompare(a.id)
);

const searchableBody = (body = '') => body
  .replace(/<style[\s\S]*?<\/style>/gi, ' ')
  .replace(/<script[\s\S]*?<\/script>/gi, ' ')
  .replace(/<[^>]+>/g, ' ')
  .replace(/https?:\/\/\S+/g, ' ')
  .replace(/[#*_`>\[\](){}|]/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();

const searchIndex = [...entries.map((entry) => ({
  title: entry.data.title,
  description: entry.data.description,
  tags: entry.data.tags,
  context: [categories[entry.data.category]?.fullLabel ?? '', searchableBody(entry.body)].join(' '),
  href: getArticlePath(entry.data.category, entry.id),
  categoryLabel: categories[entry.data.category]?.label ?? '',
  pubDate: entry.data.pubDate.toLocaleDateString('ko-KR'),
})), ...archiveEntries.map((entry) => ({
  title: entry.data.title,
  description: entry.data.description,
  tags: entry.data.keywords,
  context: [entry.data.year, entry.data.subject, entry.data.originalTitle ?? '', entry.data.branch, entry.data.index, searchableBody(entry.body)].join(' '),
  href: `/archive/${entry.data.branch}/${entry.data.index}/${entry.id}/`,
  categoryLabel: '삥이 아카이브',
  pubDate: entry.data.pubDate.toLocaleDateString('ko-KR'),
}))];
---

<Layout
  title="검색"
  description="삥이FC 글 검색"
  adsEligible={false}
  robots="noindex,follow"
  breadcrumbs={[
    { label: '홈', href: '/' },
    { label: '검색', href: '/search/' },
  ]}
>
  <div class="max-w-[680px] mx-auto px-4 md:px-5 py-6">
    <h1 class="text-[20px] font-medium text-[var(--bbfc-ink)] mb-4">무엇이든 검색해보세요</h1>
    <div class="search-prompt">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.35-4.35" stroke-linecap="round" /></svg>
      <input id="bbfc-search-input" type="search" placeholder="선수, 대회, 장소, 이야기…" autofocus />
    </div>
    <p id="bbfc-search-count" class="text-[12px] text-[var(--bbfc-gray-2)] mt-3 mb-1"></p>
    <div id="bbfc-search-results"></div>
  </div>
</Layout>

<style>
  .search-prompt { display:flex; align-items:center; gap:11px; width:100%; min-height:52px; padding:0 17px; border:1px solid var(--bbfc-border); border-radius:26px; background:#fff; color:var(--bbfc-gray-2); box-shadow:0 16px 36px -26px rgba(22,31,43,.7); animation:prompt-float 4.2s ease-in-out infinite; }
  .search-prompt:focus-within { border-color:var(--bbfc-blue); box-shadow:0 16px 40px -25px rgba(41,112,240,.55); }
  .search-prompt input { min-width:0; width:100%; border:0; outline:0; background:transparent; color:var(--bbfc-ink); font-size:15px; }
  .search-prompt input::placeholder { color:var(--bbfc-gray-2); }
  @keyframes prompt-float { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-3px); } }
  @media (prefers-reduced-motion:reduce) { .search-prompt { animation:none; } }
</style>

<script is:inline define:vars={{ searchIndex }}>
  const input = document.getElementById('bbfc-search-input');
  const resultsEl = document.getElementById('bbfc-search-results');
  const countEl = document.getElementById('bbfc-search-count');

  function render(query) {
    const normalize = (value) => String(value ?? '').normalize('NFKC').toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
    const q = normalize(query);
    if (!q) {
      resultsEl.innerHTML = '';
      countEl.textContent = '';
      return;
    }
    const tokens = q.split(/\s+/).filter(Boolean);
    const matches = searchIndex
      .map((item) => {
        const title = normalize(item.title);
        const summary = normalize([item.description, ...(item.tags || [])].join(' '));
        const context = normalize(item.context);
        const haystack = `${title} ${summary} ${context}`;
        if (!tokens.every((token) => haystack.includes(token))) return null;
        let score = title === q ? 1000 : title.includes(q) ? 500 : summary.includes(q) ? 250 : context.includes(q) ? 100 : 0;
        score += tokens.reduce((sum, token) => sum + (title.includes(token) ? 40 : summary.includes(token) ? 15 : 2), 0);
        return { ...item, score };
      })
      .filter(Boolean)
      .sort((a, b) => b.score - a.score || a.title.localeCompare(b.title, 'ko'));
    const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' })[char]);
    countEl.textContent = `${matches.length}건`;
    resultsEl.innerHTML = matches.length
      ? matches
          .map(
            (item) => `
        <a href="${escapeHtml(item.href)}" class="block py-4 border-b border-[var(--bbfc-line)] first:pt-0">
          <p class="text-[11px] text-[var(--bbfc-blue)]">${escapeHtml(item.categoryLabel)}</p>
          <p class="text-[14px] font-medium text-[var(--bbfc-ink)] mt-1 leading-snug">${escapeHtml(item.title)}</p>
          <p class="text-[13px] text-[var(--bbfc-gray-1)] mt-1 leading-relaxed">${escapeHtml(item.description)}</p>
          <p class="text-[11px] text-[var(--bbfc-gray-2)] mt-1.5">${escapeHtml(item.pubDate)}</p>
        </a>`
          )
          .join('')
      : '<p class="text-[13px] text-[var(--bbfc-gray-1)] py-8 text-center">검색 결과가 없어요.</p>';
  }

  input.addEventListener('input', () => render(input.value));

  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q') || '';
  if (initialQuery) {
    input.value = initialQuery;
    render(initialQuery);
  }
</script>
