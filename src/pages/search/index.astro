---
// 정적 사이트 원칙에 맞춰 백엔드 없이, 발행된 모든 보유 자산의 메타데이터와 본문을
// 빌드 타임에 색인한다. draft는 애초에 제외한다.
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categories, categoryList, getAncestorChain, getArticlePath, getCategoryPath } from '../../config/categories';
import { archiveBranches } from '../../data/archive';

const entries = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.id.localeCompare(a.id)
);
const archiveEntries = (await getCollection('archive', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.id.localeCompare(a.id)
);

const searchableBody = (body = '') => body
  .replace(/<style[\s\S]*?<\/style>/gi, ' ')
  .replace(/<script[\s\S]*?<\/script>/gi, ' ')
  .replace(/<[^>]+>/g, ' ')
  .replace(/https?:\/\/\S+/g, ' ')
  .replace(/[#*_`>\[\](){}|]/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();

const articleRecords = entries.map((entry) => ({
  title: entry.data.title,
  description: entry.data.description,
  tags: entry.data.tags,
  context: [categories[entry.data.category]?.fullLabel ?? '', searchableBody(entry.body)].join(' '),
  href: getArticlePath(entry.data.category, entry.id),
  categoryLabel: categories[entry.data.category]?.label ?? '',
  pubDate: entry.data.pubDate.toLocaleDateString('ko-KR'),
  image: entry.data.cardImage ?? entry.data.coverImage ?? '',
  imageAlt: entry.data.coverImageAlt ?? '',
  topicKeys: getAncestorChain(entry.data.category).map((category) => `category:${category.slug}`),
  year: 0,
}));
const archiveRecords = archiveEntries.map((entry) => ({
  title: entry.data.title,
  description: entry.data.description,
  tags: entry.data.keywords,
  context: [entry.data.year, entry.data.subject, entry.data.originalTitle ?? '', entry.data.branch, entry.data.index, searchableBody(entry.body)].join(' '),
  href: `/archive/${entry.data.branch}/${entry.data.index}/${entry.id}/`,
  categoryLabel: '삥이 아카이브',
  pubDate: `${entry.data.year}년 기록`,
  image: entry.data.coverImage,
  imageAlt: entry.data.coverImageAlt,
  topicKeys: ['archive:root', `archive:${entry.data.branch}`, `archive:${entry.data.branch}:${entry.data.index}`],
  year: entry.data.year,
}));
const searchIndex = [...articleRecords, ...archiveRecords];

const normalizeTopicAlias = (value: string) => value
  .normalize('NFKC')
  .toLocaleLowerCase('ko-KR')
  .replace(/™/g, '')
  .replace(/[^\p{L}\p{N}]+/gu, ' ')
  .trim();
const aliasesFor = (...values: string[]) => Array.from(new Set(values
  .flatMap((value) => {
    const normalized = normalizeTopicAlias(value);
    const withoutOrganizer = normalized.replace(/^(fifa|uefa)\s+/u, '');
    return [normalized, withoutOrganizer, normalized.replace(/\s+/g, '')];
  })
  .filter(Boolean)));
const firstForTopic = (key: string) => searchIndex.find((record) => record.topicKeys.includes(key));
const countForTopic = (key: string) => searchIndex.filter((record) => record.topicKeys.includes(key)).length;

const categoryTopics = categoryList.map((category) => {
  const key = `category:${category.slug}`;
  const first = firstForTopic(key);
  const count = countForTopic(key);
  return count > 0 ? {
    key,
    label: category.label,
    title: category.pageTitle ?? category.fullLabel,
    description: category.description ?? `${category.fullLabel}에 관한 글을 모았습니다.`,
    aliases: aliasesFor(category.label, category.fullLabel, category.pageTitle ?? '', category.slug),
    href: getCategoryPath(category.slug),
    categoryLabel: category.label,
    pubDate: `${count}편`,
    image: first?.image ?? '',
    imageAlt: first?.imageAlt ?? '',
    sortMode: 'published',
  } : null;
}).filter(Boolean);

const archiveTopics = archiveBranches.flatMap((branch) => {
  const branchKey = `archive:${branch.id}`;
  const branchFirst = firstForTopic(branchKey);
  const branchCount = countForTopic(branchKey);
  const branchTopic = branchCount > 0 ? [{
    key: branchKey,
    label: branch.title,
    title: branch.title,
    description: branch.description,
    aliases: aliasesFor(branch.title, branch.originalTitle, branch.id),
    href: `/archive/${branch.id}/`,
    categoryLabel: '삥이 아카이브',
    pubDate: `${branchCount}편`,
    image: branchFirst?.image ?? '',
    imageAlt: branchFirst?.imageAlt ?? '',
    sortMode: 'published',
  }] : [];
  const indexes = branch.indexes.map((index) => {
    const key = `archive:${branch.id}:${index.slug}`;
    const records = archiveRecords.filter((record) => record.topicKeys.includes(key)).sort((a, b) => a.year - b.year);
    const first = records[0];
    return records.length > 0 ? {
      key,
      label: index.label,
      title: `${index.label} 아카이브`,
      description: `${branch.title} 가운데 ${index.label}에 관한 기록을 연도순으로 모았습니다.`,
      aliases: aliasesFor(index.label, index.slug),
      href: `/archive/${branch.id}/${index.slug}/`,
      categoryLabel: '삥이 아카이브',
      pubDate: `${records.length}편`,
      image: first.image,
      imageAlt: first.imageAlt,
      sortMode: 'year',
    } : null;
  }).filter(Boolean);
  return [...branchTopic, ...indexes];
});

const rootFirst = firstForTopic('archive:root');
const searchTopics = [{
  key: 'archive:root',
  label: '삥이 아카이브',
  title: '삥이 아카이브',
  description: '축구의 인물·대회·수상 기록을 당대의 이름과 자료로 연결합니다.',
  aliases: aliasesFor('삥이 아카이브', '아카이브', 'football archive'),
  href: '/archive/',
  categoryLabel: '삥이 아카이브',
  pubDate: `${archiveRecords.length}편`,
  image: rootFirst?.image ?? '',
  imageAlt: rootFirst?.imageAlt ?? '',
  sortMode: 'published',
}, ...categoryTopics, ...archiveTopics];
---

<Layout
  title="검색"
  description="삥이FC 글 검색"
  adsEligible={false}
  robots="noindex,follow"
  breadcrumbs={[
    { label: '홈', href: '/' },
    { label: '검색', href: '/search/' },
  ]}
>
  <div class="search-shell">
    <h1>무엇이든 검색해보세요</h1>
    <div class="search-prompt">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.35-4.35" stroke-linecap="round" /></svg>
      <input id="bbfc-search-input" type="search" placeholder="선수, 대회, 장소, 이야기…" autofocus />
    </div>
    <p id="bbfc-search-count" class="search-curation-call" role="status" aria-live="polite"></p>
    <section id="bbfc-search-primary" class="search-tier" hidden aria-labelledby="bbfc-search-primary-title">
      <div class="search-tier__head"><span id="bbfc-search-primary-kicker">1순위</span><h2 id="bbfc-search-primary-title">가장 가까운 결과</h2></div>
      <div id="bbfc-search-primary-results" class="search-explore-grid"></div>
    </section>
    <section id="bbfc-search-secondary" class="search-tier search-tier--secondary" hidden aria-labelledby="bbfc-search-secondary-title">
      <div class="search-tier__head"><span id="bbfc-search-secondary-kicker">2순위</span><h2 id="bbfc-search-secondary-title">함께 보면 좋은 결과</h2></div>
      <div id="bbfc-search-secondary-results" class="search-explore-grid"></div>
    </section>
  </div>
</Layout>

<style>
  .search-shell { width:min(100%, 1040px); margin:0 auto; padding:30px 20px 72px; }
  .search-shell h1 { margin:0 0 18px; color:var(--bbfc-ink); font-size:22px; font-weight:650; letter-spacing:-.035em; }
  .search-prompt { display:flex; align-items:center; gap:11px; width:100%; min-height:54px; padding:0 19px; border:1px solid var(--bbfc-border); border-radius:28px; background:#fff; color:var(--bbfc-gray-2); box-shadow:0 16px 36px -26px rgba(22,31,43,.7); animation:prompt-float 5.2s ease-in-out infinite; will-change:transform; }
  .search-prompt:focus-within { border-color:var(--bbfc-blue); box-shadow:0 16px 40px -25px rgba(41,112,240,.55); }
  .search-prompt input { min-width:0; width:100%; border:0; outline:0; background:transparent; color:var(--bbfc-ink); font-size:15px; }
  .search-prompt input::placeholder { color:var(--bbfc-gray-2); }
  .search-curation-call { min-height:51px; margin:26px 0 6px; color:var(--bbfc-ink); }
  :global(.search-curation-call strong) { display:block; font-size:20px; font-weight:720; letter-spacing:-.035em; }
  :global(.search-curation-call span) { display:block; margin-top:5px; color:var(--bbfc-gray-2); font-size:11px; line-height:1.65; }
  .search-tier[hidden] { display:none; }
  .search-tier { margin-top:24px; }
  .search-tier--secondary { margin-top:43px; }
  .search-tier__head { display:flex; align-items:baseline; gap:11px; padding-bottom:11px; border-bottom:1px solid var(--bbfc-ink); }
  .search-tier__head span { color:var(--bbfc-blue); font-size:9px; line-height:1; font-weight:780; letter-spacing:.15em; }
  .search-tier__head h2 { color:var(--bbfc-ink); font-size:16px; line-height:1.3; font-weight:720; letter-spacing:-.025em; }
  .search-explore-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:3px; }
  #bbfc-search-primary-results[data-count="1"] { grid-template-columns:minmax(0,420px); }
  #bbfc-search-primary-results[data-count="2"] { grid-template-columns:repeat(2,minmax(0,1fr)); }
  :global(.search-explore-card) { position:relative; aspect-ratio:1/1; overflow:hidden; background:linear-gradient(145deg,#e9edf3,#dce3ed); color:#fff !important; isolation:isolate; }
  :global(.search-explore-card img) { width:100%; height:100%; object-fit:cover; transition:transform .45s ease,filter .35s ease; }
  :global(.search-explore-card::after) { position:absolute; z-index:1; inset:32% 0 0; background:linear-gradient(180deg,transparent,rgba(7,13,22,.84)); content:""; transition:opacity .25s ease; }
  :global(.search-explore-card:hover img),:global(.search-explore-card:focus-visible img) { transform:scale(1.045); filter:saturate(1.08) contrast(1.03); }
  :global(.search-explore-card:focus-visible) { outline:3px solid var(--bbfc-blue); outline-offset:2px; z-index:2; }
  :global(.search-explore-fallback) { position:absolute; inset:0; display:grid; place-items:center; color:rgba(255,255,255,.9); font-family:Georgia,serif; font-size:34px; font-weight:700; background:linear-gradient(135deg,#1a2638,#3974d9); }
  :global(.search-explore-copy) { position:absolute; z-index:2; right:0; bottom:0; left:0; padding:34px 15px 14px; }
  :global(.search-explore-copy small) { display:block; color:rgba(255,255,255,.74); font-size:9px; font-weight:750; letter-spacing:.09em; }
  :global(.search-explore-copy strong) { display:-webkit-box; margin-top:5px; overflow:hidden; font-size:14px; line-height:1.35; font-weight:700; letter-spacing:-.025em; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
  :global(.search-explore-copy span) { display:block; margin-top:6px; color:rgba(255,255,255,.72); font-size:9px; }
  @keyframes prompt-float {
    0%,100% { transform:translate3d(0,0,0); box-shadow:0 16px 36px -26px rgba(22,31,43,.7); }
    30% { transform:translate3d(1px,-5px,0); box-shadow:0 22px 42px -25px rgba(41,112,240,.42); }
    66% { transform:translate3d(-1px,-2px,0); }
  }
  @media (max-width:767px) {
    .search-shell { padding:24px 16px 56px; }
    .search-shell h1 { font-size:20px; }
    :global(.search-curation-call strong) { font-size:18px; line-height:1.45; }
    .search-tier { margin-top:19px; }
    .search-tier--secondary { margin-top:34px; }
    .search-explore-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:2px; }
    #bbfc-search-primary-results[data-count="1"] { grid-template-columns:minmax(0,1fr); }
    :global(.search-explore-copy) { padding:30px 11px 11px; }
    :global(.search-explore-copy strong) { font-size:12px; }
  }
  @media (prefers-reduced-motion:reduce) { .search-prompt { animation:none; } }
</style>

<script is:inline define:vars={{ searchIndex, searchTopics }}>
  const input = document.getElementById('bbfc-search-input');
  const countEl = document.getElementById('bbfc-search-count');
  const primarySection = document.getElementById('bbfc-search-primary');
  const secondarySection = document.getElementById('bbfc-search-secondary');
  const primaryResults = document.getElementById('bbfc-search-primary-results');
  const secondaryResults = document.getElementById('bbfc-search-secondary-results');
  const primaryKicker = document.getElementById('bbfc-search-primary-kicker');
  const primaryTitle = document.getElementById('bbfc-search-primary-title');
  const secondaryKicker = document.getElementById('bbfc-search-secondary-kicker');
  const secondaryTitle = document.getElementById('bbfc-search-secondary-title');

  const setTierLabels = (primaryLabel, primaryHeading, secondaryLabel, secondaryHeading) => {
    primaryKicker.textContent = primaryLabel;
    primaryTitle.textContent = primaryHeading;
    secondaryKicker.textContent = secondaryLabel;
    secondaryTitle.textContent = secondaryHeading;
  };
  const setPrimaryLayout = (count) => {
    primaryResults.dataset.count = String(count);
    primaryResults.style.gridTemplateColumns = count === 1 ? 'minmax(0,420px)' : count === 2 ? 'repeat(2,minmax(0,1fr))' : '';
  };

  function render(query) {
    const normalize = (value) => String(value ?? '').normalize('NFKC').toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
    const compact = (value) => normalize(value).replace(/\s+/g, '');
    const bigrams = (value) => {
      const chars = compact(value);
      if (chars.length < 2) return chars ? [chars] : [];
      return Array.from({ length: chars.length - 1 }, (_, index) => chars.slice(index, index + 2));
    };
    const similarity = (left, right) => {
      const a = bigrams(left);
      const b = bigrams(right);
      if (!a.length || !b.length) return 0;
      const pool = [...b];
      let overlap = 0;
      a.forEach((pair) => {
        const index = pool.indexOf(pair);
        if (index >= 0) { overlap += 1; pool.splice(index, 1); }
      });
      return (2 * overlap) / (a.length + b.length);
    };
    const q = normalize(query);
    if (!q) {
      primaryResults.innerHTML = '';
      secondaryResults.innerHTML = '';
      primarySection.hidden = true;
      secondarySection.hidden = true;
      countEl.textContent = '';
      setTierLabels('1순위', '가장 가까운 결과', '2순위', '함께 보면 좋은 결과');
      return;
    }
    const stopwords = ['왜', '뭐', '어떤', '이런', '저런', '그런', '인가요', '축구', '싶어', '싶어요', '싶다', '보고', '보러', '가고', '가요', '알려줘', '해줘'];
    const tokens = q.split(/\s+/)
      .map((token) => token.length > 2 ? token.replace(/(에서|으로|에게|한테|부터|까지|처럼|보다|하고|이며|이고|이라면|라면|인가요|이야|은|는|이|가|을|를|의|와|과|도|로)$/u, '') : token)
      .filter((token) => token.length > 1 && !stopwords.includes(token));
    if (/보러|여행|가고\s*싶/u.test(q)) tokens.push('여행');
    if (/입고|옷|패션|코디/u.test(q)) tokens.push('패션', '코디', '유니폼');
    if (/규칙|반칙|판정|왜/u.test(q)) tokens.push('규칙', '판정');
    const scored = searchIndex
      .map((item, order) => {
        const title = normalize(item.title);
        const tags = normalize((item.tags || []).join(' '));
        const description = normalize(item.description);
        const summary = `${tags} ${description}`.trim();
        const context = normalize(item.context);
        let hits = 0;
        let score = title === q ? 1200 : title.includes(q) ? 620 : tags.includes(q) ? 420 : description.includes(q) ? 280 : context.includes(q) ? 120 : 0;
        tokens.forEach((token) => {
          if (title.includes(token)) { score += 95; hits += 1; }
          else if (tags.includes(token)) { score += 72; hits += 1; }
          else if (description.includes(token)) { score += 46; hits += 1; }
          else if (context.includes(token)) { score += 18; hits += 1; }
        });
        if (hits === tokens.length) score += 90;
        score += similarity(q, title) * 105 + similarity(q, summary) * 65 + similarity(q, context) * 30;
        return { ...item, score, hits, order };
      })
      .sort((a, b) => b.score - a.score || b.hits - a.hits || a.order - b.order);
    const relevant = scored.filter((item) => item.hits > 0 || item.score >= 28);
    const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' })[char]);
    const card = (item) => `
      <a href="${escapeHtml(item.href)}" class="search-explore-card" aria-label="${escapeHtml(item.title)}">
        ${item.image ? `<img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.imageAlt)}" width="520" height="520" loading="lazy" />` : '<span class="search-explore-fallback" aria-hidden="true">B</span>'}
        <span class="search-explore-copy">
          <small>${escapeHtml(item.categoryLabel)}</small>
          <strong>${escapeHtml(item.title)}</strong>
          <span>${escapeHtml(item.pubDate)}</span>
        </span>
      </a>`;

    const topicQuery = q.split(/\s+/)
      .filter((token) => !['전체', '기록', '아카이브', '모음', '보여줘', '찾아줘'].includes(token))
      .join(' ')
      .trim();
    const topicAliases = new Set([topicQuery, compact(topicQuery)]);
    const matchedTopics = /(?:18|19|20)\d{2}/u.test(q)
      ? []
      : searchTopics.filter((topic) => topic.aliases.some((alias) => topicAliases.has(alias)));

    if (matchedTopics.length > 0) {
      const keys = new Set(matchedTopics.map((topic) => topic.key));
      const seen = new Set();
      let topicRecords = searchIndex.filter((item) => {
        if (!item.topicKeys.some((key) => keys.has(key)) || seen.has(item.href)) return false;
        seen.add(item.href);
        return true;
      });
      const isSingleYearSeries = matchedTopics.length === 1 && matchedTopics[0].sortMode === 'year';
      if (isSingleYearSeries) topicRecords = [...topicRecords].sort((a, b) => a.year - b.year);
      const records = topicRecords.slice(0, 9);
      const topicLabel = matchedTopics.length === 1 ? matchedTopics[0].label : topicQuery;
      countEl.innerHTML = `<strong>${escapeHtml(topicLabel)} 기록을 찾으시는 것 같아요..!</strong><span>순위를 억지로 나누지 않고, 주제 입구와 그 안의 기록을 함께 불러왔어요.</span>`;
      setTierLabels('주제', '전체 보기', isSingleYearSeries ? '연도순' : '기록', isSingleYearSeries ? '처음부터 이어 보기' : '이 주제의 기록');
      primaryResults.innerHTML = matchedTopics.slice(0, 3).map(card).join('');
      setPrimaryLayout(Math.min(matchedTopics.length, 3));
      secondaryResults.innerHTML = records.map(card).join('');
      primarySection.hidden = false;
      secondarySection.hidden = records.length === 0;
      return;
    }

    if (!relevant.length) {
      primaryResults.innerHTML = '';
      secondaryResults.innerHTML = '';
      primarySection.hidden = true;
      secondarySection.hidden = true;
      countEl.innerHTML = '<strong>아직 이 질문과 가까운 기록을 찾지 못했어요.</strong><span>다른 표현이나 선수·대회·도시 이름으로 다시 찾아봐 주세요.</span>';
      return;
    }

    const topScore = relevant[0].score;
    const primary = relevant.filter((item) => item.score >= Math.max(30, topScore * .82)).slice(0, 3);
    const primaryHrefs = new Set(primary.map((item) => item.href));
    const secondary = relevant.filter((item) => !primaryHrefs.has(item.href)).slice(0, 6);
    countEl.innerHTML = `<strong>아마 이런 걸 찾으시는 것 같아요..!</strong><span>삥이FC 전체 기록에서 ‘${escapeHtml(query)}’에 가까운 순서로 골랐어요.</span>`;
    setTierLabels('1순위', '가장 가까운 결과', '2순위', '함께 보면 좋은 결과');
    primaryResults.innerHTML = primary.map(card).join('');
    setPrimaryLayout(primary.length);
    secondaryResults.innerHTML = secondary.map(card).join('');
    primarySection.hidden = false;
    secondarySection.hidden = secondary.length === 0;
  }

  input.addEventListener('input', () => render(input.value));

  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q') || '';
  if (initialQuery) {
    input.value = initialQuery;
    render(initialQuery);
  }
</script>
