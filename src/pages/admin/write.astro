---
import '../../styles/global.css';
import { site } from '../../config/site';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>새 글쓰기 — {site.name} 관리자</title>
  </head>
  <body>
    <div class="min-h-screen bg-[var(--bbfc-bg)]">
      <header class="sticky top-0 z-30 bg-[var(--bbfc-bg)] border-b border-[var(--bbfc-line)]">
        <div class="max-w-[900px] mx-auto px-4 md:px-5 h-14 flex items-center justify-between gap-3">
          <p class="text-[15px] font-medium text-[var(--bbfc-ink)] shrink-0">새 글쓰기</p>
          <div class="flex items-center gap-2 min-w-0">
            <span id="bbfc-login-state" class="text-[11px] text-[var(--bbfc-gray-2)] whitespace-nowrap"></span>
            <button
              type="button"
              id="bbfc-publish-btn"
              class="bg-[var(--bbfc-blue)] text-white text-[13px] font-medium rounded-[var(--bbfc-radius)] px-4 py-2 shrink-0"
            >
              발행
            </button>
          </div>
        </div>
      </header>

      <div class="max-w-[900px] mx-auto px-4 md:px-5 py-6">
        <p id="bbfc-autosave-indicator" class="text-[11px] text-[var(--bbfc-gray-2)] mb-2 min-h-[14px]"></p>
        <p id="bbfc-status" class="text-[12px] mb-2 min-h-[16px]"></p>

        <input
          id="bbfc-title-input"
          type="text"
          placeholder="제목을 입력하세요"
          class="w-full text-[22px] font-medium text-[var(--bbfc-ink)] placeholder:text-[var(--bbfc-gray-3)] outline-none mb-4 bg-transparent"
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
          <label class="text-[12px] text-[var(--bbfc-gray-2)] flex flex-col gap-1">
            카테고리
            <div id="bbfc-category-levels" class="flex flex-wrap gap-2"></div>
          </label>

          <label class="text-[12px] text-[var(--bbfc-gray-2)] flex flex-col gap-1">
            URL slug (영문 소문자·숫자·하이픈, 발행 후 변경 금지)
            <input id="bbfc-slug-input" type="text" placeholder="예: my-first-post" class="bbfc-field" />
          </label>

          <label class="text-[12px] text-[var(--bbfc-gray-2)] flex flex-col gap-1 sm:col-span-2">
            설명 (검색결과에 노출)
            <textarea id="bbfc-description-input" rows="2" class="bbfc-field resize-none"></textarea>
          </label>

          <label class="text-[12px] text-[var(--bbfc-gray-2)] flex flex-col gap-1">
            태그 (쉼표로 구분)
            <input id="bbfc-tags-input" type="text" placeholder="예: 이탈리아, 축구 성지순례" class="bbfc-field" />
          </label>

          <label class="text-[12px] text-[var(--bbfc-gray-2)] flex flex-col gap-1">
            발행일 (예약 발행 시 미래 시각 지정)
            <input id="bbfc-pubdate-input" type="datetime-local" class="bbfc-field" />
          </label>

          <label class="text-[12px] text-[var(--bbfc-gray-2)] flex items-center gap-2 sm:col-span-2">
            <input id="bbfc-draft-checkbox" type="checkbox" checked />
            비공개(초안)로 저장 — 체크 해제해야 사이트에 노출됩니다
          </label>

          <label class="text-[12px] text-[var(--bbfc-gray-2)] flex items-center gap-2 sm:col-span-2">
            <input id="bbfc-featured-checkbox" type="checkbox" />
            이번 주 HOT (홈 히어로에 노출)
          </label>
        </div>

        <div
          id="bbfc-toolbar"
          class="flex flex-wrap items-center gap-1 border border-[var(--bbfc-border)] rounded-t-[var(--bbfc-radius)] bg-[var(--bbfc-fill-2)] p-2"
        >
          <select id="bbfc-block-select" class="bbfc-tb-select" aria-label="본문 스타일">
            <option value="paragraph">본문</option>
            <option value="1">제목1</option>
            <option value="2">제목2</option>
            <option value="3">제목3</option>
          </select>

          <select id="bbfc-font-select" class="bbfc-tb-select" aria-label="폰트">
            <option value="">프리텐다드</option>
            <option value="Georgia, 'Nanum Myeongjo', serif">명조체</option>
            <option value="'Malgun Gothic', sans-serif">고딕체</option>
          </select>

          <select id="bbfc-size-select" class="bbfc-tb-select" aria-label="글자 크기">
            <option value="">기본</option>
            <option value="13px">13</option>
            <option value="15px">15</option>
            <option value="18px">18</option>
            <option value="20px">20</option>
            <option value="24px">24</option>
            <option value="32px">32</option>
          </select>

          <span class="bbfc-tb-sep"></span>

          <button type="button" class="bbfc-tb-btn" data-cmd="bold" title="굵게"><b>B</b></button>
          <button type="button" class="bbfc-tb-btn" data-cmd="italic" title="기울임"><i>I</i></button>
          <button type="button" class="bbfc-tb-btn" data-cmd="underline" title="밑줄"><u>U</u></button>
          <button type="button" class="bbfc-tb-btn" data-cmd="strike" title="취소선"><s>S</s></button>

          <input id="bbfc-color-input" type="color" class="bbfc-tb-color" title="글자색" value="#191f28" />
          <button type="button" class="bbfc-tb-btn" data-cmd="highlight" title="형광펜">형광펜</button>

          <span class="bbfc-tb-sep"></span>

          <button type="button" class="bbfc-tb-btn" data-cmd="align-left" title="왼쪽 정렬">왼쪽</button>
          <button type="button" class="bbfc-tb-btn" data-cmd="align-center" title="가운데 정렬">가운데</button>
          <button type="button" class="bbfc-tb-btn" data-cmd="align-right" title="오른쪽 정렬">오른쪽</button>

          <span class="bbfc-tb-sep"></span>

          <button type="button" class="bbfc-tb-btn" data-cmd="bulletList" title="글머리 목록">목록</button>
          <button type="button" class="bbfc-tb-btn" data-cmd="orderedList" title="번호 목록">번호</button>
          <button type="button" class="bbfc-tb-btn" data-cmd="subscript" title="아래 첨자">x₂</button>
          <button type="button" class="bbfc-tb-btn" data-cmd="superscript" title="위 첨자">x²</button>

          <span class="bbfc-tb-sep"></span>

          <button type="button" class="bbfc-tb-btn" data-cmd="blockquote" title="인용구">인용</button>
          <button type="button" class="bbfc-tb-btn" data-cmd="hr" title="구분선">구분선</button>
          <button type="button" class="bbfc-tb-btn" data-cmd="table" title="표 삽입">표</button>
          <button type="button" class="bbfc-tb-btn" data-cmd="link" title="링크">링크</button>
          <button type="button" class="bbfc-tb-btn" data-cmd="image" title="사진 삽입(미리보기)">사진</button>
        </div>

        <div id="bbfc-editor" class="bbfc-editor-surface"></div>

        <div class="flex items-center justify-between mt-2">
          <p class="text-[11px] text-[var(--bbfc-gray-2)]">
            사진은 선택 즉시 GitHub의 public/images/에 업로드됩니다(첫 사진 업로드 시 GitHub 로그인 페이지로 이동하며, 로그인 후 다시 시도하면 됩니다). 유튜브 임베드는 다음 단계에서 이어집니다.
          </p>
          <button type="button" id="bbfc-clear-draft-btn" class="text-[11px] text-[var(--bbfc-gray-2)] underline shrink-0 ml-2">
            임시 초고 지우고 새로 시작
          </button>
        </div>
      </div>
    </div>

    <input type="file" id="bbfc-image-input" accept="image/*,.gif" hidden />

    <script>
      // @ts-nocheck -- 보존 중인 브라우저 전용 에디터. 기능 재개 시 모듈 분리와 함께 타입을 정비한다.
      import { Editor } from '@tiptap/core';
      import { Extension } from '@tiptap/core';
      import StarterKit from '@tiptap/starter-kit';
      import Underline from '@tiptap/extension-underline';
      import { TextStyle } from '@tiptap/extension-text-style';
      import Color from '@tiptap/extension-color';
      import Highlight from '@tiptap/extension-highlight';
      import TextAlign from '@tiptap/extension-text-align';
      import Subscript from '@tiptap/extension-subscript';
      import Superscript from '@tiptap/extension-superscript';
      import Link from '@tiptap/extension-link';
      import Image from '@tiptap/extension-image';
      import { Table } from '@tiptap/extension-table';
      import TableRow from '@tiptap/extension-table-row';
      import TableHeader from '@tiptap/extension-table-header';
      import TableCell from '@tiptap/extension-table-cell';
      import FontFamily from '@tiptap/extension-font-family';
      import Placeholder from '@tiptap/extension-placeholder';
      import TurndownService from 'turndown';
      import { gfm } from 'turndown-plugin-gfm';
      import { getTopLevel, getChildren, getAncestorChain, categories } from '../../config/categories';

      const GITHUB_REPO = 'BBINGE/bbinge-fc';
      const GITHUB_BRANCH = 'main';
      const TOKEN_KEY = 'bbfc-gh-token';
      const AUTOSAVE_KEY = 'bbfc-write-autosave-v1';

      // 공식 확장에 없는 글자 크기는 TextStyle 마크에 속성을 얹는 표준 방식으로 구현
      const FontSize = Extension.create({
        name: 'fontSize',
        addOptions() {
          return { types: ['textStyle'] };
        },
        addGlobalAttributes() {
          return [
            {
              types: this.options.types,
              attributes: {
                fontSize: {
                  default: null,
                  parseHTML: (el) => el.style.fontSize || null,
                  renderHTML: (attrs) => (attrs.fontSize ? { style: `font-size: ${attrs.fontSize}` } : {}),
                },
              },
            },
          ];
        },
        addCommands() {
          return {
            setFontSize:
              (fontSize) =>
              ({ chain }) =>
                chain().setMark('textStyle', { fontSize }).run(),
            unsetFontSize:
              () =>
              ({ chain }) =>
                chain().setMark('textStyle', { fontSize: null }).run(),
          };
        },
      });

      const editor = new Editor({
        element: document.getElementById('bbfc-editor'),
        editorProps: {
          attributes: { spellcheck: 'true', lang: 'ko', class: 'bbfc-prose' },
        },
        extensions: [
          StarterKit.configure({ code: false, codeBlock: false }),
          Underline,
          TextStyle,
          Color,
          Highlight,
          FontFamily,
          FontSize,
          TextAlign.configure({ types: ['heading', 'paragraph'] }),
          Subscript,
          Superscript,
          Link.configure({ openOnClick: false, autolink: true }),
          Image,
          Table.configure({ resizable: false }),
          TableRow,
          TableHeader,
          TableCell,
          Placeholder.configure({ placeholder: '축구 이야기를 시작해보세요…' }),
        ],
        content: '',
      });

      const toolbar = document.getElementById('bbfc-toolbar');
      const blockSelect = document.getElementById('bbfc-block-select');
      const fontSelect = document.getElementById('bbfc-font-select');
      const sizeSelect = document.getElementById('bbfc-size-select');
      const colorInput = document.getElementById('bbfc-color-input');
      const imageInput = document.getElementById('bbfc-image-input');

      function updateToolbarState() {
        toolbar.querySelectorAll('[data-cmd]').forEach((btn) => {
          const cmd = btn.getAttribute('data-cmd');
          let active = false;
          if (cmd === 'align-left') active = editor.isActive({ textAlign: 'left' });
          else if (cmd === 'align-center') active = editor.isActive({ textAlign: 'center' });
          else if (cmd === 'align-right') active = editor.isActive({ textAlign: 'right' });
          else if (cmd === 'hr' || cmd === 'table' || cmd === 'image') active = false;
          else active = editor.isActive(cmd);
          btn.classList.toggle('is-active', active);
        });

        if (editor.isActive('heading', { level: 1 })) blockSelect.value = '1';
        else if (editor.isActive('heading', { level: 2 })) blockSelect.value = '2';
        else if (editor.isActive('heading', { level: 3 })) blockSelect.value = '3';
        else blockSelect.value = 'paragraph';
      }

      editor.on('selectionUpdate', updateToolbarState);
      editor.on('transaction', updateToolbarState);

      toolbar.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-cmd]');
        if (!btn) return;
        const cmd = btn.getAttribute('data-cmd');
        const chain = editor.chain().focus();

        switch (cmd) {
          case 'bold':
            chain.toggleBold().run();
            break;
          case 'italic':
            chain.toggleItalic().run();
            break;
          case 'underline':
            chain.toggleUnderline().run();
            break;
          case 'strike':
            chain.toggleStrike().run();
            break;
          case 'highlight':
            chain.toggleHighlight().run();
            break;
          case 'align-left':
            chain.setTextAlign('left').run();
            break;
          case 'align-center':
            chain.setTextAlign('center').run();
            break;
          case 'align-right':
            chain.setTextAlign('right').run();
            break;
          case 'bulletList':
            chain.toggleBulletList().run();
            break;
          case 'orderedList':
            chain.toggleOrderedList().run();
            break;
          case 'subscript':
            chain.toggleSubscript().run();
            break;
          case 'superscript':
            chain.toggleSuperscript().run();
            break;
          case 'blockquote':
            chain.toggleBlockquote().run();
            break;
          case 'hr':
            chain.setHorizontalRule().run();
            break;
          case 'table':
            chain.insertTable({ rows: 3, cols: 3, withHeaderRow: true }).run();
            break;
          case 'link': {
            const previousUrl = editor.getAttributes('link').href;
            const url = window.prompt('링크 주소를 입력하세요', previousUrl || 'https://');
            if (url === null) break;
            if (url === '') {
              chain.extendMarkRange('link').unsetLink().run();
            } else {
              chain.extendMarkRange('link').setLink({ href: url }).run();
            }
            break;
          }
          case 'image':
            imageInput.click();
            break;
        }
      });

      blockSelect.addEventListener('change', () => {
        const value = blockSelect.value;
        const chain = editor.chain().focus();
        if (value === 'paragraph') chain.setParagraph().run();
        else chain.toggleHeading({ level: Number(value) }).run();
      });

      fontSelect.addEventListener('change', () => {
        const value = fontSelect.value;
        const chain = editor.chain().focus();
        if (value) chain.setFontFamily(value).run();
        else chain.unsetFontFamily().run();
      });

      sizeSelect.addEventListener('change', () => {
        const value = sizeSelect.value;
        const chain = editor.chain().focus();
        if (value) chain.setMark('textStyle', { fontSize: value }).run();
        else chain.setMark('textStyle', { fontSize: null }).run();
      });

      colorInput.addEventListener('input', () => {
        editor.chain().focus().setColor(colorInput.value).run();
      });

      imageInput.addEventListener('change', async () => {
        const file = imageInput.files?.[0];
        if (!file) return;
        const token = ensureToken();
        if (!token) return; // 로그인 페이지로 이동 중
        try {
          setStatus('이미지 업로드 중…');
          const base64 = await fileToBase64(file);
          const safeName = `${Date.now()}-${file.name.toLowerCase().replace(/[^a-z0-9.]+/g, '-')}`;
          const path = `public/images/${safeName}`;
          await commitFile(token, path, base64, `이미지 추가: ${safeName}`);
          editor.chain().focus().setImage({ src: `/images/${safeName}`, alt: file.name }).run();
          setStatus('이미지 업로드 완료');
        } catch (err) {
          setStatus(err instanceof Error ? err.message : '이미지 업로드에 실패했습니다.', true);
        } finally {
          imageInput.value = '';
        }
      });

      // ---------- GitHub 로그인 (전체 페이지 리다이렉트, 팝업 미사용) ----------
      // 팝업(window.open) 기반 로그인이 팝업 차단 환경에서 원천 차단되는 문제가 있어
      // /auth?flow=write 로 페이지 전체를 이동시키는 방식으로 바꿨다. /admin(Sveltia CMS)의
      // 기존 팝업+postMessage 로그인은 flow 파라미터가 없는 기본 요청이라 영향받지 않는다
      // (분기 로직은 functions/auth.js, functions/callback.js 참고).

      function updateLoginState() {
        const loginState = document.getElementById('bbfc-login-state');
        loginState.textContent = localStorage.getItem(TOKEN_KEY) ? 'GitHub 로그인됨' : '로그인 필요';
      }

      // 콜백이 /admin/write/#gh_token=... 형태로 되돌아오므로, 로드 시 해시를 읽어 토큰을
      // 저장한 뒤 즉시 해시를 지운다(주소창·히스토리에 토큰이 남지 않도록).
      function consumeAuthHash() {
        const hash = window.location.hash;
        if (!hash) return;

        const tokenMatch = hash.match(/gh_token=([^&]+)/);
        const errorMatch = hash.match(/gh_auth_error=([^&]+)/);

        if (tokenMatch) {
          localStorage.setItem(TOKEN_KEY, decodeURIComponent(tokenMatch[1]));
          updateLoginState();
          setStatus('GitHub 로그인 완료. 이어서 다시 시도해주세요.');
        } else if (errorMatch) {
          setStatus(decodeURIComponent(errorMatch[1]) || 'GitHub 로그인에 실패했습니다.', true);
        } else {
          return;
        }

        history.replaceState(null, '', window.location.pathname + window.location.search);
      }

      // 토큰이 없으면 현재 초고를 저장해두고 로그인 페이지로 이동한다(진행 중이던 함수는 여기서 중단됨).
      // 로그인 후 자동저장된 초고가 복원되므로, 사용자가 사진/발행을 다시 누르기만 하면 된다.
      function ensureToken() {
        const existing = localStorage.getItem(TOKEN_KEY);
        if (existing) return existing;
        saveDraftToLocal();
        setStatus('GitHub 로그인이 필요합니다. 로그인 페이지로 이동합니다…');
        window.location.href = '/auth?flow=write';
        return null;
      }

      // ---------- GitHub 커밋 ----------

      function toBase64Utf8(str) {
        const bytes = new TextEncoder().encode(str);
        let binary = '';
        bytes.forEach((b) => {
          binary += String.fromCharCode(b);
        });
        return btoa(binary);
      }

      function fileToBase64(file) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => {
            const result = String(reader.result);
            resolve(result.slice(result.indexOf(',') + 1));
          };
          reader.onerror = () => reject(new Error('파일을 읽지 못했습니다.'));
          reader.readAsDataURL(file);
        });
      }

      // GitHub Contents API는 기존 파일을 덮어쓸 때 그 파일의 현재 sha를 함께 보내야 한다(없으면 422).
      // 새 파일이면 404가 나므로 sha 없이 진행한다.
      async function getFileSha(token, encodedPath) {
        const res = await fetch(
          `https://api.github.com/repos/${GITHUB_REPO}/contents/${encodedPath}?ref=${GITHUB_BRANCH}`,
          {
            headers: {
              Authorization: `token ${token}`,
              Accept: 'application/vnd.github+json',
            },
          },
        );
        if (res.status === 404) return null;
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          throw new Error(body.message || `GitHub 파일 조회에 실패했습니다 (HTTP ${res.status}).`);
        }
        const data = await res.json();
        return data.sha;
      }

      async function commitFile(token, path, base64Content, message) {
        const encodedPath = path.split('/').map(encodeURIComponent).join('/');
        const sha = await getFileSha(token, encodedPath);
        const payload = { message, content: base64Content, branch: GITHUB_BRANCH };
        if (sha) payload.sha = sha;

        const res = await fetch(`https://api.github.com/repos/${GITHUB_REPO}/contents/${encodedPath}`, {
          method: 'PUT',
          headers: {
            Authorization: `token ${token}`,
            Accept: 'application/vnd.github+json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          throw new Error(body.message || `GitHub 커밋에 실패했습니다 (HTTP ${res.status}).`);
        }
        return res.json();
      }

      // ---------- 마크다운 변환 ----------

      const turndownService = new TurndownService({
        headingStyle: 'atx',
        codeBlockStyle: 'fenced',
        bulletListMarker: '-',
      });
      turndownService.use(gfm);
      // 위지윅 서식(밑줄·형광펜·위/아래첨자·글자색·글자크기·폰트)은 마크다운 기본 문법이 없어
      // Astro가 지원하는 raw HTML 그대로 보존한다.
      turndownService.keep(['u', 'mark', 'sub', 'sup', 'span']);
      turndownService.addRule('alignedBlock', {
        filter: (node) =>
          ['P', 'H1', 'H2', 'H3'].includes(node.nodeName) &&
          /text-align:\s*(center|right)/.test(node.getAttribute('style') || ''),
        replacement: (_content, node) => `\n\n${node.outerHTML}\n\n`,
      });

      function htmlToMarkdown(html) {
        return turndownService.turndown(html).trim();
      }

      // ---------- frontmatter ----------

      function yamlString(value) {
        return JSON.stringify(value);
      }

      function buildFrontmatter({ title, description, category, tags, pubDateIso, draft, featured }) {
        const lines = ['---'];
        lines.push(`title: ${yamlString(title)}`);
        lines.push(`description: ${yamlString(description)}`);
        lines.push(`category: ${category}`);
        if (tags.length > 0) {
          lines.push('tags:');
          tags.forEach((tag) => lines.push(`  - ${yamlString(tag)}`));
        } else {
          lines.push('tags: []');
        }
        lines.push(`pubDate: ${yamlString(pubDateIso)}`);
        lines.push(`draft: ${draft ? 'true' : 'false'}`);
        lines.push(`featured: ${featured ? 'true' : 'false'}`);
        lines.push('---');
        return lines.join('\n');
      }

      function slugify(title) {
        const base = title
          .toLowerCase()
          .normalize('NFKD')
          .replace(/[^\x00-\x7f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');
        if (base) return base;
        const d = new Date();
        const pad = (n) => String(n).padStart(2, '0');
        return `post-${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}`;
      }

      function nowLocalInputValue() {
        const d = new Date();
        const pad = (n) => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
      }

      // ---------- 카테고리 계단식 드롭다운 ----------
      // 트리 depth가 늘어나도 그대로 동작하도록, 선택한 노드에 하위 카테고리가 있으면
      // 다음 단계 <select>를 동적으로 이어붙인다. 지금은 전부 최상위뿐이라 드롭다운 1단으로 보임.

      const categoryLevels = document.getElementById('bbfc-category-levels');
      let selectedCategorySlug = '';

      function makeCategoryLevelSelect(level, options) {
        const select = document.createElement('select');
        select.className = 'bbfc-field bbfc-category-select';
        select.dataset.level = String(level);
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = level === 0 ? '카테고리 선택' : '하위 선택 안 함';
        if (level === 0) placeholder.disabled = true;
        placeholder.selected = true;
        select.appendChild(placeholder);
        options.forEach(({ slug, label }) => {
          const opt = document.createElement('option');
          opt.value = slug;
          opt.textContent = label;
          select.appendChild(opt);
        });
        select.addEventListener('change', onCategoryLevelChange);
        return select;
      }

      function onCategoryLevelChange(e) {
        const level = Number(e.target.dataset.level);
        categoryLevels.querySelectorAll('.bbfc-category-select').forEach((el) => {
          if (Number(el.dataset.level) > level) el.remove();
        });
        const slug = e.target.value;
        selectedCategorySlug = slug;
        if (slug) {
          const children = getChildren(slug);
          if (children.length > 0) categoryLevels.appendChild(makeCategoryLevelSelect(level + 1, children));
        }
        scheduleAutosave();
      }

      // slug가 속한 카테고리까지의 조상 체인을 따라 각 단계 드롭다운을 복원한다.
      function setCategoryFromSlug(slug) {
        categoryLevels.innerHTML = '';
        selectedCategorySlug = '';
        const first = makeCategoryLevelSelect(0, getTopLevel());
        categoryLevels.appendChild(first);
        if (!slug || !categories[slug]) return;

        let currentSelect = first;
        getAncestorChain(slug).forEach((node, i) => {
          currentSelect.value = node.slug;
          selectedCategorySlug = node.slug;
          const children = getChildren(node.slug);
          if (children.length > 0) {
            currentSelect = makeCategoryLevelSelect(i + 1, children);
            categoryLevels.appendChild(currentSelect);
          }
        });
      }

      // ---------- 폼 엘리먼트 ----------

      const titleInput = document.getElementById('bbfc-title-input');
      const slugInput = document.getElementById('bbfc-slug-input');
      const descriptionInput = document.getElementById('bbfc-description-input');
      const tagsInput = document.getElementById('bbfc-tags-input');
      const pubDateInput = document.getElementById('bbfc-pubdate-input');
      const draftCheckbox = document.getElementById('bbfc-draft-checkbox');
      const featuredCheckbox = document.getElementById('bbfc-featured-checkbox');
      const publishBtn = document.getElementById('bbfc-publish-btn');
      const clearDraftBtn = document.getElementById('bbfc-clear-draft-btn');
      const statusEl = document.getElementById('bbfc-status');
      const autosaveIndicator = document.getElementById('bbfc-autosave-indicator');

      let slugDirty = false;

      function setStatus(message, isError) {
        statusEl.textContent = message;
        statusEl.style.color = isError ? '#dc2626' : 'var(--bbfc-gray-2)';
      }

      // ---------- 자동 저장 (로컬) ----------

      let autosaveTimer;

      function scheduleAutosave() {
        clearTimeout(autosaveTimer);
        autosaveTimer = setTimeout(saveDraftToLocal, 800);
      }

      function saveDraftToLocal() {
        const data = {
          title: titleInput.value,
          slug: slugInput.value,
          slugDirty,
          description: descriptionInput.value,
          category: selectedCategorySlug,
          tags: tagsInput.value,
          pubDate: pubDateInput.value,
          draft: draftCheckbox.checked,
          featured: featuredCheckbox.checked,
          html: editor.getHTML(),
          savedAt: Date.now(),
        };
        localStorage.setItem(AUTOSAVE_KEY, JSON.stringify(data));
        autosaveIndicator.textContent = `자동 저장됨 · ${new Date(data.savedAt).toLocaleTimeString('ko-KR')}`;
      }

      function loadDraftFromLocal() {
        const raw = localStorage.getItem(AUTOSAVE_KEY);
        if (!raw) return;
        try {
          const data = JSON.parse(raw);
          if (data.title) titleInput.value = data.title;
          if (data.slug) slugInput.value = data.slug;
          slugDirty = !!data.slugDirty;
          if (data.description) descriptionInput.value = data.description;
          setCategoryFromSlug(data.category || '');
          if (data.tags) tagsInput.value = data.tags;
          if (data.pubDate) pubDateInput.value = data.pubDate;
          draftCheckbox.checked = data.draft !== false;
          featuredCheckbox.checked = !!data.featured;
          if (data.html) editor.commands.setContent(data.html);
          autosaveIndicator.textContent = `임시 저장된 초고를 불러왔습니다 · ${new Date(data.savedAt).toLocaleString('ko-KR')}`;
        } catch {
          /* 손상된 초고는 무시 */
        }
      }

      function clearDraft() {
        localStorage.removeItem(AUTOSAVE_KEY);
        titleInput.value = '';
        slugInput.value = '';
        slugDirty = false;
        descriptionInput.value = '';
        setCategoryFromSlug('');
        tagsInput.value = '';
        pubDateInput.value = nowLocalInputValue();
        draftCheckbox.checked = true;
        featuredCheckbox.checked = false;
        editor.commands.setContent('');
        autosaveIndicator.textContent = '';
        setStatus('');
      }

      titleInput.addEventListener('input', () => {
        if (!slugDirty) slugInput.value = slugify(titleInput.value);
        scheduleAutosave();
      });
      slugInput.addEventListener('input', () => {
        slugDirty = true;
        scheduleAutosave();
      });
      [descriptionInput, tagsInput, pubDateInput, draftCheckbox, featuredCheckbox].forEach((el) => {
        el.addEventListener('input', scheduleAutosave);
        el.addEventListener('change', scheduleAutosave);
      });
      editor.on('update', scheduleAutosave);

      clearDraftBtn.addEventListener('click', () => {
        if (window.confirm('임시 저장된 초고를 지우고 새로 시작할까요?')) clearDraft();
      });

      // ---------- 발행 ----------

      async function publish() {
        const title = titleInput.value.trim();
        const description = descriptionInput.value.trim();
        const category = selectedCategorySlug;
        const slug = (slugInput.value.trim() || slugify(title)).toLowerCase();
        const tags = tagsInput.value
          .split(',')
          .map((t) => t.trim())
          .filter(Boolean);
        const draft = draftCheckbox.checked;
        const featured = featuredCheckbox.checked;

        if (!title) throw new Error('제목을 입력하세요.');
        if (!description) throw new Error('설명을 입력하세요.');
        if (!category) throw new Error('카테고리를 선택하세요.');
        if (!/^[a-z0-9-]+$/.test(slug)) throw new Error('slug는 영문 소문자·숫자·하이픈만 사용할 수 있습니다.');

        const pubDateIso = pubDateInput.value ? new Date(pubDateInput.value).toISOString() : new Date().toISOString();

        const token = ensureToken();
        if (!token) return; // 로그인 페이지로 이동 중

        const markdownBody = htmlToMarkdown(editor.getHTML());
        const frontmatter = buildFrontmatter({ title, description, category, tags, pubDateIso, draft, featured });
        const fileContent = `${frontmatter}\n\n${markdownBody}\n`;
        const path = `src/content/articles/${slug}.md`;

        await commitFile(token, path, toBase64Utf8(fileContent), `글 발행: ${title}`);

        clearAutosaveOnly();
        setStatus(`발행 완료: /${category}/${slug}/ (Cloudflare 재빌드 후 사이트에 반영됩니다)`);
      }

      function clearAutosaveOnly() {
        localStorage.removeItem(AUTOSAVE_KEY);
        autosaveIndicator.textContent = '';
      }

      publishBtn.addEventListener('click', async () => {
        publishBtn.disabled = true;
        publishBtn.textContent = '발행 중…';
        setStatus('발행 중…');
        try {
          await publish();
        } catch (err) {
          setStatus(err instanceof Error ? err.message : '발행 중 오류가 발생했습니다.', true);
        } finally {
          publishBtn.disabled = false;
          publishBtn.textContent = '발행';
        }
      });

      // ---------- 초기화 ----------

      consumeAuthHash();
      updateLoginState();
      setCategoryFromSlug('');
      if (!pubDateInput.value) pubDateInput.value = nowLocalInputValue();
      loadDraftFromLocal();
    </script>

    <style>
      .bbfc-field {
        font-size: 13px;
        color: var(--bbfc-ink);
        background: var(--bbfc-bg);
        border: 1px solid var(--bbfc-border);
        border-radius: var(--bbfc-radius);
        padding: 8px 10px;
        outline: none;
      }
      .bbfc-field:focus {
        border-color: var(--bbfc-blue);
      }
      .bbfc-tb-btn {
        font-size: 12.5px;
        padding: 6px 10px;
        border-radius: var(--bbfc-radius);
        color: var(--bbfc-ink-2);
      }
      .bbfc-tb-btn:hover {
        background: var(--bbfc-fill);
      }
      .bbfc-tb-btn.is-active {
        background: var(--bbfc-blue-weak);
        color: var(--bbfc-blue);
      }
      .bbfc-tb-select {
        font-size: 12.5px;
        color: var(--bbfc-ink-2);
        background: var(--bbfc-bg);
        border: 1px solid var(--bbfc-border);
        border-radius: var(--bbfc-radius);
        padding: 5px 6px;
      }
      .bbfc-tb-color {
        width: 28px;
        height: 28px;
        padding: 2px;
        border: 1px solid var(--bbfc-border);
        border-radius: var(--bbfc-radius);
        background: var(--bbfc-bg);
      }
      .bbfc-tb-sep {
        width: 1px;
        align-self: stretch;
        background: var(--bbfc-border);
        margin: 2px 4px;
      }
      .bbfc-editor-surface {
        border: 1px solid var(--bbfc-border);
        border-top: none;
        border-radius: 0 0 var(--bbfc-radius) var(--bbfc-radius);
        min-height: 420px;
        padding: 16px;
      }
      .bbfc-editor-surface :global(.ProseMirror) {
        outline: none;
        font-size: 16px;
        line-height: 1.7;
        color: var(--bbfc-ink);
      }
      .bbfc-editor-surface :global(.ProseMirror p.is-editor-empty:first-child::before) {
        content: attr(data-placeholder);
        float: left;
        height: 0;
        color: var(--bbfc-gray-3);
        pointer-events: none;
      }
      .bbfc-editor-surface :global(.ProseMirror h1) {
        font-size: 24px;
        font-weight: 500;
        margin-top: 24px;
      }
      .bbfc-editor-surface :global(.ProseMirror h2) {
        font-size: 20px;
        font-weight: 500;
        margin-top: 20px;
      }
      .bbfc-editor-surface :global(.ProseMirror h3) {
        font-size: 18px;
        font-weight: 500;
        margin-top: 16px;
      }
      .bbfc-editor-surface :global(.ProseMirror blockquote) {
        border-left: 3px solid var(--bbfc-blue);
        padding-left: 14px;
        color: var(--bbfc-ink-2);
        margin: 16px 0;
      }
      .bbfc-editor-surface :global(.ProseMirror mark) {
        background: #fef08a;
        border-radius: 2px;
      }
      .bbfc-editor-surface :global(.ProseMirror img) {
        max-width: 100%;
        border-radius: var(--bbfc-radius);
      }
      .bbfc-editor-surface :global(.ProseMirror table) {
        border-collapse: collapse;
        width: 100%;
        margin: 16px 0;
      }
      .bbfc-editor-surface :global(.ProseMirror td),
      .bbfc-editor-surface :global(.ProseMirror th) {
        border: 1px solid var(--bbfc-border);
        padding: 8px 10px;
      }
      .bbfc-editor-surface :global(.ProseMirror th) {
        background: var(--bbfc-fill);
        font-weight: 500;
      }
      .bbfc-editor-surface :global(.ProseMirror hr) {
        border: none;
        border-top: 1px solid var(--bbfc-border);
        margin: 24px 0;
      }
    </style>
  </body>
</html>
