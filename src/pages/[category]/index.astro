---
import Layout from '../../layouts/Layout.astro';
import CategoryArticleList from '../../components/CategoryArticleList.astro';
import { getCollection } from 'astro:content';
import { categories, categoryList, type CategorySlug } from '../../config/categories';

export async function getStaticPaths() {
  // 'play'는 GOAT 토너먼트 전용 페이지(src/pages/play/index.astro)가 대신한다.
  return categoryList.filter(({ slug }) => slug !== 'play').map(({ slug }) => ({ params: { category: slug } }));
}

const { category } = Astro.params as { category: CategorySlug };
const meta = categories[category];

const articles = (
  await getCollection('articles', ({ data }) => !data.draft && data.category === category)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title={meta.label}
  description={`BBinge FC — ${meta.label} 카테고리`}
  breadcrumbs={[
    { label: '홈', href: '/' },
    { label: meta.label, href: `/${category}/` },
  ]}
>
  <div class="max-w-[1040px] mx-auto px-4 md:px-5 py-6">
    <div class="flex items-baseline gap-2 mb-5">
      <h1 class="text-[24px] font-medium text-[var(--bbfc-ink)]">{meta.label}</h1>
      <span class="text-[13px] text-[var(--bbfc-gray-2)]">{articles.length}편</span>
    </div>
    <CategoryArticleList entries={articles} />
  </div>
</Layout>
