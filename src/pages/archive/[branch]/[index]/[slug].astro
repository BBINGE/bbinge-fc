  .archive-body :global(.legend-identity-brazil .identity-team img) { width: 64px; height: 91px; justify-self: center; }
  .archive-body :global(.legend-identity-brazil span) { color: inherit; font-size: 11px; }
  .archive-body :global(.legend-identity-brazil strong) { margin-top: 6px; color: inherit; font-size: 22px; }
  .archive-body :global(.legend-identity-brazil small) { color: inherit; font-size: 12px; line-height: 1.45; }
  .archive-body :global(.legend-reel) { overflow: hidden; margin: 40px 0 64px; border-radius: 20px; background: #061b11; color: #fff; box-shadow: 0 24px 60px rgba(1,41,22,.18); }
  .archive-body :global(.legend-reel-head) { display: grid; grid-template-columns: 1fr auto; padding: 20px 22px 18px; }
  .archive-body :global(.legend-reel-head span) { grid-column: 1; font-size: 11px; font-weight: 800; letter-spacing: .16em; color: #f8d80e; }
  .archive-body :global(.legend-reel-head strong) { grid-column: 1; margin-top: 4px; font-size: 22px; }
  .archive-body :global(.legend-reel-head small) { grid-column: 2; grid-row: 1 / 3; align-self: center; color: rgba(255,255,255,.62); font-size: 12px; }
  .archive-body :global(.legend-reel video) { display: block; width: 100%; aspect-ratio: 16 / 9; max-height: 520px; object-fit: contain; background: #000; }
  .archive-body :global(.legend-reel-foot) { padding: 18px 22px 22px; }
  .archive-body :global(.legend-reel-foot p) { min-height: 3.3em; margin: 0; font-size: 16px; line-height: 1.65; color: rgba(255,255,255,.8); }
  .archive-body :global(.legend-reel-progress) { display: grid; grid-template-columns: repeat(var(--reel-count, 5), 1fr); gap: 5px; margin-top: 14px; }
  .archive-body :global(.legend-reel-progress i) { height: 3px; border-radius: 3px; background: rgba(255,255,255,.18); }
  .archive-body :global(.legend-reel-progress i.is-active) { background: #f8d80e; }
  .archive-body :global(.record-facts-brazil) { overflow: hidden; border: 1px solid #07883d; border-radius: 16px; background: #fff; }
  .archive-body :global(.profile-country-head) { grid-column: 1 / -1; display: grid; grid-template-columns: 112px 1fr 90px; align-items: center; gap: 22px; min-height: 154px; padding: 22px 28px; background: linear-gradient(135deg, #07883d 0 30%, #f7d910 30% 100%); }
  .archive-body :global(.profile-country-head > img:first-child) { width: 112px; height: 78px; object-fit: cover; border-radius: 5px; }
  .archive-body :global(.profile-country-head > img:last-child) { width: 76px; height: 82px; justify-self: end; object-fit: contain; }
