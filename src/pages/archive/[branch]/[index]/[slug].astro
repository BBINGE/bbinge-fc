---
import Layout from '../../../../layouts/Layout.astro';
import ShareButtons from '../../../../components/ShareButtons.astro';
import ContentCover from '../../../../components/ContentCover.astro';
import RelatedAssets from '../../../../components/RelatedAssets.astro';
import ArticleByline from '../../../../components/ArticleByline.astro';
import ArticleProvenance from '../../../../components/ArticleProvenance.astro';
import { categories, getArticlePath } from '../../../../config/categories';
import { site } from '../../../../config/site';
import { archiveBranches } from '../../../../data/archive';
import { getCollection, render, type CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'archive'> }

export async function getStaticPaths() {
  const entries = await getCollection('archive', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { branch: entry.data.branch, index: entry.data.index, slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as Props;
const branch = archiveBranches.find((item) => item.id === entry.data.branch)!;
const archiveIndex = branch.indexes.find((item) => item.slug === entry.data.index)!;
const isLegend = entry.data.branch === 'legends';
const viewPath = `/archive/${branch.id}/${archiveIndex.slug}/${entry.id}/`;
const { Content } = await render(entry);
const indexRecords = (await getCollection('archive', ({ data }) =>
  !data.draft && data.branch === entry.data.branch && data.index === entry.data.index
)).sort((a, b) => a.data.year - b.data.year || a.id.localeCompare(b.id));
const currentPosition = indexRecords.findIndex((record) => record.id === entry.id);
const previousRecord = currentPosition > 0 ? indexRecords[currentPosition - 1] : undefined;
const nextRecord = currentPosition >= 0 && currentPosition < indexRecords.length - 1
  ? indexRecords[currentPosition + 1]
  : undefined;
const nextExpectedYear = entry.data.year + 1;
const chronologyWindowSize = Math.min(5, indexRecords.length);
const chronologyStart = Math.min(
  Math.max(currentPosition - 2, 0),
  Math.max(indexRecords.length - chronologyWindowSize, 0)
);
const relatedRecords = indexRecords
  .slice(chronologyStart, chronologyStart + chronologyWindowSize)
  .filter((record) => record.id !== entry.id);
const relatedAssets = entry.data.relatedGroup
  ? (await getCollection('articles', ({ data }) => !data.draft && data.relatedGroup === entry.data.relatedGroup))
      .map((record) => ({
        href: getArticlePath(record.data.category, record.id),
        title: record.data.title,
        description: record.data.description,
        label: categories[record.data.category]?.label ?? '연관 기록',
        coverImage: record.data.coverImage,
      }))
  : [];
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.coverImage}
  ogImageAlt={entry.data.coverImageAlt}
  ogImageWidth={entry.data.coverImageWidth}
  ogImageHeight={entry.data.coverImageHeight}
  ogImageCaption={entry.data.coverImageCaption}
  type="article"
  article={{
    pubDate: entry.data.pubDate,
    updatedDate: entry.data.updatedDate,
    section: `${branch.title} · ${archiveIndex.label}`,
    subjects: [entry.data.subject, archiveIndex.label, entry.data.originalTitle, ...entry.data.tags, ...entry.data.keywords].filter(Boolean) as string[],
    keywords: entry.data.keywords,
  }}
  breadcrumbs={[
    { label: '홈', href: '/' }, { label: '삥이 아카이브', href: '/archive/' },
    { label: branch.title, href: `/archive/${branch.id}/` },
    { label: archiveIndex.label, href: `/archive/${branch.id}/${archiveIndex.slug}/` },
    { label: entry.data.title, href: `/archive/${branch.id}/${archiveIndex.slug}/${entry.id}/` },
  ]}
>
  <article class="archive-article">
    <nav class="article-path"><a href="/archive/">삥이 아카이브</a><span>/</span><a href={`/archive/${branch.id}/${archiveIndex.slug}/`}>{archiveIndex.label}</a></nav>
    <header class="article-header">
      <p>{isLegend ? `${archiveIndex.label} · LEGEND` : `${entry.data.year} · ${archiveIndex.label}`}</p>
      <h1>{entry.data.title}</h1>
      <span>{entry.data.description}</span>
      <ArticleByline pubDate={entry.data.pubDate} updatedDate={entry.data.updatedDate} />
    </header>
    <ContentCover
      src={entry.data.coverImage}
      alt={entry.data.coverImageAlt}
      caption={entry.data.coverImageCaption}
      width={entry.data.coverImageWidth}
      height={entry.data.coverImageHeight}
      variant="archive"
    />
    {entry.data.tags.length > 0 && (
      <nav class="archive-tags" aria-label="이 글의 인물 분류">
        {entry.data.tags.map((tag) => <span>#{tag}</span>)}
      </nav>
    )}
    <div class="archive-body"><Content /></div>
    <ArticleProvenance />
    <div class="archive-share">
      <ShareButtons
        url={new URL(`/archive/${branch.id}/${archiveIndex.slug}/${entry.id}/`, site.url).toString()}
        title={entry.data.title}
      />
    </div>
    <RelatedAssets items={relatedAssets} />
    <nav class="sequence-nav" aria-label={`${archiveIndex.label} 이전·다음 기록`}>
      {previousRecord && (
        <a class="sequence-link is-previous" href={`/archive/${previousRecord.data.branch}/${previousRecord.data.index}/${previousRecord.id}/`}>
          <span>{isLegend ? 'PREVIOUS LEGEND' : 'PREVIOUS RECORD'}</span>
          <strong>◀ {isLegend ? '이전 인물' : `${previousRecord.data.year}년 기록`}</strong>
          <small>{previousRecord.data.subject}</small>
        </a>
      )}
      {nextRecord ? (
        <a class="sequence-link is-next" href={`/archive/${nextRecord.data.branch}/${nextRecord.data.index}/${nextRecord.id}/`}>
          <span>{isLegend ? 'NEXT LEGEND' : 'NEXT RECORD'}</span>
          <strong>{isLegend ? '다음 인물' : `${nextRecord.data.year}년 기록`} ▶</strong>
          <small>{nextRecord.data.subject}</small>
        </a>
      ) : !isLegend && (
        <div class="sequence-link is-next is-pending" aria-label={`${nextExpectedYear}년 다음 기록은 아직 발행되지 않음`}>
          <span>NEXT RECORD</span>
          <strong>{nextExpectedYear}년 기록 ▶</strong>
          <small>다음 기록 발행 예정</small>
        </div>
      )}
    </nav>
    {relatedRecords.length > 0 && (
      <aside class="related-records" aria-labelledby="related-records-title">
        <div><p>{isLegend ? 'MORE LEGENDS' : 'CHRONOLOGY'}</p><h2 id="related-records-title">{isLegend ? `${archiveIndex.label} 레전드 이어보기` : '연대기 이어보기'}</h2></div>
        <div class="related-grid">
          {relatedRecords.map((record) => (
            <a href={`/archive/${record.data.branch}/${record.data.index}/${record.id}/`}>
              <div class="related-cover">
                <img src={record.data.coverImage} alt="" width="640" height="640" loading="lazy" />
                <span>{isLegend ? '인물 기록' : record.data.year < entry.data.year ? '이전 기록' : '다음 기록'}</span>
              </div>
              <small>{isLegend ? `${archiveIndex.label} · LEGEND` : `${record.data.year} · ${archiveIndex.label}`}</small>
              <strong>{record.data.title}</strong>
            </a>
          ))}
        </div>
      </aside>
    )}
  </article>
</Layout>

<script is:inline define:vars={{ viewPath }}>
  try {
    const viewKey = `bbfc-archive-view:${viewPath}`;
    if (!sessionStorage.getItem(viewKey)) {
      sessionStorage.setItem(viewKey, '1');
      fetch('/api/archive/views', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ path: viewPath }),
        keepalive: true,
      }).catch(() => {});
    }
  } catch {}
</script>

<style>
  .archive-article { max-width: 760px; margin: 0 auto; padding: 38px 20px 80px; }
  .article-path { display: flex; gap: 8px; font-size: 11px; color: var(--bbfc-gray-2); }
  .article-path a:hover { color: var(--bbfc-blue); }
  .article-header { margin-top: 30px; padding: 54px 0 46px; border-top: 2px solid var(--bbfc-ink); border-bottom: 1px solid var(--bbfc-border); }
  .article-header > p { font-size: 10px; font-weight: 650; letter-spacing: .14em; color: var(--bbfc-blue); }
  .article-header h1 { margin-top: 14px; font-size: clamp(34px, 5.3vw, 55px); line-height: 1.12; font-weight: 700; letter-spacing: -.055em; }
  .article-header > span { display: block; max-width: 620px; margin-top: 22px; font-size: 14px; line-height: 1.7; color: var(--bbfc-gray-1); }
  .article-header :global(.article-byline) { margin-top: 18px; }
  .archive-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 18px; }
  .archive-tags span { padding: 6px 10px; border: 1px solid var(--bbfc-border); border-radius: 999px; font-size: 10px; font-weight: 600; color: var(--bbfc-ink-2); background: #fff; }
  .archive-body { padding-top: 58px; font-family: var(--font-sans); font-size: 18px; line-height: 1.92; color: var(--bbfc-ink); word-break: keep-all; overflow-wrap: break-word; }
  .archive-body :global(*) { font-family: inherit; }
  .archive-body :global(h2) { margin: 82px 0 25px; padding-top: 20px; border-top: 2px solid var(--bbfc-ink); font-size: 30px; line-height: 1.3; font-weight: 680; letter-spacing: -.04em; }
  .archive-body :global(h3) { margin: 58px 0 18px; font-size: 23px; line-height: 1.4; font-weight: 650; letter-spacing: -.025em; }
  .archive-body :global(p) { margin-top: 20px; }
  .archive-body :global(figure) { width: calc(100% - 48px); margin: 48px auto; }
  .archive-body :global(figure img) { width: 100%; height: auto; border-radius: var(--bbfc-radius-lg); }
  .archive-body :global(.portrait-figure) { max-width: 520px; }
  .archive-body :global(figcaption) { margin-top: 12px; text-align: center; font-size: 13px; line-height: 1.6; color: var(--bbfc-gray-2); }
  .archive-body :global(table) { width: 100%; margin: 28px 0 42px; border-collapse: collapse; font-size: 15px; }
  .archive-body :global(th), .archive-body :global(td) { padding: 14px 12px; border-bottom: 1px solid var(--bbfc-border); text-align: left; }
  .archive-body :global(th) { font-size: 12px; letter-spacing: .08em; color: var(--bbfc-gray-2); }
  .archive-body :global(.record-lead) { display: grid; place-items: center; padding: 24px 0 44px; text-align: center; }
  .archive-body :global(.record-lead img) { width: 120px; height: auto; object-fit: contain; }
  .archive-body :global(.record-lead p) { margin-top: 24px; font-size: 22px; font-weight: 650; }
  .archive-body :global(.record-lead strong) { margin-top: 7px; font-family: var(--font-sans); font-size: 15px; font-weight: 450; letter-spacing: .015em; color: var(--bbfc-gray-1); }
  .archive-body :global(.record-facts) { display: grid; grid-template-columns: repeat(2, 1fr); margin: 26px 0 40px; border-top: 1px solid var(--bbfc-ink); }
  .archive-body :global(.record-facts dl) { display: grid; grid-template-columns: 96px 1fr; gap: 14px; padding: 17px 10px; border-bottom: 1px solid var(--bbfc-border); }
  .archive-body :global(.record-facts dt) { font-size: 13px; color: var(--bbfc-gray-2); }
  .archive-body :global(.record-facts dd) { font-size: 15px; line-height: 1.55; font-weight: 550; }
  .archive-body :global(.honours-grid) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 24px 0 42px; }
  .archive-body :global(.honours-grid div) { display: grid; min-height: 150px; align-content: end; padding: 20px; border: 1px solid var(--bbfc-border); border-radius: var(--bbfc-radius); }
  .archive-body :global(.honours-grid span) { font-size: 12px; color: var(--bbfc-blue); }
  .archive-body :global(.honours-grid strong) { margin-top: 8px; font-size: 17px; line-height: 1.4; }
  .archive-body :global(.honours-grid small) { margin-top: 6px; font-size: 12px; color: var(--bbfc-gray-2); }
  .archive-body :global(.legend-identity) { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 24px; align-items: center; margin: 0 0 58px; padding: 30px; border-radius: var(--bbfc-radius-lg); background: linear-gradient(135deg, #07883d 0 31%, #f7d910 31% 100%); color: #123826; }
  .archive-body :global(.legend-identity img) { width: 112px; height: 78px; border-radius: 5px; object-fit: cover; box-shadow: 0 8px 24px rgba(0,0,0,.14); }
  .archive-body :global(.legend-identity span) { display: block; font-size: 9px; font-weight: 800; letter-spacing: .14em; }
  .archive-body :global(.legend-identity strong) { display: block; margin-top: 8px; font-size: 22px; line-height: 1.25; }
  .archive-body :global(.legend-identity small) { display: block; margin-top: 4px; font-size: 12px; }
  .archive-body :global(.legend-video) { width: 100%; margin: 42px 0; }
  .archive-body :global(.legend-video video) { display: block; width: 100%; max-height: 520px; border-radius: var(--bbfc-radius-lg); background: #0b0d10; }
  .archive-body :global(.legend-video figcaption) { text-align: left; }
  /* 같은 인물·사건을 다룬 다른 기록으로 넘기는 배너. 일반 글의 .best-xi-cta와 같은
     토큰을 쓰되 장식 이모지 대신 해당 기록의 표지를 놓아 연대기 카드와 결을 맞춘다. */
  .archive-body :global(.record-cta) { display: grid; grid-template-columns: 88px minmax(0, 1fr); align-items: center; gap: 20px; margin: 34px 0 46px; padding: 18px 22px 18px 18px; border: 1px solid var(--bbfc-border); border-radius: var(--bbfc-radius-lg); background: var(--bbfc-fill-2); color: var(--bbfc-ink); text-decoration: none; transition: border-color 160ms ease, transform 160ms ease; }
  .archive-body :global(.record-cta:hover) { border-color: var(--bbfc-blue); transform: translateY(-2px); }
  .archive-body :global(.record-cta:focus-visible) { outline: 2px solid var(--bbfc-blue); outline-offset: 3px; }
  .archive-body :global(.record-cta > img) { width: 88px; height: 88px; border-radius: var(--bbfc-radius); object-fit: cover; }
  .archive-body :global(.record-cta small) { display: block; font-size: 9px; font-weight: 750; letter-spacing: .14em; color: var(--bbfc-blue); }
  .archive-body :global(.record-cta strong) { display: block; margin-top: 7px; font-size: 19px; line-height: 1.4; font-weight: 660; letter-spacing: -.03em; }
  .archive-body :global(.record-cta p) { margin: 6px 0 0; font-size: 13px; line-height: 1.55; color: var(--bbfc-gray-1); }
  /* 인용은 DESIGN.md의 글 상세 기준(좌측 3px 블루 보더)을 아카이브에도 그대로 쓴다.
     외국어 원문은 본문보다 한 단계 크게, 한국어 번역은 한 단계 작고 옅게 둔다. */
  .archive-body :global(.record-quote) { margin: 44px 0; padding: 2px 0 2px 22px; border-left: 3px solid var(--bbfc-blue); }
  .archive-body :global(.record-quote > p) { margin: 0; font-size: 21px; line-height: 1.7; font-weight: 560; letter-spacing: -.02em; }
  .archive-body :global(.record-quote > p + p) { margin-top: 14px; font-size: 16px; font-weight: 450; color: var(--bbfc-gray-1); }
  .archive-body :global(.record-quote > small) { display: block; margin-top: 16px; font-size: 12px; line-height: 1.6; color: var(--bbfc-gray-2); }
  .archive-body :global(ul) { margin: 18px 0; padding-left: 20px; }
  .archive-body :global(li) { margin-top: 8px; }
  .archive-body :global(.source-notes) { margin-top: -4px; font-size: 13px; line-height: 1.7; color: var(--bbfc-gray-1); }
  .archive-body :global(.source-notes ul) { padding-left: 18px; list-style: disc; }
  .archive-body :global(.source-notes li) { margin-top: 10px; padding-left: 3px; }
  .archive-body :global(.source-notes a) { color: var(--bbfc-ink-2); text-decoration: underline; text-decoration-color: var(--bbfc-gray-3); text-underline-offset: 3px; }
  .archive-body :global(.source-notes a:hover) { color: var(--bbfc-blue-strong); text-decoration-color: var(--bbfc-blue); }
  .archive-body :global(.record-note) { margin-top: 22px; padding-top: 16px; border-top: 1px solid var(--bbfc-border); font-size: 12px; line-height: 1.75; color: var(--bbfc-gray-2); }
  .archive-body :global(.record-abstract) { margin: 0 0 58px; padding: 26px 28px 28px; border-top: 2px solid var(--bbfc-blue); background: var(--bbfc-fill-2); }
  .archive-body :global(.record-abstract > span) { display: block; font-size: 10px; font-weight: 700; letter-spacing: .14em; color: var(--bbfc-blue); }
  .archive-body :global(.record-abstract p) { margin-top: 12px; font-size: 17px; line-height: 1.82; font-weight: 520; color: var(--bbfc-ink-2); }
  .archive-body :global(.flag) { display: inline-block; width: 1.35em; height: .9em; margin-left: .22em; border: 1px solid rgba(25,31,40,.12); border-radius: 2px; object-fit: cover; vertical-align: -.08em; }
  .archive-body :global(.placement-count) { display: inline-block; margin-left: .45em; padding: .18em .48em; border-radius: 999px; background: var(--bbfc-blue-weak); font-size: 10px; line-height: 1.4; font-weight: 650; color: var(--bbfc-blue-strong); vertical-align: .08em; }
  .archive-body :global(.best-xi) { display: grid; gap: 22px; margin: 30px 0 48px; padding: 34px 24px; border-radius: var(--bbfc-radius-lg); background: linear-gradient(180deg, #183f70 0%, #102d53 100%); color: #fff; }
  .archive-body :global(.best-xi-line) { display: grid; gap: 10px; justify-content: center; }
  .archive-body :global(.best-xi-line.forwards) { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .archive-body :global(.best-xi-line.halves) { grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 0 12%; }
  .archive-body :global(.best-xi-line.backs) { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 0 24%; }
  .archive-body :global(.best-xi-line.keeper) { grid-template-columns: minmax(150px, 32%); }
  /* WM(3-2-2-3) 배치용 라인. 2-3-5 시대(1930·1934·1938)와 달리 1950년 대회는 세 명의 백과
     두 명의 하프백, 두 명의 인사이드 포워드, 세 명의 최전방으로 나뉜다. */
  .archive-body :global(.best-xi-line.forwards-three) { grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 0 12%; }
  .archive-body :global(.best-xi-line.inside) { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 0 24%; }
  .archive-body :global(.best-xi-line.halves-two) { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 0 24%; }
  .archive-body :global(.best-xi-line.backs-three) { grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 0 12%; }
  .archive-body :global(.best-xi-line div) { display: grid; align-content: center; min-height: 174px; padding: 13px 10px; border: 1px solid rgba(255,255,255,.2); border-radius: 10px; background: rgba(255,255,255,.07); text-align: center; }
  .archive-body :global(.best-xi-line img) { width: 62px; height: 62px; margin: 0 auto 10px; border: 2px solid rgba(255,255,255,.82); border-radius: 50%; object-fit: cover; object-position: 50% 22%; filter: grayscale(1); }
  .archive-body :global(.best-xi-line span) { font-size: 9px; font-weight: 750; letter-spacing: .12em; color: #9dd2ff; }
  .archive-body :global(.best-xi-line strong) { margin-top: 6px; font-size: 13px; line-height: 1.35; font-weight: 650; }
  .archive-body :global(.best-xi-line small) { margin-top: 5px; font-size: 9px; line-height: 1.4; color: rgba(255,255,255,.68); }
  .archive-body :global(.best-xi-roster) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 36px 0 58px; }
  .archive-body :global(.best-xi-player) { display: grid; grid-template-columns: 142px minmax(0, 1fr); min-height: 184px; overflow: hidden; border: 1px solid var(--bbfc-border); border-radius: var(--bbfc-radius); background: #fff; }
  .archive-body :global(.best-xi-player > img) { width: 100%; height: 100%; min-height: 184px; object-fit: cover; object-position: 50% 20%; filter: grayscale(1); }
  .archive-body :global(.best-xi-player > div) { display: grid; align-content: center; min-width: 0; padding: 20px 18px; }
  .archive-body :global(.best-xi-player span) { font-size: 9px; line-height: 1.4; font-weight: 750; letter-spacing: .11em; color: var(--bbfc-blue); }
  .archive-body :global(.best-xi-player strong) { margin-top: 8px; font-size: 17px; line-height: 1.35; font-weight: 680; letter-spacing: -.025em; color: var(--bbfc-ink); }
  .archive-body :global(.best-xi-player small) { margin-top: 5px; overflow: hidden; font-size: 11px; line-height: 1.4; color: var(--bbfc-gray-2); text-overflow: ellipsis; white-space: nowrap; }
  .archive-body :global(.best-xi-player p) { margin: 18px 0 0; font-size: 12px; line-height: 1.5; font-weight: 600; color: var(--bbfc-ink-2); }
  .archive-body :global(.cite) { margin-left: .14em; font-size: .68em; font-weight: 650; color: var(--bbfc-blue-strong); vertical-align: super; }
  .archive-body :global(.foreign-note) { font-size: max(.72em, 12px) !important; line-height: inherit; font-weight: 400; letter-spacing: 0; color: var(--bbfc-gray-2) !important; vertical-align: baseline; }
  .archive-body :global(.source-notes ol) { padding-left: 22px; list-style: decimal; }
  .archive-body :global(.source-notes li:target) { background: var(--bbfc-blue-weak); }
  .archive-share { margin-top: 54px; padding-top: 8px; border-top: 1px solid var(--bbfc-border); }
  .sequence-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-top: 86px; padding: 22px 0; border-top: 2px solid var(--bbfc-ink); border-bottom: 1px solid var(--bbfc-border); }
  .sequence-link { display: grid; align-content: start; min-width: 0; padding: 8px 10px; }
  .sequence-link.is-next { grid-column: 2; text-align: right; }
