  .archive-body :global(.legend-identity-brazil .identity-team) { background: #ffcb00; color: #302681; }
  .archive-body :global(.legend-identity-brazil img) { width: 100px; height: 72px; border-radius: 0; object-fit: contain; box-shadow: none; }
