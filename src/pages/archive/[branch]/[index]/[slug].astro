  .archive-body :global(.number-history-table th) { padding: 11px 14px; border-bottom: 1px solid var(--bbfc-ink); background: var(--bbfc-fill-2); color: var(--bbfc-gray-1); font-size: 11px; font-weight: 750; letter-spacing: .06em; text-align: left; }
  .archive-body :global(.number-history-table td) { padding: 13px 14px; border-bottom: 1px solid var(--bbfc-border); color: var(--bbfc-gray-1); vertical-align: middle; }
  .archive-body :global(.number-history-table tr:last-child td) { border-bottom: 0; }
  .archive-body :global(.number-history-table td:first-child) { color: var(--bbfc-ink); font-weight: 700; }
  .archive-body :global(.number-history-table td:last-child) { color: var(--bbfc-blue-strong); }
  .archive-body :global(.number-history-table td:last-child strong) { display: inline-grid; min-width: 28px; height: 28px; place-items: center; border-radius: 50%; background: var(--bbfc-blue-weak); color: var(--bbfc-blue-strong); }
  .archive-body :global(.number-history-national) { margin-bottom: 0; }
  .archive-body :global(.trophy-feature-grid) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 26px 0 20px; }
  .archive-body :global(.trophy-card) { position: relative; display: grid; min-height: 190px; align-content: end; overflow: hidden; padding: 20px; border-radius: 16px; color: #d8b85b; }
  .archive-body :global(.trophy-card.world) { background: linear-gradient(145deg, #073a23, #08783e); }
  .archive-body :global(.trophy-card.libertadores) { background: linear-gradient(145deg, #531a10, #a83a1c); }
  .archive-body :global(.trophy-card.champions) { background: linear-gradient(145deg, #071d4b, #174d96); }
  .archive-body :global(.trophy-card img) { position: absolute; z-index: 0; right: -16px; top: 10px; width: 142px; height: 162px; object-fit: contain; object-position: center; opacity: .13; filter: grayscale(1) brightness(1.45) contrast(1.08); mix-blend-mode: screen; pointer-events: none; }
  .archive-body :global(.trophy-card.libertadores img) { right: -4px; top: 7px; width: 112px; height: 170px; }
  .archive-body :global(.trophy-card.champions img) { right: -22px; top: 8px; width: 158px; height: 166px; }
