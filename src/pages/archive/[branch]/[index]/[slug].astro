---
import Layout from '../../../../layouts/Layout.astro';
import ShareButtons from '../../../../components/ShareButtons.astro';
import ContentCover from '../../../../components/ContentCover.astro';
import RelatedAssets from '../../../../components/RelatedAssets.astro';
import ArticleByline from '../../../../components/ArticleByline.astro';
import ArticleProvenance from '../../../../components/ArticleProvenance.astro';
import { categories, getArticlePath } from '../../../../config/categories';
import { site } from '../../../../config/site';
import { archiveBranches } from '../../../../data/archive';
import { getCollection, render, type CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'archive'> }

export async function getStaticPaths() {
  const entries = await getCollection('archive', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { branch: entry.data.branch, index: entry.data.index, slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as Props;
const branch = archiveBranches.find((item) => item.id === entry.data.branch)!;
const archiveIndex = branch.indexes.find((item) => item.slug === entry.data.index)!;
const isLegend = entry.data.branch === 'legends';
const viewPath = `/archive/${branch.id}/${archiveIndex.slug}/${entry.id}/`;
const { Content } = await render(entry);
const indexRecords = (await getCollection('archive', ({ data }) =>
  !data.draft && data.branch === entry.data.branch && data.index === entry.data.index
)).sort((a, b) => a.data.year - b.data.year || a.id.localeCompare(b.id));
const currentPosition = indexRecords.findIndex((record) => record.id === entry.id);
const previousRecord = currentPosition > 0 ? indexRecords[currentPosition - 1] : undefined;
const nextRecord = currentPosition >= 0 && currentPosition < indexRecords.length - 1
  ? indexRecords[currentPosition + 1]
  : undefined;
const nextExpectedYear = entry.data.year + 1;
const chronologyWindowSize = Math.min(5, indexRecords.length);
const chronologyStart = Math.min(
  Math.max(currentPosition - 2, 0),
  Math.max(indexRecords.length - chronologyWindowSize, 0)
);
const relatedRecords = indexRecords
  .slice(chronologyStart, chronologyStart + chronologyWindowSize)
  .filter((record) => record.id !== entry.id);
const relatedAssets = entry.data.relatedGroup
  ? (await getCollection('articles', ({ data }) => !data.draft && data.relatedGroup === entry.data.relatedGroup))
      .map((record) => ({
        href: getArticlePath(record.data.category, record.id),
        title: record.data.title,
        description: record.data.description,
        label: categories[record.data.category]?.label ?? '연관 기록',
        coverImage: record.data.coverImage,
      }))
  : [];
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.coverImage}
  ogImageAlt={entry.data.coverImageAlt}
  ogImageWidth={entry.data.coverImageWidth}
  ogImageHeight={entry.data.coverImageHeight}
  ogImageCaption={entry.data.coverImageCaption}
  type="article"
  article={{
    pubDate: entry.data.pubDate,
    updatedDate: entry.data.updatedDate,
    section: `${branch.title} · ${archiveIndex.label}`,
    subjects: [entry.data.subject, archiveIndex.label, entry.data.originalTitle, ...entry.data.tags, ...entry.data.keywords].filter(Boolean) as string[],
    keywords: entry.data.keywords,
  }}
  breadcrumbs={[
    { label: '홈', href: '/' }, { label: '삥이 아카이브', href: '/archive/' },
    { label: branch.title, href: `/archive/${branch.id}/` },
    { label: archiveIndex.label, href: `/archive/${branch.id}/${archiveIndex.slug}/` },
    { label: entry.data.title, href: `/archive/${branch.id}/${archiveIndex.slug}/${entry.id}/` },
  ]}
>
  <article class="archive-article">
    <nav class="article-path"><a href="/archive/">삥이 아카이브</a><span>/</span><a href={`/archive/${branch.id}/${archiveIndex.slug}/`}>{archiveIndex.label}</a></nav>
    <header class="article-header">
      <p>{isLegend ? `${archiveIndex.label} · LEGEND` : `${entry.data.year} · ${archiveIndex.label}`}</p>
      <h1>{entry.data.title}</h1>
      <span>{entry.data.description}</span>
      <ArticleByline pubDate={entry.data.pubDate} updatedDate={entry.data.updatedDate} />
    </header>
    <ContentCover
      src={entry.data.coverImage}
      alt={entry.data.coverImageAlt}
      caption={entry.data.coverImageCaption}
      width={entry.data.coverImageWidth}
      height={entry.data.coverImageHeight}
      variant="archive"
    />
    {entry.data.tags.length > 0 && (
      <nav class="archive-tags" aria-label="이 글의 인물 분류">
        {entry.data.tags.map((tag) => <span>#{tag}</span>)}
      </nav>
    )}
    <div class="archive-body"><Content /></div>
    <ArticleProvenance />
    <div class="archive-share">
      <ShareButtons
        url={new URL(`/archive/${branch.id}/${archiveIndex.slug}/${entry.id}/`, site.url).toString()}
        title={entry.data.title}
      />
    </div>
    <RelatedAssets items={relatedAssets} />
    <nav class="sequence-nav" aria-label={`${archiveIndex.label} 이전·다음 기록`}>
      {previousRecord && (
        <a class="sequence-link is-previous" href={`/archive/${previousRecord.data.branch}/${previousRecord.data.index}/${previousRecord.id}/`}>
          <span>{isLegend ? 'PREVIOUS LEGEND' : 'PREVIOUS RECORD'}</span>
          <strong>◀ {isLegend ? '이전 인물' : `${previousRecord.data.year}년 기록`}</strong>
          <small>{previousRecord.data.subject}</small>
        </a>
      )}
      {nextRecord ? (
        <a class="sequence-link is-next" href={`/archive/${nextRecord.data.branch}/${nextRecord.data.index}/${nextRecord.id}/`}>
          <span>{isLegend ? 'NEXT LEGEND' : 'NEXT RECORD'}</span>
          <strong>{isLegend ? '다음 인물' : `${nextRecord.data.year}년 기록`} ▶</strong>
          <small>{nextRecord.data.subject}</small>
        </a>
      ) : !isLegend && (
        <div class="sequence-link is-next is-pending" aria-label={`${nextExpectedYear}년 다음 기록은 아직 발행되지 않음`}>
          <span>NEXT RECORD</span>
          <strong>{nextExpectedYear}년 기록 ▶</strong>
          <small>다음 기록 발행 예정</small>
        </div>
      )}
    </nav>
    {relatedRecords.length > 0 && (
      <aside class="related-records" aria-labelledby="related-records-title">
        <div><p>{isLegend ? 'MORE LEGENDS' : 'CHRONOLOGY'}</p><h2 id="related-records-title">{isLegend ? `${archiveIndex.label} 레전드 이어보기` : '연대기 이어보기'}</h2></div>
        <div class="related-grid">
          {relatedRecords.map((record) => (
            <a href={`/archive/${record.data.branch}/${record.data.index}/${record.id}/`}>
              <div class="related-cover">
                <img src={record.data.coverImage} alt="" width="640" height="640" loading="lazy" />
                <span>{isLegend ? '인물 기록' : record.data.year < entry.data.year ? '이전 기록' : '다음 기록'}</span>
              </div>
              <small>{isLegend ? `${archiveIndex.label} · LEGEND` : `${record.data.year} · ${archiveIndex.label}`}</small>
              <strong>{record.data.title}</strong>
            </a>
          ))}
        </div>
      </aside>
    )}
  </article>
</Layout>

<script is:inline define:vars={{ viewPath }}>
  try {
    const viewKey = `bbfc-archive-view:${viewPath}`;
    if (!sessionStorage.getItem(viewKey)) {
      sessionStorage.setItem(viewKey, '1');
      fetch('/api/archive/views', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ path: viewPath }),
        keepalive: true,
      }).catch(() => {});
    }
  } catch {}
</script>

<script is:inline>
  document.querySelectorAll('[data-legend-reel]').forEach((reel) => {
    const video = reel.querySelector('video');
    const items = [...reel.querySelectorAll('[data-reel-playlist] li')];
    const caption = reel.querySelector('[data-reel-caption]');
    const count = reel.querySelector('[data-reel-count]');
    const bars = [...reel.querySelectorAll('.legend-reel-progress i')];
    if (!video || !items.length) return;
    let index = 0;
    let activated = false;
    const play = (nextIndex) => {
      index = nextIndex % items.length;
      video.src = items[index].dataset.src;
      caption.textContent = items[index].textContent;
      count.textContent = `${index + 1} / ${items.length}`;
      bars.forEach((bar, barIndex) => bar.classList.toggle('is-active', barIndex === index));
      video.load();
      video.play().catch(() => {});
    };
    video.addEventListener('ended', () => play(index + 1));
    const observer = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting || activated) return;
      activated = true;
      play(0);
      observer.disconnect();
    }, { rootMargin: '160px 0px' });
    observer.observe(reel);
  });
</script>

<style>
  .archive-article { max-width: 760px; margin: 0 auto; padding: 38px 20px 80px; }
  .article-path { display: flex; gap: 8px; font-size: 11px; color: var(--bbfc-gray-2); }
  .article-path a:hover { color: var(--bbfc-blue); }
  .article-header { margin-top: 30px; padding: 54px 0 46px; border-top: 2px solid var(--bbfc-ink); border-bottom: 1px solid var(--bbfc-border); }
