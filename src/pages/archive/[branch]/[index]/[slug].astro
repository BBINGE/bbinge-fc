---
import Layout from '../../../../layouts/Layout.astro';
import { archiveBranches } from '../../../../data/archive';
import { getCollection, render, type CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'archive'> }

export async function getStaticPaths() {
  const entries = await getCollection('archive', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { branch: entry.data.branch, index: entry.data.index, slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as Props;
const branch = archiveBranches.find((item) => item.id === entry.data.branch)!;
const archiveIndex = branch.indexes.find((item) => item.slug === entry.data.index)!;
const { Content } = await render(entry);
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.coverImage}
  type="article"
  article={{ pubDate: entry.data.pubDate, updatedDate: entry.data.updatedDate }}
  breadcrumbs={[
    { label: '홈', href: '/' }, { label: '삥이 아카이브', href: '/archive/' },
    { label: branch.title, href: `/archive/${branch.id}/` },
    { label: archiveIndex.label, href: `/archive/${branch.id}/${archiveIndex.slug}/` },
    { label: entry.data.title, href: `/archive/${branch.id}/${archiveIndex.slug}/${entry.id}/` },
  ]}
>
  <article class="archive-article">
    <nav class="article-path"><a href="/archive/">삥이 아카이브</a><span>/</span><a href={`/archive/${branch.id}/${archiveIndex.slug}/`}>{archiveIndex.label}</a></nav>
    <header class="article-header">
      <p>{entry.data.year} · {archiveIndex.label}</p>
      <h1>{entry.data.title}</h1>
      <span>{entry.data.description}</span>
    </header>
    <div class="archive-body"><Content /></div>
  </article>
</Layout>

<style>
  .archive-article { max-width: 760px; margin: 0 auto; padding: 38px 20px 80px; }
  .article-path { display: flex; gap: 8px; font-size: 11px; color: var(--bbfc-gray-2); }
  .article-path a:hover { color: var(--bbfc-blue); }
  .article-header { margin-top: 30px; padding: 54px 0 46px; border-top: 2px solid var(--bbfc-ink); border-bottom: 1px solid var(--bbfc-border); }
  .article-header > p { font-size: 10px; font-weight: 650; letter-spacing: .14em; color: var(--bbfc-blue); }
  .article-header h1 { margin-top: 14px; font-size: clamp(34px, 5.3vw, 55px); line-height: 1.12; font-weight: 700; letter-spacing: -.055em; }
  .article-header > span { display: block; max-width: 620px; margin-top: 22px; font-size: 14px; line-height: 1.7; color: var(--bbfc-gray-1); }
  .archive-body { padding-top: 58px; font-family: var(--font-sans); font-size: 18px; line-height: 1.92; color: var(--bbfc-ink); word-break: keep-all; overflow-wrap: break-word; }
  .archive-body :global(*) { font-family: inherit; }
  .archive-body :global(h2) { margin: 82px 0 25px; padding-top: 20px; border-top: 2px solid var(--bbfc-ink); font-size: 30px; line-height: 1.3; font-weight: 680; letter-spacing: -.04em; }
  .archive-body :global(h3) { margin: 58px 0 18px; font-size: 23px; line-height: 1.4; font-weight: 650; letter-spacing: -.025em; }
  .archive-body :global(p) { margin-top: 20px; }
  .archive-body :global(figure) { width: calc(100% - 48px); margin: 48px auto; }
  .archive-body :global(figure img) { width: 100%; height: auto; border-radius: var(--bbfc-radius-lg); }
  .archive-body :global(.portrait-figure) { max-width: 520px; }
  .archive-body :global(figcaption) { margin-top: 12px; text-align: center; font-size: 13px; line-height: 1.6; color: var(--bbfc-gray-2); }
  .archive-body :global(table) { width: 100%; margin: 28px 0 42px; border-collapse: collapse; font-size: 15px; }
  .archive-body :global(th), .archive-body :global(td) { padding: 14px 12px; border-bottom: 1px solid var(--bbfc-border); text-align: left; }
  .archive-body :global(th) { font-size: 12px; letter-spacing: .08em; color: var(--bbfc-gray-2); }
  .archive-body :global(.record-lead) { display: grid; place-items: center; padding: 24px 0 44px; text-align: center; }
  .archive-body :global(.record-lead img) { width: 120px; height: auto; object-fit: contain; }
  .archive-body :global(.record-lead p) { margin-top: 24px; font-size: 22px; font-weight: 650; }
  .archive-body :global(.record-lead strong) { margin-top: 7px; font-family: var(--font-sans); font-size: 15px; font-weight: 450; letter-spacing: .015em; color: var(--bbfc-gray-1); }
  .archive-body :global(.record-facts) { display: grid; grid-template-columns: repeat(2, 1fr); margin: 26px 0 40px; border-top: 1px solid var(--bbfc-ink); }
  .archive-body :global(.record-facts dl) { display: grid; grid-template-columns: 96px 1fr; gap: 14px; padding: 17px 10px; border-bottom: 1px solid var(--bbfc-border); }
  .archive-body :global(.record-facts dt) { font-size: 13px; color: var(--bbfc-gray-2); }
  .archive-body :global(.record-facts dd) { font-size: 15px; line-height: 1.55; font-weight: 550; }
  .archive-body :global(.honours-grid) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 24px 0 42px; }
  .archive-body :global(.honours-grid div) { display: grid; min-height: 150px; align-content: end; padding: 20px; border: 1px solid var(--bbfc-border); border-radius: var(--bbfc-radius); }
  .archive-body :global(.honours-grid span) { font-size: 12px; color: var(--bbfc-blue); }
  .archive-body :global(.honours-grid strong) { margin-top: 8px; font-size: 17px; line-height: 1.4; }
  .archive-body :global(.honours-grid small) { margin-top: 6px; font-size: 12px; color: var(--bbfc-gray-2); }
  .archive-body :global(ul) { margin: 18px 0; padding-left: 20px; }
  .archive-body :global(li) { margin-top: 8px; }
  .archive-body :global(.source-notes) { margin-top: -4px; font-size: 13px; line-height: 1.7; color: var(--bbfc-gray-1); }
  .archive-body :global(.source-notes ul) { padding-left: 18px; list-style: disc; }
  .archive-body :global(.source-notes li) { margin-top: 10px; padding-left: 3px; }
  .archive-body :global(.source-notes a) { color: var(--bbfc-ink-2); text-decoration: underline; text-decoration-color: var(--bbfc-gray-3); text-underline-offset: 3px; }
  .archive-body :global(.source-notes a:hover) { color: var(--bbfc-blue-strong); text-decoration-color: var(--bbfc-blue); }
  .archive-body :global(.record-note) { margin-top: 22px; padding-top: 16px; border-top: 1px solid var(--bbfc-border); font-size: 12px; line-height: 1.75; color: var(--bbfc-gray-2); }
  @media (max-width: 767px) {
    .archive-article { padding: 24px 16px 60px; }
    .article-header { margin-top: 24px; padding: 42px 0 38px; }
    .article-header h1 { font-size: 36px; }
    .archive-body { padding-top: 46px; font-size: 17px; line-height: 1.88; }
    .archive-body :global(h2) { margin-top: 66px; font-size: 27px; }
    .archive-body :global(h3) { margin-top: 46px; font-size: 21px; }
    .archive-body :global(figure) { width: 100%; margin: 42px auto; }
    .archive-body :global(.record-facts), .archive-body :global(.honours-grid) { grid-template-columns: 1fr; }
    .archive-body :global(.honours-grid div) { min-height: 118px; }
    .archive-body :global(table) { display: block; overflow-x: auto; white-space: nowrap; }
    .archive-body :global(.source-notes) { font-size: 12.5px; }
    .archive-body :global(.record-note) { font-size: 12px; }
  }
</style>
