  .archive-body :global(.legend-section-photo) { max-width: 640px; }
  .archive-body :global(.legend-section-photo img) { display: block; width: 100%; max-height: 540px; object-fit: cover; object-position: 50% 20%; }
  .archive-body :global(.legend-section-cover img) { aspect-ratio: 16 / 10; object-position: 50% 24%; }
  .archive-body :global(.legend-section-portrait) { max-width: 480px; }
  .archive-body :global(.legend-section-portrait img) { aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 18%; }
  .archive-body :global(.section-photo-fallback) { display: grid; min-height: 340px; place-content: end start; padding: 30px; border-radius: 18px; background: radial-gradient(circle at 72% 28%, #f2aa00 0 8%, transparent 9%), linear-gradient(135deg, #6d1426, #9c2335 55%, #ee9e00); color: #fff; }
