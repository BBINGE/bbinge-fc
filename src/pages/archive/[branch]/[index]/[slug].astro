  .archive-body :global(.club-career-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 26px 0 34px; }
  .archive-body :global(.club-career-grid > div) { display: grid; grid-template-columns: 58px 1fr auto; grid-template-rows: auto auto; gap: 2px 14px; align-items: center; padding: 16px; border: 1px solid var(--bbfc-border); border-radius: 14px; background: #fff; }
