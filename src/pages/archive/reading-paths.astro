---
import Layout from '../../layouts/Layout.astro';
import ArchiveReadingPath from '../../components/ArchiveReadingPath.astro';
import { getCollection } from 'astro:content';
import { resolveReadingPaths } from '../../data/archive-reading-paths';
import '../../styles/archive-halls.css';
import '../../styles/archive-discovery.css';
const paths=resolveReadingPaths(await getCollection('archive',({data})=>!data.draft));
---
<Layout title="함께 읽는 기록: 삥이 아카이브 독서 경로" description="인물과 대회, 시대와 클럽을 연결해 읽는 삥이FC의 편집 독서 경로." adsEligible={false} robots={paths.length?'index,follow,max-image-preview:large':'noindex,follow'} breadcrumbs={[{label:'홈',href:'/'},{label:'삥이 아카이브',href:'/archive/'},{label:'독서 경로',href:'/archive/reading-paths/'}]}>
 <div class="archive-portal"><header class="archive-masthead"><p>06F · READING PATHS</p><h1>함께 읽는 기록</h1><div><span>시대·인물·대회 사이를 잇는 읽는 순서.</span><b>{paths.length}개의 독서 경로</b></div></header><nav class="archive-hall-tabs" aria-label="독서 경로 목록"><a href="/archive/">전체 아카이브</a>{paths.map(p=><a href={`#${p.id}`}>{p.title}</a>)}</nav><div style="margin-top:28px">{paths.map(path=><ArchiveReadingPath path={path} directory />)}</div></div>
</Layout>
