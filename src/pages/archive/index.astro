---
import Layout from '../../layouts/Layout.astro';
import { archiveBranches } from '../../data/archive';
import { site } from '../../config/site';
import { getCollection } from 'astro:content';
import { isNewlyPublished, isRecentlyChanged } from '../../utils/freshness';

const records = (await getCollection('archive', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.id.localeCompare(a.id));
const firstRecord = [...records].sort((a, b) => a.data.year - b.data.year)[0];
const activeSeries = archiveBranches.flatMap((branch) => branch.indexes.map((index) => {
  const seriesRecords = records.filter((record) => record.data.branch === branch.id && record.data.index === index.slug);
  return { branch, index, records: seriesRecords.sort((a, b) => a.data.year - b.data.year) };
})).filter((series) => series.records.length > 0);

const readingPaths = [
  { label: '인물로 읽기', note: '선수의 생애와 경력을 국가와 지역의 축구사 안에서 읽습니다.', branches: ['legends'] },
  { label: '대회로 읽기', note: '리그와 클럽·국가대표팀 대회를 연도와 당대 명칭으로 따라갑니다.', branches: ['leagues', 'european-club', 'national-team'] },
  { label: '수상 기록으로 읽기', note: '개인상과 득점 기록을 선정 당시의 맥락과 함께 확인합니다.', branches: ['awards'] },
];
const recordHref = (record: typeof records[number]) => `/archive/${record.data.branch}/${record.data.index}/${record.id}/`;
const freshBranches = new Set(
  records.filter((record) => isRecentlyChanged(record.data.pubDate, record.data.updatedDate)).map((record) => record.data.branch)
);
const freshIndexes = new Set(
  records.filter((record) => isRecentlyChanged(record.data.pubDate, record.data.updatedDate)).map((record) => `${record.data.branch}/${record.data.index}`)
);
---

<Layout
  title="삥이 아카이브"
  description={`축구의 인물과 대회, 수상 기록을 공식 명칭과 시대 구분에 따라 축적하는 ${site.name}의 아카이브입니다.`}
  breadcrumbs={[{ label: '홈', href: '/' }, { label: '삥이 아카이브', href: '/archive/' }]}
>
  <div class="archive-page">
    <section class="archive-hero" data-reveal>
      <div class="archive-kicker"><span>BBINGE ARCHIVE</span><span>FOOTBALL RECORD SERIES</span></div>
      <div class="archive-hero-grid">
        <div class="archive-title-wrap" data-parallax>
          <p class="archive-label">삥이FC 기록총서</p>
          <h1><span>삥이</span><span>아카이브</span></h1>
        </div>
        <div class="archive-intro">
          <strong>축구의 인물·대회·수상 기록을 연도순으로 읽는 기록 총서입니다.</strong>
          <p>당대의 공식 명칭과 원자료를 바탕으로 하나의 기록이 다음 기록으로 이어집니다.</p>
          {firstRecord && <a class="first-record-link" href={recordHref(firstRecord)}><span>첫 기록부터 읽기</span><b>{firstRecord.data.year} · {firstRecord.data.subject}</b><i>→</i></a>}
        </div>
      </div>
      <div class="archive-rule"><span>인물</span><span>대회</span><span>연도</span><span>기록</span></div>
    </section>

    <section class="latest-records" aria-labelledby="latest-title" data-reveal>
      <div class="section-heading"><div><p>AVAILABLE NOW</p><h2 id="latest-title">지금 읽을 수 있는 기록</h2></div><p>발행이 끝난 기록만 모았습니다. 새로운 글은 이곳에 먼저 추가됩니다.</p></div>
      <div class="record-grid">
        {records.map((record) => (
          <a class="record-card" href={recordHref(record)} data-interactive>
            <div class="record-cover">
              <img src={record.data.coverImage} alt="" width="640" height="640" loading="lazy" />
              {isNewlyPublished(record.data.pubDate) && <span class="new-badge">NEW</span>}
            </div>
            <div><p>{record.data.year} · {archiveBranches.find((branch) => branch.id === record.data.branch)?.indexes.find((index) => index.slug === record.data.index)?.label}</p><h3>{record.data.title}</h3><span>{record.data.description}</span><b>기록 읽기 →</b></div>
          </a>
        ))}
      </div>
    </section>

    <section class="reading-guide" aria-labelledby="guide-title" data-reveal>
      <div class="section-heading"><div><p>HOW TO READ</p><h2 id="guide-title">어떻게 읽을까요?</h2></div><p>익숙한 방식으로 먼저 들어가세요. 세부 분류는 페이지 아래에서 모두 볼 수 있습니다.</p></div>
      <div class="guide-grid">
        {readingPaths.map((path, index) => {
          const count = records.filter((record) => path.branches.includes(record.data.branch)).length;
          const target = archiveBranches.find((branch) => path.branches.includes(branch.id) && records.some((record) => record.data.branch === branch.id))
            ?? archiveBranches.find((branch) => path.branches.includes(branch.id));
          return <a class="guide-card" href={target ? `/archive/${target.id}/` : '/archive/'}><span>0{index + 1}</span><h3>{path.label}</h3><p>{path.note}</p><b>{count > 0 ? `${count}편 보기` : '분류 살펴보기'} →</b></a>;
        })}
      </div>
    </section>

    {activeSeries.length > 0 && <section class="active-series" aria-labelledby="series-title" data-reveal>
      <div class="section-heading"><div><p>CONTINUING SERIES</p><h2 id="series-title">이어지는 기록</h2></div><p>첫 글이 실제로 발행된 연속 기록만 표시합니다.</p></div>
      <div class="series-list">
        {activeSeries.map((series) => <a href={`/archive/${series.branch.id}/${series.index.slug}/`}><div><span>{series.branch.originalTitle}</span><h3>{series.index.label}</h3><p>{series.records[0].data.year}년부터 연도순으로 이어지는 기록</p></div><strong>{series.records.length}편 <i>→</i></strong></a>)}
      </div>
    </section>}

    <details class="archive-directory" data-reveal>
      <summary><div><p>FULL DIRECTORY</p><h2>전체 기록 분류</h2></div><span>세부 분류 펼치기 ＋</span></summary>
      <div class="directory-list">
        {archiveBranches.map((branch) => (
          <article class="directory-row" id={branch.id}>
            <div class="directory-number">{branch.number}</div>
            <div class="directory-main"><p>{branch.originalTitle}</p><h3><a href={`/archive/${branch.id}/`}>{branch.title}{freshBranches.has(branch.id) && <span class="category-new">NEW</span>}</a></h3><p>{branch.description}</p></div>
            <div class="directory-indexes">{branch.indexes.map((index) => <a href={`/archive/${branch.id}/${index.slug}/`}>{index.label}{freshIndexes.has(`${branch.id}/${index.slug}`) && <span class="category-new">NEW</span>}</a>)}</div>
          </article>
        ))}
      </div>
    </details>
  </div>
</Layout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (reduceMotion || !('IntersectionObserver' in window)) revealItems.forEach((item) => item.classList.add('is-visible'));
  else {
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: .1, rootMargin: '0px 0px -6% 0px' });
    revealItems.forEach((item) => observer.observe(item));
    const title = document.querySelector<HTMLElement>('[data-parallax]');
    window.addEventListener('scroll', () => title?.style.setProperty('--archive-shift', `${Math.min(window.scrollY * .045, 18)}px`), { passive: true });
  }
</script>

<style>
  .archive-page { max-width: 1040px; margin: 0 auto; padding: 44px 20px 40px; overflow: clip; }
  .archive-hero { border-top: 2px solid var(--bbfc-ink); border-bottom: 1px solid var(--bbfc-border); }
  .archive-kicker,.archive-rule { display:flex; justify-content:space-between; font-size:10px; font-weight:650; letter-spacing:.14em; color:var(--bbfc-gray-2); }
  .archive-kicker { padding:12px 0 24px; }
  .archive-hero-grid { display:grid; grid-template-columns:1.05fr .95fr; gap:clamp(56px,8vw,110px); align-items:center; min-height:390px; padding:34px 0 58px; }
  .archive-label,.section-heading div>p,details summary div>p { font-size:10px; font-weight:650; letter-spacing:.15em; color:var(--bbfc-blue); }
  .archive-title-wrap { transform:translateY(var(--archive-shift,0)); }
  .archive-hero h1 { display:grid; margin-top:18px; font-size:clamp(58px,6.8vw,84px); line-height:.92; font-weight:720; letter-spacing:-.07em; }
  .archive-intro>strong { display:block; font-size:21px; line-height:1.55; letter-spacing:-.035em; }
  .archive-intro>p { margin-top:14px; font-size:14px; line-height:1.8; color:var(--bbfc-gray-1); }
  .first-record-link { position:relative; display:grid; gap:5px; margin-top:30px; padding:20px 46px 20px 0; border-top:1px solid var(--bbfc-border); border-bottom:1px solid var(--bbfc-border); }
  .first-record-link span { font-size:10px; color:var(--bbfc-blue); }
  .first-record-link b { font-size:15px; font-weight:620; }
  .first-record-link i { position:absolute; right:5px; top:50%; font-size:20px; font-style:normal; transform:translateY(-50%); }
  .archive-rule { padding:13px 0; border-top:1px solid var(--bbfc-line); }
  .latest-records,.reading-guide,.active-series { padding-top:104px; }
  .section-heading { display:flex; justify-content:space-between; align-items:end; gap:42px; padding-bottom:22px; border-bottom:2px solid var(--bbfc-ink); }
  .section-heading h2,details summary h2 { margin-top:7px; font-size:31px; font-weight:650; letter-spacing:-.045em; }
  .section-heading>p { max-width:390px; font-size:13px; line-height:1.7; text-align:right; color:var(--bbfc-gray-2); }
  .record-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:28px 22px; padding-top:30px; }
  .record-cover { position:relative; }
  .record-card img { width:100%; aspect-ratio:1; object-fit:contain; border-radius:var(--bbfc-radius-lg); background:var(--bbfc-fill); transition:transform .25s ease; }
  .record-card:hover img { transform:translateY(-5px); }
  .record-card > div:last-child { padding:16px 2px 0; }
  .record-card > div:last-child>p { font-size:10px; color:var(--bbfc-blue); }
  .record-card h3 { margin-top:7px; font-size:17px; line-height:1.45; font-weight:630; }
  .record-card > div:last-child>span { display:block; margin-top:9px; font-size:12px; line-height:1.6; color:var(--bbfc-gray-1); }
  .record-card b { display:block; margin-top:13px; font-size:11px; font-weight:600; color:var(--bbfc-blue-strong); }
  .new-badge { position:absolute; top:10px; right:10px; z-index:1; padding:5px 8px; border-radius:999px; background:var(--bbfc-blue); color:#fff; font-size:9px; line-height:1; font-weight:750; letter-spacing:.08em; box-shadow:0 3px 10px rgba(20,91,198,.2); }
  .category-new { margin-left:7px; color:var(--bbfc-blue); font-size:8px; font-style:normal; font-weight:750; letter-spacing:.06em; vertical-align:top; }
  .guide-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; padding-top:28px; }
  .guide-card { min-height:235px; padding:24px; border:1px solid var(--bbfc-border); border-radius:var(--bbfc-radius-lg); transition:transform .2s ease,border-color .2s ease; }
  .guide-card:hover { transform:translateY(-5px); border-color:var(--bbfc-blue); }
  .guide-card>span { font-size:10px; color:var(--bbfc-blue); }
  .guide-card h3 { margin-top:38px; font-size:21px; font-weight:640; }
  .guide-card p { margin-top:12px; font-size:13px; line-height:1.7; color:var(--bbfc-gray-1); }
  .guide-card b { display:block; margin-top:22px; font-size:11px; font-weight:600; color:var(--bbfc-blue-strong); }
  .series-list { display:grid; padding-top:12px; }
  .series-list>a { display:flex; justify-content:space-between; align-items:center; gap:20px; padding:28px 10px; border-bottom:1px solid var(--bbfc-border); }
  .series-list span { font-size:9px; letter-spacing:.13em; color:var(--bbfc-gray-2); }
  .series-list h3 { margin-top:7px; font-size:22px; font-weight:640; }
  .series-list p { margin-top:8px; font-size:12px; color:var(--bbfc-gray-1); }
  .series-list strong { font-size:12px; color:var(--bbfc-blue-strong); white-space:nowrap; }
  .series-list i { margin-left:8px; font-size:17px; font-style:normal; }
  details.archive-directory { margin-top:104px; border-top:2px solid var(--bbfc-ink); }
  details summary { display:flex; justify-content:space-between; align-items:center; padding:26px 0; cursor:pointer; list-style:none; }
  details summary::-webkit-details-marker { display:none; }
  details summary>span { font-size:11px; color:var(--bbfc-gray-1); }
  details[open] summary>span { font-size:0; } details[open] summary>span::after { content:'세부 분류 접기 −'; font-size:11px; }
  .directory-row { display:grid; grid-template-columns:54px minmax(220px,.8fr) minmax(320px,1.2fr); gap:26px; padding:32px 8px; border-bottom:1px solid var(--bbfc-border); }
  .directory-number { font-size:11px; font-weight:650; color:var(--bbfc-blue); }
  .directory-main>p:first-child { font-size:9px; letter-spacing:.13em; color:var(--bbfc-gray-2); }
  .directory-main h3 { margin-top:7px; font-size:19px; font-weight:630; }
  .directory-main>p:last-child { margin-top:11px; font-size:12px; line-height:1.65; color:var(--bbfc-gray-1); }
  .directory-indexes { display:flex; flex-wrap:wrap; gap:7px; align-content:center; }
  .directory-indexes a { padding:7px 10px; border:1px solid var(--bbfc-border); border-radius:99px; font-size:11px; }
  [data-reveal] { opacity:0; transform:translateY(24px); transition:opacity .65s ease,transform .65s ease; }
  [data-reveal].is-visible { opacity:1; transform:translateY(0); }
  @media(max-width:767px){
    .archive-page{padding:26px 16px 20px}.archive-kicker{padding-bottom:10px}.archive-hero-grid{grid-template-columns:1fr;gap:42px;min-height:0;padding:40px 0 42px}.archive-title-wrap{transform:none!important}.archive-hero h1{font-size:clamp(52px,15.5vw,64px)}.archive-intro>strong{font-size:19px}.archive-rule span:nth-child(2),.archive-rule span:nth-child(3){display:none}.latest-records,.reading-guide,.active-series{padding-top:76px}.section-heading{display:block}.section-heading>p{margin-top:14px;text-align:left}.section-heading h2,details summary h2{font-size:27px}.record-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:26px 12px}.record-card h3{font-size:14px}.record-card > div:last-child>span{display:none}.guide-grid{grid-template-columns:1fr;gap:12px}.guide-card{min-height:190px}.guide-card h3{margin-top:28px}.series-list>a{padding:24px 2px}details.archive-directory{margin-top:76px}.directory-row{grid-template-columns:30px 1fr;gap:12px;padding:28px 0}.directory-indexes{grid-column:2}details summary>span{max-width:100px;text-align:right}
  }
  @media(prefers-reduced-motion:reduce){[data-reveal]{opacity:1;transform:none;transition:none}.archive-title-wrap,.record-card img,.guide-card{transform:none!important}}
</style>
