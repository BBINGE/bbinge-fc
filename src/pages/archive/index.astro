---
import Layout from '../../layouts/Layout.astro';
import { archiveBranches } from '../../data/archive';
import { site } from '../../config/site';

const featuredSeries = [
  { href: '/archive/awards/ballon-dor/', year: '1956—', eyebrow: 'BALLON D’OR', title: '발롱도르 역대 수상자', note: '연도별 인물·득표·시대적 배경' },
  { href: '/archive/awards/copa-america-best-player/', year: '1916—', eyebrow: 'COPA AMÉRICA', title: '코파 아메리카 최우수 선수', note: '대회별 수상 기록과 원전 대조' },
  { href: '/archive/european-club/european-cup/', year: '1955—', eyebrow: 'EUROPEAN CUP', title: '유러피언컵 결승전', note: 'UEFA 챔피언스 리그 이전의 기록' },
];
---

<Layout
  title="삥이 아카이브"
  description={`축구의 인물과 대회, 수상 기록을 공식 명칭과 시대 구분에 따라 축적하는 ${site.name}의 아카이브입니다.`}
  breadcrumbs={[{ label: '홈', href: '/' }, { label: '삥이 아카이브', href: '/archive/' }]}
>
  <div class="archive-page">
    <section class="archive-hero" data-reveal>
      <div class="archive-kicker"><span>BBINGE ARCHIVE</span><span>AN OPEN-ENDED RECORD</span></div>
      <div class="archive-hero-grid">
        <div class="archive-title-wrap" data-parallax>
          <p class="archive-label">삥이FC 기록총서</p>
          <h1><span>삥이</span><span>아카이브</span></h1>
        </div>
        <div class="archive-intro">
          <p>선수와 리그, 국제 대회와 시상 기록을 단편적인 정보가 아니라 서로 이어지는 축구사의 일부로 정리합니다.</p>
          <p>대회·기관·시상 명칭은 당대의 공식 명칭을 우선하며, 후대의 통칭으로 소급해 표기하지 않습니다.</p>
          <div class="archive-principle"><span>기록의 시작은 0</span><strong>끝은 정하지 않습니다.</strong></div>
        </div>
      </div>
      <div class="archive-rule"><span>PERSON</span><span>COMPETITION</span><span>YEAR</span><span>RECORD</span></div>
    </section>

    <section class="archive-directory" aria-labelledby="directory-title" data-reveal>
      <div class="section-heading">
        <div><p>ARCHIVE DIRECTORY</p><h2 id="directory-title">기록 분류</h2></div>
        <p>인물과 대회의 이름을 당대의 언어로 구분하고, 서로 연결되는 기록으로 쌓아갑니다.</p>
      </div>

      <div class="directory-list">
        {archiveBranches.map((branch) => (
          <article class="directory-row" id={branch.id} data-reveal data-interactive>
            <a class="directory-link" href={`/archive/${branch.id}/`} aria-label={`${branch.title} 전체 보기`}></a>
            <div class="directory-number">{branch.number}</div>
            <div class="directory-main">
              <p>{branch.originalTitle}</p>
              <h3>{branch.title}</h3>
              <p class="directory-description">{branch.description}</p>
            </div>
            <div class="directory-indexes">
              {branch.indexes.map((index) => <a href={`/archive/${branch.id}/${index.slug}/`}>{index.label}</a>)}
            </div>
            <span class="directory-arrow">전체 보기 <i aria-hidden="true">→</i></span>
          </article>
        ))}
      </div>
    </section>

    <section class="archive-series" aria-labelledby="series-title" data-reveal>
      <div class="section-heading">
        <div><p>SERIAL ARCHIVES</p><h2 id="series-title">대표 연재</h2></div>
        <p>한 번의 선정으로 끝나지 않고, 연도와 대회의 계보를 따라 계속 이어지는 기록입니다.</p>
      </div>
      <div class="series-grid">
        {featuredSeries.map((series, index) => (
          <a class="series-card" href={series.href} data-reveal data-interactive>
            <div class="series-visual" aria-hidden="true">
              <span>{series.eyebrow}</span><strong>{series.year}</strong><i>0{index + 1}</i>
            </div>
            <div class="series-copy"><p>{series.eyebrow}</p><h3>{series.title}</h3><span>{series.note}</span></div>
          </a>
        ))}
      </div>
    </section>

  </div>
</Layout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if (reduceMotion || !('IntersectionObserver' in window)) {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -7% 0px' });
    revealItems.forEach((item) => observer.observe(item));

    const title = document.querySelector<HTMLElement>('[data-parallax]');
    let ticking = false;
    const updateTitle = () => {
      if (title) title.style.setProperty('--archive-shift', `${Math.min(window.scrollY * 0.055, 22)}px`);
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(updateTitle); ticking = true; }
    }, { passive: true });

    document.querySelectorAll<HTMLElement>('[data-interactive]').forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        if (event.pointerType === 'touch') return;
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${((event.clientX - rect.left) / rect.width) * 100}%`);
        card.style.setProperty('--my', `${((event.clientY - rect.top) / rect.height) * 100}%`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.removeProperty('--mx');
        card.style.removeProperty('--my');
      });
    });
  }
</script>

<style>
  .archive-page { max-width: 1040px; margin: 0 auto; padding: 44px 20px 20px; overflow: clip; }
  .archive-hero { border-top: 2px solid var(--bbfc-ink); border-bottom: 1px solid var(--bbfc-border); }
  .archive-kicker, .archive-rule { display: flex; justify-content: space-between; font-size: 10px; font-weight: 600; letter-spacing: .16em; color: var(--bbfc-gray-2); }
  .archive-kicker { padding: 12px 0 26px; }
  .archive-hero-grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(300px, .92fr); gap: clamp(56px, 8vw, 112px); align-items: center; min-height: 390px; padding: 34px 0 58px; }
  .archive-label, .section-heading > div > p { font-size: 10px; font-weight: 650; letter-spacing: .16em; color: var(--bbfc-blue); }
  .archive-title-wrap { transform: translateY(var(--archive-shift, 0)); }
  .archive-hero h1 { display: grid; gap: .08em; margin-top: 18px; font-size: clamp(58px, 6.8vw, 84px); line-height: .9; font-weight: 720; letter-spacing: -.07em; }
  .archive-hero h1 span { display: block; white-space: nowrap; }
  .archive-intro > p { max-width: 430px; font-size: 15px; line-height: 1.85; color: var(--bbfc-ink-2); }
  .archive-intro > p + p { margin-top: 18px; }
  .archive-principle { display: grid; gap: 5px; margin-top: 34px; padding-top: 22px; border-top: 1px solid var(--bbfc-border); }
  .archive-principle span { font-size: 10px; letter-spacing: .08em; color: var(--bbfc-gray-2); }
  .archive-principle strong { font-size: 20px; font-weight: 620; letter-spacing: -.03em; }
  .archive-rule { padding: 13px 0; border-top: 1px solid var(--bbfc-line); }
  .archive-directory, .archive-series { padding-top: 112px; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 48px; padding-bottom: 22px; border-bottom: 2px solid var(--bbfc-ink); }
  .section-heading h2 { margin-top: 7px; font-size: 31px; font-weight: 650; letter-spacing: -.045em; }
  .section-heading > p { max-width: 390px; font-size: 13px; line-height: 1.7; text-align: right; color: var(--bbfc-gray-2); }
  .directory-list { display: grid; }
  .directory-row { --mx: 50%; --my: 50%; position: relative; display: grid; grid-template-columns: 58px minmax(230px, .9fr) minmax(320px, 1.15fr) 28px; gap: 28px; align-items: center; min-height: 180px; padding: 34px 10px; border-bottom: 1px solid var(--bbfc-border); isolation: isolate; transition: padding 220ms ease, border-color 220ms ease; }
  .directory-row::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(360px circle at var(--mx) var(--my), var(--bbfc-blue-weak), transparent 68%); opacity: 0; transition: opacity 240ms ease; }
  .directory-link { position: absolute; inset: 0; z-index: 1; }
  .directory-row:hover { padding-left: 18px; padding-right: 18px; border-color: var(--bbfc-gray-3); }
  .directory-row:hover::before { opacity: 1; }
  .directory-number { align-self: start; padding-top: 3px; font-size: 11px; font-weight: 650; color: var(--bbfc-blue); }
  .directory-main > p:first-child, .series-copy > p { font-size: 9px; font-weight: 650; letter-spacing: .14em; color: var(--bbfc-gray-2); }
  .directory-main h3 { margin-top: 8px; font-size: 20px; font-weight: 630; letter-spacing: -.03em; }
  .directory-description { margin-top: 13px; max-width: 330px; font-size: 13px; line-height: 1.65; color: var(--bbfc-gray-1); }
  .directory-indexes { position: relative; z-index: 2; display: flex; flex-wrap: wrap; gap: 8px; align-content: center; }
  .directory-indexes a { padding: 7px 10px; border: 1px solid var(--bbfc-border); border-radius: 99px; background: color-mix(in srgb, var(--bbfc-bg) 88%, transparent); font-size: 11px; color: var(--bbfc-ink-2); transition: color 180ms ease, border-color 180ms ease, transform 180ms ease; }
  .directory-row:hover .directory-indexes a { border-color: color-mix(in srgb, var(--bbfc-blue) 24%, var(--bbfc-border)); }
  .directory-indexes a:hover { color: var(--bbfc-blue-strong); transform: translateY(-2px); }
  .directory-arrow { display: flex; gap: 5px; align-items: center; justify-content: end; white-space: nowrap; font-size: 10px; color: var(--bbfc-gray-2); transition: transform 200ms ease, color 200ms ease; }
  .directory-arrow i { font-size: 14px; font-style: normal; }
  .directory-row:hover .directory-arrow { color: var(--bbfc-blue); transform: translateX(3px); }
  .series-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; padding-top: 30px; }
  .series-card { --mx: 50%; --my: 50%; border: 1px solid var(--bbfc-border); border-radius: var(--bbfc-radius-lg); overflow: hidden; transition: transform 240ms ease, box-shadow 240ms ease, border-color 240ms ease; }
  .series-card:hover { transform: translateY(-7px); border-color: var(--bbfc-gray-3); box-shadow: 0 18px 42px rgba(25,31,40,.09); }
  .series-visual { position: relative; display: flex; width: 100%; aspect-ratio: 1 / 1; flex-direction: column; justify-content: space-between; padding: 24px; background: var(--bbfc-ink); color: white; overflow: hidden; }
  .series-visual > img { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; object-fit: contain; background: var(--bbfc-ink); }
  .series-visual::before { content: ''; position: absolute; inset: 0; background: radial-gradient(280px circle at var(--mx) var(--my), rgba(49,130,246,.3), transparent 65%); opacity: 0; transition: opacity 250ms ease; }
  .series-card:hover .series-visual::before { opacity: 1; }
  .series-visual::after { content: ''; position: absolute; width: 190px; height: 190px; right: -58px; bottom: -68px; border: 25px solid rgba(255,255,255,.07); border-radius: 50%; transition: transform 500ms cubic-bezier(.2,.8,.2,1); }
  .series-card:hover .series-visual::after { transform: scale(1.12) rotate(8deg); }
  .series-visual span { position: relative; z-index: 1; font-size: 9px; letter-spacing: .18em; opacity: .68; }
  .series-visual strong { position: relative; z-index: 1; font-size: 46px; line-height: 1; letter-spacing: -.055em; }
  .series-visual i { position: absolute; right: 18px; top: 15px; font-size: 68px; line-height: 1; font-style: normal; font-weight: 700; opacity: .07; }
  .series-copy { padding: 19px 18px 21px; }
  .series-copy h3 { margin-top: 7px; font-size: 16px; font-weight: 610; }
  .series-copy > span { display: block; margin-top: 9px; font-size: 11px; line-height: 1.5; color: var(--bbfc-gray-2); }
  [data-reveal] { opacity: 0; transform: translateY(28px); transition: opacity 720ms ease, transform 720ms cubic-bezier(.2,.7,.2,1); }
  [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
  .directory-row[data-reveal]:nth-child(2), .series-card[data-reveal]:nth-child(2) { transition-delay: 70ms; }
  .directory-row[data-reveal]:nth-child(3), .series-card[data-reveal]:nth-child(3) { transition-delay: 140ms; }

  @media (max-width: 900px) {
    .archive-hero-grid { gap: 48px; }
    .directory-row { grid-template-columns: 44px minmax(200px, .8fr) minmax(260px, 1.2fr); gap: 18px; }
    .directory-arrow { display: none; }
  }
  @media (max-width: 767px) {
    .archive-page { padding: 26px 16px 12px; }
    .archive-kicker { padding-bottom: 12px; }
    .archive-hero-grid { grid-template-columns: 1fr; gap: 46px; min-height: 0; padding: 42px 0 44px; }
    .archive-title-wrap { transform: none !important; }
    .archive-hero h1 { gap: .1em; font-size: clamp(52px, 15.5vw, 64px); line-height: .92; }
    .archive-intro > p { font-size: 14px; }
    .archive-principle { margin-top: 28px; }
    .archive-rule span:nth-child(2), .archive-rule span:nth-child(3) { display: none; }
    .archive-directory, .archive-series { padding-top: 78px; }
    .section-heading { display: block; padding-bottom: 20px; }
    .section-heading > p { margin-top: 15px; text-align: left; }
    .directory-row { grid-template-columns: 32px 1fr; gap: 12px; min-height: 0; padding: 30px 0 34px; }
    .directory-row:hover { padding-left: 0; padding-right: 0; }
    .directory-indexes { grid-column: 2; margin-top: 8px; gap: 7px; }
    .directory-description { padding-right: 4px; }
    .series-grid { grid-template-columns: 1fr; gap: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    .archive-title-wrap, .directory-row, .series-card, .directory-indexes a { transform: none !important; transition: none; }
  }
</style>
