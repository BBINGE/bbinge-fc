---
import Layout from '../../layouts/Layout.astro';
import ArchivePortal from '../../components/ArchivePortal.astro';
import { getCollection } from 'astro:content';
const records = await getCollection('archive', ({data}) => !data.draft);
---
<Layout title="삥이 아카이브" description="축구의 인물과 대회, 독립 시상의 역사와 기록을 연결하는 삥이FC 도서실." adsEligible={false} breadcrumbs={[{label:'홈',href:'/'},{label:'삥이 아카이브',href:'/archive/'}]}>
  <ArchivePortal records={records} />
</Layout>
