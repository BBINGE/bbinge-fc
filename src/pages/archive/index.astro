---
import Layout from '../../layouts/Layout.astro';
import { archiveBranches } from '../../data/archive';
import { site } from '../../config/site';
import { getCollection } from 'astro:content';
import { isNewlyPublished, isRecentlyChanged } from '../../utils/freshness';
import { imageFocusStyle } from '../../utils/imageFocus';

const records = (await getCollection('archive', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.id.localeCompare(a.id));
const firstRecord = [...records].sort((a, b) => a.data.year - b.data.year)[0];
const latestRecord = records[0];
const archiveYears = records.map((record) => record.data.year);
const yearRange = archiveYears.length > 0 ? `${Math.min(...archiveYears)}–${Math.max(...archiveYears)}` : '준비 중';
const activeSeries = archiveBranches.flatMap((branch) => branch.indexes.map((index) => {
  const seriesRecords = records.filter((record) => record.data.branch === branch.id && record.data.index === index.slug);
  return { branch, index, records: seriesRecords.sort((a, b) => a.data.year - b.data.year) };
})).filter((series) => series.records.length > 0);

const readingPaths = [
  { label: '인물로 읽기', note: '선수의 생애와 경력을 국가와 지역의 축구사 안에서 읽습니다.', branches: ['legends'] },
  { label: '대회로 읽기', note: '리그와 클럽·국가대표팀 대회를 연도와 당대 명칭으로 따라갑니다.', branches: ['leagues', 'european-club', 'national-team'] },
  { label: '수상 기록으로 읽기', note: '개인상과 득점 기록을 선정 당시의 맥락과 함께 확인합니다.', branches: ['awards'] },
];
const recordHref = (record: typeof records[number]) => `/archive/${record.data.branch}/${record.data.index}/${record.id}/`;
const freshBranches = new Set(
  records.filter((record) => isRecentlyChanged(record.data.pubDate, record.data.updatedDate)).map((record) => record.data.branch)
);
const freshIndexes = new Set(
  records.filter((record) => isRecentlyChanged(record.data.pubDate, record.data.updatedDate)).map((record) => `${record.data.branch}/${record.data.index}`)
);
---

<Layout
  title="삥이 아카이브"
  description={`축구의 인물과 대회, 수상 기록을 공식 명칭과 시대 구분에 따라 축적하는 ${site.name}의 아카이브입니다.`}
  breadcrumbs={[{ label: '홈', href: '/' }, { label: '삥이 아카이브', href: '/archive/' }]}
>
  <div class="archive-page">
    <section class="archive-hero" data-reveal>
      <div class="archive-hero-grid">
        <div class="archive-title-wrap">
          <p class="archive-label">삥이FC 기록총서</p>
          <h1><span>삥이</span><span>아카이브</span></h1>
          <p class="archive-description">축구의 인물·대회·수상 기록을 당대의 이름과 자료로 연결합니다.</p>
          <div class="archive-stats" aria-label="아카이브 현황">
            <div><strong>{records.length}</strong><span>RECORDS</span></div>
            <div><strong>{yearRange}</strong><span>YEARS</span></div>
            <div><strong>{activeSeries.length}</strong><span>SERIES</span></div>
          </div>
          <div class="archive-actions">
            {latestRecord && <a class="archive-action primary" href={recordHref(latestRecord)}>최신 기록 읽기 <span aria-hidden="true">→</span></a>}
            {firstRecord && <a class="archive-action" href={recordHref(firstRecord)}>{firstRecord.data.year}년부터 정주행 <span aria-hidden="true">→</span></a>}
          </div>
        </div>
        <aside class="hot-panel" aria-labelledby="hot-post-title">
          <div class="hot-panel-head">
            <div><span>LIVE RANKING</span><h2 id="hot-post-title">HOT POST</h2></div>
            <p data-hot-status>조회 데이터 집계 전 · 최신순</p>
          </div>
          <div class="hot-list">
            {records.map((record, index) => <a href={recordHref(record)} data-hot-path={recordHref(record)}>
              <span class="hot-rank">{String(index + 1).padStart(2, '0')}</span>
              <img src={record.data.coverImage} alt="" width="640" height="640" loading={index < 5 ? 'eager' : 'lazy'} style={imageFocusStyle(record.data.coverImage)} />
              <div><small>{record.data.year} · {archiveBranches.find((branch) => branch.id === record.data.branch)?.indexes.find((item) => item.slug === record.data.index)?.label}</small><strong>{record.data.subject}</strong><em data-view-label>{index < 5 ? '최신 기록' : ''}</em></div>
              <i aria-hidden="true">→</i>
            </a>)}
          </div>
        </aside>
      </div>
      {activeSeries.length > 0 && <nav class="hero-series" aria-label="현재 연재 바로가기">
        <span>현재 연재</span>
        <div>{activeSeries.map((series) => <a href={`/archive/${series.branch.id}/${series.index.slug}/`}><b>{series.index.label}</b><small>{series.records.length}편</small></a>)}</div>
      </nav>}
    </section>

    <section class="latest-records" aria-labelledby="latest-title" data-reveal>
      <div class="section-heading"><div><p>AVAILABLE NOW</p><h2 id="latest-title">지금 읽을 수 있는 기록</h2></div><p>발행이 끝난 기록만 모았습니다. 새로운 글은 이곳에 먼저 추가됩니다.</p></div>
      <div class="record-grid">
        {records.map((record) => (
          <a class="record-card" href={recordHref(record)} data-interactive>
            <div class="record-cover">
              <img src={record.data.coverImage} alt="" width="640" height="640" loading="lazy" style={imageFocusStyle(record.data.coverImage)} />
              {isNewlyPublished(record.data.pubDate) && <span class="new-badge">NEW</span>}
            </div>
            <div><p>{record.data.year} · {archiveBranches.find((branch) => branch.id === record.data.branch)?.indexes.find((index) => index.slug === record.data.index)?.label}</p><h3>{record.data.title}</h3><span>{record.data.description}</span><b>기록 읽기 →</b></div>
          </a>
        ))}
      </div>
    </section>

    <section class="reading-guide" aria-labelledby="guide-title" data-reveal>
      <div class="section-heading"><div><p>HOW TO READ</p><h2 id="guide-title">어떻게 읽을까요?</h2></div><p>익숙한 방식으로 먼저 들어가세요. 세부 분류는 페이지 아래에서 모두 볼 수 있습니다.</p></div>
      <div class="guide-grid">
        {readingPaths.map((path, index) => {
          const count = records.filter((record) => path.branches.includes(record.data.branch)).length;
          const target = archiveBranches.find((branch) => path.branches.includes(branch.id) && records.some((record) => record.data.branch === branch.id))
            ?? archiveBranches.find((branch) => path.branches.includes(branch.id));
          return <a class="guide-card" href={target ? `/archive/${target.id}/` : '/archive/'}><span>0{index + 1}</span><h3>{path.label}</h3><p>{path.note}</p><b>{count > 0 ? `${count}편 보기` : '분류 살펴보기'} →</b></a>;
        })}
      </div>
    </section>

    {activeSeries.length > 0 && <section class="active-series" aria-labelledby="series-title" data-reveal>
      <div class="section-heading"><div><p>CONTINUING SERIES</p><h2 id="series-title">이어지는 기록</h2></div><p>첫 글이 실제로 발행된 연속 기록만 표시합니다.</p></div>
      <div class="series-list">
        {activeSeries.map((series) => <a href={`/archive/${series.branch.id}/${series.index.slug}/`}><div><span>{series.branch.originalTitle}</span><h3>{series.index.label}</h3><p>{series.records[0].data.year}년부터 연도순으로 이어지는 기록</p></div><strong>{series.records.length}편 <i>→</i></strong></a>)}
      </div>
    </section>}

    <details class="archive-directory" data-reveal>
      <summary><div><p>FULL DIRECTORY</p><h2>전체 기록 분류</h2></div><span>세부 분류 펼치기 ＋</span></summary>
      <div class="directory-list">
        {archiveBranches.map((branch) => (
          <article class="directory-row" id={branch.id}>
            <div class="directory-number">{branch.number}</div>
            <div class="directory-main"><p>{branch.originalTitle}</p><h3><a href={`/archive/${branch.id}/`}>{branch.title}{freshBranches.has(branch.id) && <span class="category-new">NEW</span>}</a></h3><p>{branch.description}</p></div>
            <div class="directory-indexes">{branch.indexes.map((index) => <a href={`/archive/${branch.id}/${index.slug}/`}>{index.label}{freshIndexes.has(`${branch.id}/${index.slug}`) && <span class="category-new">NEW</span>}</a>)}</div>
          </article>
        ))}
      </div>
    </details>
  </div>
</Layout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (reduceMotion || !('IntersectionObserver' in window)) revealItems.forEach((item) => item.classList.add('is-visible'));
  else {
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: .1, rootMargin: '0px 0px -6% 0px' });
    revealItems.forEach((item) => observer.observe(item));
  }

  const hotList = document.querySelector<HTMLElement>('.hot-list');
  const hotStatus = document.querySelector<HTMLElement>('[data-hot-status]');
  if (hotList && hotStatus) {
    const cards = [...hotList.querySelectorAll<HTMLAnchorElement>('[data-hot-path]')];
    fetch('/api/archive/views')
      .then((response) => response.ok ? response.json() : Promise.reject())
      .then((data) => {
        const ranking = Array.isArray(data?.ranking) ? data.ranking : [];
        if (!ranking.length) return;
        const cardMap = new Map(cards.map((card) => [card.dataset.hotPath, card]));
        const rankedCards = ranking.map((item: { path?: string; views?: number }) => {
          const card = item.path ? cardMap.get(item.path) : undefined;
          if (!card) return undefined;
          card.querySelector<HTMLElement>('[data-view-label]')!.textContent = `조회 ${Number(item.views ?? 0).toLocaleString('ko-KR')}`;
          card.dataset.ranked = 'true';
          return card;
        }).filter(Boolean) as HTMLAnchorElement[];
        if (!rankedCards.length) return;
        [...rankedCards, ...cards.filter((card) => !rankedCards.includes(card))].forEach((card, index) => {
          card.querySelector<HTMLElement>('.hot-rank')!.textContent = String(index + 1).padStart(2, '0');
          hotList.append(card);
        });
        hotStatus.textContent = '실시간 누적 조회수 순';
      })
      .catch(() => {});
  }
</script>

<style>
  .archive-page { max-width: 1040px; margin: 0 auto; padding: 44px 20px 40px; overflow: clip; }
  .archive-hero { border-top: 2px solid var(--bbfc-ink); border-bottom: 1px solid var(--bbfc-border); }
  .archive-hero-grid { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(360px,.95fr); gap:clamp(48px,7vw,86px); align-items:center; min-height:470px; padding:42px 0 38px; }
  .archive-label,.section-heading div>p,details summary div>p { font-size:10px; font-weight:650; letter-spacing:.15em; color:var(--bbfc-blue); }
  .archive-hero h1 { display:grid; margin-top:15px; font-size:clamp(54px,6.1vw,75px); line-height:.91; font-weight:720; letter-spacing:-.07em; }
  .archive-description { max-width:430px; margin-top:23px; font-size:14px; line-height:1.75; color:var(--bbfc-gray-1); }
  .archive-stats { display:flex; margin-top:28px; border-top:1px solid var(--bbfc-border); border-bottom:1px solid var(--bbfc-border); }
  .archive-stats>div { min-width:112px; padding:15px 22px 14px 0; }
  .archive-stats>div+div { padding-left:22px; border-left:1px solid var(--bbfc-border); }
  .archive-stats strong { display:block; font-size:19px; line-height:1.1; font-weight:680; letter-spacing:-.035em; }
  .archive-stats span { display:block; margin-top:6px; font-size:8px; font-weight:700; letter-spacing:.14em; color:var(--bbfc-gray-2); }
  .archive-actions { display:flex; flex-wrap:wrap; gap:9px; margin-top:20px; }
  .archive-action { display:flex; align-items:center; justify-content:space-between; gap:28px; min-width:176px; padding:11px 13px; border:1px solid var(--bbfc-border); border-radius:8px; font-size:11px; font-weight:620; transition:border-color .18s,color .18s,background .18s; }
  .archive-action span { font-size:14px; }
  .archive-action:hover { border-color:var(--bbfc-blue); color:var(--bbfc-blue); }
  .archive-action.primary { border-color:var(--bbfc-ink); background:var(--bbfc-ink); color:#fff; }
  .archive-action.primary:hover { border-color:var(--bbfc-blue); background:var(--bbfc-blue); color:#fff; }
  .hot-panel { padding:18px; border:1px solid var(--bbfc-border); border-radius:var(--bbfc-radius-lg); background:var(--bbfc-white); }
  .hot-panel-head { display:flex; justify-content:space-between; align-items:end; gap:16px; padding:0 2px 13px; border-bottom:1px solid var(--bbfc-ink); }
  .hot-panel-head span { font-size:8px; font-weight:700; letter-spacing:.14em; color:var(--bbfc-blue); }
  .hot-panel-head h2 { margin-top:3px; font-size:22px; line-height:1; font-weight:720; letter-spacing:-.04em; }
  .hot-panel-head>p { padding-bottom:1px; font-size:9px; color:var(--bbfc-gray-2); }
  .hot-list { display:grid; }
  .hot-list>a { display:grid; grid-template-columns:24px 54px minmax(0,1fr) 15px; align-items:center; gap:10px; min-height:68px; padding:8px 2px; border-bottom:1px solid var(--bbfc-border); transition:background .16s,color .16s; }
  .hot-list>a:nth-child(n+6) { display:none; }
  .hot-list>a:hover { background:var(--bbfc-fill); color:var(--bbfc-blue); }
  .hot-rank { font-size:10px; font-weight:700; color:var(--bbfc-gray-2); }
  .hot-list img { width:54px; height:54px; border-radius:8px; object-fit:cover; background:var(--bbfc-fill); }
  .hot-list div { display:grid; min-width:0; }
  .hot-list small { overflow:hidden; font-size:8px; line-height:1.3; color:var(--bbfc-gray-2); text-overflow:ellipsis; white-space:nowrap; }
  .hot-list strong { overflow:hidden; margin-top:3px; font-size:13px; line-height:1.35; font-weight:650; letter-spacing:-.02em; text-overflow:ellipsis; white-space:nowrap; }
  .hot-list em { margin-top:3px; font-size:8px; font-style:normal; color:var(--bbfc-blue); }
  .hot-list i { font-size:13px; font-style:normal; color:var(--bbfc-gray-2); }
  .hero-series { display:flex; align-items:center; gap:24px; padding:14px 0; border-top:1px solid var(--bbfc-border); }
  .hero-series>span { flex:0 0 auto; font-size:9px; font-weight:700; letter-spacing:.12em; color:var(--bbfc-gray-2); }
  .hero-series>div { display:flex; flex-wrap:wrap; gap:8px; }
  .hero-series a { display:flex; align-items:center; gap:9px; padding:7px 10px; border-radius:99px; background:var(--bbfc-fill); transition:background .18s,color .18s; }
  .hero-series a:hover { background:var(--bbfc-blue-weak); color:var(--bbfc-blue); }
  .hero-series b { font-size:10px; font-weight:620; }
  .hero-series small { font-size:9px; color:var(--bbfc-gray-2); }
  .latest-records,.reading-guide,.active-series { padding-top:88px; }
  .section-heading { display:flex; justify-content:space-between; align-items:end; gap:42px; padding-bottom:22px; border-bottom:2px solid var(--bbfc-ink); }
  .section-heading h2,details summary h2 { margin-top:7px; font-size:31px; font-weight:650; letter-spacing:-.045em; }
  .section-heading>p { max-width:390px; font-size:13px; line-height:1.7; text-align:right; color:var(--bbfc-gray-2); }
  .record-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:28px 22px; padding-top:30px; }
  .record-cover { position:relative; }
  .record-card img { width:100%; aspect-ratio:1; object-fit:contain; border-radius:var(--bbfc-radius-lg); background:var(--bbfc-fill); transition:transform .25s ease; }
  .record-card:hover img { transform:translateY(-5px); }
  .record-card > div:last-child { padding:16px 2px 0; }
  .record-card > div:last-child>p { font-size:10px; color:var(--bbfc-blue); }
  .record-card h3 { margin-top:7px; font-size:17px; line-height:1.45; font-weight:630; }
  .record-card > div:last-child>span { display:block; margin-top:9px; font-size:12px; line-height:1.6; color:var(--bbfc-gray-1); }
  .record-card b { display:block; margin-top:13px; font-size:11px; font-weight:600; color:var(--bbfc-blue-strong); }
  .new-badge { position:absolute; top:10px; right:10px; z-index:1; padding:5px 8px; border-radius:999px; background:var(--bbfc-blue); color:#fff; font-size:9px; line-height:1; font-weight:750; letter-spacing:.08em; box-shadow:0 3px 10px rgba(20,91,198,.2); }
  .category-new { margin-left:7px; color:var(--bbfc-blue); font-size:8px; font-style:normal; font-weight:750; letter-spacing:.06em; vertical-align:top; }
  .guide-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; padding-top:28px; }
  .guide-card { min-height:235px; padding:24px; border:1px solid var(--bbfc-border); border-radius:var(--bbfc-radius-lg); transition:transform .2s ease,border-color .2s ease; }
  .guide-card:hover { transform:translateY(-5px); border-color:var(--bbfc-blue); }
  .guide-card>span { font-size:10px; color:var(--bbfc-blue); }
  .guide-card h3 { margin-top:38px; font-size:21px; font-weight:640; }
  .guide-card p { margin-top:12px; font-size:13px; line-height:1.7; color:var(--bbfc-gray-1); }
  .guide-card b { display:block; margin-top:22px; font-size:11px; font-weight:600; color:var(--bbfc-blue-strong); }
  .series-list { display:grid; padding-top:12px; }
  .series-list>a { display:flex; justify-content:space-between; align-items:center; gap:20px; padding:28px 10px; border-bottom:1px solid var(--bbfc-border); }
  .series-list span { font-size:9px; letter-spacing:.13em; color:var(--bbfc-gray-2); }
  .series-list h3 { margin-top:7px; font-size:22px; font-weight:640; }
  .series-list p { margin-top:8px; font-size:12px; color:var(--bbfc-gray-1); }
  .series-list strong { font-size:12px; color:var(--bbfc-blue-strong); white-space:nowrap; }
  .series-list i { margin-left:8px; font-size:17px; font-style:normal; }
  details.archive-directory { margin-top:104px; border-top:2px solid var(--bbfc-ink); }
  details summary { display:flex; justify-content:space-between; align-items:center; padding:26px 0; cursor:pointer; list-style:none; }
  details summary::-webkit-details-marker { display:none; }
  details summary>span { font-size:11px; color:var(--bbfc-gray-1); }
  details[open] summary>span { font-size:0; } details[open] summary>span::after { content:'세부 분류 접기 −'; font-size:11px; }
  .directory-row { display:grid; grid-template-columns:54px minmax(220px,.8fr) minmax(320px,1.2fr); gap:26px; padding:32px 8px; border-bottom:1px solid var(--bbfc-border); }
  .directory-number { font-size:11px; font-weight:650; color:var(--bbfc-blue); }
  .directory-main>p:first-child { font-size:9px; letter-spacing:.13em; color:var(--bbfc-gray-2); }
  .directory-main h3 { margin-top:7px; font-size:19px; font-weight:630; }
  .directory-main>p:last-child { margin-top:11px; font-size:12px; line-height:1.65; color:var(--bbfc-gray-1); }
  .directory-indexes { display:flex; flex-wrap:wrap; gap:7px; align-content:center; }
  .directory-indexes a { padding:7px 10px; border:1px solid var(--bbfc-border); border-radius:99px; font-size:11px; }
  [data-reveal] { opacity:0; transform:translateY(24px); transition:opacity .65s ease,transform .65s ease; }
  [data-reveal].is-visible { opacity:1; transform:translateY(0); }
  @media(max-width:767px){
    .archive-page{padding:26px 16px 20px}.archive-hero-grid{grid-template-columns:1fr;gap:28px;min-height:0;padding:34px 0 28px}.archive-hero h1{font-size:clamp(50px,14.8vw,62px)}.archive-description{margin-top:18px}.archive-stats>div{min-width:0;flex:1;padding:13px 12px 12px 0}.archive-stats>div+div{padding-left:12px}.archive-stats strong{font-size:16px}.archive-actions{display:grid;grid-template-columns:1fr 1fr}.archive-action{min-width:0;gap:10px;padding:11px 10px}.hot-panel{padding:14px}.hot-list>a{grid-template-columns:22px 48px minmax(0,1fr) 13px;min-height:62px;gap:8px}.hot-list img{width:48px;height:48px}.hot-panel-head h2{font-size:20px}.hero-series{align-items:flex-start;gap:13px;padding:13px 0}.hero-series>div{gap:6px}.latest-records,.reading-guide,.active-series{padding-top:72px}.section-heading{display:block}.section-heading>p{margin-top:14px;text-align:left}.section-heading h2,details summary h2{font-size:27px}.record-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:26px 12px}.record-card h3{font-size:14px}.record-card > div:last-child>span{display:none}.guide-grid{grid-template-columns:1fr;gap:12px}.guide-card{min-height:190px}.guide-card h3{margin-top:28px}.series-list>a{padding:24px 2px}details.archive-directory{margin-top:76px}.directory-row{grid-template-columns:30px 1fr;gap:12px;padding:28px 0}.directory-indexes{grid-column:2}details summary>span{max-width:100px;text-align:right}
  }
  @media(prefers-reduced-motion:reduce){[data-reveal]{opacity:1;transform:none;transition:none}.record-card img,.guide-card{transform:none!important}}
</style>
