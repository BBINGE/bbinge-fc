---

<Layout
  title="소개"
  description={`${site.fullName} — 박성호(삥이) 공식 소개`}
  breadcrumbs={[
    { label: '홈', href: '/' },
    { label: '소개', href: '/about/' },
  ]}
>
  <!-- 섹션 1 — 히어로 -->
  <section class="relative overflow-hidden">
    <p
      id="about-watermark"
      aria-hidden="true"
      class="pointer-events-none select-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 font-medium whitespace-nowrap"
      style="font-size:clamp(56px,13vw,200px); color:var(--bbfc-blue); opacity:0.1; line-height:1;"
    >
      @삥이
    </p>
    <div class="relative max-w-[1040px] mx-auto px-4 md:px-5 pt-14 pb-12 md:pt-20 md:pb-16">
      <div class="flex flex-col md:flex-row md:items-center gap-8 md:gap-14">
        <div data-reveal class="shrink-0 mx-auto md:mx-0">
          <div class="about-photo-frame w-[136px] h-[136px] md:w-[176px] md:h-[176px]">
            <img
              src="/images/profile-bbinge.png"
              alt="박성호(삥이) 프로필"
              width="176"
              height="176"
              loading="eager"
              fetchpriority="high"
              class="about-photo"
            />
          </div>
        </div>

        <div class="max-w-[560px] text-center md:text-left">
          <p data-reveal class="text-[18px] md:text-[21px] leading-[1.7] text-[var(--bbfc-ink)]">
            기획자 박성호. 온라인에서는 삥이로 씁니다.
          </p>
          <p
            data-reveal
            style="transition-delay:80ms"
            class="text-[18px] md:text-[21px] leading-[1.7] text-[var(--bbfc-gray-1)]"
          >
            광고·브랜딩이 업이고, 축구사(史) 저술이 오래된 일입니다.
          </p>
        </div>
      </div>

      <!-- SKILL 태그 -->
      <div data-reveal style="transition-delay:140ms" class="mt-10 md:mt-14">
        <p class="text-[11px] tracking-wide text-[var(--bbfc-gray-2)] font-medium">SKILL</p>
        <div class="flex flex-wrap gap-2 mt-3">
          {skills.map((s) => (
            <span class="text-[13px] text-[var(--bbfc-gray-1)] bg-[var(--bbfc-fill)] px-3 py-1.5 rounded-[6px]">
              {s}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-[1040px] mx-auto px-4 md:px-5">
    <!-- 섹션 2 — 이력 -->
    <section class="mt-14 md:mt-20">
      <h2 data-reveal class="about-h2">이력</h2>
      <ul class="mt-6">
        {careerTrack1.map((c, i) => (
          <li
            data-reveal
            style={`transition-delay:${i * 60}ms`}
            class="flex items-start gap-4 py-3 border-b border-[var(--bbfc-line)]"
          >
            <span
              class:list={[
                'shrink-0 text-[11px] font-medium px-2 py-0.5 rounded-[4px] mt-0.5',
                c.label === '現'
                  ? 'text-[var(--bbfc-blue)] bg-[var(--bbfc-blue-weak)]'
                  : 'text-[var(--bbfc-gray-2)] bg-[var(--bbfc-fill)]',
              ]}
            >
              {c.label}
            </span>
            <span class="text-[15px] md:text-[16px] leading-[1.6] text-[var(--bbfc-ink-2)]">{c.text}</span>
          </li>
        ))}
      </ul>
      <div class="my-3 border-t border-dashed border-[var(--bbfc-border)]" aria-hidden="true"></div>
      <ul>
        {careerTrack2.map((c, i) => (
          <li
            data-reveal
            style={`transition-delay:${i * 60}ms`}
            class="flex items-start gap-4 py-3 border-b border-[var(--bbfc-line)] last:border-b-0"
          >
            <span
              class:list={[
                'shrink-0 text-[11px] font-medium px-2 py-0.5 rounded-[4px] mt-0.5',
                c.label === '現'
                  ? 'text-[var(--bbfc-blue)] bg-[var(--bbfc-blue-weak)]'
                  : 'text-[var(--bbfc-gray-2)] bg-[var(--bbfc-fill)]',
              ]}
            >
              {c.label}
            </span>
            <span class="text-[15px] md:text-[16px] leading-[1.6] text-[var(--bbfc-ink-2)]">{c.text}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- 섹션 3 — 온라인 권위 -->
    <section class="mt-14 md:mt-20">
      <h2 data-reveal class="about-h2">온라인 권위</h2>
      <ul class="columns-1 md:columns-2 gap-x-10 mt-6">
        {authority.map((a, i) => (
          <li data-reveal style={`transition-delay:${(i % 5) * 60}ms`} class="about-link-row break-inside-avoid">
            <span class="about-link-row-inner">
              <svg
                class="about-link-icon"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={icons[a.icon]} />
              </svg>
              <span class="text-[14px] md:text-[15px] leading-[1.6] text-[var(--bbfc-ink-2)]">{a.text}</span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <!-- 섹션 4 — 주요 의뢰인 / 성과 -->
    <section class="mt-14 md:mt-20">
      <h2 data-reveal class="about-h2">주요 의뢰인 · 성과</h2>
      <div class="columns-1 md:columns-2 gap-x-10 mt-6">
        {clients.map((c, gi) => (
          <div data-reveal style={`transition-delay:${(gi % 4) * 80}ms`} class="break-inside-avoid mb-8">
            <p class="text-[11px] tracking-wide text-[var(--bbfc-blue)] font-medium">{c.group}</p>
            <ul class="mt-2">
              {c.items.map((item) => (
                <li class="about-client-row">
                  <span class="text-[14px] md:text-[15px] leading-[1.7] text-[var(--bbfc-ink)]">{item.org}</span>
                  <span class="text-[13px] md:text-[14px] leading-[1.7] text-[var(--bbfc-gray-1)]"> — {item.detail}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- 섹션 5 — 연락처 -->
    <section data-reveal class="mt-14 md:mt-20 pb-16 md:pb-24">
      <h2 class="text-[16px] font-medium text-[var(--bbfc-ink)]">연락은 이곳으로.</h2>
      <div class="flex flex-wrap gap-3 mt-5">
        <a
          href={NAVER_BLOG_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="about-cta"
        >
          네이버 블로그
        </a>
        <a
          href={INSTAGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="about-cta"
        >
          인스타그램
        </a>
        <a href={`mailto:${EMAIL}`} class="about-cta about-cta-solid">
          이메일 보내기
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .about-h2 {
    display: inline-block;
    position: relative;
    font-size: 18px;
    font-weight: 500;
    color: var(--bbfc-ink);
    padding-bottom: 10px;
  }
  .about-h2::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: var(--bbfc-blue);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
  }
  .about-h2.is-visible::after {
    transform: scaleX(1);
  }

  .about-photo-frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% 82%, 82% 100%, 0 100%);
    box-shadow: 0 0 0 1px var(--bbfc-border), 0 20px 40px -20px rgba(25, 31, 40, 0.25);
  }
  .about-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.001);
    transition: transform 0.5s ease;
  }
  .about-photo-frame:hover .about-photo {
    transform: scale(1.05);
  }

  .about-link-row {
    border-bottom: 1px solid var(--bbfc-line);
  }
  .about-link-row-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    position: relative;
    padding: 12px 0 12px 14px;
    transition: color 0.25s ease, transform 0.25s ease;
  }
  .about-link-row-inner::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--bbfc-blue);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.3s ease;
  }
  .about-link-icon {
    color: var(--bbfc-gray-2);
    flex-shrink: 0;
    transition: color 0.25s ease;
  }
  .about-link-row:hover .about-link-row-inner {
    transform: translateX(4px);
  }
  .about-link-row:hover .about-link-row-inner::before {
    transform: scaleY(1);
  }
  .about-link-row:hover .about-link-icon {
    color: var(--bbfc-blue);
  }

  .about-client-row {
    padding: 6px 0;
    border-bottom: 1px solid var(--bbfc-line);
  }
  .about-client-row:last-child {
    border-bottom: none;
  }

  .about-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--bbfc-ink-2);
    background: var(--bbfc-fill);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .about-cta:hover {
    background: var(--bbfc-blue-weak);
    color: var(--bbfc-blue);
  }
  .about-cta-solid {
    background: var(--bbfc-blue);
    color: #fff;
  }
  .about-cta-solid:hover {
    background: var(--bbfc-blue-strong);
    color: #fff;
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .about-h2::after {
      transform: scaleX(1);
      transition: none;
    }
    .about-photo-frame:hover .about-photo {
      transform: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    const revealTargets = document.querySelectorAll('[data-reveal], .about-h2');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
    );
    revealTargets.forEach((el) => observer.observe(el));

    const watermark = document.getElementById('about-watermark');
    if (watermark) {
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const offset = window.scrollY * 0.08;
          watermark.style.transform = `translate(-50%, calc(-50% + ${offset}px))`;
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  } else {
    document.querySelectorAll('[data-reveal], .about-h2').forEach((el) => el.classList.add('is-visible'));
  }
</script>
