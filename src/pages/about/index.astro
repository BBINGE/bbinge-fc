const authority: { icon: keyof typeof icons; text: string; href: string | null }[] = [
  { icon: 'newspaper', text: '조선일보 · 삥이 (Google·NAVER 광고 생태계 자문)', href: null },
  { icon: 'book', text: '나무위키 · 삥이', href: null },
  { icon: 'user', text: 'NAVER 인물 / NAVER 인플루언서', href: null },
  { icon: 'users', text: 'NAVER 카페 운영자 (중고거래 틈새마켓, 회원 약 1만)', href: null },
  { icon: 'edit', text: 'NAVER 블로그 @삥이(삥이N스포츠) / @삥이핏 / @광자삥이(DONEMOYA)', href: null },
  { icon: 'video', text: 'NAVER TV/Clip (삥이_official)', href: null },
  { icon: 'badge', text: 'NAVER expert (광고 전문가 자격)', href: null },
  { icon: 'feather', text: 'Kakao BrunchStory 작가 / Kakao Tistory 창작자(BBingStory)', href: null },
  { icon: 'camera', text: 'Instagram @bbinge_26 / @bbinge_official', href: null },
  { icon: 'broadcast', text: 'SPOTV NOW 전문 프리뷰어 (메이저 방송사 8년 협업)', href: null },
  { icon: 'mail', text: 'Substack @bbinge', href: null },
