  { logos: [{ src: '/images/about-logos/brunchstory.svg', alt: '브런치스토리', fit: 'flush' }], text: '브런치 작가 (@삥이)', href: site.brunch },
  { logos: [{ src: '/images/about-logos/spotv-now.png', alt: 'SPOTV NOW', fit: 'flush' }], text: 'SPOTV NOW 전문 프리뷰어 (8년 협업)', href: null },
  { logos: [{ src: '/images/about-logos/substack.png', alt: 'Substack', fit: 'flush' }], text: 'Substack 저자 (@bbinge)', href: site.substack },
];

const currentChannel = officialChannels[0];
const connectedRecords = [
  ...officialChannels.slice(1).map((channel) => ({
    label: channel.name,
    detail: `${channel.platform} · ${channel.handle}`,
    description: channel.description,
    href: channel.href,
    logo: channel.logo,
  })),
  ...identityReferences.map((reference) => ({
    label: reference.label,
    detail: reference.detail,
    description: '',
    href: reference.href,
    logo: reference.logo,
  })),
  ...authority.map((record) => ({
    label: record.text,
    detail: '',
    description: '',
    href: record.href,
    logo: record.logos[0],
  })),
];

const clients = [
  {
    group: '방송',
    items: [{ org: '주식회사 에이클라미디어그룹(SPOTV NOW)', detail: '축구 분야 전문 프리뷰어 협업' }],
  },
  {
    group: '금융',
    items: [{ org: 'KEB하나은행', detail: '프로스포츠 연계 금융상품 디지털 캠페인' }],
  },
  {
    group: '공공·행정',
    items: [
      { org: '중소벤처기업부', detail: '소상공인 지원사업 통합 홍보' },
      { org: '소상공인시장진흥공단', detail: '소상공인 유통·판로 지원사업 운영' },
      { org: '대전광역시', detail: '지역 행사 및 디지털 콘텐츠 홍보' },
      { org: '새만금개발청', detail: '기관 종합홍보' },
      { org: '한국기초과학지원연구원', detail: '연구기관 디지털 콘텐츠 홍보' },
      { org: '국립호남권생물자원관', detail: '온라인 콘텐츠 확산 캠페인' },
      { org: '국민 철도 플랫폼 SRT', detail: 'SNS 홍보 운영' },
    ],
  },
  {
    group: '글로벌',
    items: [
      { org: 'PANINI S.P.A.', detail: '파니니 축구카드 탑클래스 2023/2024 트레이딩 카드 협찬' },
      { org: 'About Vintage × AC밀란', detail: '123주년 리미티드 에디션 협찬' },
      { org: 'Gaston Luga', detail: '블랙 백팩 + 도트백 협찬' },
      { org: 'Dr.Wolff-Group', detail: 'Alpecin 카페인 샴푸 월드컵패키지 협찬' },
      { org: 'ExpressVPN', detail: '대한민국 프로모션 기념 NAVER 블로그 광고' },
      { org: '제닉스 × 파리 생제르맹 FC(PSG)', detail: '게이밍 의자 협찬' },
    ],
  },
  {
    group: '교육',
    items: [
      { org: '건양사이버대학교', detail: '소상공인 상대 NAVER 광고 자문·교육 (2023~2025)' },
      { org: '건양대학교', detail: '온·오프라인 홍보' },
      { org: '500명의 연(緣) 마케터 교육방', detail: '운영 중' },
    ],
  },
  {
    group: '수상·공인',
    items: [
      { org: 'NAVER 슈퍼애드 선정', detail: '대한민국 64번째' },
      { org: '고용노동부 청년내일채움공제 수기 공모전', detail: '우수상' },
    ],
  },
  {
    group: '언론',
    items: [{ org: '조선일보', detail: 'GOOGLE & NAVER 광고 생태계 자문 및 본인 출연' }],
  },
  {
    group: '유통',
    items: [{ org: '대전신세계 Art&Science', detail: '온라인 마케팅 운영 대행' }],
  },
  {
    group: '그 외',
    items: [
      { org: '산부인과·정형외과·피부과·한의원 등', detail: '의료기관 다수 마케팅 기획' },
      { org: '제9회 전국동시지방선거', detail: '보수/진보 정당 캠페인 기획 참여 (신원 비공개)' },
      { org: '100여 개 기업·소상공인', detail: '통합 홍보 기획 및 실행' },
      { org: '중앙행정기관·지방자치단체', detail: '광고 및 용역 다수 (AE/마케팅)' },
    ],
  },
];
---

<Layout
  title="소개"
  description={`${site.fullName} - 박성호(삥이) 공식 소개`}
  adsEligible={false}
  extraSchema={profileSchema}
  breadcrumbs={[
    { label: '홈', href: '/' },
    { label: '소개', href: '/about/' },
  ]}
>
  <!-- 섹션 1 - 히어로 -->
  <section class="relative overflow-hidden">
    <p
      id="about-watermark"
      aria-hidden="true"
      class="pointer-events-none select-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 font-medium whitespace-nowrap"
      style="font-size:clamp(56px,13vw,200px); color:var(--bbfc-blue); opacity:0.1; line-height:1;"
    >
      @삥이
    </p>
    <div class="relative max-w-[1200px] mx-auto px-5 md:px-8 pt-16 pb-16 md:pt-24 md:pb-24">
      <div class="about-hero-grid">
        <div class="about-hero-copy order-2 md:order-1">
          <p data-reveal class="about-kicker">PARK SEONGHO · BBINGE</p>
          <div class="mt-5 md:mt-7 max-w-[720px]">
            <h1 data-reveal class="text-[25px] md:text-[40px] font-medium leading-[1.35] text-[var(--bbfc-ink)] tracking-[-0.035em]">
              기획자 박성호. 온라인에서는 삥이로 씁니다.
            </h1>
            <p data-reveal style="transition-delay:80ms" class="mt-3 text-[17px] md:text-[21px] leading-[1.7] text-[var(--bbfc-gray-1)]">
              광고·브랜딩이 업이고, 축구사(史) 저술이 오래된 일입니다.
            </p>
          </div>

          <div data-reveal style="transition-delay:140ms" class="mt-9 md:mt-12">
            <p class="text-[11px] tracking-[0.16em] text-[var(--bbfc-gray-2)] font-medium">SKILL</p>
            <div class="flex flex-wrap gap-2 mt-3">
              {skills.map((s) => <span class="about-skill">{s}</span>)}
            </div>
          </div>

          <div data-reveal style="transition-delay:200ms" class="about-hero-actions">
            <a href="#official-channels" class="about-hero-action about-hero-action-primary">공식 채널 한눈에 보기</a>
            <a href={NAVER_PERSON_URL} target="_blank" rel="noopener noreferrer" class="about-hero-action">
              NAVER 인물정보 <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div data-reveal class="order-1 md:order-2 md:justify-self-end">
          <a
            href={NAVER_PERSON_URL}
            target="_blank"
            rel="noopener"
            aria-label="네이버 인물정보에서 박성호(삥이) 보기 (새 창)"
            class="about-photo-frame w-[176px] h-[208px] md:w-[300px] md:h-[360px]"
          >
            <img
              src="/images/profile-bbinge.png"
              alt="박성호(삥이) 프로필"
              width="300"
              height="360"
              loading="eager"
              fetchpriority="high"
              class="about-photo"
            />
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-[1200px] mx-auto px-5 md:px-8">
    <!-- 섹션 2 - 저자의 편지 -->
    <section class="mt-6 md:mt-10" aria-labelledby="football-letter-title">
      <article class="about-letter">
        <img
          src="/images/about-world-cup-trophy.webp"
          alt=""
          aria-hidden="true"
          class="about-letter-trophy"
          loading="lazy"
          decoding="async"
        />
        <img src="/images/about-euro-trophy.webp" alt="" aria-hidden="true" class="about-letter-trophy about-letter-trophy-euro" loading="lazy" decoding="async" />
        <img src="/images/about-asian-cup-trophy.webp" alt="" aria-hidden="true" class="about-letter-trophy about-letter-trophy-asian" loading="lazy" decoding="async" />
        <img src="/images/about-champions-league-trophy.webp" alt="" aria-hidden="true" class="about-letter-trophy about-letter-trophy-champions" loading="lazy" decoding="async" />
        <div class="about-letter-head">
          <p class="about-letter-kicker">A LETTER FROM BBINGE</p>
          <span aria-hidden="true" class="about-letter-mark">BBINGE FC · 01</span>
        </div>

        <h2 id="football-letter-title" class="about-letter-title">나는 왜 축구를 쓰는가</h2>

        <div class="about-letter-body">
          {footballLetter.map((paragraph) => (
            <p>
              {'text' in paragraph ? paragraph.text : (
                <>{paragraph.before}<strong>{paragraph.strong}</strong>{paragraph.after}</>
              )}
            </p>
          ))}
        </div>

        <footer class="about-letter-signature">
          <span class="about-letter-signature-line" aria-hidden="true"></span>
          <p>삥이, 박성호</p>
        </footer>
      </article>
    </section>

    <!-- 섹션 3 - 이력 -->
    <section class="mt-14 md:mt-20">
      <h2 data-reveal class="about-h2">이력</h2>
      <div class="about-career-grid mt-7">
      <div><p class="about-track-label">MEDIA · WRITING</p><ul class="mt-3">
        {careerTrack1.map((c, i) => (
          <li
            data-reveal
            style={`transition-delay:${i * 60}ms`}
            class="flex items-start gap-4 py-3 border-b border-[var(--bbfc-line)]"
          >
            <span
              class:list={[
                'shrink-0 text-[11px] font-medium px-2 py-0.5 rounded-[4px] mt-0.5',
                c.label === '現'
                  ? 'text-[var(--bbfc-blue)] bg-[var(--bbfc-blue-weak)]'
                  : 'text-[var(--bbfc-gray-2)] bg-[var(--bbfc-fill)]',
              ]}
            >
              {c.label}
            </span>
            <span class="text-[15px] md:text-[16px] leading-[1.6] text-[var(--bbfc-ink-2)]">{c.text}</span>
          </li>
        ))}
      </ul></div>
      <div><p class="about-track-label">PLANNING · BUSINESS</p><ul class="mt-3">
        {careerTrack2.map((c, i) => (
          <li
            data-reveal
            style={`transition-delay:${i * 60}ms`}
            class="flex items-start gap-4 py-3 border-b border-[var(--bbfc-line)] last:border-b-0"
          >
            <span
              class:list={[
                'shrink-0 text-[11px] font-medium px-2 py-0.5 rounded-[4px] mt-0.5',
                c.label === '現'
                  ? 'text-[var(--bbfc-blue)] bg-[var(--bbfc-blue-weak)]'
                  : 'text-[var(--bbfc-gray-2)] bg-[var(--bbfc-fill)]',
              ]}
            >
              {c.label}
            </span>
            <span class="text-[15px] md:text-[16px] leading-[1.6] text-[var(--bbfc-ink-2)]">{c.text}</span>
          </li>
        ))}
      </ul></div></div>
    </section>

    <!-- 섹션 4 - 공식 채널·외부 인물정보·활동과 공인 -->
    <section id="official-channels" class="about-identity-hub about-identity-hub-lower" aria-labelledby="identity-hub-title">
      <div data-reveal class="about-section-intro">
        <p class="about-kicker">ONE PERSON · CONNECTED RECORDS</p>
        <h2 id="identity-hub-title" class="about-section-title">하나의 이름, 이어진 기록</h2>
        <p class="about-section-description">
          네이버에서 쓴 시간, 티스토리에 남긴 기록, 인스타그램의 활동은 지금 삥이FC로 이어집니다. 이름과 플랫폼은 달라도 저자와 운영자는 박성호(삥이) 한 사람입니다.
        </p>
      </div>

      <a data-reveal href={currentChannel.href} class="about-channel-card is-current about-current-record">
        <span class:list={['about-brand-mark', `is-${currentChannel.logo.fit}`]}>
          <img src={currentChannel.logo.src} alt={currentChannel.logo.alt} width="48" height="48" loading="lazy" decoding="async" />
        </span>
        <span class="about-channel-copy">
          <span class="about-channel-platform">
            {currentChannel.platform}
            <span class="about-current-badge">현재 위치</span>
          </span>
          <strong>{currentChannel.name}</strong>
          <span class="about-channel-handle">{currentChannel.handle}</span>
          <span class="about-channel-description">{currentChannel.description}</span>
        </span>
        <span class="about-channel-arrow" aria-hidden="true">→</span>
      </a>

      <ul class="about-record-grid" aria-label="삥이의 연결된 채널과 활동 이력">
        {connectedRecords.map((record, i) => (
          <li data-reveal style={`transition-delay:${(i % 4) * 45}ms`} class:list={['about-record-card', record.href && 'is-linked']}>
            {record.href ? (
              <a href={record.href} target="_blank" rel="noopener noreferrer" class="about-record-card-inner" aria-label={`${record.label} (새 창)`}>
                <span class:list={['about-brand-mark', `is-${record.logo.fit}`]}>
                  <img src={record.logo.src} alt={record.logo.alt} width="48" height="48" loading="lazy" decoding="async" />
                </span>
                <span class="about-record-copy">
                  <strong>{record.label}</strong>
                  {record.detail && <small>{record.detail}</small>}
                  {record.description && <small>{record.description}</small>}
                </span>
                <span class="about-record-arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              <div class="about-record-card-inner is-static">
                <span class:list={['about-brand-mark', `is-${record.logo.fit}`]}>
                  <img src={record.logo.src} alt={record.logo.alt} width="48" height="48" loading="lazy" decoding="async" />
                </span>
                <span class="about-record-copy">
                  <strong>{record.label}</strong>
                </span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>

    <!-- 섹션 5 - 주요 의뢰인 / 성과 -->
    <section class="mt-14 md:mt-20">
      <h2 data-reveal class="about-h2">주요 의뢰인 · 성과</h2>
      <div class="about-clients-panel columns-1 md:columns-2 gap-x-12 mt-7">
        {clients.map((c, gi) => (
          <div data-reveal style={`transition-delay:${(gi % 4) * 80}ms`} class="break-inside-avoid mb-8">
            <p class="text-[11px] tracking-wide text-[var(--bbfc-blue)] font-medium">{c.group}</p>
            <ul class="mt-2">
              {c.items.map((item) => (
                <li class="about-client-row">
                  <span class="text-[14px] md:text-[15px] leading-[1.7] text-[var(--bbfc-ink)]">{item.org}</span>
                  <span class="text-[13px] md:text-[14px] leading-[1.7] text-[var(--bbfc-gray-1)]"> - {item.detail}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- 섹션 6 - 연락처 -->
    <section data-reveal class="about-contact mt-14 md:mt-24 mb-16 md:mb-24">
      <div><p class="about-kicker">CONTACT</p><h2 class="mt-2 text-[22px] md:text-[28px] font-medium text-[var(--bbfc-ink)]">연락은 이곳으로.</h2></div>
      <div class="flex flex-wrap gap-3 mt-5 md:mt-0">
        <a
          href={NAVER_BLOG_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="about-cta about-cta-naver"
        >
          <svg class="about-cta-icon about-cta-icon-blog" viewBox="0 0 32 24" aria-hidden="true">
            <path d="M3.5 2.5h25v15.2H18l-3.1 3.8-3.2-3.8H3.5z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
            <text x="16" y="13.7" text-anchor="middle" fill="currentColor" font-size="8.5" font-weight="800" font-family="Arial, sans-serif" letter-spacing="-.4">blog</text>
          </svg>
          네이버 블로그
        </a>
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="about-cta about-cta-instagram"
        >
          <svg class="about-cta-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="17.5" cy="6.8" r="1.2" fill="currentColor" />
          </svg>
          인스타그램
        </a>
        <a href={`mailto:${EMAIL}`} class="about-cta about-cta-solid">
          <svg class="about-cta-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="m4.5 7 7.5 6 7.5-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          이메일 보내기
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .about-hero-grid { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:clamp(40px,7vw,112px); }
  .about-kicker,.about-track-label { font-size:11px; font-weight:600; letter-spacing:.16em; color:var(--bbfc-blue); }
  .about-skill { font-size:13px; color:var(--bbfc-gray-1); background:rgba(255,255,255,.82); border:1px solid var(--bbfc-border); padding:7px 12px; border-radius:999px; }
  .about-hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin-top:28px; }
  .about-hero-action {
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:7px;
    min-height:42px;
    padding:10px 15px;
    border:1px solid var(--bbfc-border);
    border-radius:var(--bbfc-radius);
    color:var(--bbfc-ink-2);
    background:var(--bbfc-bg);
    font-size:13px;
    font-weight:500;
    transition:border-color .2s ease, background .2s ease, color .2s ease, transform .2s ease;
  }
  .about-hero-action:hover { border-color:var(--bbfc-blue); color:var(--bbfc-blue); transform:translateY(-1px); }
  .about-hero-action-primary { border-color:var(--bbfc-blue); background:var(--bbfc-blue); color:var(--bbfc-bg); }
  .about-hero-action-primary:hover { border-color:var(--bbfc-blue-strong); background:var(--bbfc-blue-strong); color:var(--bbfc-bg); }
  .about-hero-action:focus-visible,
  .about-channel-card:focus-visible,
  .about-record-card-inner:focus-visible { outline:3px solid var(--bbfc-blue); outline-offset:3px; }

  .about-identity-hub {
    scroll-margin-top:80px;
    margin:0 0 32px;
    padding:clamp(28px,5vw,52px);
    border:1px solid var(--bbfc-border);
    border-radius:20px;
    background:var(--bbfc-fill-2);
  }
  .about-identity-hub-lower { margin-top:clamp(56px,8vw,80px); }
  .about-section-intro { max-width:740px; }
  .about-identity-hub-lower .about-section-intro { max-width:none; }
  .about-section-title { margin-top:8px; color:var(--bbfc-ink); font-size:clamp(24px,3.2vw,32px); font-weight:500; line-height:1.35; letter-spacing:-.03em; }
  .about-section-description { margin-top:13px; color:var(--bbfc-gray-1); font-size:15px; line-height:1.75; }
  .about-channel-card {
    position:relative;
    display:grid;
    grid-template-columns:auto minmax(0,1fr) auto;
