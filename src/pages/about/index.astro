---
import { site } from '../../config/site';
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="소개"
  description={`${site.fullName} — 운영자 소개, 이력, 포트폴리오, 연락처`}
  breadcrumbs={[
    { label: '홈', href: '/' },
    { label: '소개', href: '/about/' },
  ]}
>
  <div class="max-w-[680px] mx-auto px-4 py-10">
    <p class="text-[11px] tracking-wide text-[var(--bbfc-blue)] font-medium">ABOUT</p>
    <h1 class="text-[24px] font-medium text-[var(--bbfc-ink)] mt-1">{site.fullName}</h1>
    <p class="text-[14px] text-[var(--bbfc-gray-1)] mt-2 leading-[1.7]">{site.tagline}</p>

    <!-- ⬇ 여기부터 운영자가 내용을 채우는 영역. 구조는 유지하고 문단만 교체하세요. -->

    <section class="mt-10">
      <h2 class="text-[18px] font-medium text-[var(--bbfc-ink)] border-b border-[var(--bbfc-border)] pb-2">저자 소개</h2>
      <p class="text-[15px] leading-[1.7] text-[var(--bbfc-ink-2)] mt-4">
        (운영자 소개 원고 자리 — 삥이/박성호, 네이버 프로스포츠 인플루언서, 유럽축구 저술 1,000편+ 등)
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-[18px] font-medium text-[var(--bbfc-ink)] border-b border-[var(--bbfc-border)] pb-2">이력 · 포트폴리오</h2>
      <p class="text-[15px] leading-[1.7] text-[var(--bbfc-ink-2)] mt-4">
        (경력·저술·프로젝트 목록 자리 — 운영자 원고 대기)
      </p>
    </section>

    <section class="mt-10 mb-4 bg-[var(--bbfc-blue-weak)] rounded-[12px] p-6">
      <h2 class="text-[16px] font-medium text-[var(--bbfc-ink)]">함께 일하고 싶다면</h2>
      <p class="text-[14px] leading-[1.7] text-[var(--bbfc-gray-1)] mt-2">
        (제휴·기고·강연·광고 기획 문의 안내 문구 자리)
      </p>
      <a href="mailto:contact@example.com"
         class="inline-block mt-4 bg-[var(--bbfc-blue)] text-white text-[13px] font-medium px-5 py-2.5 rounded-[8px]">
        문의하기
      </a>
      <p class="text-[11px] text-[var(--bbfc-gray-2)] mt-2">※ mailto 주소는 운영자 확정 후 교체</p>
    </section>
  </div>
</Layout>
