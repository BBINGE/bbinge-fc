---

<Layout
  title="소개"
  description={`${site.fullName} — 박성호(삥이) 공식 소개`}
  breadcrumbs={[
    { label: '홈', href: '/' },
    { label: '소개', href: '/about/' },
  ]}
>
  <!-- 섹션 1 — 히어로 -->
  <section class="relative overflow-hidden">
    <p
      id="about-watermark"
      aria-hidden="true"
      class="pointer-events-none select-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 font-medium whitespace-nowrap"
      style="font-size:clamp(56px,13vw,200px); color:var(--bbfc-blue); opacity:0.1; line-height:1;"
    >
      @삥이
    </p>
    <div class="relative max-w-[1200px] mx-auto px-5 md:px-8 pt-16 pb-16 md:pt-24 md:pb-24">
      <div class="about-hero-grid">
        <div class="about-hero-copy order-2 md:order-1">
          <p data-reveal class="about-kicker">PARK SEONGHO · BBINGE</p>
          <div class="mt-5 md:mt-7 max-w-[720px]">
            <p data-reveal class="text-[25px] md:text-[40px] font-medium leading-[1.35] text-[var(--bbfc-ink)] tracking-[-0.035em]">
              기획자 박성호. 온라인에서는 삥이로 씁니다.
            </p>
            <p data-reveal style="transition-delay:80ms" class="mt-3 text-[17px] md:text-[21px] leading-[1.7] text-[var(--bbfc-gray-1)]">
              광고·브랜딩이 업이고, 축구사(史) 저술이 오래된 일입니다.
            </p>
          </div>

          <div data-reveal style="transition-delay:140ms" class="mt-9 md:mt-12">
            <p class="text-[11px] tracking-[0.16em] text-[var(--bbfc-gray-2)] font-medium">SKILL</p>
            <div class="flex flex-wrap gap-2 mt-3">
              {skills.map((s) => <span class="about-skill">{s}</span>)}
            </div>
          </div>
        </div>
        <div data-reveal class="order-1 md:order-2 md:justify-self-end">
          <div class="about-photo-frame w-[176px] h-[208px] md:w-[300px] md:h-[360px]">
            <img
              src="/images/profile-bbinge.png"
              alt="박성호(삥이) 프로필"
              width="300"
              height="360"
              loading="eager"
              fetchpriority="high"
              class="about-photo"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-[1200px] mx-auto px-5 md:px-8">
    <!-- 섹션 2 — 저자의 편지 -->
    <section class="mt-6 md:mt-10" aria-labelledby="football-letter-title">
      <article data-reveal class="about-letter">
        <img
          src="/images/about-world-cup-trophy.webp"
          alt=""
          aria-hidden="true"
          class="about-letter-trophy"
          loading="lazy"
          decoding="async"
        />
        <div class="about-letter-head">
          <p class="about-letter-kicker">A LETTER FROM BBINGE</p>
          <span aria-hidden="true" class="about-letter-mark">BBINGE FC · 01</span>
        </div>

        <h2 id="football-letter-title" class="about-letter-title">나는 왜 축구를 쓰는가</h2>

        <div class="about-letter-body">
          {footballLetter.map((paragraph) => (
            <p>
              {'text' in paragraph ? paragraph.text : (
                <>{paragraph.before}<strong>{paragraph.strong}</strong>{paragraph.after}</>
              )}
            </p>
          ))}
        </div>

        <footer class="about-letter-signature">
          <span class="about-letter-signature-line" aria-hidden="true"></span>
          <p>삥이, 박성호</p>
        </footer>
      </article>
    </section>

    <!-- 섹션 3 — 이력 -->
    <section class="mt-14 md:mt-20">
      <h2 data-reveal class="about-h2">이력</h2>
      <div class="about-career-grid mt-7">
      <div><p class="about-track-label">MEDIA · WRITING</p><ul class="mt-3">
        {careerTrack1.map((c, i) => (
          <li
            data-reveal
            style={`transition-delay:${i * 60}ms`}
            class="flex items-start gap-4 py-3 border-b border-[var(--bbfc-line)]"
          >
            <span
              class:list={[
                'shrink-0 text-[11px] font-medium px-2 py-0.5 rounded-[4px] mt-0.5',
                c.label === '現'
                  ? 'text-[var(--bbfc-blue)] bg-[var(--bbfc-blue-weak)]'
                  : 'text-[var(--bbfc-gray-2)] bg-[var(--bbfc-fill)]',
              ]}
            >
              {c.label}
            </span>
            <span class="text-[15px] md:text-[16px] leading-[1.6] text-[var(--bbfc-ink-2)]">{c.text}</span>
          </li>
        ))}
      </ul></div>
      <div><p class="about-track-label">PLANNING · BUSINESS</p><ul class="mt-3">
        {careerTrack2.map((c, i) => (
          <li
            data-reveal
            style={`transition-delay:${i * 60}ms`}
            class="flex items-start gap-4 py-3 border-b border-[var(--bbfc-line)] last:border-b-0"
          >
            <span
              class:list={[
                'shrink-0 text-[11px] font-medium px-2 py-0.5 rounded-[4px] mt-0.5',
                c.label === '現'
                  ? 'text-[var(--bbfc-blue)] bg-[var(--bbfc-blue-weak)]'
                  : 'text-[var(--bbfc-gray-2)] bg-[var(--bbfc-fill)]',
              ]}
            >
              {c.label}
            </span>
            <span class="text-[15px] md:text-[16px] leading-[1.6] text-[var(--bbfc-ink-2)]">{c.text}</span>
          </li>
        ))}
      </ul></div></div>
    </section>

    <!-- 섹션 3 — 온라인 권위 -->
    <section class="mt-14 md:mt-20">
      <h2 data-reveal class="about-h2">온라인 권위</h2>
      <ul class="about-authority-grid mt-7">
        {authority.map((a, i) => (
          <li data-reveal style={`transition-delay:${(i % 4) * 60}ms`} class="about-link-row">
            <span class="about-link-row-inner">
              <span class="about-logo-stack">
                {a.logos.map((logo) => (
                  <span class:list={['about-brand-mark', `is-${logo.fit}`]}>
                    <img src={logo.src} alt={logo.alt} width="48" height="48" />
                  </span>
                ))}
              </span>
              <span class="text-[14px] md:text-[15px] leading-[1.6] text-[var(--bbfc-ink-2)]">{a.text}</span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <!-- 섹션 4 — 주요 의뢰인 / 성과 -->
    <section class="mt-14 md:mt-20">
      <h2 data-reveal class="about-h2">주요 의뢰인 · 성과</h2>
      <div class="about-clients-panel columns-1 md:columns-2 gap-x-12 mt-7">
        {clients.map((c, gi) => (
          <div data-reveal style={`transition-delay:${(gi % 4) * 80}ms`} class="break-inside-avoid mb-8">
            <p class="text-[11px] tracking-wide text-[var(--bbfc-blue)] font-medium">{c.group}</p>
            <ul class="mt-2">
              {c.items.map((item) => (
                <li class="about-client-row">
                  <span class="text-[14px] md:text-[15px] leading-[1.7] text-[var(--bbfc-ink)]">{item.org}</span>
                  <span class="text-[13px] md:text-[14px] leading-[1.7] text-[var(--bbfc-gray-1)]"> — {item.detail}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- 섹션 5 — 연락처 -->
    <section data-reveal class="about-contact mt-14 md:mt-24 mb-16 md:mb-24">
      <div><p class="about-kicker">CONTACT</p><h2 class="mt-2 text-[22px] md:text-[28px] font-medium text-[var(--bbfc-ink)]">연락은 이곳으로.</h2></div>
      <div class="flex flex-wrap gap-3 mt-5 md:mt-0">
        <a
          href={NAVER_BLOG_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="about-cta about-cta-naver"
        >
          <svg class="about-cta-icon about-cta-icon-blog" viewBox="0 0 32 24" aria-hidden="true">
            <path d="M3.5 2.5h25v15.2H18l-3.1 3.8-3.2-3.8H3.5z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
            <text x="16" y="13.7" text-anchor="middle" fill="currentColor" font-size="8.5" font-weight="800" font-family="Arial, sans-serif" letter-spacing="-.4">blog</text>
          </svg>
          네이버 블로그
        </a>
        <a
          href={INSTAGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="about-cta about-cta-instagram"
        >
          <svg class="about-cta-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="17.5" cy="6.8" r="1.2" fill="currentColor" />
          </svg>
          인스타그램
        </a>
        <a href={`mailto:${EMAIL}`} class="about-cta about-cta-solid">
          <svg class="about-cta-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="m4.5 7 7.5 6 7.5-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          이메일 보내기
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .about-hero-grid { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:clamp(40px,7vw,112px); }
  .about-kicker,.about-track-label { font-size:11px; font-weight:600; letter-spacing:.16em; color:var(--bbfc-blue); }
  .about-skill { font-size:13px; color:var(--bbfc-gray-1); background:rgba(255,255,255,.82); border:1px solid var(--bbfc-border); padding:7px 12px; border-radius:999px; }
  .about-letter {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--bbfc-border);
    border-radius: 4px;
    background: var(--bbfc-bg);
    padding: clamp(30px, 6vw, 64px) clamp(28px, 8vw, 88px);
    box-shadow: 0 28px 70px -58px rgba(25, 31, 40, .55);
  }
  .about-letter::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: clamp(14px, 3vw, 28px);
    width: 2px;
    background: var(--bbfc-blue);
    opacity: .52;
  }
  .about-letter::after {
    content: '“';
    position: absolute;
    right: clamp(20px, 4vw, 44px);
    bottom: -44px;
    color: var(--bbfc-blue-weak);
    font-family: Georgia, serif;
    font-size: clamp(150px, 20vw, 240px);
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }
  .about-letter-trophy {
    position: absolute;
    z-index: 0;
    top: 180px;
    right: -15%;
    width: min(58%, 480px);
    height: auto;
    opacity: .1;
    pointer-events: none;
    user-select: none;
  }
  .about-letter-head { position:relative; z-index:1; display:flex; align-items:center; justify-content:space-between; gap:20px; }
  .about-letter-kicker { color:var(--bbfc-blue); font-size:10px; font-weight:600; letter-spacing:.17em; }
  .about-letter-mark { color:var(--bbfc-gray-3); font-size:9px; letter-spacing:.14em; white-space:nowrap; }
  .about-letter-title { position:relative; z-index:1; margin-top:26px; color:var(--bbfc-ink); font-size:clamp(25px,4vw,36px); font-weight:500; line-height:1.35; letter-spacing:-.035em; }
  .about-letter-body { position:relative; z-index:1; min-height:132px; margin-top:30px; }
  .about-letter-body p { max-width:610px; color:var(--bbfc-ink-2); font-size:clamp(15px,2vw,17px); line-height:1.95; letter-spacing:-.012em; }
  .about-letter-body strong { color:var(--bbfc-ink); font-weight:650; }
  .about-letter-body p + p { margin-top:20px; }
  .about-letter-placeholder { color:var(--bbfc-gray-2) !important; }
  .about-letter-signature { position:relative; z-index:1; display:flex; align-items:center; justify-content:flex-end; gap:14px; margin-top:28px; color:var(--bbfc-gray-1); font-size:13px; }
  .about-letter-signature-line { width:48px; height:1px; background:var(--bbfc-border); }
  .about-career-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(36px,7vw,96px); }
  .about-authority-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
  .about-clients-panel { background:var(--bbfc-fill-2); border:1px solid var(--bbfc-border); border-radius:16px; padding:clamp(24px,4vw,48px); }
  .about-contact { display:flex; align-items:center; justify-content:space-between; gap:28px; background:var(--bbfc-fill-2); border-top:1px solid var(--bbfc-border); border-bottom:1px solid var(--bbfc-border); padding:36px clamp(20px,4vw,48px); }
  .about-h2 {
    display: inline-block;
    position: relative;
    font-size: 18px;
    font-weight: 500;
    color: var(--bbfc-ink);
    padding-bottom: 10px;
  }
  .about-h2::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: var(--bbfc-blue);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
  }
  .about-h2.is-visible::after {
    transform: scaleX(1);
  }

  .about-photo-frame {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% 82%, 82% 100%, 0 100%);
    box-shadow: 0 0 0 1px var(--bbfc-border), 0 20px 40px -20px rgba(25, 31, 40, 0.25);
  }
  .about-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.001);
    transition: transform 0.5s ease;
  }
  .about-photo-frame:hover .about-photo {
    transform: scale(1.05);
  }

  .about-link-row {
    border: 1px solid var(--bbfc-border);
    border-radius: 12px;
    background:#fff;
  }
  .about-link-row-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    position: relative;
    min-height:76px;
    padding:14px 16px;
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  .about-logo-stack { display:flex; align-items:center; flex:0 0 auto; min-width:48px; }
  .about-brand-mark { width:48px; height:48px; display:inline-flex; align-items:center; justify-content:center; overflow:hidden; border-radius:50%; background:#fff; border:1px solid var(--bbfc-border); box-shadow:0 4px 14px -10px rgba(25,31,40,.55); flex:0 0 auto; }
  .about-brand-mark img { width:100%; height:100%; object-fit:contain; display:block; }
  .about-brand-mark.is-flush img { object-fit:cover; }
  .about-brand-mark.is-padded img { width:68%; height:68%; }
  .about-brand-mark.is-padded-dark { background:#24272d; }
  .about-brand-mark.is-padded-dark img { width:72%; height:72%; }
  .about-link-row:hover .about-link-row-inner { transform:translateY(-2px); box-shadow:0 12px 28px -22px rgba(25,31,40,.5); border-color:#cad1d8; }
  .about-link-icon {
    flex-shrink: 0;
    transition: color 0.25s ease;
  }

  .about-client-row {
    padding: 6px 0;
    border-bottom: 1px solid var(--bbfc-line);
  }
  .about-client-row:last-child {
    border-bottom: none;
  }

  .about-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--bbfc-ink-2);
    background: var(--bbfc-fill);
    transition: background 0.2s ease, color 0.2s ease;
    gap: 8px;
  }
  .about-cta-icon { width:18px; height:18px; flex:0 0 auto; display:block; color:currentColor; }
  .about-cta-icon-blog { width:23px; height:18px; }
  .about-cta:hover {
    background: var(--bbfc-blue-weak);
    color: var(--bbfc-blue);
  }
  .about-cta-naver { background:#03c75a; color:#fff; }
  .about-cta-naver:hover { background:#02b351; color:#fff; }
  .about-cta-instagram { color:#fff; background:linear-gradient(110deg,#833ab4,#fd1d1d,#fcb045); }
  .about-cta-instagram:hover { color:#fff; filter:saturate(.85) brightness(.96); }
  .about-cta-solid {
    background: var(--bbfc-blue);
    color: #fff;
  }
  .about-cta-solid:hover {
    background: var(--bbfc-blue-strong);
    color: #fff;
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 767px) {
    .about-hero-grid,.about-career-grid,.about-authority-grid { grid-template-columns:1fr; }
    .about-hero-grid { gap:32px; }
    .about-photo-frame { margin:0 auto; }
    .about-contact { display:block; }
    .about-authority-grid { gap:9px; }
    .about-link-row-inner { min-height:76px; padding:12px 13px; }
    .about-brand-mark { width:44px; height:44px; }
    .about-logo-stack { min-width:44px; }
    .about-letter { padding-left:40px; }
    .about-letter::before { left:18px; }
    .about-letter-head { align-items:flex-start; }
    .about-letter-mark { white-space:normal; text-align:right; }
    .about-letter-body { min-height:112px; margin-top:24px; }
    .about-letter-trophy { top:240px; right:-34%; width:86%; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .about-h2::after {
      transform: scaleX(1);
      transition: none;
    }
    .about-photo-frame:hover .about-photo {
      transform: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    const revealTargets = document.querySelectorAll('[data-reveal], .about-h2');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
    );
    revealTargets.forEach((el) => observer.observe(el));

    const watermark = document.getElementById('about-watermark');
    if (watermark) {
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const offset = window.scrollY * 0.08;
          watermark.style.transform = `translate(-50%, calc(-50% + ${offset}px))`;
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  } else {
    document.querySelectorAll('[data-reveal], .about-h2').forEach((el) => el.classList.add('is-visible'));
  }
</script>
