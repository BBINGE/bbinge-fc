---
import Layout from '../../layouts/Layout.astro';
import StoreFloorIcon from '../../components/StoreFloorIcon.astro';
import { site } from '../../config/site';
import { storeFloors as floors } from '../../config/store';

const description = '서울 강남을 배경으로 설계한 삥이FC의 가상 백화점, PB 온라인 본점의 1층부터 옥상까지 층별 안내.';
const storeSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'PB 온라인 본점 층별 안내',
  url: `${site.url}/about/store/`,
  description,
};
---

<Layout
  title="층별 안내 | PB 온라인 본점"
  description={description}
  ogImage="/images/about/pb-online-main-seoul.webp"
  ogImageAlt="서울 강남을 배경으로 설계한 PB 온라인 본점 콘셉트 건축물"
  ogImageWidth={1428}
  ogImageHeight={1072}
  adsEligible={false}
  bodyClass="pb-store-page"
  breadcrumbs={[
    { label: '홈', href: '/' },
    { label: '저자 @삥이', href: '/about/' },
    { label: '층별 안내', href: '/about/store/' },
  ]}
  extraSchema={storeSchema}
>
  <article class="store" data-store>
    <div class="scroll-meter" aria-hidden="true"><i></i></div>

    <header class="store-hero">
      <div class="hero-copy">
        <p class="store-kicker"><span>PB</span> ONLINE FLAGSHIP · SEOUL</p>
        <h1>층별 안내<br /><em>PB 온라인 본점</em></h1>
        <p class="hero-lead">축구를 입고, 걷고, 읽고, 보고, 노는 열 개의 층.<br />서로 다른 삥이FC의 세계를 한 건물에 담았습니다.</p>
        <a class="explore-cta" href="#directory">
          <span>엘리베이터 타기</span>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v13m0 0 5-5m-5 5-5-5" /></svg>
        </a>
      </div>

      <div class="building-wrap" data-building>
        <div class="building-light" aria-hidden="true"></div>
        <figure class="building-card">
          <span class="building-image-frame">
            <img
              src="/images/about/pb-online-main-seoul.webp"
              width="1428"
              height="1072"
              alt="테헤란로 풍경 속 PB 온라인 본점 콘셉트 건축물"
              fetchpriority="high"
              decoding="async"
            />
          </span>
          <nav class="hero-elevator" aria-label="PB 온라인 본점 빠른 층 선택">
            <span class="elevator-brand"><b>PB</b><small>FLOOR</small></span>
            {floors.map((item) => (
              <a href={`#floor-${item.floor}`} aria-label={`${item.floor}층 ${item.name} 안내로 이동`}>
                <span>{item.floor}</span><i aria-hidden="true"></i><small>{item.name}</small>
              </a>
            ))}
          </nav>
          <figcaption><span>CONCEPT ARCHITECTURE · 2026</span><b>SEOUL, GANGNAM</b></figcaption>
        </figure>
      </div>

      <p class="concept-note">서울 강남을 배경으로 설계한 PB 온라인 본점의 콘셉트 아키텍처입니다. 실제 오프라인 매장이 아닙니다.</p>
    </header>

    <section class="directory" id="directory" aria-labelledby="directory-title">
      <header class="directory-head">
        <p>PB DEPARTMENT DIRECTORY</p>
        <h2 id="directory-title"><span>오늘은</span><span>몇 층으로 갈까요?</span></h2>
        <span>층을 고르면 각 공간의 안내와 현재 입점 상태를 확인할 수 있습니다.</span>
        <div class="active-floor" data-active-floor aria-hidden="true">
          <span><b>10</b><small>F</small></span>
          <em data-active-name>옥상</em>
        </div>
      </header>

      <div class="floor-list">
        {floors.map((item, index) => (
          <div
            id={`floor-${item.floor}`}
            class:list={['floor', !item.href && 'floor--waiting', 'split' in item && item.split && 'floor--split']}
            data-floor
            data-floor-number={item.floor}
            data-floor-name={item.name}
            style={`--delay:${index * 35}ms`}
          >
            <span class="floor-number">{item.floor}<small>F</small></span>
            <StoreFloorIcon name={item.icon} />
            <span class="floor-name">
              {item.href && !('split' in item && item.split) ? (
                <a class="floor-title" href={item.href}><b>{item.name}</b><small>{item.en}</small></a>
              ) : (
                <span class="floor-title"><b>{item.name}</b><small>{item.en}</small></span>
              )}
              {!('split' in item && item.split) && (
                <span class="floor-zones">
                  {item.zones.map((zone) => zone.href ? <a href={zone.href}>{zone.label}</a> : <i>{zone.label}</i>)}
                </span>
              )}
            </span>
            <span class="floor-copy">{item.copy}</span>
            {'split' in item && item.split ? (
              <span class="floor-actions" role="group" aria-label={`${item.floor}층 입점 공간`}>
                {item.zones.map((zone) => zone.href && (
                  <a class="floor-action" href={zone.href} aria-label={`${item.floor}층 ${zone.label}로 이동`}>
                    <span>{zone.label}</span><i aria-hidden="true">↗</i>
                  </a>
                ))}
              </span>
            ) : item.href ? (
              <a class="floor-arrow" href={item.href} aria-label={`${item.floor}층 ${item.name} 안내로 이동`}><span>입장</span><i aria-hidden="true">↗</i></a>
            ) : (
              <span class="waiting-light" aria-label="입점 대기중"><i></i>WAITING</span>
            )}
          </div>
        ))}
      </div>
    </section>

    <footer class="store-footer">
      <p><span>PB</span> | BBingeFC</p>
      <strong>축구의 역사를 놀고, 읽고, 걷는 곳.</strong>
      <a class="logo-story-cta" href="/about/logo/">
        <span><small>PB BRAND IDENTITY</small><b>PB 로고 이야기</b><em>P와 B, 하나의 저자명</em></span>
        <i aria-hidden="true">↗</i>
      </a>
    </footer>
  </article>
</Layout>

<style>
  :global(html){scroll-behavior:smooth}
  :global(body.pb-store-page){background:#07090d}
  :global(body.pb-store-page>footer){margin-top:0;border-color:rgba(255,255,255,.11);background:#07090d;color:#f7f8fa}
  :global(body.pb-store-page>footer>div){border-top:1px solid rgba(217,182,91,.18)}
  :global(body.pb-store-page>footer a){color:rgba(247,248,250,.7)}
  :global(body.pb-store-page>footer a:hover){color:#f0d998}
  :global(body.pb-store-page>footer p){color:rgba(247,248,250,.47)}
  :global(body.pb-store-page>footer .footer-label){color:#82c7ff}
  :global(body.pb-store-page>footer div[class*="border-t"]){border-color:rgba(255,255,255,.11)}
  .store{--gold:#d9b65b;--gold-soft:#f0d998;--sky:#82c7ff;--night:#07090d;--white:#f7f8fa;--hero-scroll:0;position:relative;overflow:clip;background:var(--night);color:var(--white);isolation:isolate}
  .store::before{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(circle at 82% 5%,rgba(130,199,255,.09),transparent 24%),linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:auto,72px 72px,72px 72px;mask-image:linear-gradient(to bottom,#000 0,transparent 74%)}
  .scroll-meter{position:fixed;right:14px;top:90px;bottom:28px;z-index:20;width:1px;background:rgba(255,255,255,.12);pointer-events:none}.scroll-meter i{display:block;width:1px;height:var(--scroll-progress,0%);background:linear-gradient(var(--sky),var(--gold));box-shadow:0 0 12px rgba(130,199,255,.65)}
  .store-hero{position:relative;display:grid;grid-template-columns:minmax(260px,.68fr) minmax(0,1.32fr);align-items:center;gap:clamp(32px,5vw,88px);min-height:calc(100svh - 64px);max-width:1440px;margin:0 auto;padding:clamp(60px,8vw,120px) clamp(20px,4.5vw,72px) 46px}
  .hero-copy{position:relative;z-index:2;opacity:calc(1 - var(--hero-scroll)*.56);transform:translate3d(0,calc(var(--hero-scroll)*-42px),0);will-change:transform,opacity}.store-kicker{display:flex;align-items:center;gap:9px;color:var(--sky);font-size:10px;font-weight:600;letter-spacing:.19em}.store-kicker span{display:grid;place-items:center;width:31px;height:31px;border:1px solid rgba(217,182,91,.62);border-radius:50%;color:var(--gold-soft);font-size:11px;letter-spacing:0}
  .hero-copy h1{margin-top:26px;font-size:clamp(42px,4.65vw,72px);font-weight:500;line-height:.98;letter-spacing:-.065em}.hero-copy h1 em{display:block;margin-top:13px;color:var(--gold-soft);font-style:normal}.hero-lead{margin-top:31px;color:rgba(247,248,250,.72);font-size:clamp(15px,1.35vw,18px);line-height:1.85;word-break:keep-all}
  .explore-cta{display:inline-flex;align-items:center;gap:17px;margin-top:40px;padding:13px 18px 13px 20px;border:1px solid rgba(217,182,91,.5);border-radius:999px;color:var(--gold-soft);font-size:13px;transition:background .25s ease,color .25s ease,transform .25s ease,box-shadow .25s ease}.explore-cta svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.4}.explore-cta:hover,.explore-cta:focus-visible{background:var(--gold);color:#080a0e;outline:none;transform:translateY(-3px);box-shadow:0 14px 35px rgba(217,182,91,.18)}
  .building-wrap{position:relative;perspective:1400px;--rx:0deg;--ry:0deg;--mx:50%;--my:50%;transform:translate3d(0,calc(var(--hero-scroll)*34px),0) scale(calc(1 - var(--hero-scroll)*.035));transform-origin:center 35%;will-change:transform}.building-light{position:absolute;inset:-15%;z-index:2;background:radial-gradient(circle at var(--mx) var(--my),rgba(255,231,163,.2),transparent 23%);mix-blend-mode:screen;pointer-events:none}.building-card{position:relative;overflow:visible;transform:rotateX(var(--rx)) rotateY(var(--ry));transform-style:preserve-3d;transition:transform .18s ease-out}.building-image-frame{position:relative;display:block;overflow:hidden;border:1px solid rgba(217,182,91,.35);border-radius:3px;background:#111;box-shadow:0 40px 90px rgba(0,0,0,.52),0 0 0 1px rgba(255,255,255,.035) inset}.building-image-frame::after{content:"";position:absolute;inset:0;z-index:4;background:linear-gradient(115deg,transparent 28%,rgba(255,255,255,.12) 42%,transparent 55%);transform:translateX(-130%);transition:transform .8s cubic-bezier(.2,.7,.2,1);pointer-events:none}.building-wrap:hover .building-image-frame::after{transform:translateX(130%)}.building-image-frame>img{display:block;width:112%;max-width:none;height:auto;filter:saturate(.82) brightness(.82);transform:translateX(-10.5%)}.building-card figcaption{position:absolute;z-index:5;left:0;right:0;bottom:0;display:flex;justify-content:space-between;gap:20px;padding:42px 18px 14px;background:linear-gradient(transparent,rgba(3,5,8,.9));font-size:8px;letter-spacing:.14em;pointer-events:none}.building-card figcaption span{color:rgba(255,255,255,.68)}.building-card figcaption b{color:var(--gold-soft);font-weight:500}
  .hero-elevator{position:absolute;z-index:6;top:6%;right:-5%;bottom:10%;display:grid;grid-template-rows:auto repeat(10,1fr);width:42%;min-width:240px;padding:16px 18px 18px;border:1px solid rgba(217,182,91,.52);background:rgba(5,8,13,.52);box-shadow:0 20px 42px rgba(0,0,0,.35);backdrop-filter:blur(4px)}.elevator-brand{display:flex;align-items:baseline;justify-content:space-between;padding:0 2px 10px;border-bottom:1px solid rgba(217,182,91,.34)}.elevator-brand b{color:var(--gold-soft);font:500 21px Georgia,serif}.elevator-brand small{color:var(--sky);font-size:8px;letter-spacing:.2em}.hero-elevator>a{display:grid;grid-template-columns:32px 1fr minmax(0,134px);align-items:center;gap:10px;border-bottom:1px solid rgba(255,255,255,.09);color:rgba(255,255,255,.88);transition:color .2s ease,background .2s ease,padding .2s ease}.hero-elevator>a:hover,.hero-elevator>a:focus-visible{padding-left:6px;background:rgba(217,182,91,.1);color:var(--gold-soft);outline:none}.hero-elevator>a>span{font-size:14px;font-weight:600}.hero-elevator>a>i{height:1px;background:rgba(217,182,91,.28)}.hero-elevator>a>small{overflow:hidden;font-size:11px;font-weight:600;line-height:1.2;letter-spacing:.01em;text-align:right;text-overflow:ellipsis;white-space:nowrap}
  .concept-note{grid-column:1/-1;justify-self:end;max-width:630px;margin-top:8px;color:rgba(255,255,255,.38);font-size:10px;line-height:1.65;text-align:right}
  .directory{display:grid;grid-template-columns:340px minmax(0,1fr);gap:clamp(45px,6vw,90px);max-width:1280px;margin:0 auto;padding:140px clamp(20px,4.5vw,72px) 170px}.directory-head{position:sticky;top:88px;z-index:2;align-self:start;height:max-content}.directory-head>p{color:var(--sky);font-size:9px;font-weight:600;letter-spacing:.2em}.directory-head h2{margin-top:25px;color:var(--white);font-size:clamp(36px,3.7vw,52px);font-weight:500;line-height:1.12;letter-spacing:-.055em}.directory-head h2 span{display:block;white-space:nowrap}.directory-head>span{display:block;max-width:310px;margin-top:27px;color:rgba(255,255,255,.52);font-size:14px;line-height:1.7}
  .active-floor{margin-top:50px;color:rgba(217,182,91,.12);transition:color .35s ease,transform .5s cubic-bezier(.2,.75,.2,1)}.active-floor>span{display:flex;align-items:flex-start;line-height:.75}.active-floor.is-changing{color:rgba(217,182,91,.3);transform:translateX(8px)}.active-floor b{font-size:clamp(78px,10vw,132px);font-weight:400;letter-spacing:-.09em}.active-floor small{margin:3px 0 0 8px;color:var(--sky);font-size:16px;font-weight:600;letter-spacing:.1em}.active-floor em{display:block;margin-top:15px;color:rgba(255,255,255,.58);font-size:14px;font-style:normal;letter-spacing:.1em}
  .floor-list{border-top:1px solid rgba(217,182,91,.35)}.floor{--pointer-x:50%;position:relative;display:grid;grid-template-columns:86px 62px minmax(180px,.85fr) minmax(190px,1fr) 72px;align-items:center;gap:18px;min-height:136px;border-bottom:1px solid rgba(255,255,255,.11);color:var(--white);opacity:.62;transform:translateY(24px);transition:opacity .65s ease var(--delay),transform .65s ease var(--delay),background .25s ease,padding .25s ease}.floor--split{grid-template-columns:86px 62px minmax(180px,.85fr) minmax(155px,1fr) 132px}.floor::after{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(circle at var(--pointer-x) 50%,rgba(130,199,255,.11),transparent 30%);opacity:0;transition:opacity .25s ease}.floor::before{content:"";position:absolute;left:-1px;top:50%;width:2px;height:0;background:linear-gradient(var(--sky),var(--gold));box-shadow:0 0 18px rgba(130,199,255,.5);transform:translateY(-50%);transition:height .35s ease}.floor.is-visible{opacity:1;transform:none}.floor.is-active{background:linear-gradient(90deg,rgba(217,182,91,.08),transparent);opacity:1}.floor.is-active::before{height:58%}.floor:hover,.floor:focus-within{padding-left:12px;padding-right:10px;background:linear-gradient(90deg,rgba(217,182,91,.1),rgba(130,199,255,.045));outline:none}.floor:hover::after,.floor:focus-within::after{opacity:1}.floor--waiting{cursor:default}.floor-number{color:var(--gold-soft);font-size:42px;font-weight:400;letter-spacing:-.04em;white-space:nowrap}.floor-number small{margin-left:4px;font-size:13px;font-weight:600;color:var(--gold);letter-spacing:0}.floor-title{display:block;color:var(--white)}.floor-title:focus-visible{outline:1px solid var(--sky);outline-offset:4px}.floor-title b,.floor-title small{display:block}.floor-title b{font-size:20px;font-weight:500}.floor-title small{margin-top:6px;color:var(--sky);font-size:10px;font-weight:600;letter-spacing:.09em}.floor-zones{display:flex;flex-wrap:wrap;gap:6px;margin-top:13px}.floor-zones a,.floor-zones i{padding:5px 8px;border:1px solid rgba(255,255,255,.16);border-radius:999px;color:rgba(255,255,255,.64);font-size:9px;font-style:normal;letter-spacing:.03em}.floor-zones a{transition:border-color .2s ease,color .2s ease,background .2s ease}.floor-zones a:hover,.floor-zones a:focus-visible{border-color:rgba(240,217,152,.68);background:rgba(217,182,91,.1);color:var(--gold-soft);outline:none}.floor-copy{color:rgba(255,255,255,.68);font-size:14px;line-height:1.62;word-break:keep-all}.floor-arrow{display:flex;align-items:center;justify-content:center;gap:7px;min-width:72px;min-height:38px;padding:8px 11px;border:1px solid rgba(217,182,91,.55);border-radius:999px;background:rgba(217,182,91,.1);color:var(--gold-soft);font-size:11px;font-weight:600;white-space:nowrap;box-shadow:0 0 18px rgba(217,182,91,.06);transition:background .2s ease,color .2s ease,border-color .2s ease,transform .2s ease,box-shadow .2s ease}.floor-arrow i{font-size:15px;font-style:normal;transition:transform .2s ease}.floor-arrow:focus-visible{outline:2px solid var(--sky);outline-offset:3px}.floor:hover .floor-arrow,.floor:focus-within .floor-arrow{border-color:var(--gold-soft);background:var(--gold);color:#07090d;box-shadow:0 8px 22px rgba(217,182,91,.18);transform:translateX(3px)}.floor:hover .floor-arrow i,.floor:focus-within .floor-arrow i{transform:rotate(45deg)}.floor-actions{display:grid;gap:8px}.floor-action{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:36px;padding:8px 11px;border:1px solid rgba(217,182,91,.52);border-radius:999px;background:rgba(217,182,91,.085);color:rgba(255,255,255,.9);font-size:11px;font-weight:600;line-height:1;white-space:nowrap;box-shadow:0 0 18px rgba(217,182,91,.05);transition:border-color .2s ease,background .2s ease,color .2s ease,transform .2s ease,box-shadow .2s ease}.floor-action i{color:var(--gold-soft);font-size:14px;font-style:normal;transition:transform .2s ease}.floor-action:hover,.floor-action:focus-visible{border-color:var(--gold-soft);background:var(--gold);color:var(--night);box-shadow:0 8px 22px rgba(217,182,91,.18);outline:none;transform:translateX(3px)}.floor-action:hover i,.floor-action:focus-visible i{color:var(--night);transform:rotate(45deg)}.waiting-light{display:flex;flex-direction:column;align-items:center;gap:7px;color:rgba(255,255,255,.46);font-size:8px;letter-spacing:.13em}.waiting-light>i{width:9px;height:9px;border-radius:50%;background:rgba(217,182,91,.55);box-shadow:0 0 11px rgba(217,182,91,.35);animation:waiting-pulse 2.1s ease-in-out infinite}
  .store-footer{display:grid;grid-template-columns:minmax(0,1fr) minmax(310px,.62fr);align-items:end;gap:28px 64px;max-width:1240px;margin:0 auto;padding:78px clamp(20px,4.5vw,72px) 100px;border-top:1px solid rgba(255,255,255,.11)}.store-footer>p{font-size:15px;letter-spacing:.04em}.store-footer>p span{color:var(--gold-soft)}.store-footer>strong{grid-column:1;font-size:clamp(24px,3.5vw,44px);font-weight:500;letter-spacing:-.045em}.store-footer>a{grid-row:1/3;grid-column:2;align-self:end}
  .logo-story-cta{position:relative;display:grid!important;grid-template-columns:1fr 54px;align-items:center;gap:22px;min-height:142px;padding:26px 25px 26px 29px;overflow:hidden;border:1px solid rgba(217,182,91,.38);background:linear-gradient(125deg,rgba(217,182,91,.09),rgba(130,199,255,.035));color:var(--white)!important;transition:border-color .3s ease,transform .3s ease,box-shadow .3s ease}.logo-story-cta::before{content:"";position:absolute;inset:-1px;background:linear-gradient(105deg,transparent 30%,rgba(240,217,152,.16) 48%,transparent 65%);transform:translateX(-120%);animation:logo-shine 4.2s ease-in-out infinite}.logo-story-cta>span{position:relative;z-index:1}.logo-story-cta small,.logo-story-cta b,.logo-story-cta em{display:block}.logo-story-cta small{color:var(--sky);font-size:8px;font-weight:600;letter-spacing:.18em}.logo-story-cta b{margin-top:12px;color:var(--white);font-size:clamp(21px,2.2vw,30px);font-weight:500;letter-spacing:-.045em}.logo-story-cta em{margin-top:7px;color:rgba(255,255,255,.47);font-size:11px;font-style:normal}.logo-story-cta>i{position:relative;z-index:1;display:grid;place-items:center;width:54px;height:54px;border:1px solid rgba(217,182,91,.6);border-radius:50%;background:rgba(217,182,91,.06);color:var(--gold-soft);font-size:21px;font-style:normal;animation:logo-arrow 2.4s ease-in-out infinite;transition:background .25s ease,color .25s ease,transform .25s ease}.logo-story-cta:hover,.logo-story-cta:focus-visible{border-color:var(--gold-soft);outline:none;transform:translateY(-5px);box-shadow:0 24px 50px rgba(0,0,0,.32),0 0 28px rgba(217,182,91,.1)}.logo-story-cta:hover>i,.logo-story-cta:focus-visible>i{background:var(--gold);color:var(--night);animation:none;transform:rotate(45deg)}
  @keyframes logo-shine{0%,52%{transform:translateX(-120%)}78%,100%{transform:translateX(120%)}}
  @keyframes logo-arrow{0%,100%{transform:translate(0,0)}50%{transform:translate(4px,-4px)}}
  @keyframes waiting-pulse{0%,100%{opacity:.45;transform:scale(.8)}50%{opacity:1;transform:scale(1.15)}}
  @media(max-width:1080px) and (min-width:821px){.directory{grid-template-columns:1fr}.directory-head{position:static}.directory-head h2{font-size:48px}.active-floor{display:none}.floor{grid-template-columns:82px 58px minmax(180px,.8fr) minmax(180px,1fr) 72px}.floor--split{grid-template-columns:82px 58px minmax(180px,.8fr) minmax(155px,1fr) 132px}}
