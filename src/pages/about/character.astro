---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../config/site';

// 나이는 빌드할 때 센다. 사이트가 6시간마다 자동 배포되므로 화면의 숫자는 스크립트 없이도 따라온다.
const BIRTH = new Date('2026-09-11T00:00:00+09:00');
function ageText(now = new Date()) {
  const days = Math.floor((now.getTime() - BIRTH.getTime()) / 86400000);
  if (days < 30) return `생후 ${days}일`;
  let years = now.getFullYear() - BIRTH.getFullYear();
  let months = now.getMonth() - BIRTH.getMonth();
  if (now.getDate() < BIRTH.getDate()) months -= 1;
  if (months < 0) { years -= 1; months += 12; }
  if (years < 1) return `생후 ${years * 12 + months}개월`;
  return `만 ${years}세`;
}
const birthLine = `2026년 9월 11일생 · ${ageText()}`;

// 단체 프로필 카드 뒤 배경. 빌드하는 달로 계절을 정한다(운영자 지시, 2026-09-23).
// 3~5월 벚꽃, 6~8월 비꽃, 9~11월 낙엽꽃, 12~2월 눈꽃.
const month = new Date().getMonth() + 1;
const season = month <= 2 || month === 12 ? 'winter' : month <= 5 ? 'spring' : month <= 8 ? 'summer' : 'autumn';
const seasonLabel = { spring: '벚꽃', summer: '비꽃', autumn: '낙엽꽃', winter: '눈꽃' }[season];
// 궤적을 섞는다. 어떤 것은 곧게 떨어지고, 어떤 것은 오른쪽 위에서 왼쪽 아래로, 어떤 것은 그 반대로 간다.
const drifts = [0, -220, 140, -60, 260, -140, 40, -300, 180, 0, -100, 220, -180, 80, 300, -40, 120, -260, 60, -160, 200, 0, -80, 240];
const petals = Array.from({ length: 26 }, (_, i) => {
  // 세 갈래로 나눈다. 0은 곧게 떨어지고, 1은 오른쪽 위에서 왼쪽 아래로, 2는 그 반대로 간다.
  const mode = i % 3;
  const spread = 60 + ((i * 37) % 200);
  return {
    left: mode === 1 ? 20 + ((i * 11) % 80) : mode === 2 ? -6 + ((i * 13) % 78) : (i * 7.3) % 100,
    dx: mode === 1 ? -spread : mode === 2 ? spread : -14 + ((i * 9) % 28),
    spin: (mode === 0 ? 180 : 420) + ((i * 53) % 260),
    delay: ((i * 1.31) % 14).toFixed(2),
    dur: (12 + ((i * 3.7) % 10)).toFixed(2),
    size: 8 + ((i * 5) % 9),
    sway: mode === 0 ? (2.2 + ((i * 2) % 4)).toFixed(2) : (3.4 + ((i * 3) % 5)).toFixed(2),
    swayPx: mode === 0 ? 16 : 7,
    fade: (0.24 + ((i * 7) % 20) / 100).toFixed(2),
  };
});
const scenePetals = petals.slice(0, 9);

const characters = [
  {
    name: '삥지',
    en: 'BBINGE',
    sex: '여자',
    file: 'bbingji',
    shot: 'bbingji-ball.png',
    motion: 'roll',
    shotAlt: '공에 기대 옆으로 누운 삥지',
    faceAlt: '눈썹 한 줄과 코, 분홍 볼터치가 있는 삥지의 얼굴',
    faceNote: '눈썹 한 줄, 코, 분홍 볼터치.',
    height: '94cm',
    home: '서울특별시 서초구',
    trait: '시니컬하고 쿨함. 칭찬은 짧고 지적은 길다.',
    skills: ['전반 10분 보고 "이거 진다" 맞히기', '남이 쓴 글에서 틀린 연도 찾아내기'],
    likes: ['새벽에 혼자 보는 유럽 경기', '촌스러운 90년대 유니폼', '숫자가 정확한 글'],
    dislikes: ['하이라이트만 보고 다 아는 척하는 사람', '아무한테나 붙이는 "레전드"', '진 경기를 감동 서사로 포장하기'],
  },
  {
    name: '삥맹',
    en: 'BBINGMANG',
    sex: '남자',
    file: 'bbingmaeng',
    shot: 'bbingmaeng-sweat.png',
    motion: 'walk',
    shotAlt: '땀을 흘리며 손발을 떨고 있는 삥맹',
    faceAlt: '눈 점 두 개와 입 선 하나만 있는 삥맹의 얼굴',
    faceNote: '눈 두 개, 입 하나. 끝.',
    height: '95cm',
    home: '서울특별시 강남구',
    trait: '섬세하고 감성적. 남의 은퇴 경기를 보고 운다.',
    skills: ['경기보다 경기 끝난 뒤 선수 표정 오래 보기', '그 경기에 어울리는 노래 고르기'],
    likes: ['비 오는 날 홈경기', '흑백 사진', '승격 확정된 순간의 관중석'],
    dislikes: ['승부차기', '팀 연고 이전', '"그래서 결론이 뭔데"'],
  },
];

const characterDescription = '삥이FC 공식 캐릭터 삥지와 삥맹의 자기소개서. 키, 고향, 성격, 특기, 좋아하는 것과 싫어하는 것을 담았습니다.';
const characterSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: '삥이FC 공식 캐릭터 삥지와 삥맹',
  url: `${site.url}/about/character/`,
  description: characterDescription,
  about: characters.map((c) => ({ '@type': 'Person', name: c.name, alternateName: c.en, height: c.height, birthDate: '2026-09-11' })),
};
---

<Layout title="공식 캐릭터 삥지와 삥맹" description={characterDescription} ogImage="/images/brand/character/bbingji-front.webp" ogImageAlt="검정 BBINGE FC 후드티를 입은 구름 머리 캐릭터 삥지" ogImageWidth={1254} ogImageHeight={1254} adsEligible={false} breadcrumbs={[{ label: '홈', href: '/' }, { label: '저자 @삥이', href: '/about/' }, { label: '공식 캐릭터', href: '/about/character/' }]} extraSchema={characterSchema}>
  <article class="character-page">
    <header class="lineup">
      <p class="eyebrow">BBINGE FC · OFFICIAL CHARACTERS</p>
      <h1>삥지와 삥맹</h1>
      <div class="lineup-grid">
        {characters.map((c) => (
          <figure>
            <img src={`/images/brand/character/${c.file}-front.png`} alt={`검정 BBINGE FC 후드티를 입고 정면을 보는 ${c.name}`} width="1254" height="1254" />
            <figcaption>{c.name}<span>{c.sex} · 2026.09.11</span></figcaption>
          </figure>
        ))}
      </div>
    </header>

    {characters.map((c, i) => (
      <section class="profile">
        <div class="shot"><img src={`/images/brand/character/${c.shot}`} alt={c.shotAlt} width="1254" height="1254" loading="lazy" data-motion={c.motion} /></div>
        <div class="profile-body">
          <h2><b>PROFILE {String(i + 1).padStart(2, '0')}</b>{c.name} 자기소개서</h2>
          <table class="profile-table">
            <tbody>
              <tr><th scope="row">이름</th><td>{c.name} <i>({c.en})</i></td></tr>
              <tr><th scope="row">나이</th><td>{birthLine}</td></tr>
              <tr><th scope="row">키</th><td>{c.height}</td></tr>
              <tr><th scope="row">고향</th><td>{c.home}</td></tr>
              <tr><th scope="row">성격</th><td>{c.trait}</td></tr>
              <tr><th scope="row">특기</th><td>{c.skills.map((v) => <span>{v}</span>)}</td></tr>
              <tr><th scope="row">좋아하는 것</th><td>{c.likes.map((v) => <span>{v}</span>)}</td></tr>
              <tr><th scope="row">싫어하는 것</th><td>{c.dislikes.map((v) => <span>{v}</span>)}</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    ))}

    <section class="post" data-season={season} aria-label={`삥지와 삥맹 단체 프로필, 배경은 ${seasonLabel}`}>
      <div class="weather" aria-hidden="true">{petals.map((f) => (
        <span style={`left:${f.left}%;--dx:${f.dx}px;--spin:${f.spin}deg;--fade:${f.fade};animation-delay:-${f.delay}s;animation-duration:${f.dur}s`}><i style={`width:${f.size}px;height:${f.size}px;--sway:${f.swayPx}px;animation-duration:${f.sway}s`} /></span>
      ))}</div>
      <article class="post-card">
        <header class="post-head">
          <span class="post-avatar"><img src="/images/brand/pb-mark-2026-color.png" alt="" width="1596" height="985" loading="lazy" /></span>
          <span class="post-who"><b>bbingefc</b><small>PB 온라인 본점 · 서울 강남</small></span>
        </header>
        <div class="post-photo">
          <div class="weather weather--scene" aria-hidden="true">{scenePetals.map((f) => (
            <span style={`left:${f.left}%;--dx:${Math.round(f.dx / 3)}px;--spin:${f.spin}deg;animation-delay:-${f.delay}s;animation-duration:${(Number(f.dur) * 0.8).toFixed(2)}s`}><i style={`width:${Math.max(7, f.size - 2)}px;height:${Math.max(7, f.size - 2)}px;animation-duration:${f.sway}s`} /></span>
          ))}</div>
          <img class="stand stand--ji" src="/images/brand/character/bbingji-front.png" alt="검정 BBINGE FC 후드티를 입고 선 삥지" width="1254" height="1254" loading="lazy" />
          <img class="stand stand--maeng" src="/images/brand/character/bbingmaeng-front.png" alt="검정 BBINGE FC 후드티를 입고 선 삥맹" width="1254" height="1254" loading="lazy" />
        </div>
        <div class="post-actions" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 20.4 4.6 13a4.6 4.6 0 0 1 6.5-6.5l.9.9.9-.9A4.6 4.6 0 0 1 19.4 13z" stroke-linejoin="round"/></svg>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8 8 0 0 1-11.6 7.1L4 20l1.4-5A8 8 0 1 1 21 11.5z" stroke-linejoin="round"/></svg>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21.5 3 2.5 10.3l7.3 2.9 2.9 7.3z" stroke-linejoin="round"/></svg>
        </div>
        <div class="post-body">
          <p><b>bbingefc</b> 볼터치가 있는 쪽이 삥지, 없는 쪽이 삥맹입니다.</p>
          <p class="post-tags">#삥이FC #삥이 #삥지 #삥맹</p>
          <p class="post-date">2026년 9월 23일</p>
        </div>
      </article>
    </section>

    <footer class="character-signature">
      <p>BBINGE <span>×</span> BBINGMANG</p>
      <h2>삥지와 삥맹.<br />삥이FC의 두 얼굴입니다.</h2>
      <div>
        <div class="signature-meta"><strong>삥지 · 삥맹</strong><span>2026년 9월 11일 태어남 · 2026년 9월 23일 공개 · 삥이FC 공식 캐릭터</span></div>
        <a class="author-cta" href="/about/logo/"><i aria-hidden="true"></i><span>로고 이야기 보러가기</span></a>
      </div>
    </footer>
  </article>
</Layout>

<script>
  // 자기소개서 사진 두 장만 움직인다. 라인업과 얼굴 컷은 가만히 둔다.
  // 스크롤한 거리가 그대로 진행도가 되므로 내리면 앞으로, 올리면 뒤로 돌아간다. 멈추면 그 자세로 선다.
  const roller = document.querySelector<HTMLImageElement>('[data-motion="roll"]');
  const walker = document.querySelector<HTMLImageElement>('[data-motion="walk"]');

  if ((roller || walker) && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // 각자 자기 칸이 화면 아래끝에 닿는 순간부터 0으로 센다. 그래야 굴러 들어오고 걸어 들어온다.
    const startOf = (el: HTMLElement) => {
      const sec = el.closest('.profile') as HTMLElement | null;
      // 첫 칸은 이미 화면 안에 있으므로 0으로 눌러, 페이지를 열었을 때는 똑바로 서 있게 한다.
      return sec ? Math.max(0, sec.getBoundingClientRect().top + scrollY - innerHeight) : 0;
    };
    let rollStart = roller ? startOf(roller) : 0;
    // 한 바퀴 구를 때 옆으로 가는 거리. 칸 밖으로 나가지 않을 만큼만 준다.
    // 굴러가는 거리와, 그 사이 스크롤해야 하는 양
    const runOf = (el: HTMLElement | null) => (el ? Math.min(90, el.clientWidth * 0.28) : 0);
    const spanOf = (el: HTMLElement | null) => {
      const sec = el?.closest('.profile') as HTMLElement | null;
      return sec ? sec.offsetHeight + innerHeight * 0.4 : 1;
    };
    let rollRun = runOf(roller);
    let rollSpan = spanOf(roller);
    let walkStart = walker ? startOf(walker) : 0;
    let ticking = false;

    const paint = () => {
      ticking = false;
      if (roller) {
        // 진짜 데굴데굴. 자기 칸을 지나는 동안 왼쪽에서 오른쪽으로 굴러간다.
        // 회전만 주면 제자리에서 도는 것으로 보이므로 굴러간 만큼 옆으로도 간다.
        // 카톡 짤처럼 비스듬히 아래로 굴러 내려간다. 옆으로만 가면 평지에서 구르는 것으로 보인다.
        const p = Math.min(1, Math.max(0, (scrollY - rollStart) / rollSpan));
        const turn = p * 720;
        // 바닥에 닿을 때마다 살짝 튄다. 두 바퀴 도는 동안 네 번.
        const hop = Math.abs(Math.sin(turn * Math.PI / 180 * 2)) * 6;
        roller.style.transform = `translate(${((p - 0.5) * 2 * rollRun).toFixed(2)}px, ${((p - 0.5) * 2 * rollRun * 0.5 - hop).toFixed(2)}px) rotate(${turn.toFixed(2)}deg)`;
      }
      if (walker) {
        // 걸음. 190px마다 한 걸음이며 착지할 때 아주 조금 눌린다. 방정맞지 않게 낮게 뛴다.
        const d = Math.max(0, scrollY - walkStart);
        const phase = (d / 190) * Math.PI * 2;
        const squash = Math.cos(phase * 2) * 0.012;
        walker.style.transform = `translate(${(Math.sin(phase) * 4).toFixed(2)}px, ${(-Math.abs(Math.sin(phase)) * 6).toFixed(2)}px) rotate(${(Math.sin(phase) * 2).toFixed(2)}deg) scale(${(1 - squash * 0.7).toFixed(4)}, ${(1 + squash).toFixed(4)})`;
      }
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(paint);
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', () => {
      if (roller) { rollStart = startOf(roller); rollRun = runOf(roller); rollSpan = spanOf(roller); }
      if (walker) walkStart = startOf(walker);
      onScroll();
    }, { passive: true });
    paint();
  }
</script>

<style>
  .character-page{--line:var(--bbfc-border);max-width:1200px;margin:0 auto;padding:0 20px 96px;color:var(--bbfc-ink)}
  .eyebrow{color:var(--bbfc-blue);font-size:14px;font-weight:750;letter-spacing:.17em}
  .lineup{padding:56px 0 40px;border-bottom:1px solid var(--bbfc-ink)}
  .lineup h1{margin-top:18px;font-size:clamp(40px,5vw,62px);font-weight:680;line-height:1.05;letter-spacing:-.065em}
  .lineup-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(16px,3vw,40px);margin-top:26px}
  .lineup-grid figure{margin:0;text-align:center}
  .lineup-grid img{display:block;width:100%;max-width:360px;height:auto;margin:0 auto}
  .lineup-grid figcaption{margin-top:4px;font-size:22px;font-weight:750;letter-spacing:-.03em}
  .lineup-grid figcaption span{display:block;margin-top:6px;color:var(--bbfc-gray-1);font-size:15px;font-weight:500;letter-spacing:0}

  .profile{display:grid;grid-template-columns:minmax(0,340px) minmax(0,1fr);gap:clamp(28px,4vw,52px);align-items:start;padding:52px 0;border-bottom:1px solid var(--line)}
  /* 로고 페이지의 landscape-mark처럼 사진이 표 옆에 붙어 따라 내려온다. */
  .profile .shot{position:sticky;top:88px;align-self:start;display:grid;place-items:center;padding:0}
  .profile .shot img{display:block;width:100%;height:auto;transform-origin:50% 72%}
  .profile h2{font-size:clamp(28px,3.4vw,42px);font-weight:660;line-height:1.15;letter-spacing:-.05em}
  .profile h2 b{display:block;margin-bottom:10px;color:var(--bbfc-blue);font-size:15px;font-weight:750;letter-spacing:.08em}
  .profile-table{width:100%;margin-top:22px;border-collapse:collapse;border-top:2px solid var(--bbfc-ink)}
  .profile-table th,.profile-table td{padding:15px 16px;border-bottom:1px solid var(--line);font-size:16px;text-align:left;vertical-align:top}
  .profile-table th{width:124px;background:var(--bbfc-fill-2);font-weight:700}
  .profile-table td{color:var(--bbfc-ink-2);line-height:1.65}
  .profile-table td span{display:block}
  .profile-table td span+span{margin-top:7px}
  .profile-table td i{color:var(--bbfc-gray-1);font-size:15px;font-style:normal}

  .post{position:relative;padding:72px 0 48px;display:grid;place-items:center}
  .weather{position:absolute;top:0;bottom:0;left:50%;width:100vw;margin-left:-50vw;overflow:clip;pointer-events:none}
  .weather span{position:absolute;top:-10%;display:block;animation-name:petal-fall;animation-timing-function:linear;animation-iteration-count:infinite}
  .weather i{display:block;animation-name:petal-sway;animation-timing-function:ease-in-out;animation-iteration-count:infinite;animation-direction:alternate;opacity:var(--fade)}
  /* 가을: 낙엽꽃 */
  .weather i{border-radius:0 62% 0 62%;background:#c9772f}
  .post[data-season="autumn"] .weather span:nth-child(3n) i{background:#a8552a}
  .post[data-season="autumn"] .weather span:nth-child(3n+1) i{background:#d9a05b}
  /* 봄: 벚꽃 */
  .post[data-season="spring"] .weather i{border-radius:60% 0 60% 0;background:#e9a7bd}
  .post[data-season="spring"] .weather span:nth-child(3n) i{background:#f2c4d3}
  /* 여름: 비꽃 */
  .post[data-season="summer"] .weather i{width:2px!important;border-radius:2px;background:var(--bbfc-blue)}
  .post[data-season="summer"] .weather span{animation-duration:3.4s!important}
  /* 겨울: 눈꽃 */
  .post[data-season="winter"] .weather i{border-radius:50%;background:#9fb6d4}
  @keyframes petal-fall{from{transform:translate(0,0) rotate(0)}to{transform:translate(var(--dx,0),calc(100% + 130vh)) rotate(var(--spin,320deg))}}
  @keyframes petal-sway{from{transform:translateX(calc(var(--sway,14px) * -1))}to{transform:translateX(var(--sway,14px))}}
  @media(prefers-reduced-motion:reduce){.weather{display:none}}

  .post-card{position:relative;z-index:1;width:min(100%,470px);border:1px solid var(--line);background:#fff}
  .post-head{display:flex;align-items:center;gap:12px;padding:12px 14px}
  .post-avatar{display:grid;place-items:center;width:42px;height:42px;overflow:hidden;border:1px solid var(--line);border-radius:50%;background:#fff}
  .post-avatar img{width:34px;height:auto}
  .post-who{display:grid;gap:2px}
  .post-who b{font-size:15px;font-weight:700}
  .post-who small{color:var(--bbfc-gray-1);font-size:14px}
  /* 사진 칸은 정사각이며 배경은 흰색이다. 둘은 바닥에 나란히 서고 그 사이로 낙엽이 지나간다. */
  .post-photo{position:relative;aspect-ratio:1;overflow:clip;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#fff}
  .post-photo .stand{position:absolute;bottom:6%;width:50%;height:auto;z-index:1}
  .stand--ji{left:1%}
  .stand--maeng{right:1%;width:50.5%}
  .weather--scene{position:absolute;inset:0;left:0;width:100%;margin:0;z-index:0}
  .post-actions{display:flex;gap:16px;padding:12px 14px 4px;color:var(--bbfc-ink)}
