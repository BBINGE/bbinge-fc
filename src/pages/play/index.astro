---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import playersFile from '../../data/goat-players.json';
import playerImageFile from '../../data/goat-player-images.json';
import playerPhotoAuditFile from '../../data/player-photo-audit.json';

const { players, drawAllocation } = playersFile;

// 선수 id와 슬러그가 같은 '역사' 카테고리 글이 있으면 우승 화면에서 바로 연결한다.
const historyArticles = await getCollection('articles', ({ data }) => !data.draft && data.category === 'history');
const articleMap: Record<string, string> = Object.fromEntries(
  historyArticles
    .filter((entry) => players.some((p) => p.id === entry.id))
    .map((entry) => [entry.id, `/history/${entry.id}/`])
);

const auditedPhotos = Object.fromEntries(
  playerPhotoAuditFile.players
    .filter((entry) => ['focus-review', 'ready', 'user-provided'].includes(entry.status) && entry.currentAsset)
    .map((entry) => [entry.id, entry])
);
const playerImages: Record<string, string> = Object.fromEntries(
  Object.entries(auditedPhotos).map(([id, entry]) => [
    id,
    entry.photoVersion ? `${entry.currentAsset}?v=${entry.photoVersion}` : entry.currentAsset,
  ])
);
const playerCredits = playerImageFile.portraits;
const flagBackgrounds: Record<string, string> = {
  브라질: 'linear-gradient(145deg,#159447 0 34%,#f7d117 34% 66%,#17479e 66%)',
  우루과이: 'repeating-linear-gradient(180deg,#fff 0 12%,#69b9e9 12% 24%)',
  스페인: 'linear-gradient(180deg,#aa151b 0 25%,#f1bf00 25% 75%,#aa151b 75%)',
  이탈리아: 'linear-gradient(90deg,#169b62 0 33%,#fff 33% 66%,#ce2b37 66%)',
  오스트리아: 'linear-gradient(180deg,#ed2939 0 33%,#fff 33% 66%,#ed2939 66%)',
  잉글랜드: 'linear-gradient(90deg,transparent 43%,#c8102e 43% 57%,transparent 57%),linear-gradient(180deg,#fff 42%,#c8102e 42% 58%,#fff 58%)',
  헝가리: 'linear-gradient(180deg,#ce2939 0 33%,#fff 33% 66%,#477050 66%)',
  프랑스: 'linear-gradient(90deg,#183b8f 0 33%,#fff 33% 66%,#e23b45 66%)',
  독일: 'linear-gradient(180deg,#161616 0 33%,#d71920 33% 66%,#f5cf35 66%)',
  서독: 'linear-gradient(180deg,#161616 0 33%,#d71920 33% 66%,#f5cf35 66%)',
  네덜란드: 'linear-gradient(180deg,#ae1c28 0 33%,#fff 33% 66%,#21468b 66%)',
  포르투갈: 'linear-gradient(90deg,#046a38 0 40%,#da291c 40%)',
  아르헨티나: 'linear-gradient(180deg,#75aadb 0 33%,#fff 33% 66%,#75aadb 66%)',
  체코: 'linear-gradient(180deg,#fff 0 50%,#d7141a 50%)',
  체코슬로바키아: 'linear-gradient(180deg,#fff 0 50%,#d7141a 50%)',
  소련: 'linear-gradient(135deg,#cd0000 0 72%,#f5d000 72%)',
  스코틀랜드: 'linear-gradient(45deg,transparent 43%,#fff 43% 57%,transparent 57%),linear-gradient(-45deg,#07519b 43%,#fff 43% 57%,#07519b 57%)',
  북아일랜드: 'linear-gradient(90deg,transparent 43%,#c8102e 43% 57%,transparent 57%),linear-gradient(180deg,#fff 42%,#c8102e 42% 58%,#fff 58%)',
  폴란드: 'linear-gradient(180deg,#fff 0 50%,#dc143c 50%)',
  우크라이나: 'linear-gradient(180deg,#1769aa 0 50%,#ffd700 50%)',
  라이베리아: 'repeating-linear-gradient(180deg,#c8102e 0 9%,#fff 9% 18%)',
  코트디부아르: 'linear-gradient(90deg,#f77f00 0 33%,#fff 33% 66%,#009e60 66%)',
  카메룬: 'linear-gradient(90deg,#007a5e 0 33%,#ce1126 33% 66%,#fcd116 66%)',
  대한민국: 'linear-gradient(135deg,#fff 0 44%,#cd2e3a 44% 58%,#0047a0 58% 72%,#fff 72%)',
  불가리아: 'linear-gradient(180deg,#fff 0 33%,#00966e 33% 66%,#d62612 66%)',
  벨기에: 'linear-gradient(90deg,#111 0 33%,#fdda24 33% 66%,#ef3340 66%)',
  스웨덴: 'linear-gradient(90deg,transparent 30%,#ffcd00 30% 40%,transparent 40%),linear-gradient(180deg,#006aa7 42%,#ffcd00 42% 58%,#006aa7 58%)',
  크로아티아: 'linear-gradient(180deg,#ff0000 0 33%,#fff 33% 66%,#171796 66%)',
  이집트: 'linear-gradient(180deg,#ce1126 0 33%,#fff 33% 66%,#000 66%)',
  웨일스: 'linear-gradient(180deg,#fff 0 50%,#00ab39 50%)',
  덴마크: 'linear-gradient(90deg,transparent 30%,#fff 30% 38%,transparent 38%),linear-gradient(180deg,#c60c30 43%,#fff 43% 56%,#c60c30 56%)',
};
const playerFocus = Object.fromEntries(Object.entries(auditedPhotos).map(([id, entry]) => [id, {
  position: entry.photoPosition,
  scale: entry.photoScale,
}]));
---

<Layout
  title="GOAT 토너먼트"
  description="시대별 136명 중 32명이 출전하는 GOAT 토너먼트. 한 명만 끝까지 남겨보세요."
  breadcrumbs={[
    { label: '홈', href: '/' },
    { label: '놀이', href: '/play/' },
  ]}
>
  <div class="max-w-[980px] mx-auto px-3 md:px-5 py-5 md:py-7">
    <header class="mb-5">
      <p class="text-[11px] text-[var(--bbfc-blue)]">PLAY · 32강</p>
      <h1 class="text-[24px] md:text-[30px] font-medium text-[var(--bbfc-ink)] mt-1">둘 중 한 명만 찍어.</h1>
      <p class="text-[13px] text-[var(--bbfc-gray-1)] mt-1.5">
        고민은 짧게, 클릭은 세게. 살아남은 한 명이 다음 라운드로 갑니다.
      </p>
    </header>

    <div id="goat-app" data-loading="true">
      <p class="text-[13px] text-[var(--bbfc-gray-1)] py-10 text-center">불러오는 중…</p>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ players, drawAllocation, articleMap, playerImages, playerCredits, playerFocus, flagBackgrounds }}>
  const STORAGE_KEY = 'bbfc-goat-v3';
  const ROUND_NAME = { 32: '32강', 16: '16강', 8: '8강', 4: '4강', 2: '결승' };
  const POSITION_KR = { GK: '골키퍼', DF: '수비수', MF: '미드필더', FW: '공격수' };
  const ERA_ORDER = ['pre1950', '1950s60s', '1970s80s', '1990s00s', '2010s'];
  const MATCH_LINES = ['누가 올라가?', '한 명만 찍어.', '이건 좀 어렵다.', '오늘은 네가 감독이다.', '고민하다 둘 다 늙는다.'];

  const app = document.getElementById('goat-app');
  const playersById = Object.fromEntries(players.map((p) => [p.id, p]));
  const debugPhotoFocus = new URLSearchParams(window.location.search).get('debugPhotoFocus') === '1';
  if (debugPhotoFocus) app?.classList.add('goat-app--debug-photo-focus');

  function escapeHTML(value = '') {
    return String(value).replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char]);
  }

  function mulberry32(seedInt) {
    let a = seedInt >>> 0;
    return function () {
      a |= 0;
      a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function hashSeed(seedStr) {
    let h = 0x811c9dc5;
    for (let i = 0; i < seedStr.length; i++) {
      h ^= seedStr.charCodeAt(i);
      h = Math.imul(h, 0x01000193);
    }
    return h >>> 0;
  }

  function generateSeed() {
    return Math.floor(Math.random() * 1e9).toString(36);
  }

  function seededShuffle(arr, rng) {
    const out = arr.slice();
    for (let i = out.length - 1; i > 0; i--) {
      const j = Math.floor(rng() * (i + 1));
      [out[i], out[j]] = [out[j], out[i]];
    }
    return out;
  }

  function buildBracket(seedStr) {
    const rng = mulberry32(hashSeed(seedStr));
    const pool = ERA_ORDER.flatMap((era) => {
      const needed = drawAllocation[era] ?? 0;
      const eraPlayers = players.filter((player) => player.era === era);
      return seededShuffle(eraPlayers, rng)
        .slice(0, Math.min(needed, eraPlayers.length))
        .map((player) => player.id);
    });
    return seededShuffle(pool, rng);
  }

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch {
      return null;
    }
  }

  function saveState(state) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch {
      // localStorage 접근 불가(시크릿 모드 등)여도 게임은 계속 진행
    }
  }

  function newState(seedStr) {
    const bracket = buildBracket(seedStr);
    return { seed: seedStr, roundPlayers: bracket, matchIndex: 0, final4: null, winner: null };
  }

  function pickWinner(state, winnerId) {
    const size = state.roundPlayers.length;
    const nextIndex = (state.nextRoundPlayers ??= []);
    nextIndex.push(winnerId);
    state.matchIndex += 1;

    if (state.matchIndex * 2 >= size) {
      const advancing = state.nextRoundPlayers;
      state.nextRoundPlayers = [];
      state.matchIndex = 0;
      state.roundPlayers = advancing;

      if (advancing.length === 4) {
        state.final4 = advancing.slice();
      }
      if (advancing.length === 1) {
        state.winner = advancing[0];
      }
    }
    return state;
  }

  function currentFocusBreakpoint() {
    if (window.innerWidth >= 1280) return 'desktop';
    if (window.innerWidth >= 1024) return 'laptop';
    if (window.innerWidth >= 768) return 'tablet';
    return 'mobile';
  }

  function updatePhotoFocusDebugLabels() {
    const breakpoint = currentFocusBreakpoint();
    document.querySelectorAll('.goat-card__focus-debug').forEach((label) => {
      label.textContent = label.dataset[breakpoint] ?? '';
    });
  }

  function playerCardHTML(player, side) {
    const clubs = player.clubs.join(' · ');
    const image = playerImages[player.id];
    const focus = playerFocus[player.id] ?? {
      position: { desktop: '50% 22%', laptop: '50% 24%', tablet: '50% 26%', mobile: '50% 28%' },
      scale: { desktop: 1, laptop: 1, tablet: 1, mobile: 1 },
    };
    const focusStyle = [
      `--face-position-desktop:${focus.position.desktop}`,
      `--face-position-laptop:${focus.position.laptop}`,
      `--face-position-tablet:${focus.position.tablet}`,
      `--face-position-mobile:${focus.position.mobile}`,
      `--face-scale-desktop:${focus.scale.desktop}`,
      `--face-scale-laptop:${focus.scale.laptop}`,
      `--face-scale-tablet:${focus.scale.tablet}`,
      `--face-scale-mobile:${focus.scale.mobile}`,
    ].join(';');
    const nationality = player.nationality.split('·')[0];
    const flag = flagBackgrounds[nationality] ?? 'linear-gradient(135deg,#1d395a,#12243b)';
    const punchline = player.nicknameKr || player.nickname || player.note || `${player.position}의 정점`;
    return `
      <button type="button" class="goat-card goat-card--${side}" data-player-id="${player.id}" data-side="${side}" aria-label="${player.name} 선택">
        <span class="goat-card__crosshair" aria-hidden="true"></span>
        <span class="goat-card__impact" aria-hidden="true"></span>
        <span class="goat-card__media ${image ? '' : 'goat-card__media--empty'}">
          ${image
            ? `<img src="${image}" alt="${player.name}" loading="eager" decoding="async" style="${focusStyle}"><span class="goat-card__focus-debug" data-mobile="mobile ${focus.position.mobile} · ${focus.scale.mobile}×" data-tablet="tablet ${focus.position.tablet} · ${focus.scale.tablet}×" data-laptop="laptop ${focus.position.laptop} · ${focus.scale.laptop}×" data-desktop="desktop ${focus.position.desktop} · ${focus.scale.desktop}×">${currentFocusBreakpoint()} ${focus.position[currentFocusBreakpoint()]} · ${focus.scale[currentFocusBreakpoint()]}×</span>`
            : `<span class="goat-card__initial">${player.name.slice(0, 1)}</span><span class="goat-card__waiting">사진 수급 중</span>`}
          <span class="goat-card__shade"></span>
          <span class="goat-card__position">${player.position}</span>
        </span>
        <span class="goat-card__body" style="--player-flag:${flag}">
          <span class="goat-card__country">${player.nationality} · ${POSITION_KR[player.position] ?? player.position}</span>
          <strong class="goat-card__name">${player.name}</strong>
          <span class="goat-card__nickname">“${punchline}”</span>
          <span class="goat-card__greatness">${player.greatness}</span>
          <span class="goat-card__clubs">${clubs}</span>
        </span>
      </button>
    `;
  }

  function renderMatch(state) {
    const size = state.roundPlayers.length;
    const a = playersById[state.roundPlayers[state.matchIndex * 2]];
    const b = playersById[state.roundPlayers[state.matchIndex * 2 + 1]];
    const totalMatches = size / 2;
    const credits = [a, b]
      .map((player) => ({ player, credit: playerCredits[player.id] }))
      .filter(({ credit }) => credit?.commons);

    app.innerHTML = `
      <div class="flex items-center justify-between mb-3">
        <span class="goat-round">${ROUND_NAME[size] ?? `${size}강`} · ${state.matchIndex + 1}/${totalMatches}</span>
        <button type="button" id="goat-restart" class="text-[12px] text-[var(--bbfc-gray-1)] underline">다시 시작</button>
      </div>
      <div class="goat-progress" aria-hidden="true"><span style="width:${((state.matchIndex + 1) / totalMatches) * 100}%"></span></div>
      <p class="goat-match-line">${MATCH_LINES[(state.matchIndex + size) % MATCH_LINES.length]}</p>
      <div class="goat-arena">
        ${playerCardHTML(a, 'a')}
        <div class="goat-vs" aria-hidden="true"><span>VS</span></div>
        ${playerCardHTML(b, 'b')}
      </div>
      ${credits.length ? `<details class="goat-credits"><summary>사진 출처</summary>${credits.map(({ player, credit }) => `<a href="${credit.commons}" target="_blank" rel="noopener noreferrer">${player.name} · ${escapeHTML(credit.author)} · ${escapeHTML(credit.license)}</a>`).join('')}</details>` : ''}
    `;

    app.querySelectorAll('.goat-card').forEach((btn) => {
      btn.addEventListener('pointermove', (event) => {
        if (event.pointerType === 'touch') return;
        const rect = btn.getBoundingClientRect();
        btn.style.setProperty('--mouse-x', `${event.clientX - rect.left}px`);
        btn.style.setProperty('--mouse-y', `${event.clientY - rect.top}px`);
      });
    });

    app.querySelectorAll('.goat-card').forEach((btn) => {
      btn.addEventListener('click', (event) => {
        if (app.classList.contains('goat-app--locked')) return;
        app.classList.add('goat-app--locked', 'goat-app--hit');
        const impact = btn.querySelector('.goat-card__impact');
        if (impact) {
          const rect = btn.getBoundingClientRect();
          impact.style.left = `${event.clientX - rect.left}px`;
          impact.style.top = `${event.clientY - rect.top}px`;
        }
        app.querySelectorAll('.goat-card').forEach((el) => {
          el.classList.remove('goat-card--selected');
          if (el !== btn) el.classList.add('goat-card--eliminated');
        });
        btn.classList.add('goat-card--selected');
        const winnerId = btn.getAttribute('data-player-id');
        setTimeout(() => {
          const nextState = pickWinner(state, winnerId);
          saveState(nextState);
          app.classList.remove('goat-app--locked', 'goat-app--hit');
          render(nextState);
        }, 480);
      });
    });

    document.getElementById('goat-restart')?.addEventListener('click', () => startNewGame());
  }

  function renderResult(state) {
    const winner = playersById[state.winner];
    const nickname = winner.nickname
      ? `${winner.nickname}${winner.nicknameKr ? ` (${winner.nicknameKr})` : ''}`
      : winner.note;
    const final4 = (state.final4 ?? []).map((id) => playersById[id]);
    const articleHref = articleMap[winner.id] ?? '/history/';

    app.innerHTML = `
      <div class="text-center py-6 border-b border-[var(--bbfc-line)]">
        <p class="text-[11px] text-[var(--bbfc-blue)]">🏆 우승</p>
        <h2 class="text-[22px] font-medium text-[var(--bbfc-ink)] mt-2">${winner.name}</h2>
        <p class="text-[13px] text-[var(--bbfc-gray-1)] mt-1">${winner.nationality} · ${POSITION_KR[winner.position] ?? winner.position}</p>
        ${nickname ? `<p class="text-[13px] text-[var(--bbfc-ink-2)] mt-2">${nickname}</p>` : ''}
      </div>

      <div class="py-5">
        <h3 class="text-[14px] font-medium text-[var(--bbfc-ink)] mb-2">내 브래킷 — 4강</h3>
        <ul>
          ${final4
            .map(
              (p) => `
            <li class="flex items-center justify-between py-2 border-t border-[var(--bbfc-line)] first:border-t-0 text-[13.5px]">
              <span class="${p.id === winner.id ? 'text-[var(--bbfc-blue)] font-medium' : 'text-[var(--bbfc-ink)]'}">${p.name}</span>
              ${p.id === winner.id ? '<span class="text-[11px] text-[var(--bbfc-blue)]">우승</span>' : ''}
            </li>`
            )
            .join('')}
        </ul>
      </div>

      <div class="flex flex-wrap gap-2 mt-2">
        <button type="button" id="goat-share" class="bg-[var(--bbfc-blue)] text-white text-[13px] font-medium rounded-[var(--bbfc-radius)] px-4 py-2.5">
          결과 공유
        </button>
        <a href="${articleHref}" class="text-[13px] font-medium text-[var(--bbfc-ink)] border border-[var(--bbfc-border)] rounded-[var(--bbfc-radius)] px-4 py-2.5">
          이 선수의 역사 깊이 읽기
        </a>
        <button type="button" id="goat-restart" class="text-[13px] text-[var(--bbfc-gray-1)] rounded-[var(--bbfc-radius)] px-4 py-2.5">
          다시 하기
        </button>
      </div>
      <p id="goat-share-msg" class="text-[12px] text-[var(--bbfc-gray-2)] mt-2" hidden>링크가 복사됐어요.</p>
    `;

    document.getElementById('goat-share')?.addEventListener('click', async () => {
      const url = buildShareURL(state);
      const msg = document.getElementById('goat-share-msg');
      let copied = false;
      try {
        await navigator.clipboard.writeText(url);
        copied = true;
      } catch {
        try {
          window.prompt('아래 링크를 복사하세요', url);
          copied = true;
        } catch {
          // 클립보드·prompt 모두 막힌 환경 — 링크를 화면에 텍스트로 노출
        }
      }
      if (msg) {
        msg.hidden = false;
        msg.textContent = copied ? '링크가 복사됐어요.' : url;
      }
    });
    document.getElementById('goat-restart')?.addEventListener('click', () => startNewGame());
  }

  function renderSharedPreview(seedStr, winnerId, final4Ids) {
    const winner = playersById[winnerId];
    const final4 = final4Ids.map((id) => playersById[id]).filter(Boolean);
    if (!winner) {
      startNewGame();
      return;
    }
    app.innerHTML = `
      <div class="text-center py-6 border-b border-[var(--bbfc-line)]">
        <p class="text-[11px] text-[var(--bbfc-blue)]">공유된 결과</p>
        <h2 class="text-[22px] font-medium text-[var(--bbfc-ink)] mt-2">${winner.name}</h2>
        <p class="text-[13px] text-[var(--bbfc-gray-1)] mt-1">${winner.nationality} · ${POSITION_KR[winner.position] ?? winner.position}</p>
      </div>
      <div class="py-5">
        <h3 class="text-[14px] font-medium text-[var(--bbfc-ink)] mb-2">4강</h3>
        <ul>
          ${final4
            .map(
              (p) => `<li class="py-2 border-t border-[var(--bbfc-line)] first:border-t-0 text-[13.5px] ${p.id === winner.id ? 'text-[var(--bbfc-blue)] font-medium' : 'text-[var(--bbfc-ink)]'}">${p.name}</li>`
            )
            .join('')}
        </ul>
      </div>
      <button type="button" id="goat-play-same" class="bg-[var(--bbfc-blue)] text-white text-[13px] font-medium rounded-[var(--bbfc-radius)] px-4 py-2.5">
        나도 이 대진으로 플레이하기
      </button>
    `;
    document.getElementById('goat-play-same')?.addEventListener('click', () => {
      const state = newState(seedStr);
      saveState(state);
      setURL(seedStr);
      render(state);
    });
  }

  function buildShareURL(state) {
    const url = new URL(window.location.href);
    url.search = '';
    url.searchParams.set('seed', state.seed);
    url.searchParams.set('w', state.winner);
    url.searchParams.set('f4', (state.final4 ?? []).join(','));
    return url.toString();
  }

  function setURL(seedStr) {
    const url = new URL(window.location.href);
    url.search = '';
    url.searchParams.set('seed', seedStr);
    window.history.replaceState({}, '', url.toString());
  }

  function startNewGame() {
    const seedStr = generateSeed();
    const state = newState(seedStr);
    saveState(state);
    setURL(seedStr);
    render(state);
  }

  function render(state) {
    if (state.winner) {
      renderResult(state);
    } else {
      renderMatch(state);
    }
  }

  function init() {
    const params = new URLSearchParams(window.location.search);
    const sharedWinner = params.get('w');
    const sharedSeed = params.get('seed');
    const debugPlayers = (params.get('debugPlayers') ?? '').split(',').filter((id) => playersById[id]).slice(0, 2);

    if (debugPhotoFocus && debugPlayers.length) {
      const state = newState('photo-focus-debug');
      state.roundPlayers.splice(0, debugPlayers.length, ...debugPlayers);
      render(state);
      return;
    }

    if (sharedWinner && sharedSeed) {
      const final4Ids = (params.get('f4') ?? '').split(',').filter(Boolean);
      renderSharedPreview(sharedSeed, sharedWinner, final4Ids);
      return;
    }

    const saved = loadState();
    if (saved && (!sharedSeed || saved.seed === sharedSeed) && saved.roundPlayers?.length) {
      if (!sharedSeed) setURL(saved.seed);
      render(saved);
      return;
    }

    if (sharedSeed) {
      const state = newState(sharedSeed);
      saveState(state);
      setURL(sharedSeed);
      render(state);
      return;
    }

    startNewGame();
  }

  init();
  if (debugPhotoFocus) {
    updatePhotoFocusDebugLabels();
    window.addEventListener('resize', updatePhotoFocusDebugLabels);
  }
</script>

