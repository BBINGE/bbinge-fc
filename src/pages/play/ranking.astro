---
import Layout from '../../layouts/Layout.astro';
import playersFile from '../../data/goat-players.json';
import playerPhotoAuditFile from '../../data/player-photo-audit.json';

const photos = Object.fromEntries(playerPhotoAuditFile.players.map((entry) => [entry.id, {
  src: entry.photoVersion ? `${entry.currentAsset}?v=${entry.photoVersion}` : entry.currentAsset,
  position: entry.photoPosition,
  scale: entry.photoScale,
}]));
const rankingPlayers = Object.fromEntries(playersFile.players.map((player) => [player.id, {
  id: player.id,
  name: player.name,
  nickname: player.nicknameKr || player.nickname || player.note,
  position: player.position,
  era: player.era,
  photo: photos[player.id],
}]));
---

<Layout
  title="삥이FC GOAT 랭킹"
  description="삥이FC 축겜 완주자들의 실제 선택으로 쌓이는 축구 GOAT 우승률과 1대1 승률 순위입니다."
  adsEligible={false}
  robots="noindex,follow"
  breadcrumbs={[{ label: '홈', href: '/' }, { label: '축겜', href: '/play/' }, { label: 'GOAT 랭킹', href: '/play/ranking/' }]}
>
  <main class="goat-ranking-shell">
    <header class="goat-ranking-hero">
      <p>PLAY · PEOPLE'S CHOICE</p>
      <h1>삥이FC GOAT 랭킹</h1>
      <div class="goat-ranking-hero__row">
        <span id="ranking-count">완주 기록을 불러오는 중…</span>
        <a href="/play/">나도 한 판 하기 →</a>
      </div>
    </header>
    <p class="goat-ranking-note">우승률은 전체 완주 게임, 1:1 승률은 실제 맞대결 선택을 기준으로 계산합니다.</p>
    <div id="ranking-error" class="goat-ranking-error" hidden>랭킹을 잠시 불러오지 못했어요. 게임은 정상적으로 즐길 수 있습니다.</div>
    <ol id="goat-ranking-list" class="goat-ranking-list" aria-live="polite">
      <li class="goat-ranking-loading">랭킹 집계 중…</li>
    </ol>
  </main>
</Layout>

<script is:inline define:vars={{ rankingPlayers }}>
  const list = document.getElementById('goat-ranking-list');
  const count = document.getElementById('ranking-count');
  const error = document.getElementById('ranking-error');

  function percent(value) {
    return `${(Number(value || 0) * 100).toFixed(1)}%`;
  }

  function rankingCard(item, index) {
    const player = rankingPlayers[item.id];
    if (!player) return null;
    const row = document.createElement('li');
    row.className = 'goat-ranking-card';
    const rank = document.createElement('span');
    rank.className = 'goat-ranking-card__rank';
    rank.textContent = String(index + 1).padStart(2, '0');
    const media = document.createElement('div');
    media.className = 'goat-ranking-card__media';
    if (player.photo?.src) {
      const image = document.createElement('img');
      image.src = player.photo.src;
      image.alt = player.name;
      image.loading = index < 8 ? 'eager' : 'lazy';
      image.style.setProperty('--photo-position-desktop', player.photo.position?.desktop ?? '50% 25%');
      image.style.setProperty('--photo-position-tablet', player.photo.position?.tablet ?? player.photo.position?.desktop ?? '50% 25%');
      image.style.setProperty('--photo-position-mobile', player.photo.position?.mobile ?? '50% 25%');
      image.style.setProperty('--photo-scale-desktop', player.photo.scale?.desktop ?? 1);
      image.style.setProperty('--photo-scale-tablet', player.photo.scale?.tablet ?? player.photo.scale?.desktop ?? 1);
      image.style.setProperty('--photo-scale-mobile', player.photo.scale?.mobile ?? 1);
      media.append(image);
    }
    const identity = document.createElement('div');
    identity.className = 'goat-ranking-card__identity';
    const name = document.createElement('strong');
    name.textContent = player.name;
    const nickname = document.createElement('span');
    nickname.textContent = player.nickname ? `“${player.nickname}”` : '';
    identity.append(name, nickname);
    const stats = document.createElement('dl');
    stats.className = 'goat-ranking-card__stats';
    [['우승률', percent(item.championshipRate)], ['1:1 승률', percent(item.matchupWinRate)]].forEach(([label, value]) => {
      const box = document.createElement('div');
      const term = document.createElement('dt');
      term.textContent = label;
      const detail = document.createElement('dd');
      detail.textContent = value;
      box.append(term, detail);
      stats.append(box);
    });
    const sample = document.createElement('span');
    sample.className = 'goat-ranking-card__sample';
    sample.textContent = `${item.championships}회 우승 · ${item.matchups}경기`;
    row.append(rank, media, identity, stats, sample);
    return row;
  }

  async function loadRanking() {
    try {
      const response = await fetch('/api/goat/ranking');
      if (!response.ok) throw new Error('ranking unavailable');
      const data = await response.json();
      count.textContent = `지금까지 ${Number(data.totalGames).toLocaleString('ko-KR')}번 완주`;
      list.replaceChildren();
      data.ranking.forEach((item, index) => {
        const card = rankingCard(item, index);
        if (card) list.append(card);
      });
    } catch {
      list.replaceChildren();
      error.hidden = false;
      count.textContent = '랭킹 집계 대기 중';
    }
  }

  loadRanking();
</script>

<style is:global>
  .goat-ranking-shell { width:min(980px,calc(100% - 24px)); margin:0 auto; padding:26px 0 60px; }
  .goat-ranking-hero { padding:24px; border-radius:20px; background:#0b1b2f; color:#fff; }
  .goat-ranking-hero > p { color:#8dbbff; font-size:11px; font-weight:850; letter-spacing:.08em; }
  .goat-ranking-hero h1 { margin-top:5px; font-size:clamp(26px,5vw,42px); font-weight:850; letter-spacing:-.04em; }
  .goat-ranking-hero__row { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-top:22px; color:#bac9db; font-size:13px; }
  .goat-ranking-hero__row a { border:1px solid rgba(255,255,255,.28); border-radius:999px; padding:9px 13px; color:#fff; font-weight:750; }
  .goat-ranking-note { margin:16px 3px 20px; color:var(--bbfc-gray-1); font-size:12px; line-height:1.55; }
  .goat-ranking-error, .goat-ranking-loading { padding:28px 16px; border:1px solid var(--bbfc-line); border-radius:14px; color:var(--bbfc-gray-1); text-align:center; font-size:13px; }
  .goat-ranking-list { display:grid; gap:10px; margin:0; padding:0; list-style:none; }
  .goat-ranking-card { display:grid; grid-template-columns:54px 84px minmax(180px,1fr) 230px 130px; align-items:center; gap:16px; min-width:0; min-height:108px; padding:11px 18px; overflow:hidden; border:1px solid var(--bbfc-line); border-radius:18px; background:#fff; }
  .goat-ranking-card__rank { color:#17365d; font-size:21px; font-weight:900; font-variant-numeric:tabular-nums; }
  .goat-ranking-card__media { width:84px; height:84px; overflow:hidden; border-radius:14px; background:#17304e; }
  .goat-ranking-card__media img { width:100%; height:100%; object-fit:cover; object-position:var(--photo-position-desktop); scale:var(--photo-scale-desktop); transform-origin:center; }
  .goat-ranking-card__identity { display:grid; gap:4px; min-width:0; }
  .goat-ranking-card__identity strong { overflow:hidden; color:var(--bbfc-ink); font-size:16px; text-overflow:ellipsis; white-space:nowrap; }
  .goat-ranking-card__identity span { overflow:hidden; color:var(--bbfc-blue); font-size:12px; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }
  .goat-ranking-card__stats { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
  .goat-ranking-card__stats div { padding:8px 10px; border-radius:9px; background:#f3f6fa; }
  .goat-ranking-card__stats dt { color:var(--bbfc-gray-1); font-size:10px; }
  .goat-ranking-card__stats dd { margin-top:2px; color:var(--bbfc-ink); font-size:15px; font-weight:850; font-variant-numeric:tabular-nums; }
  .goat-ranking-card__sample { color:var(--bbfc-gray-2); font-size:11px; text-align:right; }
  @media (max-width:1023px) {
    .goat-ranking-card { grid-template-columns:48px 80px minmax(150px,1fr) 210px; }
    .goat-ranking-card__media { width:80px; height:80px; }
    .goat-ranking-card__media img { object-position:var(--photo-position-tablet); scale:var(--photo-scale-tablet); }
    .goat-ranking-card__sample { grid-column:4; text-align:left; }
  }
  @media (max-width:760px) {
    .goat-ranking-shell { padding-top:14px; }
    .goat-ranking-hero { padding:20px 17px; border-radius:16px; }
    .goat-ranking-list { gap:8px; }
    .goat-ranking-card { grid-template-columns:34px 68px minmax(0,1fr); gap:10px; min-height:0; padding:10px 11px 12px; border-radius:15px; }
    .goat-ranking-card__rank { font-size:17px; }
    .goat-ranking-card__media { width:68px; height:76px; border-radius:11px; }
    .goat-ranking-card__media img { object-position:var(--photo-position-mobile); scale:var(--photo-scale-mobile); }
    .goat-ranking-card__identity strong { font-size:14px; white-space:normal; }
    .goat-ranking-card__stats { grid-column:2 / 4; gap:6px; }
    .goat-ranking-card__stats div { padding:7px 9px; }
    .goat-ranking-card__sample { grid-column:2 / 4; text-align:left; }
  }
</style>
