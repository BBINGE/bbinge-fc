---
// 1층 팝업관(운영자 결정, 2026-09-16): 층·카테고리를 새로 만들지 않고 특집을 여는 자리.
// 상시 개방·이름 유지 확정(운영자, 2026-09-17): 지난 팝업도 닫지 않으므로 기간 한정 문구를 쓰지 않고, 카드 라벨은 회차·개관일로 쓴다.
// 포스터 월 확정(운영자, 2026-09-17): 포스터가 주인공인 1:1 그리드(데스크톱 3열·좁은 화면 2열).
// 목록에는 짧은 표시명(name)과 한 줄 훅(deck)을 쓰고 긴 검색용 제목은 각 팝업 페이지가 갖는다.
// 관 자체는 중립(잉크·블루)으로 두고 색은 포스터가 말한다. 첫 팝업 시절의 빨강 UI는 쓰지 않는다.
import Layout from '../../layouts/Layout.astro';
import { total } from '../../data/popup/bayern-dungi';
import { total as comebackTotal } from '../../data/popup/comebacks';
import { counts as rivalryCounts } from '../../data/popup/rivalries';

// 회차는 개관 순서로 고정한다. 박빙 편은 운영자가 제목을 원안으로 확정한 편이라 `ㄷㄷ`를 붙이지 않는다.
const popups = [
  { href: '/popup/big-club-rivalries/', no: 'POP-UP 03', open: '2026.09 개관', name: '빅클럽 박빙 상대전적', deck: `승패도 골도 안 갈린 ${rivalryCounts.total}대진`, image: '/images/popup/rivalries/card.webp' },
  { href: '/popup/european-comebacks/', no: 'POP-UP 02', open: '2026.09 개관', name: '유럽 대항전 역전극', deck: `3골 차를 뒤집은 ${comebackTotal}경기 ㄷㄷ`, image: '/images/popup/comebacks/card.webp' },
  { href: '/popup/bayern-dungi/', no: 'POP-UP 01', open: '2026.09 개관', name: '바이언 둔기론', deck: `역대 대승 참사 ${total}경기 ㄷㄷ`, image: '/images/popup/bayern-dungi/card.webp' },
];
---
<Layout title="팝업관 - 층별 서가와 따로 여는 특집" description="삥이FC 1층 팝업관. 층별 서가와 따로 여는 축구 특집을 모았다. 지난 팝업도 닫지 않고 상시 열어둔다." breadcrumbs={[{ label: '홈', href: '/' }, { label: '팝업관', href: '/popup/' }]}>
  <div class="popup-hall">
    <header class="popup-hall__head">
      <p><span>01F</span> POP-UP STORE</p>
      <h1>팝업관</h1>
      <span>층별 서가와 따로 여는 특집</span>
    </header>
    <ul class="popup-wall">
      {popups.map((p) => (
        <li><a href={p.href}>
          <span class="popup-wall__poster"><img src={p.image} alt="" width="540" height="540" loading="lazy" decoding="async" /></span>
          <small><b>{p.no}</b><i>{p.open}</i></small>
          <strong>{p.name}</strong>
          <em>{p.deck}</em>
        </a></li>
      ))}
    </ul>
  </div>
</Layout>

<style>
  .popup-hall { max-width: 1180px; margin: 0 auto; padding: 24px 16px 64px; }
  .popup-hall__head { padding: 28px 30px 24px; border-radius: 18px; background: var(--bbfc-ink); color: #fff; }
  .popup-hall__head p { display: flex; align-items: center; gap: 10px; margin: 0; color: rgba(255,255,255,.72); font-size: 12px; font-weight: 800; letter-spacing: .12em; }
  .popup-hall__head p span { display: inline-grid; place-items: center; min-width: 44px; height: 26px; border-radius: 999px; background: var(--bbfc-blue); color: #fff; }
  .popup-hall__head h1 { margin: 10px 0 0; font-size: 36px; font-weight: 850; letter-spacing: -.04em; }
  .popup-hall__head > span { display: block; margin-top: 6px; color: rgba(255,255,255,.72); font-size: 15px; }

  .popup-wall { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px 20px; margin: 24px 0 0; padding: 0; list-style: none; }
  .popup-wall a { display: block; color: var(--bbfc-ink); }
  .popup-wall__poster { display: block; overflow: hidden; border: 1px solid var(--bbfc-border); border-radius: 14px; background: var(--bbfc-ink); transition: border-color .16s ease, transform .16s ease; }
  .popup-wall__poster img { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; }
  .popup-wall a:hover .popup-wall__poster,
  .popup-wall a:focus-visible .popup-wall__poster { border-color: var(--bbfc-blue); transform: translateY(-3px); }
  .popup-wall small { display: flex; align-items: center; gap: 8px; margin-top: 12px; font-size: 11.5px; font-weight: 800; letter-spacing: .1em; }
  .popup-wall small b { color: var(--bbfc-blue); }
  .popup-wall small i { font-style: normal; color: var(--bbfc-gray-1); font-weight: 700; letter-spacing: .04em; }
  .popup-wall strong { display: block; margin-top: 7px; font-size: 20px; line-height: 1.35; font-weight: 800; letter-spacing: -.03em; word-break: keep-all; }
  .popup-wall em { display: block; margin-top: 6px; color: var(--bbfc-gray-1); font-size: 14px; font-style: normal; line-height: 1.55; word-break: keep-all; }

  @media (prefers-reduced-motion: reduce) {
    .popup-wall__poster { transition: border-color .16s ease; }
    .popup-wall a:hover .popup-wall__poster,
    .popup-wall a:focus-visible .popup-wall__poster { transform: none; }
  }
  @media (max-width: 900px) {
    .popup-wall { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 14px; }
    .popup-wall strong { font-size: 17px; }
  }
  @media (max-width: 600px) {
    .popup-hall { padding: 14px 12px 48px; }
    .popup-hall__head { padding: 22px 18px 18px; }
    .popup-wall { gap: 18px 12px; }
    .popup-wall small { gap: 6px; font-size: 10.5px; }
    .popup-wall strong { margin-top: 6px; font-size: 15px; }
    .popup-wall em { font-size: 12.5px; }
  }
</style>
